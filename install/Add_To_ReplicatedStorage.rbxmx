]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX52"><Properties><string name="Name">SpinCharacters</string></Properties><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">Axl_Client</string><ProtectedString name="Source"><![CDATA[--[[
	Axl_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Axl RO: Civil War.
	Its other half is Axl_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: AxlVFX
-- ======================================================================
__modules["AxlVFX"] = function()
--[[
	TuskActVFX.AxlVFX  (StarterPlayerScripts.SpinClient.TuskActVFX.AxlVFX)

	Client visuals for Axl RO / CIVIL WAR: guilt made real. Blocky.
	  * the CIVIL WAR Stand (CivilWarStand) floats behind him with a crimson
	    aura and strikes with his moves
	  * GUILT (passive): crimson marks above anyone carrying guilt (1-5)
	  * GUILT SPECTERS: pale ghosts rise from his shadow and chase their
	    target, reaching for them, and grab with a flash
	  * ABANDONED JUNK: junk (crates, wheels, chairs, bottles, boots, lamps)
	    materialises round him, shakes, then flies, tumbling; what hits sticks
	    to their body until it falls off
	  * GUILT MEMBRANE: a grey-violet film wraps the target with junk stuck to
	    it and slowly shrinks; in the rain it drips and dissolves faster. The
	    victim's own screen darkens and their guilt whispers at them; at max
	    guilt the crush flattens them
	  * CIVIL WAR: junk piles and specters rise in a ring round him; everyone
	    caught is wrapped; when he's hit he breaks apart into red, yellow and
	    silver pieces and reforms; then every membrane crushes shut
]]

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local Net = __require("Net")
local TuskStandModels = __require("TuskStandModels")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")
local Fighters = __require("Fighters")
local TuskStand = __require("TuskStand")
local CivilWarStand = __require("CivilWarStand")

local AxlVFX = {}
local ACT = 12
local pal = Common.palette(ACT)
local sounds = TuskConfig.Sounds

-- CIVIL WAR floats behind him (players and NPCs), like Tusk does.
TuskStandModels.register(ACT, CivilWarStand.build, { Aura = CivilWarStand.Aura, AuraLight = CivilWarStand.AuraLight, Offset = CivilWarStand.Offset })

local GHOST = Color3.fromRGB(210, 222, 255)
local SHADOW = Color3.fromRGB(30, 18, 36)
local FILM = Color3.fromRGB(150, 130, 170)
local WATER = Color3.fromRGB(150, 205, 255)
local WOOD = Color3.fromRGB(130, 92, 56)
local WOOD_DARK = Color3.fromRGB(90, 62, 38)
local METAL = Color3.fromRGB(140, 144, 152)
local GLASS = Color3.fromRGB(110, 160, 110)
local LEATHER = Color3.fromRGB(70, 46, 32)
local PIECES = { Color3.fromRGB(196, 46, 40), Color3.fromRGB(234, 208, 128), Color3.fromRGB(190, 196, 206), Color3.fromRGB(90, 52, 110) }

local projectiles = {} -- [id] = flying junk
local hunters = {} -- [id] = specter chasing its target
local marks = {} -- [character] = guilt marks above their head
local stuckJunk = {} -- list of junk stuck to bodies
local membranes = {} -- [character] = film
local stanced = {}

---------------------------------------------------------------------------
-- Pieces
---------------------------------------------------------------------------
local function box(model, size, cf, color, material, transparency)
	local p = VFXLib.part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, Transparency = transparency or 0 })
	p.Parent = model
	return p
end

local function newModel(name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = VFXLib.Folder
	return m
end

-- Move every part of a model built round the origin to `cf` (keeps offsets).
local function place(item, cf)
	for _, p in ipairs(item.Parts) do
		p.CFrame = cf * item.Offsets[p]
	end
end

local function finish(m)
	local item = { Model = m, Parts = {}, Offsets = {} }
	for _, p in ipairs(m:GetChildren()) do
		if p:IsA("BasePart") then
			table.insert(item.Parts, p)
			item.Offsets[p] = p.CFrame
		end
	end
	return item
end

-- A piece of abandoned junk, built round the origin.
local function buildJunk(style, scale)
	local s = scale or 1
	local m = newModel("Junk")
	if style == "Wheel" then
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			box(m, Vector3.new(0.2, 0.62, 0.2) * s, CFrame.new(math.cos(a) * 0.75 * s, math.sin(a) * 0.75 * s, 0) * CFrame.Angles(0, 0, a), WOOD)
		end
		box(m, Vector3.new(1.4, 0.1, 0.1) * s, CFrame.new(), WOOD_DARK)
		box(m, Vector3.new(0.1, 1.4, 0.1) * s, CFrame.new(), WOOD_DARK)
		box(m, Vector3.new(0.3, 0.3, 0.3) * s, CFrame.new(), METAL)
	elseif style == "Chair" then
		box(m, Vector3.new(1, 0.15, 1) * s, CFrame.new(), WOOD)
		box(m, Vector3.new(1, 1, 0.14) * s, CFrame.new(0, 0.55 * s, 0.45 * s), WOOD)
		for _, x in ipairs({ -0.4, 0.4 }) do
			for _, z in ipairs({ -0.4, 0.4 }) do
				box(m, Vector3.new(0.12, 0.8, 0.12) * s, CFrame.new(x * s, -0.45 * s, z * s), WOOD_DARK)
			end
		end
	elseif style == "Bottle" then
		box(m, Vector3.new(0.45, 0.8, 0.45) * s, CFrame.new(), GLASS, Enum.Material.Glass, 0.2)
		box(m, Vector3.new(0.2, 0.4, 0.2) * s, CFrame.new(0, 0.6 * s, 0), GLASS, Enum.Material.Glass, 0.2)
		box(m, Vector3.new(0.22, 0.1, 0.22) * s, CFrame.new(0, 0.82 * s, 0), WOOD_DARK)
	elseif style == "Boot" then
		box(m, Vector3.new(0.5, 0.9, 0.5) * s, CFrame.new(0, 0.2 * s, 0.15 * s), LEATHER)
		box(m, Vector3.new(0.5, 0.35, 0.9) * s, CFrame.new(0, -0.3 * s, -0.1 * s), LEATHER)
	elseif style == "Lamp" then
		box(m, Vector3.new(0.6, 0.12, 0.6) * s, CFrame.new(0, -0.5 * s, 0), METAL)
		box(m, Vector3.new(0.12, 0.8, 0.12) * s, CFrame.new(0, -0.05 * s, 0), METAL)
		box(m, Vector3.new(0.7, 0.45, 0.7) * s, CFrame.new(0, 0.5 * s, 0), Color3.fromRGB(230, 200, 120), Enum.Material.Neon, 0.3)
	else -- Crate
		box(m, Vector3.new(1, 1, 1) * s, CFrame.new(), WOOD)
		for _, y in ipairs({ -0.3, 0.3 }) do
			box(m, Vector3.new(1.04, 0.12, 1.04) * s, CFrame.new(0, y * s, 0), WOOD_DARK)
		end
		box(m, Vector3.new(1.04, 0.12, 1.04) * s, CFrame.new() * CFrame.Angles(0, 0, math.pi / 4), WOOD_DARK)
	end
	return finish(m)
end

-- A pale ghost (a specter of someone they left behind), arms reaching up.
local function buildGhost(scale)
	local s = scale or 1
	local m = newModel("Specter")
	box(m, Vector3.new(1.4, 1.6, 0.8) * s, CFrame.new(0, 0, 0), GHOST, Enum.Material.Neon, 0.45)
	box(m, Vector3.new(1, 1, 1) * s, CFrame.new(0, 1.35 * s, 0), GHOST, Enum.Material.Neon, 0.4)
	box(m, Vector3.new(0.2, 0.25, 0.05) * s, CFrame.new(-0.22 * s, 1.4 * s, -0.5 * s), SHADOW)
	box(m, Vector3.new(0.2, 0.25, 0.05) * s, CFrame.new(0.22 * s, 1.4 * s, -0.5 * s), SHADOW)
	box(m, Vector3.new(0.3, 0.35, 0.05) * s, CFrame.new(0, 1.05 * s, -0.5 * s), SHADOW)
	for _, side in ipairs({ -1, 1 }) do
		box(m, Vector3.new(0.4, 1.7, 0.4) * s, CFrame.new(side * 0.85 * s, 1.1 * s, -0.2 * s) * CFrame.Angles(-0.4, 0, side * -0.35), GHOST, Enum.Material.Neon, 0.45)
	end
	-- Tail of mist fading into the ground.
	for i = 1, 3 do
		box(m, Vector3.new(1.2 - i * 0.25, 0.6, 0.7 - i * 0.12) * s, CFrame.new(0, -0.6 * s - i * 0.5 * s, 0), GHOST, Enum.Material.Neon, 0.45 + i * 0.15)
	end
	return finish(m)
end

local function puff(position, color, count)
	VFXLib.burst(position, { Count = count or 10, Color = color or GHOST, Speed = 10, Lifetime = 0.4, Spread = 180 })
end

-- A ghost rises out of the ground at `spot`, holds, and fades.
local function riseGhost(spot, scale, facing)
	local g = buildGhost(scale)
	local look = facing or Vector3.new(0, 0, -1)
	local base = CFrame.lookAt(spot, spot + Vector3.new(look.X, 0, look.Z))
	VFXLib.animate(0.9, function(a)
		local up = VFXLib.easeOut(math.min(a / 0.35, 1))
		place(g, base * CFrame.new(0, -3 + up * 5, 0) * CFrame.Angles(0, math.sin(a * 9) * 0.1, 0))
		for _, p in ipairs(g.Parts) do
			if a > 0.6 then
				p.Transparency = math.min(1, p.Transparency + 0.06)
			end
		end
	end, function()
		g.Model:Destroy()
	end)
	puff(spot + Vector3.new(0, 1, 0), GHOST, 12)
end

---------------------------------------------------------------------------
-- Membrane on a target: film + stuck junk, shrinks; drips in the rain
---------------------------------------------------------------------------
local function wrap(target, duration, rain, flatten)
	local tr = Common.rootOf(target)
	if not tr then
		return
	end
	local old = membranes[target]
	if old then
		old.Model:Destroy()
	end
	local m = newModel("GuiltMembrane")
	local film = box(m, Vector3.new(3.4, 5.6, 2.4), tr.CFrame, FILM, Enum.Material.Glass, 0.55)
	local stuck = {}
	for i = 1, 5 do
		local styles = { "Crate", "Wheel", "Bottle", "Boot", "Chair" }
		local j = buildJunk(styles[i], 0.55)
		j.Model.Parent = m
		local a = i / 5 * math.pi * 2
		table.insert(stuck, { Item = j, Offset = CFrame.new(math.cos(a) * 1.5, (i % 3 - 1) * 1.4, math.sin(a) * 1.1) * CFrame.Angles(a, a * 2, 0) })
	end
	membranes[target] = { Model = m, Film = film, Stuck = stuck, Target = target, Born = os.clock(), Duration = duration or 3, Rain = rain, Flatten = flatten }
	puff(tr.Position, FILM, 14)
end

local function stepMembranes()
	local now = os.clock()
	for target, mb in pairs(membranes) do
		local tr = Common.rootOf(target)
		local a = (now - mb.Born) / mb.Duration
		if not tr or a >= 1 or not target.Parent then
			membranes[target] = nil
			mb.Model:Destroy()
			if tr then
				-- Squeezed shut: a crunch and a puff.
				VFXLib.burst(tr.Position, { Count = 14, Color = FILM, Speed = 16, Lifetime = 0.35 })
				TuskVFX.CreateImpactStar(tr.Position, { Size = mb.Flatten and 6 or 3, Rays = 6, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Duration = 0.12 })
				if mb.Flatten then
					-- Max guilt: flattened like paper for a moment.
					local sheet = VFXLib.part({ Size = Vector3.new(3.2, 0.15, 2.2), Color = FILM, Material = Enum.Material.Glass, Transparency = 0.3 })
					local at = tr.CFrame
					VFXLib.animate(0.6, function(a)
						sheet.CFrame = at * CFrame.new(0, -2.4, 0)
						sheet.Size = Vector3.new(3.2 + a, 0.15, 2.2 + a)
						sheet.Transparency = 0.3 + 0.7 * a
					end, function()
						sheet:Destroy()
					end)
					TuskVFX.CreateGroundCracks(tr.Position - Vector3.new(0, 2.5, 0), { Radius = 6, Color = pal.Main })
				end
			end
		else
			-- Shrinks tighter and tighter (with a heartbeat squeeze each half second).
			local squeeze = 1.25 - 0.4 * a - 0.05 * math.abs(math.sin((now - mb.Born) * math.pi * 2))
			mb.Film.Size = Vector3.new(2.7, 5.2, 1.9) * squeeze
			mb.Film.CFrame = tr.CFrame
			mb.Film.Transparency = mb.Rain and (0.55 + 0.35 * a) or 0.55
			for _, st in ipairs(mb.Stuck) do
				local off = st.Offset
				place(st.Item, tr.CFrame * CFrame.new(off.Position * squeeze) * (off - off.Position))
			end
			if mb.Rain and math.random() < 0.3 then
				-- Water washes it away: it drips.
				VFXLib.burst(tr.Position + Vector3.new((math.random() - 0.5) * 2, -1, (math.random() - 0.5) * 2), { Count = 2, Color = WATER, Speed = 4, Lifetime = 0.4, Direction = Vector3.new(0, -1, 0), Spread = 20 })
			end
		end
	end
end

---------------------------------------------------------------------------
-- GUILT marks above a head: five pips, the lit ones crimson
---------------------------------------------------------------------------
local function setMarks(target, stacks)
	if typeof(target) ~= "Instance" then
		return
	end
	local m = marks[target]
	if stacks <= 0 then
		if m then
			m.Gui:Destroy()
			marks[target] = nil
		end
		return
	end
	local head = target:FindFirstChild("Head") or Common.rootOf(target)
	if not head then
		return
	end
	if not m then
		local gui = Instance.new("BillboardGui")
		gui.Name = "GuiltMarks"
		gui.Size = UDim2.fromOffset(96, 26)
		gui.StudsOffset = Vector3.new(0, 2.8, 0)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 90
		gui.Adornee = head
		gui.Parent = VFXLib.Folder
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0, 11)
		label.Font = Enum.Font.GothamBlack
		label.TextSize = 10
		label.TextColor3 = Color3.fromRGB(255, 170, 180)
		label.TextStrokeTransparency = 0.3
		label.Text = "GUILT"
		label.Parent = gui
		local pips = {}
		for i = 1, 5 do
			local pip = Instance.new("Frame")
			pip.AnchorPoint = Vector2.new(0.5, 0)
			pip.Position = UDim2.new(0.5, (i - 3) * 17, 0, 13)
			pip.Size = UDim2.fromOffset(12, 12)
			pip.Rotation = 45
			pip.BorderSizePixel = 0
			pip.Parent = gui
			pips[i] = pip
		end
		m = { Gui = gui, Pips = pips, Stacks = 0 }
		marks[target] = m
	end
	if stacks > m.Stacks then
		-- A new mark flares as it lands.
		local pip = m.Pips[stacks]
		if pip then
			VFXLib.animate(0.25, function(a)
				pip.Size = UDim2.fromOffset(12 + 10 * (1 - a), 12 + 10 * (1 - a))
			end)
		end
	end
	m.Stacks = stacks
	for i, pip in ipairs(m.Pips) do
		local lit = i <= stacks
		pip.BackgroundColor3 = lit and (stacks >= 5 and Color3.fromRGB(255, 60, 90) or pal.Main) or Color3.fromRGB(40, 24, 36)
		pip.BackgroundTransparency = lit and 0 or 0.35
	end
end

---------------------------------------------------------------------------
-- Specters hunting their target (the server decides the grab)
---------------------------------------------------------------------------
local function spawnHunter(data)
	local target = data.Target
	local g = buildGhost(0.95)
	local h = { Ghost = g, Pos = data.From, Target = target, Speed = data.Speed or 24, Born = os.clock() + (data.Delay or 0), Life = (data.Life or 3) + 0.5, Next = 0 }
	hunters[data.Id] = h
	place(g, CFrame.new(data.From - Vector3.new(0, 3, 0)))
	puff(data.From, GHOST, 8)
end

local function endHunter(id, grabbed, position)
	local h = hunters[id]
	if not h then
		return
	end
	hunters[id] = nil
	local at = position or h.Pos
	if grabbed then
		-- It lunges in and pours into them.
		local g = h.Ghost
		local from = h.Pos
		VFXLib.animate(0.25, function(a)
			place(g, CFrame.lookAt(from:Lerp(at, a), at) * CFrame.new(0, 0, 0) * CFrame.Angles(-0.6 * a, 0, 0))
			for _, p in ipairs(g.Parts) do
				p.Transparency = math.min(1, p.Transparency + 0.08)
			end
		end, function()
			g.Model:Destroy()
		end)
		TuskVFX.CreateImpactStar(at, { Size = 3.5, Rays = 7, Color = GHOST, Color2 = pal.Main, Duration = 0.15 })
		puff(at, GHOST, 16)
	else
		h.Ghost.Model:Destroy()
		puff(at, GHOST, 10)
	end
end

local function stepHunters(dt)
	local now = os.clock()
	for id, h in pairs(hunters) do
		local tr = Common.rootOf(h.Target)
		if now - h.Born > h.Life or (now > h.Born and not tr) then
			endHunter(id, false)
		elseif now >= h.Born then
			local to = tr.Position - h.Pos
			if to.Magnitude > 0.5 then
				h.Pos = h.Pos + to.Unit * math.min(h.Speed * dt, to.Magnitude)
			end
			-- Floats low, swaying, arms out toward them.
			local rise = math.min((now - h.Born) / 0.3, 1)
			local look = Vector3.new(to.X, 0, to.Z)
			local cf = CFrame.lookAt(h.Pos, h.Pos + (look.Magnitude > 0.1 and look or Vector3.new(0, 0, -1)))
			place(h.Ghost, cf * CFrame.new(math.sin(now * 5 + id) * 0.3, -3 + rise * 3.3 + math.sin(now * 3) * 0.2, 0) * CFrame.Angles(0.25, 0, 0))
			h.Next = h.Next - dt
			if h.Next <= 0 then
				h.Next = 0.12
				puff(h.Pos - Vector3.new(0, 1.5, 0), GHOST, 1)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Junk stuck to a body
---------------------------------------------------------------------------
local function stickJunk(target, style, duration)
	local tr = Common.rootOf(target)
	if not tr then
		return
	end
	local item = buildJunk(style or "Crate", 0.5)
	local a = math.random() * math.pi * 2
	table.insert(stuckJunk, { Item = item, Target = target, Offset = CFrame.new(math.cos(a) * 1.1, math.random() * 2 - 0.8, math.sin(a) * 0.7) * CFrame.Angles(a, a * 2, 0), Until = os.clock() + (duration or 4) })
end

local function stepStuck()
	local now = os.clock()
	for i = #stuckJunk, 1, -1 do
		local st = stuckJunk[i]
		local tr = Common.rootOf(st.Target)
		if not tr or now > st.Until then
			table.remove(stuckJunk, i)
			-- It drops off and fades.
			local item = st.Item
			local from = item.Parts[1] and item.Parts[1].CFrame or CFrame.new()
			VFXLib.animate(0.4, function(a)
				place(item, from * CFrame.new(0, -3 * a * a, 0))
				for _, p in ipairs(item.Parts) do
					p.Transparency = math.min(1, p.Transparency + 0.06)
				end
			end, function()
				item.Model:Destroy()
			end)
		else
			place(st.Item, tr.CFrame * st.Offset)
		end
	end
end

-- The victim's own screen: their guilt closes in on them.
local WHISPERS = { "...you left it behind.", "...you gave it up.", "...remember?", "...it was your fault.", "...you never went back." }
local function guiltScreen(duration, strong)
	TuskVFX.ScreenTint(duration, { Tint = Color3.fromRGB(200, 170, 210), Saturation = -0.5, Brightness = -0.12 })
	local gui = Instance.new("ScreenGui")
	gui.Name = "GuiltWhispers"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 5
	gui.Parent = game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local count = strong and 4 or 2
	for i = 1, count do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.25 + math.random() * 0.5, 0.3 + math.random() * 0.4)
		label.Size = UDim2.fromOffset(360, 30)
		label.Font = Enum.Font.Fondamento
		label.TextSize = strong and 28 or 22
		label.TextColor3 = Color3.fromRGB(235, 215, 240)
		label.TextStrokeColor3 = Color3.fromRGB(40, 10, 30)
		label.Text = WHISPERS[math.random(1, #WHISPERS)]
		label.TextTransparency = 1
		label.TextStrokeTransparency = 1
		label.Parent = gui
		local start = (i - 1) * duration / (count + 1)
		VFXLib.animate(duration, function(a)
			local t = a * duration - start
			local alpha = t < 0 and 0 or math.min(t / 0.4, 1) * math.max(0, 1 - (t - 1.2) / 0.6)
			label.TextTransparency = 1 - alpha * 0.9
			label.TextStrokeTransparency = 1 - alpha * 0.6
		end)
	end
	task.delay(duration + 0.1, function()
		gui:Destroy()
	end)
end

---------------------------------------------------------------------------
-- Junk projectiles (server Kind "GuiltJunk")
---------------------------------------------------------------------------
local function spawnJunk(data)
	local style = data.Visual and data.Visual.Style or "Crate"
	local item = buildJunk(style, 1)
	projectiles[data.Id] = { Item = item, Origin = data.Origin, Direction = data.Direction, Speed = data.Speed, Range = data.Range, ServerTime = data.ServerTime, Expire = os.clock() + data.Range / math.max(data.Speed, 1) + 0.5, Spin = math.random() * 10 }
end

local function endJunk(data)
	local v = projectiles[data.Id]
	if v then
		projectiles[data.Id] = nil
		v.Item.Model:Destroy()
	end
	VFXLib.burst(data.Position, { Count = data.HitCharacter and 12 or 6, Color = WOOD, Speed = 14, Lifetime = 0.35 })
	if data.HitCharacter then
		TuskVFX.CreateImpactStar(data.Position, { Size = 2.6, Rays = 5, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Duration = 0.12 })
	end
end

local function stepJunk()
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	for id, v in pairs(projectiles) do
		local t = serverNow - v.ServerTime
		local distance = math.min(v.Speed * t, v.Range)
		local pos = v.Origin + v.Direction * math.max(distance, 0)
		place(v.Item, CFrame.new(pos) * CFrame.Angles(t * 9 + v.Spin, t * 6, t * 4))
		if now > v.Expire then
			projectiles[id] = nil
			v.Item.Model:Destroy()
		end
	end
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	TuskAnimation.play(character, "A_M1_" .. index)
	TuskStand.action(character, "Lunge", { Target = CFrame.new(index % 2 == 0 and -0.8 or 0.8, 1, -3.2), Duration = 0.3 })
	VFXLib.sound(sounds.Swing, root, 0.5, 0.95 + index * 0.05)
	Common.swipe(root, index % 2 == 1 and 1 or -1, index % 2 == 1 and pal.Main or pal.Second)
end

local function onFinisher(data)
	Common.finisher(data, pal)
	if data.Position then
		puff(data.Position, FILM, 14)
	end
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local move, phase = data.Move, data.Phase
	if move == "Guilt" and phase == "Mark" then
		setMarks(data.Target, data.Stacks or 0)
		return
	end
	if move == "GuiltSpecter" then
		if phase == "Spawn" then
			spawnHunter(data)
		elseif phase == "Grab" then
			endHunter(data.Id, true, data.Position)
			if data.Target and Common.isLocal(data.Target) then
				CameraFX.shake(0.5, 0.25)
			end
		elseif phase == "Fade" then
			endHunter(data.Id, false, data.Position)
		elseif phase == "Cast" and character then
			TuskAnimation.play(character, "AxlSpecter")
			TuskStand.action(character, "Lunge", { Duration = 0.4 })
		elseif phase == "Warn" and data.Position then
			-- A dark pool spreads under them: something is coming up.
			local pool = VFXLib.part({ Size = Vector3.new(0.2, 1, 1), Color = SHADOW, Material = Enum.Material.SmoothPlastic, Transparency = 0.2 })
			local r = data.Radius or 5
			local at = data.Position
			VFXLib.animate(data.Rise or 0.55, function(a)
				pool.Size = Vector3.new(0.2, r * 2 * a, r * 2 * a)
				pool.CFrame = CFrame.new(at + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, a * 2, math.pi / 2)
				if math.random() < 0.4 then
					puff(at + Vector3.new((math.random() - 0.5) * r, 0.5, (math.random() - 0.5) * r), FILM, 2)
				end
			end, function()
				pool:Destroy()
			end)
		elseif phase == "Rise" and data.Position then
			local facing = root and (root.Position - data.Position) or nil
			riseGhost(data.Position, 1.2, facing)
			if data.Hit then
				CameraFX.shake(0.4, 0.2)
			end
		elseif phase == "Miss" and root then
			puff((root.CFrame * CFrame.new(0, 0, -5)).Position, GHOST, 8)
		end
	elseif move == "AbandonedJunk" and phase == "Stick" then
		stickJunk(data.Target, data.Style, data.Duration)
	elseif move == "AbandonedJunk" and phase == "Gather" and root then
		TuskAnimation.play(character, "AxlJunk")
		TuskStand.action(character, "Lunge", { Duration = (data.Startup or 0.3) + 0.2 })
		-- Junk rises out of his shadow and shakes before it flies.
		local styles = { "Crate", "Wheel", "Chair", "Bottle", "Boot", "Lamp" }
		local items = {}
		for i = 1, data.Count or 6 do
			local t = (i - 1) / math.max((data.Count or 6) - 1, 1) - 0.5
			local item = buildJunk(styles[(i - 1) % #styles + 1], 1)
			local home = root.CFrame * CFrame.new(t * 5, 1.5 + (i % 3) * 0.6, -2)
			table.insert(items, { Item = item, Home = home })
		end
		VFXLib.animate(data.Startup or 0.3, function(a)
			for i, it in ipairs(items) do
				local shake = CFrame.new((math.random() - 0.5) * 0.12, (math.random() - 0.5) * 0.12, 0)
				place(it.Item, it.Home * CFrame.new(0, -2 * (1 - a), 0) * shake * CFrame.Angles(0, i + a * 2, 0))
			end
		end, function()
			for _, it in ipairs(items) do
				it.Item.Model:Destroy()
			end
		end)
	elseif move == "GuiltMembrane" then
		if phase == "Cast" and character then
			TuskAnimation.play(character, "AxlMembrane")
			TuskStand.action(character, "Lunge", { Duration = 0.5 })
		elseif phase == "Engulf" then
			for _, target in ipairs(data.Targets or {}) do
				wrap(target, data.Duration, data.Rain, data.Flatten)
				if Common.isLocal(target) then
					guiltScreen(data.Duration or 3, data.Flatten)
				end
			end
		elseif phase == "Miss" and root then
			puff((root.CFrame * CFrame.new(0, 0, -6)).Position, FILM, 8)
		end
	end
end

local rises = {} -- piles and specters standing round an ultimate

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Rise" then
		TuskAnimation.play(character, "AxlCivilWar")
		TuskStand.action(character, "Manifest", { Duration = 1 })
		local center = data.Position
		local radius = data.Radius or 20
		-- Junk piles rise in a ring, specters among them reaching inward.
		local styles = { "Crate", "Wheel", "Chair", "Bottle", "Boot", "Lamp" }
		local list = {}
		for i = 1, 12 do
			local a = i / 12 * math.pi * 2
			local spot = center + Vector3.new(math.cos(a) * radius * 0.85, 0, math.sin(a) * radius * 0.85)
			local pile = buildJunk(styles[(i - 1) % #styles + 1], 1.6)
			table.insert(list, { Item = pile, Spot = spot, Angle = a })
		end
		VFXLib.animate(data.Windup or 1, function(a)
			for _, it in ipairs(list) do
				place(it.Item, CFrame.new(it.Spot + Vector3.new(0, -2 + VFXLib.easeOut(a) * 2.8, 0)) * CFrame.Angles(it.Angle, it.Angle * 2, 0))
			end
		end)
		rises[character] = list
		for i = 1, data.Specters or 7 do
			local a = (i + 0.5) / (data.Specters or 7) * math.pi * 2
			local spot = center + Vector3.new(math.cos(a) * radius * 0.7, 0, math.sin(a) * radius * 0.7)
			task.delay((data.Windup or 1) * 0.5 + i * 0.05, function()
				riseGhost(spot, 1.4, center - spot)
			end)
		end
		if Common.isLocal(character) then
			TuskVFX.ScreenTint((data.Windup or 1) + 3, { Tint = Color3.fromRGB(230, 200, 210), Saturation = -0.4, Brightness = -0.08 })
		end
		VFXLib.sound(sounds.AwakeningBuild, center, 0.5, 0.8)
	elseif data.Phase == "Engulf" then
		for _, target in ipairs(data.Targets or {}) do
			wrap(target, data.Duration, data.Rain, true)
			if Common.isLocal(target) then
				guiltScreen(data.Duration or 3, true)
			end
		end
		TuskVFX.CreateGroundCracks(data.Position, { Radius = (data.Radius or 20) * 0.6, Color = pal.Main })
	elseif data.Phase == "Scatter" then
		-- Civil War breaks apart: red, yellow and silver pieces scatter and reform.
		local from, to = data.From, data.To
		for i = 1, 18 do
			local p = VFXLib.part({ Size = Vector3.new(0.5, 0.5, 0.5), Color = PIECES[(i - 1) % #PIECES + 1], Material = Enum.Material.SmoothPlastic })
			local off = Vector3.new(math.random() - 0.5, math.random() * 2 - 0.5, math.random() - 0.5) * 6
			VFXLib.animate(0.4, function(a)
				local out = a < 0.5 and VFXLib.easeOut(a * 2) or 1 - VFXLib.easeOut((a - 0.5) * 2)
				p.CFrame = CFrame.new(from:Lerp(to, a) + off * out) * CFrame.Angles(a * 6, a * 4, 0)
			end, function()
				p:Destroy()
			end)
		end
		puff(from, FILM, 16)
	elseif data.Phase == "Crush" then
		local list = rises[character]
		rises[character] = nil
		if list then
			for _, it in ipairs(list) do
				local start = it.Item.Parts[1] and it.Item.Parts[1].CFrame or CFrame.new(it.Spot)
				VFXLib.animate(0.35, function(a)
					place(it.Item, CFrame.new(it.Spot + Vector3.new(0, 0.8 - a * 3, 0)) * (start - start.Position))
				end, function()
					it.Item.Model:Destroy()
				end)
			end
		end
		for _, target in ipairs(data.Targets or {}) do
			local tr = Common.rootOf(target)
			if tr then
				Common.finisher({ Character = character, Position = tr.Position, Hit = true }, pal, { Size = 1.2, Layers = 2, Shake = 0.6 })
			end
		end
		if Common.isLocal(character) then
			CameraFX.impactFrame(pal.Main)
		end
	end
end

---------------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------------
local function stepStance()
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		if character then
			local want = character:GetAttribute("TuskAct") == ACT
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "AxlStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "AxlStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
end

function AxlVFX.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		onFinisher(data)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function AxlVFX.step(dt)
	dt = dt or 1 / 60
	stepJunk()
	stepMembranes()
	stepHunters(dt)
	stepStuck()
	-- Marks go when the character does.
	for target, m in pairs(marks) do
		if not target.Parent then
			m.Gui:Destroy()
			marks[target] = nil
		end
	end
	slowTimer = slowTimer + dt
	if slowTimer > 0.2 then
		slowTimer = 0
		stepStance()
	end
end

Net.get("SpinFX").OnClientEvent:Connect(function(name, data)
	if typeof(data) ~= "table" or data.Kind ~= "GuiltJunk" then
		return
	end
	if name == "ProjectileSpawn" then
		spawnJunk(data)
	elseif name == "ProjectileEnd" then
		endJunk(data)
	end
end)

return AxlVFX
end

-- ======================================================================
-- MODULE: CivilWarStand
-- ======================================================================
__modules["CivilWarStand"] = function()
--[[
	TuskActVFX.CivilWarStand  (StarterPlayerScripts.SpinClient.TuskActVFX.CivilWarStand)

	The CIVIL WAR Stand model (Axl RO), blocky, matched to the art: red,
	yellow and silvery metal.
	  * the head: a distorted metal mask of tall vertical discs pressed
	    together, a spike on top, three arrow points tapering below
	  * three gas-mask filter canisters round the base of the neck (front
	    and both sides)
	  * a red quilted (tufted) chest and a quilted hump on the back
	  * silver shoulder balls; long yellow limbs with purple joint rings
	  * a bare silver spine from the ribcage down to a toothed silver pelvis
	  * red, fraying bell-bottom lower legs like roots, pointed red feet
	Registered with TuskStandModels by AxlVFX, so TuskStand floats it behind
	Axl RO (players and NPCs) with a crimson aura. A custom model at
	ReplicatedStorage.SpinAssets.TuskAct12 replaces it.
]]

local CivilWarStand = {}

local RED = Color3.fromRGB(196, 46, 40)
local RED_DARK = Color3.fromRGB(128, 26, 26)
local YELLOW = Color3.fromRGB(234, 208, 128)
local YELLOW_DARK = Color3.fromRGB(196, 166, 90)
local SILVER = Color3.fromRGB(190, 196, 206)
local SILVER_DARK = Color3.fromRGB(120, 126, 140)
local PURPLE = Color3.fromRGB(90, 52, 110)
local PURPLE_DARK = Color3.fromRGB(40, 24, 52)
local BUTTON = Color3.fromRGB(214, 170, 80)

CivilWarStand.Aura = Color3.fromRGB(220, 50, 70)
CivilWarStand.AuraLight = Color3.fromRGB(255, 170, 180)
CivilWarStand.Offset = CFrame.new(2.5, 1.7, 3.1)

local function newPart(model, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.Color = color
	p.Parent = model
	return p
end

local function box(model, parent, name, size, color, cf, material)
	local p = newPart(model, name, size, color, material)
	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = p
	w.C0 = cf
	w.Parent = p
	p.CFrame = parent.CFrame * cf
	return p, w
end

-- A purple joint ring round a limb (local Y axis) at `cf`.
local function ring(model, parent, cf, width, s)
	box(model, parent, "Ring", Vector3.new(width + 0.22 * s, 0.24 * s, width + 0.22 * s), PURPLE, cf)
	box(model, parent, "RingHole", Vector3.new(0.2, 0.2, 0.06) * s, PURPLE_DARK, cf * CFrame.new(0, 0, -(width / 2 + 0.12 * s)))
end

-- Quilting on a face: a diamond grid of creases with buttons where they meet.
local function quilt(model, parent, cf, w, h, s)
	local cols, rows = math.max(2, math.floor(w / (0.5 * s))), math.max(2, math.floor(h / (0.45 * s)))
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			local x = (i - (cols - 1) / 2) * w / cols
			local y = (j - (rows - 1) / 2) * h / rows
			box(model, parent, "Quilt", Vector3.new(0.3, 0.05, 0.04) * s, RED_DARK, cf * CFrame.new(x, y, 0) * CFrame.Angles(0, 0, math.pi / 4))
			box(model, parent, "Quilt", Vector3.new(0.3, 0.05, 0.04) * s, RED_DARK, cf * CFrame.new(x, y, 0) * CFrame.Angles(0, 0, -math.pi / 4))
			box(model, parent, "Tuft", Vector3.new(0.08, 0.08, 0.05) * s, BUTTON, cf * CFrame.new(x, y, -0.01 * s))
		end
	end
end

function CivilWarStand.build(scale)
	local s = (scale or 1) * 0.85
	local model = Instance.new("Model")
	model.Name = "CivilWar"
	local rig = { Joints = {} }

	-- Red quilted chest (the anchored root the Stand is moved by).
	local torso = newPart(model, "Body", Vector3.new(2.1, 1.5, 1.1) * s, RED)
	torso.Anchored = true
	torso.Massless = false
	torso.CFrame = CFrame.new()
	model.PrimaryPart = torso
	rig.Body = torso
	quilt(model, torso, CFrame.new(0, 0, -0.56 * s), 1.9 * s, 1.3 * s, s)
	-- The quilted hump on its back.
	local hump = box(model, torso, "Hump", Vector3.new(1.9, 1.4, 0.8) * s, RED, CFrame.new(0, 0.25 * s, 0.85 * s))
	box(model, torso, "Hump", Vector3.new(1.5, 1.0, 0.3) * s, RED, CFrame.new(0, 0.3 * s, 1.36 * s))
	quilt(model, hump, CFrame.new(0, 0, 0.41 * s) * CFrame.Angles(0, math.pi, 0), 1.7 * s, 1.2 * s, s)
	box(model, torso, "ChestTrim", Vector3.new(2.16, 0.14, 1.16) * s, RED_DARK, CFrame.new(0, -0.72 * s, 0))

	-- Bare silver spine from the ribcage to the pelvis.
	for i = 0, 3 do
		local y = -0.95 * s - i * 0.34 * s
		box(model, torso, "Vertebra", Vector3.new(0.34, 0.22, 0.34) * s, SILVER, CFrame.new(0, y, 0.05 * s))
		box(model, torso, "Vertebra", Vector3.new(0.6, 0.08, 0.14) * s, SILVER_DARK, CFrame.new(0, y, 0.05 * s))
	end
	-- Toothed pelvis.
	box(model, torso, "Pelvis", Vector3.new(1.5, 0.55, 0.9) * s, SILVER, CFrame.new(0, -2.45 * s, 0))
	for i = -3, 3 do
		box(model, torso, "PelvisTooth", Vector3.new(0.1, 0.4, 0.06) * s, SILVER_DARK, CFrame.new(i * 0.18 * s, -2.5 * s, -0.47 * s))
	end

	-- Neck and the three gas-mask filter canisters.
	box(model, torso, "Neck", Vector3.new(0.5, 0.4, 0.5) * s, SILVER_DARK, CFrame.new(0, 0.9 * s, 0))
	for _, spot in ipairs({ { 0, -0.55, 0 }, { -0.6, -0.1, math.pi / 2 }, { 0.6, -0.1, -math.pi / 2 } }) do
		local cf = CFrame.new(spot[1] * s, 0.95 * s, spot[2] * s) * CFrame.Angles(0, spot[3], 0)
		box(model, torso, "Filter", Vector3.new(0.42, 0.42, 0.32) * s, SILVER, cf)
		box(model, torso, "FilterCap", Vector3.new(0.34, 0.34, 0.08) * s, SILVER_DARK, cf * CFrame.new(0, 0, -0.18 * s))
		box(model, torso, "FilterHole", Vector3.new(0.14, 0.14, 0.06) * s, PURPLE_DARK, cf * CFrame.new(0, 0, -0.22 * s))
	end

	-- Head: tall vertical discs pressed together, a spike, three arrows below.
	local headBase = CFrame.new(0, 1.1 * s, 0)
	local headOffset = CFrame.new(0, 0.75 * s, 0)
	local head, headWeld = box(model, torso, "Head", Vector3.new(0.3, 1.1, 0.9) * s, SILVER, headBase * headOffset, Enum.Material.Metal)
	rig.Joints.Head = { Weld = headWeld, Base = headBase, Offset = headOffset }
	local discs = { { -0.48, 0.9 }, { -0.32, 1.2 }, { -0.16, 1.45 }, { 0.16, 1.45 }, { 0.32, 1.2 }, { 0.48, 0.9 } }
	for i, d in ipairs(discs) do
		box(model, head, "Disc", Vector3.new(0.13, d[2], 0.95) * s, i % 2 == 0 and SILVER or SILVER_DARK, CFrame.new(d[1] * s, (d[2] - 1.1) * 0.3 * s, 0), Enum.Material.Metal)
	end
	box(model, head, "Disc", Vector3.new(0.16, 1.7, 1.0) * s, SILVER, CFrame.new(0, 0.2 * s, 0), Enum.Material.Metal)
	-- Spike on top with two little cross bars.
	for i = 0, 4 do
		local w = (0.22 - i * 0.035) * s
		box(model, head, "Spike", Vector3.new(w, 0.32 * s, w), SILVER, CFrame.new(0, (1.15 + i * 0.3) * s, 0), Enum.Material.Metal)
	end
	box(model, head, "CrossBar", Vector3.new(0.7, 0.06, 0.06) * s, SILVER_DARK, CFrame.new(0, 1.35 * s, 0))
	box(model, head, "CrossBar", Vector3.new(0.06, 0.06, 0.5) * s, SILVER_DARK, CFrame.new(0, 1.55 * s, 0))
	-- Three arrow points tapering down below the mask.
	for _, x in ipairs({ -0.3, 0, 0.3 }) do
		box(model, head, "Arrow", Vector3.new(0.1, 0.45, 0.1) * s, SILVER, CFrame.new(x * s, -0.75 * s, -0.2 * s), Enum.Material.Metal)
		box(model, head, "ArrowHead", Vector3.new(0.24, 0.24, 0.08) * s, SILVER_DARK, CFrame.new(x * s, -1.0 * s, -0.2 * s) * CFrame.Angles(0, 0, math.pi / 4), Enum.Material.Metal)
	end
	-- A slit of an eye in the mask.
	box(model, head, "Eye", Vector3.new(0.9, 0.06, 0.04) * s, PURPLE_DARK, CFrame.new(0, 0.25 * s, -0.5 * s))

	-- Shoulders (silver balls) and long yellow arms with purple joint rings.
	for _, a in ipairs({ { "ArmL", -1 }, { "ArmR", 1 } }) do
		local side = a[2]
		box(model, torso, "ShoulderBall", Vector3.new(0.6, 0.6, 0.6) * s, SILVER, CFrame.new(side * 1.25 * s, 0.5 * s, 0), Enum.Material.Metal)
		local base = CFrame.new(side * 1.3 * s, 0.4 * s, 0)
		local offset = CFrame.new(0, -1.25 * s, 0)
		local arm, weld = box(model, torso, a[1], Vector3.new(0.42, 2.5, 0.42) * s, YELLOW, base * offset)
		rig.Joints[a[1]] = { Weld = weld, Base = base, Offset = offset }
		ring(model, arm, CFrame.new(0, 1.05 * s, 0), 0.42 * s, s)
		ring(model, arm, CFrame.new(0, 0, 0), 0.42 * s, s)
		ring(model, arm, CFrame.new(0, -1.05 * s, 0), 0.42 * s, s)
		box(model, arm, "Muscle", Vector3.new(0.5, 0.7, 0.5) * s, YELLOW_DARK, CFrame.new(0, 0.55 * s, 0))
		local hand = box(model, arm, "Hand", Vector3.new(0.4, 0.34, 0.36) * s, YELLOW, CFrame.new(0, -1.38 * s, 0))
		for f = -1.5, 1.5 do
			box(model, hand, "Finger", Vector3.new(0.08, 0.5, 0.08) * s, YELLOW_DARK, CFrame.new(f * 0.1 * s, -0.38 * s, -0.06 * s) * CFrame.Angles(0.25, 0, 0))
		end
		if a[1] == "ArmR" then
			local point = Instance.new("Attachment")
			point.Name = "NailPoint"
			point.Position = Vector3.new(0, -0.5 * s, 0)
			point.Parent = hand
			rig.NailPoint = point
		end
	end

	-- Legs: yellow thighs, purple knee rings, red fraying bell-bottoms.
	for i, side in ipairs({ -1, 1 }) do
		local base = CFrame.new(side * 0.5 * s, -2.6 * s, 0)
		local offset = CFrame.new(0, -0.65 * s, 0)
		local leg, weld = box(model, torso, "Leg" .. i, Vector3.new(0.5, 1.3, 0.5) * s, YELLOW, base * offset)
		rig.Joints["Leg" .. i] = { Weld = weld, Base = base, Offset = offset }
		ring(model, leg, CFrame.new(0, 0.6 * s, 0), 0.5 * s, s)
		ring(model, leg, CFrame.new(0, -0.7 * s, 0), 0.5 * s, s)
		-- The bell-bottom widens toward the hem.
		for k = 0, 3 do
			local w = (0.6 + k * 0.16) * s
			box(model, leg, "BellBottom", Vector3.new(w, 0.4 * s, w), k % 2 == 0 and RED or RED_DARK, CFrame.new(0, (-1.0 - k * 0.38) * s, 0))
		end
		-- Frayed, root-like strips hanging from the hem.
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			local len = (0.35 + (k % 3) * 0.18) * s
			box(model, leg, "Fray", Vector3.new(0.12 * s, len, 0.12 * s), k % 2 == 0 and RED or RED_DARK, CFrame.new(math.cos(a) * 0.5 * s, -2.32 * s - len / 2, math.sin(a) * 0.5 * s) * CFrame.Angles(math.sin(a) * 0.3, 0, -math.cos(a) * 0.3))
		end
		box(model, leg, "Foot", Vector3.new(0.5, 0.26, 1.0) * s, RED, CFrame.new(0, -2.4 * s, -0.25 * s))
		box(model, leg, "Toe", Vector3.new(0.3, 0.2, 0.35) * s, RED_DARK, CFrame.new(0, -2.42 * s, -0.86 * s))
	end
	return model, rig
end

return CivilWarStand
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">Blackmore_Client</string><ProtectedString name="Source"><![CDATA[--[[
	Blackmore_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Blackmore: Catch the Rainbow.
	Its other half is Blackmore_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: BlackmoreVFX
-- ======================================================================
__modules["BlackmoreVFX"] = function()
--[[
	TuskActVFX.BlackmoreVFX  (StarterPlayerScripts.SpinClient.TuskActVFX.BlackmoreVFX)

	Client visuals for Blackmore / CATCH THE RAINBOW: raindrops frozen in
	mid-air. Blocky like the rest of the game.
	  * his UMBRELLA is always in his left hand (closed, like a cane); it
	    opens above his head during the storm
	  * RAINDROP BLADES: drops freeze in a fan in front of him, shiver, fire
	  * RAINDROP STEP: a stair of frozen drops hangs in the air along his dash
	    for a few seconds, then falls and splashes
	  * RAINDROP CAGE: a dome of frozen drops follows the target; each cut flashes
	  * RAIN WALK: while it rains (or in his storm) a jump in mid-air plants a
	    frozen raindrop under his feet: he can walk on the air and jump again
	    to step higher (an invisible local step follows him; everyone sees
	    the drops under his feet and his umbrella open)
	  * CATCH THE RAINBOW: a dark cloud, a downpour, a rainbow arc overhead,
	    frozen drops hanging everywhere; he scatters into raindrops when hit;
	    the end: every drop fires inward
]]

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local Net = __require("Net")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")
local Fighters = __require("Fighters")

local BlackmoreVFX = {}
local ACT = 11
local pal = Common.palette(ACT)
local sounds = TuskConfig.Sounds

local DROP = Color3.fromRGB(150, 205, 255)
local DROP_LIGHT = Color3.fromRGB(225, 245, 255)
local CANOPY = Color3.fromRGB(52, 50, 100)
local CANOPY_TRIM = Color3.fromRGB(84, 80, 140)
local SHAFT = Color3.fromRGB(30, 30, 36)
local RAINBOW = {
	Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 150, 60), Color3.fromRGB(255, 230, 80), Color3.fromRGB(90, 220, 110),
	Color3.fromRGB(80, 170, 255), Color3.fromRGB(110, 100, 230), Color3.fromRGB(180, 110, 230),
}

local umbrellas = {} -- [character] = { Closed, Open }
local stanced = {}
local projectiles = {} -- [id] = flying drop
local cages = {} -- [model] = dome of drops
local storms = {} -- list of active storms

---------------------------------------------------------------------------
-- Pieces
---------------------------------------------------------------------------
local function box(model, size, cf, color, material, transparency)
	local p = VFXLib.part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, Transparency = transparency or 0 })
	p.Parent = model
	return p
end

local function newDrop(scale)
	local s = scale or 1
	return VFXLib.part({ Size = Vector3.new(0.18, 0.36, 0.18) * s, Color = DROP, Material = Enum.Material.Glass, Transparency = 0.2 })
end

-- Closed umbrella (a cane): handle at the origin, shaft going down -Y.
local function buildClosedUmbrella()
	local m = Instance.new("Model")
	m.Name = "Umbrella"
	m.Parent = VFXLib.Folder
	local grip = box(m, Vector3.new(0.16, 0.5, 0.16), CFrame.new(0, 0.15, 0), SHAFT)
	box(m, Vector3.new(0.16, 0.16, 0.4), CFrame.new(0, 0.42, -0.14), SHAFT) -- hooked handle
	box(m, Vector3.new(0.16, 0.3, 0.16), CFrame.new(0, 0.3, -0.32), SHAFT)
	box(m, Vector3.new(0.08, 2.8, 0.08), CFrame.new(0, -1.3, 0), SHAFT)
	-- Furled canopy: stacked blocks tapering to the tip.
	for i = 0, 3 do
		local w = 0.42 - i * 0.08
		box(m, Vector3.new(w, 0.5, w), CFrame.new(0, -0.9 - i * 0.45, 0), i % 2 == 0 and CANOPY or CANOPY:Lerp(CANOPY_TRIM, 0.2))
	end
	box(m, Vector3.new(0.3, 0.06, 0.3), CFrame.new(0, -0.62, 0), CANOPY_TRIM)
	box(m, Vector3.new(0.06, 0.3, 0.06), CFrame.new(0, -2.85, 0), Color3.fromRGB(190, 195, 205)) -- tip
	m.PrimaryPart = grip
	return m
end

-- Open umbrella: canopy above, handle at the bottom of the shaft (origin = grip).
local function buildOpenUmbrella()
	local m = Instance.new("Model")
	m.Name = "UmbrellaOpen"
	m.Parent = VFXLib.Folder
	local grip = box(m, Vector3.new(0.16, 0.5, 0.16), CFrame.new(), SHAFT)
	box(m, Vector3.new(0.08, 2.6, 0.08), CFrame.new(0, 1.4, 0), SHAFT)
	-- Stepped octagon canopy: wide plates getting smaller toward the top.
	for i = 0, 3 do
		local r = 2.4 - i * 0.55
		local y = 2.5 + i * 0.22
		local color = i % 2 == 0 and CANOPY or CANOPY:Lerp(CANOPY_TRIM, 0.25)
		box(m, Vector3.new(r * 2, 0.16, r * 1.2), CFrame.new(0, y, 0), color)
		box(m, Vector3.new(r * 1.2, 0.16, r * 2), CFrame.new(0, y, 0), color)
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		box(m, Vector3.new(0.08, 0.08, 2.4), CFrame.new(math.cos(a) * 1.2, 2.45, math.sin(a) * 1.2) * CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(0.15, 0, 0), CANOPY_TRIM)
	end
	box(m, Vector3.new(0.1, 0.4, 0.1), CFrame.new(0, 3.5, 0), Color3.fromRGB(190, 195, 205))
	m.PrimaryPart = grip
	return m
end

local function splash(position, size)
	size = size or 1
	VFXLib.burst(position, { Count = math.floor(10 * size), Color = DROP_LIGHT, Speed = 14 * size, Lifetime = 0.35, Spread = 60, Direction = Vector3.new(0, 1, 0), Acceleration = Vector3.new(0, -40, 0) })
end

-- Drops let go: they fall and splash.
local function release(drops)
	for _, d in ipairs(drops) do
		local from = d.Position
		VFXLib.animate(0.35, function(a)
			d.CFrame = CFrame.new(from - Vector3.new(0, 9 * a * a, 0))
			d.Transparency = 0.2 + a * 0.8
		end, function()
			d:Destroy()
		end)
	end
end

---------------------------------------------------------------------------
-- Umbrella in his hand
---------------------------------------------------------------------------
local function stormOver(character)
	for _, st in ipairs(storms) do
		if st.Character == character then
			return st
		end
	end
	return nil
end

local function stepUmbrellas()
	local seen = {}
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		if character and character:GetAttribute("TuskAct") == ACT then
			local hand = character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
			local root = Common.rootOf(character)
			if hand and root then
				seen[character] = true
				local u = umbrellas[character]
				if not u then
					u = { Closed = buildClosedUmbrella(), Open = buildOpenUmbrella() }
					umbrellas[character] = u
				end
				local storm = stormOver(character) or character:GetAttribute("RainFloating") ~= nil
				local down = hand.Name == "Left Arm" and -hand.Size.Y / 2 + 0.2 or -0.15
				if storm then
					-- Open, held above his head.
					u.Closed:PivotTo(CFrame.new(0, -1000, 0))
					u.Open:PivotTo(root.CFrame * CFrame.new(-0.6, 1.4, 0) * CFrame.Angles(0, 0, 0.08))
				else
					-- Closed, carried like a cane.
					u.Open:PivotTo(CFrame.new(0, -1000, 0))
					u.Closed:PivotTo(hand.CFrame * CFrame.new(0, down, 0))
				end
			end
		end
	end
	for character, u in pairs(umbrellas) do
		if not seen[character] then
			u.Closed:Destroy()
			u.Open:Destroy()
			umbrellas[character] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Raindrop projectiles (server Kind "RainDrop")
---------------------------------------------------------------------------
local function spawnDrop(data)
	local d = newDrop(1.4)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.2, 0)
	a0.Parent = d
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.2, 0)
	a1.Parent = d
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(DROP_LIGHT, DROP)
	trail.Lifetime = 0.12
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.Parent = d
	projectiles[data.Id] = { Part = d, Origin = data.Origin, Direction = data.Direction, Speed = data.Speed, Range = data.Range, ServerTime = data.ServerTime, Expire = os.clock() + data.Range / math.max(data.Speed, 1) + 0.5 }
end

local function endDrop(data)
	local v = projectiles[data.Id]
	if v then
		projectiles[data.Id] = nil
		v.Part:Destroy()
	end
	splash(data.Position, data.HitCharacter and 0.9 or 0.5)
	if data.HitCharacter then
		TuskVFX.CreateImpactStar(data.Position, { Size = 2.4, Rays = 6, Color = DROP, Color2 = Color3.new(1, 1, 1), Duration = 0.12 })
	end
end

local function stepDrops()
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	for id, v in pairs(projectiles) do
		local distance = math.min(v.Speed * (serverNow - v.ServerTime), v.Range)
		local pos = v.Origin + v.Direction * math.max(distance, 0)
		-- Point along the flight, like a streak.
		v.Part.CFrame = CFrame.lookAt(pos, pos + v.Direction) * CFrame.Angles(math.pi / 2, 0, 0)
		if now > v.Expire then
			projectiles[id] = nil
			v.Part:Destroy()
		end
	end
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	TuskAnimation.play(character, "B_M1_" .. index)
	VFXLib.sound(sounds.Swing, root, 0.5, 1.05 + index * 0.06)
	Common.swipe(root, index % 2 == 1 and 1 or -1, index % 2 == 1 and pal.Main or DROP_LIGHT)
	-- A few frozen shards flick out with each strike.
	for i = 1, 3 do
		local d = newDrop(0.9)
		local dir = (root.CFrame * CFrame.Angles(0, (i - 2) * 0.25, 0)).LookVector
		local from = (root.CFrame * CFrame.new(0, 0.5, -1.5)).Position
		VFXLib.animate(0.18, function(a)
			local p = from + dir * 6 * a
			d.CFrame = CFrame.lookAt(p, p + dir) * CFrame.Angles(math.pi / 2, 0, 0)
			d.Transparency = 0.2 + a * 0.8
		end, function()
			d:Destroy()
		end)
	end
end

local function onFinisher(data)
	Common.finisher(data, pal)
	-- A fan of hardened drops bursts out.
	local root = Common.rootOf(data.Character)
	if not root then
		return
	end
	for i = 1, 9 do
		local d = newDrop(1.2)
		local dir = (root.CFrame * CFrame.Angles(0, (i - 5) * 0.18, 0)).LookVector
		local from = data.Position + Vector3.new(0, 0.5, 0)
		VFXLib.animate(0.3, function(a)
			local p = from + dir * 10 * a
			d.CFrame = CFrame.lookAt(p, p + dir) * CFrame.Angles(math.pi / 2, 0, 0)
			d.Transparency = 0.2 + a * 0.8
		end, function()
			d:Destroy()
		end)
	end
end

-- Fibonacci-sphere points for a dome of drops.
local function domePoints(n, radius)
	local pts = {}
	for i = 0, n - 1 do
		local y = 1 - (i / (n - 1)) * 1.4 -- top cap down past the middle
		local r = math.sqrt(math.max(0, 1 - y * y))
		local phi = i * 2.39996
		pts[i + 1] = Vector3.new(math.cos(phi) * r, y, math.sin(phi) * r) * radius
	end
	return pts
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local move, phase = data.Move, data.Phase
	if move == "RaindropBlades" and phase == "Freeze" and root then
		TuskAnimation.play(character, "BMBlades")
		-- Drops freeze in a fan in front of him, shivering, then fire.
		local drops = {}
		local count = (data.Drops or 7) * 3
		local dir = data.Direction or root.CFrame.LookVector
		local base = CFrame.lookAt(root.Position + Vector3.new(0, 1, 0), root.Position + Vector3.new(0, 1, 0) + dir)
		for i = 1, count do
			local t = (i - 1) / (count - 1) - 0.5
			local d = newDrop(1.1)
			local cf = base * CFrame.Angles(0, math.rad(-t * (data.Spread or 34)), 0) * CFrame.new((i % 3 - 1) * 0.3, (i % 3 - 1) * 0.5, -2.5 - (i % 3) * 0.4)
			d.CFrame = cf * CFrame.Angles(math.pi / 2, 0, 0)
			drops[i] = { Part = d, CF = d.CFrame }
		end
		VFXLib.animate(data.Startup or 0.3, function(a)
			for _, d in ipairs(drops) do
				d.Part.CFrame = d.CF + Vector3.new((math.random() - 0.5) * 0.08, (math.random() - 0.5) * 0.08, 0)
			end
		end, function()
			for _, d in ipairs(drops) do
				d.Part:Destroy()
			end
		end)
		VFXLib.sound(sounds.Warning, root, 0.3, 1.8)
	elseif move == "RaindropStep" and phase == "Step" then
		TuskAnimation.play(character, "BMStep")
		local from, to = data.From, data.To
		local steps = math.max(4, math.floor((to - from).Magnitude / 2.2))
		local drops = {}
		for i = 0, steps do
			local p = from:Lerp(to, i / steps) + Vector3.new(0, -2.4 + math.sin(i / steps * math.pi) * 1.2, 0)
			for k = 1, 3 do
				local d = newDrop(1)
				d.CFrame = CFrame.new(p + Vector3.new((k - 2) * 0.5, (k % 2) * 0.3, 0))
				table.insert(drops, d)
			end
			task.delay(i * (data.Travel or 0.25) / steps, function()
				if character and character.Parent then
					VFXLib.afterimage(CFrame.new(from:Lerp(to, i / steps)), 2, DROP)
				end
			end)
		end
		splash(from - Vector3.new(0, 2.5, 0), 0.6)
		-- The drops hang (glinting), then fall.
		local life = data.TrailTime or 3
		VFXLib.animate(life, function(a)
			for i, d in ipairs(drops) do
				if (i + math.floor(a * 30)) % 9 == 0 then
					d.Color = DROP_LIGHT
				else
					d.Color = DROP
				end
			end
		end, function()
			release(drops)
		end)
		if Common.isLocal(character) then
			CameraFX.fovPunch(6, 0.2)
		end
	elseif move == "RaindropCage" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "BMCage")
		elseif phase == "Cage" and data.Target then
			local pts = domePoints(36, 3.4)
			local drops = {}
			for i, p in ipairs(pts) do
				drops[i] = { Part = newDrop(1), Offset = p }
			end
			cages[data.Target] = { Drops = drops, Expire = os.clock() + (data.Duration or 2.5), Born = os.clock() }
			local tr = Common.rootOf(data.Target)
			if tr then
				splash(tr.Position, 1)
			end
		elseif phase == "Cut" and data.Position then
			VFXLib.burst(data.Position, { Count = 8, Color = DROP_LIGHT, Speed = 18, Lifetime = 0.25 })
			TuskVFX.CreateImpactStar(data.Position, { Size = 2.5, Rays = 6, Color = DROP, Color2 = Color3.new(1, 1, 1), Duration = 0.12 })
		elseif phase == "Miss" and root then
			splash((root.CFrame * CFrame.new(0, 0, -6)).Position - Vector3.new(0, 2, 0), 0.6)
		end
	end
end

-- A rainbow arc over the storm: seven bands of short neon segments.
local function buildRainbow(frame, radius)
	local m = Instance.new("Model")
	m.Name = "Rainbow"
	m.Parent = VFXLib.Folder
	for b, color in ipairs(RAINBOW) do
		local r = radius - (b - 1) * 0.9
		local n = 22
		for i = 0, n - 1 do
			local a0 = i / n * math.pi
			local a1 = (i + 1) / n * math.pi
			local p0 = frame * Vector3.new(math.cos(a0) * r, math.sin(a0) * r, 0)
			local p1 = frame * Vector3.new(math.cos(a1) * r, math.sin(a1) * r, 0)
			local seg = VFXLib.part({ Size = Vector3.new(0.9, 0.9, (p1 - p0).Magnitude + 0.1), Color = color, Material = Enum.Material.Neon, Transparency = 0.35 })
			seg.CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
			seg.Parent = m
		end
	end
	return m
end

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Start" then
		TuskAnimation.play(character, "BMStorm")
		local center = data.Position
		local radius = data.Radius or 22
		local storm = { Character = character, Center = center, Radius = radius, Until = os.clock() + (data.Windup or 0.8) + (data.Duration or 5), Hanging = {}, Next = 0 }
		-- Dark cloud overhead.
		storm.Cloud = Instance.new("Model")
		storm.Cloud.Parent = VFXLib.Folder
		for i = 1, 9 do
			local a = i / 9 * math.pi * 2
			box(storm.Cloud, Vector3.new(12, 3, 12), CFrame.new(center + Vector3.new(math.cos(a) * radius * 0.55, 24 + (i % 3), math.sin(a) * radius * 0.55)), Color3.fromRGB(70, 74, 90), Enum.Material.SmoothPlastic, 0.25)
		end
		box(storm.Cloud, Vector3.new(radius, 3, radius), CFrame.new(center + Vector3.new(0, 25, 0)), Color3.fromRGB(60, 64, 80), Enum.Material.SmoothPlastic, 0.2)
		-- The rainbow arcs over the storm.
		local look = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
		local flatLook = Vector3.new(look.X, 0, look.Z)
		flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
		local arcAt = center + flatLook * radius * 0.6 + Vector3.new(0, 2, 0)
		storm.Rainbow = buildRainbow(CFrame.lookAt(arcAt, arcAt + flatLook), radius * 0.9)
		-- Frozen drops hanging all through the area.
		for i = 1, 40 do
			local a = math.random() * math.pi * 2
			local r = math.sqrt(math.random()) * radius
			local d = newDrop(1.2)
			d.CFrame = CFrame.new(center + Vector3.new(math.cos(a) * r, math.random() * 8 - 1, math.sin(a) * r))
			table.insert(storm.Hanging, d)
		end
		table.insert(storms, storm)
		if Common.isLocal(character) then
			TuskVFX.ScreenTint((data.Windup or 0.8) + (data.Duration or 5), { Tint = Color3.fromRGB(190, 205, 235), Saturation = -0.3, Brightness = -0.1 })
		end
		VFXLib.sound(sounds.AwakeningBuild, center, 0.5, 1.3)
	elseif data.Phase == "Scatter" then
		-- He bursts into raindrops and comes back together out of reach.
		local from, to = data.From, data.To
		VFXLib.burst(from, { Count = 30, Color = DROP_LIGHT, Speed = 22, Lifetime = 0.4 })
		for i = 1, 14 do
			local d = newDrop(1.1)
			local off = Vector3.new(math.random() - 0.5, math.random() * 2 - 1, math.random() - 0.5) * 3
			VFXLib.animate(0.25, function(a)
				d.CFrame = CFrame.new((from + off):Lerp(to + off * (1 - a), a))
			end, function()
				d:Destroy()
			end)
		end
		splash(to, 1)
	elseif data.Phase == "Burst" then
		local center = data.Position
		for i = #storms, 1, -1 do
			local st = storms[i]
			if st.Character == character then
				table.remove(storms, i)
				-- Every hanging drop fires inward.
				for _, d in ipairs(st.Hanging) do
					local from = d.Position
					VFXLib.animate(0.2, function(a)
						d.CFrame = CFrame.lookAt(from:Lerp(center + Vector3.new(0, 1, 0), a), center) * CFrame.Angles(math.pi / 2, 0, 0)
					end, function()
						d:Destroy()
					end)
				end
				st.Cloud:Destroy()
				st.Rainbow:Destroy()
			end
		end
		task.delay(0.2, function()
			Common.finisher({ Character = character, Position = center + Vector3.new(0, 1, 0), Radius = data.Radius, Hit = true }, pal, { Size = 1.6, Layers = 3, Shake = 0.9 })
			splash(center, 2.5)
		end)
		if Common.isLocal(character) then
			CameraFX.impactFrame(DROP_LIGHT)
		end
	end
end

---------------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------------
local function stepCages()
	local now = os.clock()
	for target, cage in pairs(cages) do
		local tr = Common.rootOf(target)
		if not tr or now > cage.Expire then
			cages[target] = nil
			local parts = {}
			for _, d in ipairs(cage.Drops) do
				table.insert(parts, d.Part)
			end
			release(parts)
		else
			local grow = math.min((now - cage.Born) / 0.2, 1)
			for i, d in ipairs(cage.Drops) do
				local jitter = Vector3.new(math.sin(now * 9 + i), math.cos(now * 7 + i), math.sin(now * 8 + i * 2)) * 0.05
				d.Part.CFrame = CFrame.new(tr.Position + d.Offset * grow + jitter)
			end
		end
	end
end

local function stepStorms(dt)
	local now = os.clock()
	for i = #storms, 1, -1 do
		local st = storms[i]
		if now > st.Until + 1 then
			table.remove(storms, i)
			release(st.Hanging)
			st.Cloud:Destroy()
			st.Rainbow:Destroy()
		else
			-- The downpour: streaks falling from the cloud.
			st.Next = st.Next - dt
			while st.Next <= 0 do
				st.Next = st.Next + 0.03
				local a = math.random() * math.pi * 2
				local r = math.sqrt(math.random()) * st.Radius
				local top = st.Center + Vector3.new(math.cos(a) * r, 22, math.sin(a) * r)
				local streak = VFXLib.part({ Size = Vector3.new(0.08, 1.6, 0.08), Color = DROP_LIGHT, Material = Enum.Material.Glass, Transparency = 0.35 })
				VFXLib.animate(0.45, function(t)
					streak.CFrame = CFrame.new(top - Vector3.new(0, 24 * t, 0))
				end, function()
					streak:Destroy()
				end)
			end
			-- Hanging drops glint.
			for k, d in ipairs(st.Hanging) do
				d.Color = (k + math.floor(now * 12)) % 11 == 0 and DROP_LIGHT or DROP
			end
		end
	end
end

local function stepStance()
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		if character then
			local want = character:GetAttribute("TuskAct") == ACT
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "BMStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "BMStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
end

---------------------------------------------------------------------------
-- RAIN WALK (local player's movement + everyone's drops under the feet)
---------------------------------------------------------------------------
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local walkCfg = (TuskConfig.Blackmore and TuskConfig.Blackmore.RainWalk) or { FloatTime = 6, MaxSteps = 8, Cooldown = 3 }
local localPlayer = Players.LocalPlayer
local walk = { Floating = false, Steps = 0, CooldownUntil = 0, LastPlant = 0 }
local footDrops = {} -- [character] = { Parts }

local function rainingFor(character)
	if ReplicatedStorage:GetAttribute("SpinRaining") == true then
		return true
	end
	return (character:GetAttribute("RainStormUntil") or 0) > workspace:GetServerTimeNow()
end

local function feetOffset(humanoid, root)
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return 3
end

local function endWalk(cooldown)
	if walk.Platform then
		walk.Platform:Destroy()
		walk.Platform = nil
	end
	if walk.Floating then
		walk.Floating = false
		Net.get("TuskRequest"):FireServer("RainFloat", false)
		if cooldown then
			walk.CooldownUntil = os.clock() + walkCfg.Cooldown
		end
	end
	walk.Steps = 0
end

local function plant()
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	local feetY = root.Position.Y - feetOffset(humanoid, root)
	if not walk.Platform then
		local p = Instance.new("Part")
		p.Name = "RainStep"
		p.Anchored = true
		p.CanCollide = true
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(5, 0.4, 5)
		p.Parent = workspace
		walk.Platform = p
	end
	walk.FloatY = feetY
	walk.Platform.CFrame = CFrame.new(root.Position.X, feetY - 0.2, root.Position.Z)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 0), v.Z)
	walk.Steps = walk.Steps + 1
	walk.LastPlant = os.clock()
	walk.AirSince = nil
	if not walk.Floating then
		walk.Floating = true
		walk.Start = os.clock()
		Net.get("TuskRequest"):FireServer("RainFloat", true)
	end
	-- A frozen drop catches his foot.
	local at = Vector3.new(root.Position.X, feetY, root.Position.Z)
	TuskVFX.CreateImpactStar(at, { Size = 3, Rays = 6, Color = DROP, Color2 = Color3.new(1, 1, 1), Duration = 0.15 })
	splash(at, 0.6)
end

local function onJumpRequest()
	local character = localPlayer.Character
	if not character or character:GetAttribute("TuskAct") ~= ACT or not rainingFor(character) then
		return
	end
	if character:GetAttribute("Stunned") then
		return
	end
	local now = os.clock()
	-- Only in mid-air (a jump from the ground or from a drop is a normal jump).
	if not walk.AirSince or now - walk.AirSince < 0.15 or now - walk.LastPlant < 0.25 then
		return
	end
	if not walk.Floating and now < walk.CooldownUntil then
		return
	end
	if walk.Steps >= walkCfg.MaxSteps then
		return
	end
	plant()
end

local function stepWalk()
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or character:GetAttribute("TuskAct") ~= ACT then
		walk.AirSince = nil
		endWalk(false)
		return
	end
	local now = os.clock()
	local inAir = humanoid.FloorMaterial == Enum.Material.Air
	if inAir then
		walk.AirSince = walk.AirSince or now
	else
		walk.AirSince = nil
	end
	if not walk.Floating then
		if not inAir then
			walk.Steps = 0
		end
		return
	end
	-- Ends: time's up, the rain stops, stunned, dead, or back on real ground.
	if now - walk.Start > walkCfg.FloatTime or not rainingFor(character) or character:GetAttribute("Stunned") or humanoid.Health <= 0 then
		endWalk(true)
		return
	end
	local feet = root.Position.Y - feetOffset(humanoid, root)
	if not inAir and feet < walk.FloatY - 1 then
		endWalk(true) -- landed on something real below the step
		return
	end
	-- The step follows him so he can walk on the air.
	if walk.Platform then
		walk.Platform.CFrame = CFrame.new(root.Position.X, walk.FloatY - 0.2, root.Position.Z)
	end
end

-- Everyone floating on drops gets a cluster of frozen drops under the feet.
local function stepFootDrops()
	local now = os.clock()
	local seen = {}
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		local root = character and Common.rootOf(character)
		if root and character:GetAttribute("RainFloating") then
			seen[character] = true
			local fd = footDrops[character]
			if not fd then
				fd = { Parts = {} }
				for i = 1, 6 do
					fd.Parts[i] = newDrop(1.3)
				end
				footDrops[character] = fd
				splash(root.Position - Vector3.new(0, 3, 0), 0.8)
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local feet = root.Position.Y - (humanoid and feetOffset(humanoid, root) or 3)
			for i, d in ipairs(fd.Parts) do
				local a = i / #fd.Parts * math.pi * 2 + now * 1.5
				local r = i == 1 and 0 or 0.9
				d.CFrame = CFrame.new(root.Position.X + math.cos(a) * r, feet - 0.25 + math.sin(now * 6 + i) * 0.05, root.Position.Z + math.sin(a) * r)
			end
		end
	end
	for character, fd in pairs(footDrops) do
		if not seen[character] then
			footDrops[character] = nil
			release(fd.Parts)
		end
	end
end

UserInputService.JumpRequest:Connect(onJumpRequest)

function BlackmoreVFX.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		onFinisher(data)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function BlackmoreVFX.step(dt)
	dt = dt or 1 / 60
	stepUmbrellas()
	stepDrops()
	stepCages()
	stepStorms(dt)
	stepWalk()
	stepFootDrops()
	slowTimer = slowTimer + dt
	if slowTimer > 0.2 then
		slowTimer = 0
		stepStance()
	end
end

Net.get("SpinFX").OnClientEvent:Connect(function(name, data)
	if typeof(data) ~= "table" or data.Kind ~= "RainDrop" then
		return
	end
	if name == "ProjectileSpawn" then
		spawnDrop(data)
	elseif name == "ProjectileEnd" then
		endDrop(data)
	end
end)

return BlackmoreVFX
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">Diego_Client</string><ProtectedString name="Source"><![CDATA[--[[
	Diego_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Diego Brando: Scary Monsters.
	Its other half is Diego_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: Diego
-- ======================================================================
__modules["Diego"] = function()
--[[
	TuskActVFX.Diego  (StarterPlayerScripts.SpinClient.TuskActVFX.Diego)

	Client visuals for Diego Brando / SCARY MONSTERS:
	  * hunched predator stance + claw / tail-whip / bite animations (human)
	  * SCARY MONSTERS: the player turns into the full raptor (RaptorModel),
	    animated every frame: running legs, swaying tail, jaw snaps, claw
	    rakes, tail whips. The player's own body is hidden locally.
	  * KINETIC VISION (Diego only, while transformed): moving enemies glow
	  * claw marks, tail sweeps, "chomp" fangs that snap shut on bites
	  * DINO INFECTION: scales spread over the victim, then they turn into a
	    dinosaur in their own avatar's colours that Diego commands
	    ("YOUR DINO 7s" tag, blue outline, bites, "sic 'em" target marks)
	  * RAPTOR POUNCE: crouch, leap trail, crunching landing
	  * RAPTOR PACK: a roar shock, then a pack of raptors charges out
]]

local Players = game:GetService("Players")
local Fighters = __require("Fighters")
local Debris = game:GetService("Debris")

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local VFXQuality = __require("VFXQuality")
local RaptorModel = __require("RaptorModel")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")

local Diego = {}
local pal = Common.palette(6)
local sounds = TuskConfig.Sounds
local localPlayer = Players.LocalPlayer
local DIEGO_ACT = 6
local WHITE = Color3.new(1, 1, 1)
-- Scary Monsters' slashes are blue (owner's request).
local SLASH = Color3.fromRGB(40, 110, 255)
local SLASH_LIGHT = Color3.fromRGB(150, 205, 255)

local dinos = {} -- [character] = transformed raptor entry
local stanced = {} -- [character] = true while holding the human stance
local infected = {} -- [model] = infection visuals
local seen = {} -- [model] = kinetic-vision highlight
local pack = {} -- [raptor id] = running pack raptor
local thralls = {} -- [model] = a Dino Infection victim turned into a dinosaur
local visionTint

local function candidates()
	local list = {}
	for _, player in ipairs(Fighters.list()) do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	local dummies = workspace:FindFirstChild("SpinTestDummies")
	if dummies then
		for _, d in ipairs(dummies:GetChildren()) do
			if d:IsA("Model") then
				table.insert(list, d)
			end
		end
	end
	return list
end

local function groundCF(character, root)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local drop = 3
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		drop = humanoid.HipHeight + root.Size.Y / 2
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	local pos = root.Position - Vector3.new(0, drop, 0)
	return CFrame.lookAt(pos, pos + flat.Unit)
end

---------------------------------------------------------------------------
-- Small effects
---------------------------------------------------------------------------
-- Three parallel claw marks raking across.
local function clawMarks(cf, side, scale, color)
	for k = -1, 1 do
		TuskVFX.CreateCrescent(cf * CFrame.new(k * 0.35 * scale, k * 0.45 * scale, 0) * CFrame.Angles(0, 0, side * 0.95), {
			Radius = 2.3 * scale,
			Width = 0.24 * scale,
			Arc = math.rad(105),
			Sweep = side * 1.5,
			Color = color or SLASH,
			Color2 = SLASH_LIGHT,
			Duration = 0.2,
		})
	end
end

-- Rows of fangs that snap shut on a point: the "chomp".
local function chomp(position, facing, size, color)
	if not VFXLib.acquire() then
		return
	end
	size = size or 1
	color = color or pal.Light
	local fangs = {}
	local count = 5
	local look = facing or Vector3.new(0, 0, -1)
	local base = CFrame.lookAt(position, position + look)
	for row = -1, 1, 2 do
		for i = 1, count do
			local x = (i - (count + 1) / 2) * 0.42 * size
			local fang = VFXLib.part({ Color = color, Size = Vector3.new(0.18, 0.75, 0.18) * size, Transparency = 0.05 })
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = fang
			fangs[#fangs + 1] = { Part = fang, X = x, Row = row }
		end
	end
	local open = 1.3 * size
	VFXLib.animate(0.32, function(a)
		local close = a < 0.35 and VFXLib.easeOut(a / 0.35) or 1
		local fade = a < 0.5 and 0 or (a - 0.5) / 0.5
		for _, f in ipairs(fangs) do
			local y = f.Row * (open - (open - 0.3 * size) * close)
			f.Part.CFrame = base * CFrame.new(f.X, y, 0) * CFrame.Angles(0, 0, f.Row > 0 and 0 or math.pi)
			f.Part.Transparency = 0.05 + fade * 0.95
		end
	end, function()
		for _, f in ipairs(fangs) do
			f.Part:Destroy()
		end
		VFXLib.release()
	end)
	task.delay(0.1, function()
		TuskVFX.CreateImpactStar(position, { Size = 3.5 * size, Rays = 7, Color = pal.Main, Color2 = WHITE, Duration = 0.2 })
		VFXLib.burst(position, { Count = 10, Color = pal.Light, Speed = 18, Lifetime = 0.25 })
	end)
end

local function roarSound(position, pitch)
	VFXLib.sound(sounds.AwakeningBurst, position, 1, pitch or 0.55)
	VFXLib.sound(sounds.Warning, position, 0.5, 0.45)
end

---------------------------------------------------------------------------
-- SCARY MONSTERS: transformed raptor on any character
---------------------------------------------------------------------------
local function setHidden(character, hidden)
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
end

local function transformBurst(character, root, color)
	local pos = root.Position
	VFXLib.flash(pos, color or pal.Main, 8, 30, 0.4)
	TuskVFX.CreateRotationalShockwave(CFrame.new(pos - Vector3.new(0, 2.8, 0)), { Radius = 12, Layers = 3, Color = pal.Main, Color2 = pal.Second, Ground = true, Particles = 1.5, Width = 0.6 })
	TuskVFX.CreateImpactStar(pos + Vector3.new(0, 1, 0), { Size = 8, Rays = 10, Color = pal.Main, Color2 = WHITE, Duration = 0.35 })
	-- Scales burst off the body.
	VFXLib.burst(pos, {
		Count = 30,
		Color = pal.Main,
		Speed = 30,
		Lifetime = 0.6,
		Drag = 2,
		Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) }),
	})
	VFXLib.burst(pos, { Count = 8, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(190, 170, 140), LightEmission = 0, Speed = 10, Lifetime = 0.8 })
end

local function startDino(character, root)
	local rig = RaptorModel.build(1, { Lite = VFXQuality.get().RingSegments <= 12 })
	rig.Model.Parent = VFXLib.Folder
	local entry = { Rig = rig, Phase = 0, Jaw = 0, Lunge = 0, Claw = 0, Crouch = 0, Whip = 0, WhipT = 0, WhipDir = 1, Grow = 0 }
	dinos[character] = entry
	transformBurst(character, root)
	roarSound(root.Position, 0.6)
	if Common.isLocal(character) then
		CameraFX.shake(0.6, 0.4)
		CameraFX.fovPunch(10, 0.4)
		if not visionTint then
			visionTint = Instance.new("ColorCorrectionEffect")
			visionTint.Name = "KineticVision"
			visionTint.TintColor = Color3.fromRGB(215, 255, 240)
			visionTint.Saturation = 0.15
			visionTint.Contrast = 0.08
			visionTint.Parent = game:GetService("Lighting")
		end
	end
	return entry
end

local function stopDino(character)
	local entry = dinos[character]
	if not entry then
		return
	end
	dinos[character] = nil
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		transformBurst(character, root, pal.Light)
	end
	entry.Rig:Destroy()
	if character.Parent then
		setHidden(character, false)
	end
	if Common.isLocal(character) and visionTint then
		visionTint:Destroy()
		visionTint = nil
	end
end

local function stepDinos(dt)
	local now = os.clock()
	local alive = {}
	for _, player in ipairs(Fighters.list()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 and character:GetAttribute("DinoMode") then
			alive[character] = true
			local entry = dinos[character] or startDino(character, root)
			setHidden(character, true)
			local v = root.AssemblyLinearVelocity
			local speed = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude / 26, 0, 1)
			entry.Phase = entry.Phase + dt * (3 + speed * 12)
			local decay = math.exp(-dt * 7)
			entry.Jaw = entry.Jaw * decay
			entry.Lunge = entry.Lunge * decay
			entry.Claw = entry.Claw * decay
			entry.Crouch = entry.Crouch * math.exp(-dt * 5)
			local whip = 0
			if entry.WhipT > 0 then
				entry.WhipT = math.max(0, entry.WhipT - dt)
				whip = math.sin((1 - entry.WhipT / 0.35) * math.pi) * entry.WhipDir
			end
			entry.Grow = math.min(1, entry.Grow + dt * 4)
			local airborne = humanoid.FloorMaterial == Enum.Material.Air
			entry.Rig:Pose(groundCF(character, root), {
				Time = now,
				Phase = entry.Phase,
				Speed = airborne and 0.3 or speed,
				Jaw = math.max(entry.Jaw, entry.Roar or 0),
				Lunge = entry.Lunge,
				Claw = entry.Claw,
				Crouch = entry.Crouch + (1 - entry.Grow) * 0.8,
				Whip = whip,
				HeadPitch = (entry.Roar or 0) * 0.5,
			})
		end
	end
	for character in pairs(dinos) do
		if not alive[character] then
			stopDino(character)
		end
	end
end

---------------------------------------------------------------------------
-- DINO INFECTION victims: a dinosaur in their own avatar's colours
---------------------------------------------------------------------------
local function partColor(model, names)
	for _, n in ipairs(names) do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p.Color
		end
	end
	return nil
end

-- Colours from the victim's avatar: torso -> body, legs -> legs and tail, head -> head.
local function avatarPalette(model)
	local body = partColor(model, { "UpperTorso", "Torso" }) or pal.Main
	local legs = partColor(model, { "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg" }) or pal.Second
	local head = partColor(model, { "Head" }) or body
	-- Keep the body and legs readable when the avatar is all one colour.
	local d = math.abs(body.R - legs.R) + math.abs(body.G - legs.G) + math.abs(body.B - legs.B)
	if d < 0.15 then
		legs = body:Lerp(Color3.new(0, 0, 0), 0.35)
	end
	return { Body = body, Legs = legs, Head = head }
end

local function stopThrall(model)
	local t = thralls[model]
	if not t then
		return
	end
	thralls[model] = nil
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		transformBurst(model, root, pal.Light)
	end
	t.Rig:Destroy()
	t.Tag:Destroy()
	t.Highlight:Destroy()
	if model.Parent then
		setHidden(model, false)
	end
end

local function stepThralls(dt)
	local now = os.clock()
	local keep = {}
	for _, model in ipairs(candidates()) do
		local owner = model:GetAttribute("DinoThrall")
		local root = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if owner and root and humanoid and humanoid.Health > 0 then
			keep[model] = true
			local t = thralls[model]
			if not t then
				local rig = RaptorModel.build(0.85, { Lite = VFXQuality.get().RingSegments <= 12, Palette = avatarPalette(model) })
				rig.Model.Parent = VFXLib.Folder
				-- Blue outline: this dinosaur belongs to Diego.
				local h = Instance.new("Highlight")
				h.Adornee = rig.Model
				h.FillTransparency = 1
				h.OutlineColor = SLASH
				h.DepthMode = Enum.HighlightDepthMode.Occluded
				h.Parent = VFXLib.Folder
				-- Floating tag with the time left.
				local tag = Instance.new("BillboardGui")
				tag.Size = UDim2.fromOffset(150, 26)
				tag.StudsOffset = Vector3.new(0, 5.5, 0)
				tag.AlwaysOnTop = true
				tag.Adornee = root
				tag.Parent = VFXLib.Folder
				local label = Instance.new("TextLabel")
				label.BackgroundTransparency = 1
				label.Size = UDim2.fromScale(1, 1)
				label.Font = Enum.Font.Bangers
				label.TextScaled = true
				label.TextColor3 = SLASH_LIGHT
				label.TextStrokeTransparency = 0
				label.Parent = tag
				t = { Rig = rig, Tag = tag, Label = label, Highlight = h, Phase = 0, Jaw = 0, Lunge = 0 }
				thralls[model] = t
				transformBurst(model, root, pal.Main)
				roarSound(root.Position, 0.75)
			end
			setHidden(model, true)
			local v = root.AssemblyLinearVelocity
			local speed = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude / 24, 0, 1)
			t.Phase = t.Phase + dt * (3 + speed * 12)
			local decay = math.exp(-dt * 7)
			t.Jaw = t.Jaw * decay
			t.Lunge = t.Lunge * decay
			t.Rig:Pose(groundCF(model, root), { Time = now, Phase = t.Phase, Speed = speed, Jaw = math.max(t.Jaw, 0.15), Lunge = t.Lunge })
			local untilT = model:GetAttribute("DinoThrallUntil")
			local left = untilT and math.max(0, untilT - workspace:GetServerTimeNow()) or 0
			t.Label.Text = (owner == localPlayer.UserId and "YOUR DINO" or "DIEGO'S DINO") .. "  " .. math.ceil(left) .. "s"
		end
	end
	for model in pairs(thralls) do
		if not keep[model] then
			stopThrall(model)
		end
	end
end

-- Kinetic vision: while YOU are transformed, moving enemies glow through walls.
local function stepVision()
	local me = localPlayer.Character
	local myRoot = me and me:FindFirstChild("HumanoidRootPart")
	local active = me and me:GetAttribute("DinoMode") and myRoot
	local range = TuskConfig.Diego.ScaryMonsters.KineticVision or 90
	local keep = {}
	if active then
		for _, model in ipairs(candidates()) do
			if model ~= me and model:GetAttribute("DinoThrall") ~= localPlayer.UserId then
				local root = model:FindFirstChild("HumanoidRootPart")
				if root and (root.Position - myRoot.Position).Magnitude < range then
					local v = root.AssemblyLinearVelocity
					if Vector3.new(v.X, 0, v.Z).Magnitude > 3 or math.abs(v.Y) > 8 then
						keep[model] = true
						if not seen[model] then
							local h = Instance.new("Highlight")
							h.Name = "KineticVision"
							h.Adornee = model
							h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							h.FillColor = Color3.fromRGB(255, 120, 60)
							h.FillTransparency = 0.75
							h.OutlineColor = Color3.fromRGB(255, 200, 80)
							h.Parent = VFXLib.Folder
							seen[model] = h
						end
					end
				end
			end
		end
	end
	for model, h in pairs(seen) do
		if not keep[model] then
			h:Destroy()
			seen[model] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Human stance (hunched predator) while playing Diego untransformed
---------------------------------------------------------------------------
local function stepStance()
	for _, player in ipairs(Fighters.list()) do
		local character = player.Character
		if character then
			local want = character:GetAttribute("TuskAct") == DIEGO_ACT and not character:GetAttribute("DinoMode")
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "DiegoStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "DiegoStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
end

---------------------------------------------------------------------------
-- DINO INFECTION visuals on infected targets
---------------------------------------------------------------------------
local function stepInfected()
	local keep = {}
	for _, model in ipairs(candidates()) do
		if model:GetAttribute("DinoInfected") and not model:GetAttribute("DinoThrall") then
			local root = model:FindFirstChild("HumanoidRootPart")
			if root then
				keep[model] = true
				local entry = infected[model]
				if not entry then
					entry = { Scales = {}, Start = os.clock() }
					local h = Instance.new("Highlight")
					h.Adornee = model
					h.FillColor = pal.Main
					h.FillTransparency = 0.7
					h.OutlineColor = pal.Second
					h.DepthMode = Enum.HighlightDepthMode.Occluded
					h.Parent = VFXLib.Folder
					entry.Highlight = h
					local a = Instance.new("Attachment")
					a.Name = "DinoSpores"
					a.Parent = root
					local e = Instance.new("ParticleEmitter")
					e.Texture = VFXLib.Textures.Sparkle
					e.Color = ColorSequence.new(pal.Light, pal.Second)
					e.LightEmission = 0.6
					e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
					e.Lifetime = NumberRange.new(0.4, 0.8)
					e.Speed = NumberRange.new(1, 3)
					e.SpreadAngle = Vector2.new(180, 180)
					e.Rate = 14 * VFXQuality.get().Particles
					e.Parent = a
					entry.Spores = a
					-- Dinosaur scales sprout on the limbs.
					for _, limbName in ipairs({ "RightUpperArm", "LeftUpperArm", "UpperTorso", "RightUpperLeg", "LeftUpperLeg", "Right Arm", "Left Arm", "Torso", "Right Leg", "Left Leg", "Head" }) do
						local limb = model:FindFirstChild(limbName)
						if limb and limb:IsA("BasePart") and #entry.Scales < 10 then
							for _ = 1, 2 do
								local offset = Vector3.new((math.random() - 0.5) * limb.Size.X, (math.random() - 0.5) * limb.Size.Y, -limb.Size.Z / 2)
								local scale = VFXLib.part({ Material = Enum.Material.SmoothPlastic, Color = (math.random() < 0.5) and pal.Main or pal.Second, Size = Vector3.new(0.1, 0.1, 0.1), Anchored = false, Massless = true })
								local mesh = Instance.new("SpecialMesh")
								mesh.MeshType = Enum.MeshType.Sphere
								mesh.Parent = scale
								scale.CFrame = limb.CFrame * CFrame.new(offset)
								local weld = Instance.new("WeldConstraint")
								weld.Part0 = limb
								weld.Part1 = scale
								weld.Parent = scale
								table.insert(entry.Scales, { Part = scale, Limb = limb, Offset = offset })
							end
						end
					end
					infected[model] = entry
				end
				-- Scales grow in over half a second; the glow pulses.
				local grow = math.min(1, (os.clock() - entry.Start) / 0.5)
				for _, sc in ipairs(entry.Scales) do
					local d = 0.1 + 0.5 * grow
					if sc.Part.Size.X < d - 0.01 then
						-- Resize only: never move a welded part (that would drag the victim).
						sc.Part.Size = Vector3.new(d, d * 0.6, d)
					end
				end
				entry.Highlight.FillTransparency = 0.65 + math.sin(os.clock() * 6) * 0.1
			end
		end
	end
	for model, entry in pairs(infected) do
		if not keep[model] then
			infected[model] = nil
			entry.Highlight:Destroy()
			entry.Spores:Destroy()
			for _, sc in ipairs(entry.Scales) do
				local root = model:FindFirstChild("HumanoidRootPart")
				if root and sc.Part.Parent then
					VFXLib.burst(sc.Part.Position, { Count = 2, Color = pal.Main, Speed = 6, Lifetime = 0.3 })
				end
				sc.Part:Destroy()
			end
		end
	end
end

---------------------------------------------------------------------------
-- Events
---------------------------------------------------------------------------
local function dinoAction(character, kind, value)
	local entry = dinos[character]
	if not entry then
		return false
	end
	if kind == "Claw" then
		entry.Claw = 1
		entry.Jaw = math.max(entry.Jaw, 0.35)
	elseif kind == "Whip" then
		entry.WhipT = 0.35
		entry.WhipDir = value or 1
	elseif kind == "Bite" then
		entry.Jaw = 1
		entry.Lunge = 1
	elseif kind == "Crouch" then
		entry.Crouch = 1
	elseif kind == "Roar" then
		entry.Roar = 1
		task.delay(value or 0.8, function()
			entry.Roar = 0
		end)
	end
	return true
end

local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	local transformed = dinos[character] ~= nil
	local scale = transformed and 1.4 or 1
	VFXLib.sound(sounds.Swing, root, 0.5, (transformed and 0.8 or 1) * (0.95 + index * 0.06))
	if index <= 2 then
		local side = index == 1 and 1 or -1
		if not dinoAction(character, "Claw") then
			TuskAnimation.play(character, "D_M1_" .. index)
		end
		clawMarks(root.CFrame * CFrame.new(side * 0.3, 0.6, -2.2 * scale), side, scale)
	elseif index == 3 then
		if not dinoAction(character, "Whip", 1) then
			TuskAnimation.play(character, "D_M1_3")
		end
		-- Wide low tail sweep around the body.
		TuskVFX.CreateCrescent(root.CFrame * CFrame.new(0, -1.6, 0), { Radius = 4.5 * scale, Width = 0.5 * scale, Arc = math.rad(200), Sweep = 2.6, Color = SLASH, Color2 = SLASH_LIGHT, Duration = 0.26 })
		VFXLib.burst(root.Position - Vector3.new(0, 2.5, 0), { Count = 8, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(200, 180, 140), LightEmission = 0, Speed = 12, Lifetime = 0.5 })
	else
		if not dinoAction(character, "Bite") then
			TuskAnimation.play(character, "D_M1_4")
		end
	end
end

-- RAPTOR POUNCE: Diego's own client flies the leap (it owns his physics, so
-- the arc is smooth and every other player sees it replicate). The server
-- picked the landing spot and deals the damage there.
local function flyLeap(character, root, data)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local from = root.Position -- start from where we really are right now
	local to = data.To or from
	local height = data.Height or 7
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(data.Direction.X, 0, data.Direction.Z).Unit
	local stopped = false
	if humanoid then
		humanoid.AutoRotate = false
	end
	VFXLib.animate(data.Time or 0.36, function(a)
		if stopped then
			return
		end
		-- Hit out of the air (stunned) or died: let physics take over.
		if not root.Parent or character:GetAttribute("Stunned") or (humanoid and humanoid.Health <= 0) then
			stopped = true
			return
		end
		local e = a < 1 and (0.5 - 0.5 * math.cos(a * math.pi)) or 1 -- ease in/out along the ground
		local p = from:Lerp(to, e) + Vector3.new(0, 4 * height * a * (1 - a), 0)
		root.CFrame = CFrame.lookAt(p, p + dir)
		root.AssemblyLinearVelocity = Vector3.new()
	end, function()
		if humanoid and humanoid.Parent then
			humanoid.AutoRotate = true
		end
		if root.Parent and not stopped then
			root.AssemblyLinearVelocity = dir * 6 -- small carry on landing, no slide
		end
	end)
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Move == "RaptorPounce" then
		if data.Phase == "Startup" and root then
			if not dinoAction(character, "Crouch") then
				TuskAnimation.play(character, "DiegoPounce")
			end
			VFXLib.burst(root.Position - Vector3.new(0, 2.6, 0), { Count = 10, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(200, 180, 140), LightEmission = 0, Speed = 8, Lifetime = 0.6 })
			-- Eyes flash before the leap.
			VFXLib.flash(root.Position + Vector3.new(0, 1.5, 0), pal.Main, 3, 10, 0.2)
		elseif data.Phase == "Leap" and root then
			if Common.isLocal(character) then
				flyLeap(character, root, data)
			end
			dinoAction(character, "Bite")
			VFXLib.sound(sounds.Swing, root, 0.7, 0.7)
			TuskVFX.CreateRotationalShockwave(CFrame.new(data.From - Vector3.new(0, 2.8, 0)), { Radius = 6, Layers = 2, Color = pal.Light, Color2 = pal.Main, Ground = true, Particles = 0.5, Width = 0.3 })
			-- Streak trail while airborne.
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, 1, 0)
			a0.Parent = root
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -1, 0)
			a1.Parent = root
			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Color = ColorSequence.new(pal.Light, pal.Second)
			trail.LightEmission = 0.8
			trail.Lifetime = 0.25
			trail.Transparency = NumberSequence.new(0.2, 1)
			trail.Parent = root
			Debris:AddItem(trail, (data.Time or 0.36) + 0.3)
			Debris:AddItem(a0, (data.Time or 0.36) + 0.3)
			Debris:AddItem(a1, (data.Time or 0.36) + 0.3)
			task.delay(data.Time or 0.36, function()
				trail.Enabled = false
			end)
		elseif data.Phase == "Land" then
			if character and not dinos[character] then
				TuskAnimation.play(character, "DiegoLand")
			end
			local pos = data.Position
			TuskVFX.CreateImpact(pos - Vector3.new(0, 2.5, 0), Vector3.new(0, 1, 0), { Size = 1.4, Radius = data.Radius or 6, Layers = 2, Color = pal.Main, Color2 = pal.Light, Sound = sounds.NailImpact, Pitch = 0.7 })
			TuskVFX.CreateGroundCracks(pos, { Radius = (data.Radius or 6) * 0.9, Count = 6, Color = pal.Main, Duration = 1.4 })
			if data.Hit then
				chomp(pos + (data.Direction or Vector3.new(0, 0, -1)) * 2 + Vector3.new(0, 0.5, 0), data.Direction, 1.3)
				VFXLib.sound(sounds.Hit, pos, 0.8, 0.8)
			end
			CameraFX.shakeAt(pos, data.Hit and 0.7 or 0.4, 50)
		end
	elseif data.Move == "DinoInfection" and data.Phase == "ThrallBite" then
		local t = data.Target and thralls[data.Target]
		if t then
			t.Jaw = 1
			t.Lunge = 1
		end
		chomp(data.Position + Vector3.new(0, 0.5, 0), data.Direction, 1.1)
		VFXLib.sound(sounds.Hit, data.Position, 0.6, 0.85)
	elseif data.Move == "DinoInfection" and data.Phase == "Command" then
		-- "Sic 'em": a blue target mark on the prey, the dinosaur roars.
		local t = data.Target and thralls[data.Target]
		if t then
			t.Jaw = 1
		end
		TuskVFX.CreateImpactStar(data.Position + Vector3.new(0, 1, 0), { Size = 5, Rays = 8, Color = SLASH, Color2 = SLASH_LIGHT, Duration = 0.35 })
		TuskVFX.CreateRotationalShockwave(CFrame.new(data.Position - Vector3.new(0, 2.6, 0)), { Radius = 5, Layers = 2, Color = SLASH, Color2 = SLASH_LIGHT, Ground = true, Particles = 0, Width = 0.3 })
		local thrallRoot = data.Target and data.Target:FindFirstChild("HumanoidRootPart")
		if thrallRoot then
			roarSound(thrallRoot.Position, 0.8)
		end
		if root then
			TuskAnimation.play(character, "D_M1_1") -- Diego points the claw
		end
	elseif data.Move == "DinoInfection" and (data.Phase == "Turn" or data.Phase == "Release") then
		-- Drawn by stepThralls from the DinoThrall attribute.
	elseif data.Move == "DinoInfection" then
		if data.Phase == "Startup" and root then
			if not dinoAction(character, "Bite") then
				TuskAnimation.play(character, "DiegoBite")
			end
			-- Teal venom gathers at the mouth.
			local mouth = root.Position + root.CFrame.LookVector * 1.4 + Vector3.new(0, 1.4, 0)
			VFXLib.flash(mouth, pal.Main, 3, 10, (data.Windup or 0.2) + 0.1)
			VFXLib.burst(mouth, { Count = 8, Color = pal.Light, Speed = 3, Lifetime = 0.3 })
		elseif data.Phase == "Hit" then
			local look = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
			chomp(data.Position + Vector3.new(0, 1, 0), look, data.Hit and 1.4 or 1)
			VFXLib.sound(sounds.Hit, data.Position, 0.7, 0.75)
			if data.Hit then
				-- Infection spores burst out of the bite.
				VFXLib.burst(data.Position, { Count = 24, Color = pal.Main, Speed = 16, Lifetime = 0.7, Drag = 3, Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) }) })
				TuskVFX.CreateRotationalShockwave(CFrame.new(data.Position), { Radius = 5, Layers = 2, Color = pal.Main, Color2 = pal.Second, Particles = 0, Width = 0.25, Duration = 0.4 })
				if Common.isLocal(character) then
					CameraFX.shake(0.4, 0.25)
				end
			end
		end
	elseif data.Move == "ScaryMonsters" then
		if data.Phase == "Transform" and root then
			TuskAnimation.play(character, "DiegoTransform")
			TuskVFX.CreateMagicCircle(CFrame.new(root.Position - Vector3.new(0, 2.9, 0)), { Radius = 7, Color = pal.Main, Color2 = pal.Second, Duration = (data.Duration or 0.5) + 0.3, RotationSpeed = 3, Points = 6 })
			VFXLib.sound(sounds.AwakeningBuild, root, 0.7, 0.8)
			-- Scales flicker over the body before the change.
			VFXLib.burst(root.Position, { Count = 18, Color = pal.Main, Speed = 4, Lifetime = 0.5, Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) }) })
		end
		-- "Revert" is handled by stepDinos when the DinoMode attribute goes away.
	end
end

---------------------------------------------------------------------------
-- RAPTOR PACK (ultimate)
---------------------------------------------------------------------------
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundAt(pos)
	local ignore = { VFXLib.Folder }
	for _, player in ipairs(Fighters.list()) do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	groundParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -30, 0), groundParams)
	return hit and hit.Position or pos
end

local function endRaptor(id, position)
	local r = pack[id]
	if not r then
		return
	end
	pack[id] = nil
	local pos = position or r.Pos
	VFXLib.burst(pos + Vector3.new(0, 2, 0), { Count = 16, Color = pal.Main, Speed = 16, Lifetime = 0.5 })
	VFXLib.burst(pos, { Count = 6, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(200, 180, 140), LightEmission = 0, Speed = 8, Lifetime = 0.8 })
	local rig = r.Rig
	VFXLib.animate(0.3, function(a)
		rig:SetTransparency(a)
	end, function()
		rig:Destroy()
	end)
end

local function stepPack(dt)
	local now = os.clock()
	for id, r in pairs(pack) do
		r.Traveled = math.min(r.Traveled + r.Speed * dt, r.Range)
		local flat = r.Origin + r.Direction * r.Traveled
		-- Follow the ground a few times a second (cheap).
		r.NextGround = r.NextGround - dt
		if r.NextGround <= 0 then
			r.NextGround = 0.1
			r.GroundY = groundAt(flat).Y
		end
		r.Pos = Vector3.new(flat.X, r.GroundY, flat.Z)
		r.Phase = r.Phase + dt * 15
		r.Jaw = r.Jaw * math.exp(-dt * 6)
		r.Rig:Pose(CFrame.lookAt(r.Pos, r.Pos + r.Direction), { Time = now, Phase = r.Phase, Speed = 1, Jaw = math.max(r.Jaw, 0.25 + math.sin(now * 9 + r.Seed) * 0.2), Lunge = r.Jaw * 0.6 })
		if now > r.Expire then
			endRaptor(id)
		end
	end
end

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Roar" and root then
		local w = data.Windup or 1.2
		if not dinoAction(character, "Roar", w * 0.8) then
			TuskAnimation.play(character, "DiegoRoar")
		end
		local near = Common.isLocal(character) or TuskVFX.IsNear(root.Position, 90)
		if near then
			TuskVFX.ScreenTint(w, { Brightness = -0.12, Saturation = -0.2, Contrast = 0.2, Tint = Color3.fromRGB(200, 255, 240), Release = 0.1 })
		end
		TuskVFX.CreateMagicCircle(CFrame.new(root.Position - Vector3.new(0, 2.9, 0)), { Radius = data.Radius or 16, Color = pal.Main, Color2 = pal.Second, Duration = w + 0.3, RotationSpeed = 1.5, Points = 7 })
		-- The roar: rings of sound blasting out from the mouth.
		task.delay(w * 0.35, function()
			if not root.Parent then
				return
			end
			roarSound(root.Position, 0.5)
			local mouth = root.Position + root.CFrame.LookVector * 2 + Vector3.new(0, 2, 0)
			for i = 1, 4 do
				task.delay(i * 0.07, function()
					local axis = CFrame.lookAt(mouth, mouth + root.CFrame.LookVector) * CFrame.Angles(math.pi / 2, 0, 0)
					TuskVFX.CreateRotationalShockwave(axis * CFrame.new(0, -i * 1.5, 0), { Radius = 3 + i * 2.5, Layers = 1, Color = i % 2 == 1 and pal.Light or pal.Main, Color2 = pal.Main, Particles = 0, Width = 0.35, Duration = 0.35, Spin = 0 })
				end)
			end
			TuskVFX.CreateRotationalShockwave(CFrame.new(root.Position - Vector3.new(0, 2.8, 0)), { Radius = data.Radius or 16, Layers = 3, Color = pal.Main, Color2 = pal.Light, Ground = true, Particles = 1.5, Width = 0.6 })
			TuskVFX.CreateDistortion(mouth, { Radius = 6, Duration = 0.5 })
			CameraFX.shakeAt(root.Position, 1, 80)
			if near then
				CameraFX.impactFrame(pal.Light)
			end
		end)
	elseif data.Phase == "Release" then
		local count = 0
		for _, info in ipairs(data.Raptors or {}) do
			count = count + 1
			local rig = RaptorModel.build(0.75, { Lite = true })
			rig.Model.Parent = VFXLib.Folder
			pack[info.Id] = {
				Rig = rig,
				Origin = info.Origin,
				Direction = info.Direction,
				Pos = info.Origin,
				GroundY = info.Origin.Y,
				NextGround = 0,
				Speed = data.Speed or 48,
				Range = data.Range or 75,
				Traveled = 0,
				Phase = math.random() * 6,
				Seed = math.random() * 10,
				Jaw = 1,
				Expire = os.clock() + (data.Range or 75) / (data.Speed or 48) + 1,
			}
			-- Each raptor bursts out of the ground.
			VFXLib.burst(info.Origin, { Count = 8, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(200, 180, 140), LightEmission = 0, Speed = 12, Lifetime = 0.7 })
			TuskVFX.CreateImpactStar(info.Origin + Vector3.new(0, 2, 0), { Size = 4, Rays = 6, Color = pal.Main, Color2 = WHITE, Duration = 0.25 })
		end
		if root then
			VFXLib.sound(sounds.AwakeningBurst, root.Position, 0.8, 0.7)
		end
		if Common.isLocal(character) then
			CameraFX.speedLines(0.5, pal.Light)
			CameraFX.fovPunch(14, 0.5)
		end
	elseif data.Phase == "RaptorBite" then
		local r = pack[data.Id]
		if r then
			r.Jaw = 1
		end
		chomp(data.Position + Vector3.new(0, 0.5, 0), r and r.Direction, 1.2)
		VFXLib.sound(sounds.Hit, data.Position, 0.7, 0.8)
		CameraFX.shakeAt(data.Position, 0.4, 40)
	elseif data.Phase == "RaptorEnd" then
		endRaptor(data.Id, data.Position)
	end
end

function Diego.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		Common.finisher(data, Common.palette(6))
		local look = data.Character and Common.rootOf(data.Character)
		chomp(data.Position + Vector3.new(0, 0.5, 0), look and look.CFrame.LookVector, 1.4)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function Diego.step(dt)
	dt = dt or 1 / 60
	stepDinos(dt)
	stepThralls(dt)
	stepPack(dt)
	slowTimer = slowTimer + dt
	if slowTimer > 0.1 then
		slowTimer = 0
		stepStance()
		stepInfected()
		stepVision()
	end
end

return Diego
end

-- ======================================================================
-- MODULE: RaptorModel
-- ======================================================================
__modules["RaptorModel"] = function()
--[[
	RaptorModel  (ReplicatedStorage.SpinShared.RaptorModel)

	Scary Monsters' raptor, built from parts (from the owner's references):
	  * teal head, neck and chest with dark navy stripe rings
	  * deep blue haunches, legs and tail; pale yellow tail underside
	  * yellow "0101" markings along the tail
	  * open jaws with rows of white teeth and a pink mouth/tongue
	  * the yellow pin crown around the back of the skull
	  * small clawed arms, digitigrade legs with yellow toe and sickle claws

	RaptorModel.build(scale, opts) -> rig
	  opts.Lite = true   fewer details (teeth, crown, markings) for crowds
	  opts.Blocky = false  keep rounded shapes (default: TuskConfig.BlockyModels)
	  opts.Palette = { Body, Legs, Head }  recolour the raptor (Color3 values)
	  rig.Model          the Model (all parts anchored, no collision)
	  rig:Pose(groundCF, s)  place every part. groundCF = point on the ground
	                         under the hips, facing the way the raptor looks.
	      s.Phase  walk cycle (radians)     s.Speed  0..1 run amount
	      s.Jaw    0..1 mouth open          s.Lunge  0..1 head/body thrust
	      s.Claw   0..1 arm swipe           s.Crouch 0..1 low stance
	      s.Whip   -1..1 tail whip          s.Time   seconds (idle motion)
	      s.HeadYaw / s.HeadPitch  radians
	  rig:Destroy()
	Size: about 8 studs tall at the head and 15 long at scale 1.
]]

local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local Blockify = __require("Blockify")

local RaptorModel = {}

local C = {
	Teal = Color3.fromRGB(95, 205, 212),
	TealDark = Color3.fromRGB(55, 150, 170),
	Navy = Color3.fromRGB(22, 32, 72),
	Blue = Color3.fromRGB(38, 62, 190),
	BlueDark = Color3.fromRGB(24, 40, 140),
	Pale = Color3.fromRGB(242, 234, 172),
	Yellow = Color3.fromRGB(246, 212, 62),
	Gold = Color3.fromRGB(232, 190, 58),
	Mouth = Color3.fromRGB(215, 95, 108),
	Tongue = Color3.fromRGB(230, 130, 140),
	Teeth = Color3.fromRGB(246, 246, 236),
	Eye = Color3.fromRGB(250, 240, 200),
	Pupil = Color3.fromRGB(15, 15, 20),
}
RaptorModel.Colors = C

local TAIL_SEGMENTS = 9
local TAIL_LENGTH = 1.25

local function newPart(model, name, size, color, opts)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = (opts and opts.Material) or Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = size
	p.CastShadow = not (opts and opts.NoShadow)
	if opts and opts.Ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	if opts and opts.Cylinder then
		p.Shape = Enum.PartType.Cylinder
	end
	if opts and opts.Ball then
		p.Shape = Enum.PartType.Ball
	end
	p.Parent = model
	return p
end

function RaptorModel.build(scale, opts)
	scale = scale or 1
	opts = opts or {}
	local lite = opts.Lite == true
	local model = Instance.new("Model")
	model.Name = "ScaryMonstersRaptor"

	local entries = {} -- { Part, Bone, Offset }
	-- Optional recolour (e.g. a victim of Dino Infection in their avatar's colours):
	-- teal skin -> Body (Head colour on the head and jaw), blue -> Legs.
	local palette = opts.Palette
	local function recolor(bone, color)
		if not palette then
			return color
		end
		local onHead = bone == "Head" or bone == "Jaw"
		if color == C.Teal then
			return onHead and (palette.Head or palette.Body) or palette.Body
		elseif color == C.TealDark then
			return (onHead and (palette.Head or palette.Body) or palette.Body):Lerp(Color3.new(0, 0, 0), 0.25)
		elseif color == C.Blue then
			return palette.Legs
		elseif color == C.BlueDark then
			return palette.Legs:Lerp(Color3.new(0, 0, 0), 0.3)
		elseif color == C.Navy then
			return palette.Body:Lerp(Color3.new(0, 0, 0), 0.6)
		end
		if bone:sub(1, 4) == "Tail" and color ~= C.Pale and color ~= C.Yellow then
			return palette.Legs -- tail base blends teal -> blue
		end
		return color
	end
	local function add(bone, name, size, color, offset, partOpts)
		local p = newPart(model, name, size * scale, recolor(bone, color), partOpts)
		local o = offset or CFrame.new()
		table.insert(entries, { Part = p, Bone = bone, Offset = o - o.Position + o.Position * scale })
		return p
	end
	local E = { Ellipsoid = true }
	local function ell(extra)
		local t = { Ellipsoid = true }
		for k, v in pairs(extra or {}) do
			t[k] = v
		end
		return t
	end

	-- BODY (bone origin = middle of the torso)
	add("Body", "Torso", Vector3.new(2.6, 2.7, 4.6), C.Teal, CFrame.new(0, 0, 0), E)
	add("Body", "Chest", Vector3.new(2.35, 2.55, 2.5), C.Teal, CFrame.new(0, 0.25, -2.0), E)
	add("Body", "Belly", Vector3.new(2.1, 1.6, 3.4), C.TealDark, CFrame.new(0, -0.65, -0.6), E)
	for _, side in ipairs({ -1, 1 }) do
		add("Body", "Haunch", Vector3.new(1.5, 2.5, 2.8), C.Blue, CFrame.new(side * 0.85, -0.2, 1.0), E)
	end
	-- Dark stripe rings around the chest and torso.
	for i, z in ipairs({ -2.5, -1.7, -0.9, -0.1 }) do
		local k = 1 - math.abs(z + 1) * 0.08
		add("Body", "Stripe", Vector3.new(2.66 * k, 2.76 * k, 0.24), C.Navy, CFrame.new(0, 0.12, z), E)
	end
	add("Body", "Spine", Vector3.new(0.5, 0.4, 5.6), C.TealDark, CFrame.new(0, 1.3, -0.6), E)

	-- NECK (pitched up)
	add("Neck", "NeckLow", Vector3.new(1.6, 1.7, 2.4), C.Teal, CFrame.new(0, 0, -0.8), E)
	add("Neck", "NeckHigh", Vector3.new(1.4, 1.5, 2.2), C.Teal, CFrame.new(0, 0, -1.9), E)
	for _, z in ipairs({ -0.5, -1.3, -2.1 }) do
		add("Neck", "Stripe", Vector3.new(1.62, 1.72, 0.2), C.Navy, CFrame.new(0, 0, z), E)
	end

	-- HEAD
	add("Head", "Skull", Vector3.new(2.0, 1.8, 2.6), C.Teal, CFrame.new(0, 0.15, -0.6), E)
	add("Head", "Snout", Vector3.new(1.45, 1.0, 2.7), C.Teal, CFrame.new(0, 0.1, -2.2), E)
	add("Head", "MouthRoof", Vector3.new(0.95, 0.12, 2.1), C.Mouth, CFrame.new(0, -0.32, -1.9))
	add("Head", "Brow", Vector3.new(1.85, 0.35, 0.9), C.TealDark, CFrame.new(0, 0.62, -1.0), E)
	for _, side in ipairs({ -1, 1 }) do
		add("Head", "Eye", Vector3.new(0.18, 0.36, 0.42), C.Eye, CFrame.new(side * 0.78, 0.42, -0.95), E)
		add("Head", "Pupil", Vector3.new(0.1, 0.2, 0.12), C.Pupil, CFrame.new(side * 0.86, 0.43, -1.0), ell({ NoShadow = true }))
		add("Head", "Nostril", Vector3.new(0.12, 0.1, 0.16), C.Navy, CFrame.new(side * 0.32, 0.4, -3.1), ell({ NoShadow = true }))
		add("Head", "Cheek", Vector3.new(0.3, 0.6, 1.2), C.TealDark, CFrame.new(side * 0.7, -0.15, -0.6), E)
		if not lite then
			for k = 0, 5 do
				local tooth = add("Head", "Tooth", Vector3.new(0.1, 0.32, 0.12), C.Teeth, CFrame.new(side * (0.5 - k * 0.04), -0.42, -1.1 - k * 0.36) * CFrame.Angles(0, 0, side * 0.1), { NoShadow = true })
				tooth.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	-- The yellow pin crown fanned around the back of the skull.
	local pins = lite and 4 or 7
	for k = 1, pins do
		local a = -1.25 + (k - 1) / (pins - 1) * 2.5 -- side to side over the top
		local dir = Vector3.new(math.sin(a), math.cos(a), 0.35).Unit
		local base = Vector3.new(0, 0.2, -0.3) + dir * 0.72
		local pinCF = CFrame.lookAt(base + dir * 0.55, base + dir * 2) * CFrame.Angles(0, math.pi / 2, 0)
		add("Head", "CrownPin", Vector3.new(1.1, 0.12, 0.12), C.Gold, pinCF, { Cylinder = true, Material = Enum.Material.Metal })
		add("Head", "CrownBall", Vector3.new(0.3, 0.3, 0.3), C.Yellow, CFrame.new(base + dir * 1.15), { Ball = true, Material = Enum.Material.Metal })
	end

	-- JAW
	add("Jaw", "LowerJaw", Vector3.new(1.35, 0.55, 2.7), C.Teal, CFrame.new(0, -0.12, -1.55), E)
	add("Jaw", "Tongue", Vector3.new(0.7, 0.16, 1.7), C.Tongue, CFrame.new(0, 0.04, -1.3), E)
	add("Jaw", "Throat", Vector3.new(0.9, 0.5, 1.0), C.Pale, CFrame.new(0, -0.25, -0.4), E)
	if not lite then
		for _, side in ipairs({ -1, 1 }) do
			for k = 0, 4 do
				add("Jaw", "Tooth", Vector3.new(0.1, 0.28, 0.12), C.Teeth, CFrame.new(side * (0.42 - k * 0.04), 0.18, -0.95 - k * 0.36), { NoShadow = true })
			end
		end
	end

	-- TAIL (bone i starts at segment i and points backward, +Z)
	for i = 1, TAIL_SEGMENTS do
		local k = (i - 1) / TAIL_SEGMENTS
		local d = 1.95 * (1 - k * 0.85)
		local color = i <= 2 and C.Teal:Lerp(C.Blue, (i - 1) / 2) or C.Blue
		add("Tail" .. i, "Tail", Vector3.new(d, d * 0.92, TAIL_LENGTH * 1.75), color, CFrame.new(0, 0, TAIL_LENGTH / 2), E)
		add("Tail" .. i, "TailBelly", Vector3.new(d * 0.72, d * 0.4, TAIL_LENGTH * 1.7), C.Pale, CFrame.new(0, -d * 0.3, TAIL_LENGTH / 2), E)
		if not lite and i >= 2 and i <= 8 then
			-- Yellow "0101" markings riding on top of the tail.
			local strip = add("Tail" .. i, "Marking", Vector3.new(d * 0.55, 0.05, TAIL_LENGTH), C.Yellow, CFrame.new(0, d * 0.47, TAIL_LENGTH / 2), { NoShadow = true })
			strip.Transparency = 1
			local gui = Instance.new("SurfaceGui")
			gui.Face = Enum.NormalId.Top
			gui.LightInfluence = 0.3
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 30
			gui.Parent = strip
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Size = UDim2.fromScale(1, 1)
			label.Font = Enum.Font.Arcade
			label.TextScaled = true
			label.TextColor3 = C.Yellow
			label.Rotation = 90
			label.Text = (i % 2 == 0) and "0101" or "1010"
			label.Parent = gui
		end
	end

	-- LEGS
	for _, side in ipairs({ -1, 1 }) do
		local s = side > 0 and "R" or "L"
		add("Thigh" .. s, "Thigh", Vector3.new(1.2, 2.4, 1.5), C.Blue, CFrame.new(0, -0.95, 0), E)
		add("Shin" .. s, "Shin", Vector3.new(0.75, 2.3, 0.85), C.Blue, CFrame.new(0, -1.0, 0), E)
		add("Meta" .. s, "Metatarsal", Vector3.new(0.55, 1.4, 0.6), C.BlueDark, CFrame.new(0, -0.6, 0), E)
		for t = -1, 1 do
			add("Foot" .. s, "Toe", Vector3.new(0.28, 0.26, 1.0), C.BlueDark, CFrame.new(t * 0.3, 0.14, -0.45 - math.abs(t) * -0.05) * CFrame.Angles(0, -t * 0.25, 0), E)
			add("Foot" .. s, "ToeClaw", Vector3.new(0.18, 0.34, 0.36), C.Yellow, CFrame.new(t * 0.3 - t * 0.12, 0.12, -1.02) * CFrame.Angles(-0.5, -t * 0.25, 0), { NoShadow = true })
		end
		-- The big curved sickle claw on the second toe.
		add("Foot" .. s, "SickleClaw", Vector3.new(0.16, 0.55, 0.5), C.Yellow, CFrame.new(-side * 0.08, 0.5, -0.15) * CFrame.Angles(0.6, 0, 0), { NoShadow = true })
	end

	-- ARMS
	for _, side in ipairs({ -1, 1 }) do
		local s = side > 0 and "R" or "L"
		add("UpperArm" .. s, "UpperArm", Vector3.new(0.55, 1.3, 0.6), C.Teal, CFrame.new(0, -0.55, 0), E)
		add("Forearm" .. s, "Forearm", Vector3.new(0.45, 1.15, 0.5), C.Teal, CFrame.new(0, -0.5, 0), E)
		for c = -1, 1 do
			add("Forearm" .. s, "Claw", Vector3.new(0.12, 0.55, 0.14), C.Yellow, CFrame.new(c * 0.15, -1.2, -0.12) * CFrame.Angles(0.6, 0, 0), { NoShadow = true })
		end
	end

	-- Blocky (classic Roblox) look: boxes instead of rounded shapes.
	if opts.Blocky ~= false and Blockify.enabled(TuskConfig) then
		Blockify.apply(model, { Voxel = false }) -- parts are posed one by one
	end

	local rig = { Model = model, Scale = scale, Entries = entries }

	local function bonesFor(ground, s)
		local sc = scale
		local t = s.Time or 0
		local speed = s.Speed or 0
		local phase = s.Phase or 0
		local lunge = s.Lunge or 0
		local crouch = s.Crouch or 0
		local claw = s.Claw or 0
		local jaw = s.Jaw or 0
		local whip = s.Whip or 0
		local idle = 1 - math.min(speed, 1)
		local breath = math.sin(t * 2.4) * 0.04 * idle
		local bob = math.abs(math.sin(phase)) * 0.18 * speed
		local bones = {}
		local function at(x, y, z)
			return CFrame.new(x * sc, y * sc, z * sc)
		end
		local body = ground * at(0, 4.6 + bob - crouch * 0.9, -0.3 - lunge * 1.3)
			* CFrame.Angles(0.1 - lunge * 0.3 - crouch * 0.12 + breath, whip * 0.5, math.sin(phase) * 0.04 * speed)
		bones.Body = body
		local neck = body * at(0, 0.5, -2.6) * CFrame.Angles(0.8 - lunge * 0.45 + (s.HeadPitch or 0) * 0.5 + breath * 2, (s.HeadYaw or 0) * 0.5, 0)
		bones.Neck = neck
		local head = neck * at(0, 0, -2.5) * CFrame.Angles(-0.85 + lunge * 0.2 + (s.HeadPitch or 0) * 0.5 + jaw * 0.2, (s.HeadYaw or 0) * 0.5, 0)
		bones.Head = head
		bones.Jaw = head * at(0, -0.3, 0.2) * CFrame.Angles(-0.06 - jaw * 0.8, 0, 0)
		-- Tail: sways while idle, swings harder when running, whips on attacks.
		local tail = body * at(0, 0.15, 2.1)
		for i = 1, TAIL_SEGMENTS do
			local k = i / TAIL_SEGMENTS
			local sway = math.sin(t * 2.2 - i * 0.55) * (0.06 + 0.08 * speed) + whip * 0.35 * (1 - k * 0.5)
			local lift = (i == 1 and 0.12 or 0) + (i >= 2 and i <= 4 and 0.04 or 0) + (i >= 6 and -0.12 or 0) - speed * 0.02
			tail = tail * CFrame.Angles(lift, sway, 0)
			bones["Tail" .. i] = tail
			tail = tail * at(0, 0, TAIL_LENGTH * 0.92)
		end
		-- Legs (digitigrade): hip -> knee -> ankle -> toes.
		local flatGround = ground - ground.Position
		for _, side in ipairs({ -1, 1 }) do
			local s2 = side > 0 and "R" or "L"
			local off = side > 0 and 0 or math.pi
			local swing = math.sin(phase + off) * 0.65 * speed
			local liftAmt = math.max(0, math.cos(phase + off)) * speed
			local hip = body * at(side * 0.95, -0.25, 1.0)
			local thigh = hip * CFrame.Angles(math.rad(28) + swing - crouch * 0.55 + lunge * 0.2, 0, side * 0.05)
			bones["Thigh" .. s2] = thigh
			local knee = thigh * at(0, -2.0, 0) * CFrame.Angles(math.rad(-78) - liftAmt * 0.7 - crouch * 0.7, 0, 0)
			bones["Shin" .. s2] = knee
			local ankle = knee * at(0, -2.0, 0) * CFrame.Angles(math.rad(62) + liftAmt * 0.6 + crouch * 0.6, 0, 0)
			bones["Meta" .. s2] = ankle
			local toe = ankle * at(0, -1.2, 0)
			bones["Foot" .. s2] = CFrame.new(toe.Position) * flatGround * CFrame.Angles(liftAmt * 0.5, 0, 0)
		end
		-- Arms: tucked, raking forward on claw attacks.
		for _, side in ipairs({ -1, 1 }) do
			local s2 = side > 0 and "R" or "L"
			local shoulder = body * at(side * 0.95, 0.15, -2.5)
			local upper = shoulder * CFrame.Angles(math.rad(35) + claw * 1.4 + math.sin(phase + (side > 0 and math.pi or 0)) * 0.12 * speed, 0, side * (0.2 + claw * 0.2))
			bones["UpperArm" .. s2] = upper
			bones["Forearm" .. s2] = upper * at(0, -1.1, 0) * CFrame.Angles(math.rad(70) - claw * 0.9, 0, 0)
		end
		return bones
	end

	local parts, cframes = {}, {}
	for i, e in ipairs(entries) do
		parts[i] = e.Part
	end

	function rig:Pose(ground, s)
		local bones = bonesFor(ground, s or {})
		for i, e in ipairs(entries) do
			cframes[i] = bones[e.Bone] * e.Offset
		end
		local ok = pcall(function()
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if not ok then
			for i, p in ipairs(parts) do
				p.CFrame = cframes[i]
			end
		end
	end

	function rig:SetTransparency(t)
		for _, e in ipairs(entries) do
			if e.Part.Name ~= "Marking" then
				e.Part.Transparency = t
			end
		end
	end

	function rig:Destroy()
		model:Destroy()
	end

	return rig
end

return RaptorModel
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Gyro_Client</string><ProtectedString name="Source"><![CDATA[--[[
	Gyro_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Gyro Zeppeli: Steel Balls and Ball Breaker.
	Its other half is Gyro_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: Gyro
-- ======================================================================
__modules["Gyro"] = function()
--[[
	TuskActVFX.Gyro  (StarterPlayerScripts.SpinClient.TuskActVFX.Gyro)

	Client visuals for Gyro Zeppeli (Steel Ball moveset):
	  * the green Steel Ball always spinning in Gyro's right hand
	    (hidden while it's thrown, back when it returns)
	  * thrown / returning ball with white-green spin rings and a trail
	  * SPIN TORNADO: a travelling green funnel of spinning rings
	  * Spin Vibration ripples, and shaking sparks on anyone hit by the Spin
	  * Gyro's own animations (pitch, bowl, kick, palm press...) and his
	    ball-in-hand idle stance
	  * BALL BREAKER: spiral build-up, giant ball, spinning vortex, burst
]]

local Players = game:GetService("Players")
local Fighters = __require("Fighters")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local VFXQuality = __require("VFXQuality")
local Net = __require("Net")
local SteelBallModel = __require("SteelBallModel")
local WreckingBallModel = __require("WreckingBallModel")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")

local Gyro = {}
local pal = Common.palette(5)
local sounds = TuskConfig.Sounds
local localPlayer = Players.LocalPlayer
local GYRO_ACT = 5

local held = {} -- [character] = { Ball, Weld, Grip, Angle, HiddenUntil }
local shakes = {} -- [character] = attachment with sparkles
local balls = {} -- [projectile id] = visual

local function handOf(character)
	local hand = character:FindFirstChild("RightHand")
	if hand then
		return hand, CFrame.new(0, -0.5, -0.15)
	end
	local arm = character:FindFirstChild("Right Arm")
	if arm then
		return arm, CFrame.new(0, -1.15, -0.15)
	end
	return nil
end

local function setHidden(entry, hidden)
	for _, d in ipairs(entry.Ball:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
	entry.Hidden = hidden
end

---------------------------------------------------------------------------
-- Ball always in Gyro's hand
---------------------------------------------------------------------------
local function updateHeld(dt)
	local seen = {}
	local now = os.clock()
	for _, player in ipairs(Fighters.list()) do
		local character = player.Character
		if character and character:GetAttribute("TuskAct") == GYRO_ACT then
			local hand, grip = handOf(character)
			if hand then
				seen[character] = true
				local entry = held[character]
				if not entry then
					local ball = SteelBallModel.build(0.9, VFXQuality.get().Grooves)
					local core = ball.PrimaryPart
					core.Anchored = false
					ball:PivotTo(hand.CFrame * grip)
					local weld = Instance.new("Weld")
					weld.Part0 = hand
					weld.Part1 = core
					weld.C0 = grip
					weld.Parent = core
					ball.Parent = VFXLib.Folder
					entry = { Ball = ball, Weld = weld, Grip = grip, Angle = 0, HiddenUntil = 0, Spin = 8, Character = character }
					held[character] = entry
					TuskAnimation.hold(character, "GyroIdle") -- ball held up at the chest
				end
				entry.Angle = entry.Angle + dt * entry.Spin
				entry.Weld.C0 = entry.Grip * CFrame.Angles(entry.Angle, entry.Angle * 0.3, 0)
				local hide = now < entry.HiddenUntil
				if hide ~= (entry.Hidden == true) then
					setHidden(entry, hide)
				end
			end
		end
	end
	for character, entry in pairs(held) do
		if not seen[character] then
			held[character] = nil
			entry.Ball:Destroy()
			if character.Parent then
				TuskAnimation.stopHold(character, "GyroIdle")
			end
		end
	end
end

-- Sparkly "shaking" on anyone the Spin is vibrating.
local function updateShakes()
	local seen = {}
	local candidates = {}
	for _, player in ipairs(Fighters.list()) do
		if player.Character then
			table.insert(candidates, player.Character)
		end
	end
	local dummies = workspace:FindFirstChild("SpinTestDummies")
	if dummies then
		for _, d in ipairs(dummies:GetChildren()) do
			table.insert(candidates, d)
		end
	end
	for _, model in ipairs(candidates) do
		if model:IsA("Model") and model:GetAttribute("GyroSpinShake") then
			local root = model:FindFirstChild("HumanoidRootPart")
			if root then
				seen[model] = true
				if not shakes[model] then
					local a = Instance.new("Attachment")
					a.Name = "GyroSpinShake"
					a.Parent = root
					local e = Instance.new("ParticleEmitter")
					e.Texture = VFXLib.Textures.Sparkle
					e.Color = ColorSequence.new(pal.Light, pal.Main)
					e.LightEmission = 1
					e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
					e.Lifetime = NumberRange.new(0.2, 0.35)
					e.Speed = NumberRange.new(4, 8)
					e.SpreadAngle = Vector2.new(180, 180)
					e.Rate = 30 * VFXQuality.get().Particles
					e.Parent = a
					shakes[model] = a
				end
			end
		end
	end
	for model, a in pairs(shakes) do
		if not seen[model] then
			shakes[model] = nil
			a:Destroy()
		end
	end
end

---------------------------------------------------------------------------
-- Ball projectiles (server Kind "GyroBall")
---------------------------------------------------------------------------
local function spawnBall(data)
	local style = data.Visual and data.Visual.Style or "Throw"
	local ball
	local rings = {}
	if style == "Wrecking" then
		ball = WreckingBallModel.build(0.7, false)
	else
		local size = style == "Breaker" and (data.Visual.Scale or 6) or 1.1
		ball = SteelBallModel.build(size, VFXQuality.get().Grooves)
		local ringCount = style == "Breaker" and 3 or 2
		for i = 1, ringCount do
			rings[i] = VFXLib.ring({ Radius = size * 0.6 + i * (style == "Breaker" and 0.8 or 0.25), Width = style == "Breaker" and 0.35 or 0.1, Color = i % 2 == 1 and pal.Light or pal.Main, Transparency = 0.1 })
		end
	end
	ball.PrimaryPart.Anchored = true
	ball.Parent = VFXLib.Folder
	local core = ball.PrimaryPart
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.3, 0)
	a0.Parent = core
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.3, 0)
	a1.Parent = core
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = style == "Wrecking" and ColorSequence.new(Color3.fromRGB(255, 160, 60)) or ColorSequence.new(pal.Light, pal.Main)
	trail.LightEmission = 1
	trail.Lifetime = style == "Breaker" and 0.5 or 0.25
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Parent = core
	-- Steel Ball Throw / return: green glow, spiral Spin trails, afterimages.
	local glow, helix
	if style == "Throw" or style == "Return" then
		local bounce = data.Visual and data.Visual.Bounce or 0
		glow = VFXLib.part({ Shape = Enum.PartType.Ball, Material = Enum.Material.ForceField, Color = pal.Main:Lerp(pal.Light, math.min(bounce * 0.3, 0.8)), Transparency = 0.1, Size = Vector3.new(1.9, 1.9, 1.9) })
		helix = VFXLib.anchor(CFrame.new(data.Origin))
		local strands = VFXQuality.get().RingSegments > 12 and 3 or 2
		for i = 1, strands do
			local th = (i - 1) / strands * math.pi * 2
			local dir = Vector3.new(math.cos(th), math.sin(th), 0)
			local h0 = Instance.new("Attachment")
			h0.Position = dir * 0.9
			h0.Parent = helix
			local h1 = Instance.new("Attachment")
			h1.Position = dir * 1.05
			h1.Parent = helix
			local t = Instance.new("Trail")
			t.Attachment0 = h0
			t.Attachment1 = h1
			t.Color = ColorSequence.new(Color3.new(1, 1, 1), pal.Main)
			t.LightEmission = 1
			t.LightInfluence = 0
			t.FaceCamera = true
			t.Lifetime = 0.3
			t.WidthScale = NumberSequence.new(1, 0.1)
			t.Transparency = NumberSequence.new(0, 1)
			t.Parent = helix
		end
	end
	local whirl
	if style == "Breaker" then
		-- Spinning spiral trailing the giant ball.
		whirl = VFXLib.anchor(CFrame.new(data.Origin))
		local prev
		for i = 0, 16 do
			local t = i / 16
			local angle = t * math.pi * 3
			local r = 1 + t * 4
			local a = Instance.new("Attachment")
			a.Position = Vector3.new(math.cos(angle) * r, math.sin(angle) * r, t * 3)
			a.Parent = whirl
			if prev then
				local b = Instance.new("Beam")
				b.Attachment0 = prev
				b.Attachment1 = a
				b.FaceCamera = true
				b.LightEmission = 1
				b.Width0 = 0.5 * (1 - t * 0.6)
				b.Width1 = 0.5 * (1 - t * 0.6)
				b.Color = ColorSequence.new(pal.Light:Lerp(pal.Main, t))
				b.Transparency = NumberSequence.new(t * 0.7)
				b.Parent = whirl
			end
			prev = a
		end
	end
	balls[data.Id] = {
		Glow = glow,
		Helix = helix,
		Whirl = whirl,
		Model = ball,
		Rings = rings,
		Style = style,
		Origin = data.Origin,
		Direction = data.Direction,
		Speed = data.Speed,
		Range = data.Range,
		ServerTime = data.ServerTime,
		Spin = 0,
		Expire = os.clock() + data.Range / data.Speed + 1.5,
		NextGhost = 0,
	}
	VFXLib.sound(sounds.NailFire, data.Origin, 0.5, style == "Wrecking" and 1.3 or 0.8)
	if style ~= "Return" then
		VFXLib.burst(data.Origin, { Count = 14, Color = pal.Light, Speed = 22, Spread = 30, Direction = data.Direction, Lifetime = 0.3 })
	end
	if style == "Throw" then
		-- Release: a spin ring blasts off the hand along the throw, plus a flash.
		local axis = CFrame.lookAt(data.Origin, data.Origin + data.Direction) * CFrame.Angles(math.pi / 2, 0, 0)
		TuskVFX.CreateRotationalShockwave(axis, { Radius = 3.2, Layers = 2, Color = pal.Light, Color2 = pal.Main, Particles = 0, Width = 0.25, Duration = 0.3, Spin = 6 })
		TuskVFX.CreateImpactStar(data.Origin, { Size = 3, Rays = 6, Color = pal.Main, Color2 = pal.Light, Duration = 0.18 })
		VFXLib.flash(data.Origin, pal.Main, 4, 16, 0.2)
	end
end

local function removeBall(v)
	for _, ring in ipairs(v.Rings) do
		ring:Destroy()
	end
	if v.Whirl then
		v.Whirl:Destroy()
	end
	if v.Glow then
		v.Glow:Destroy()
	end
	if v.Helix then
		Debris:AddItem(v.Helix, 0.4) -- let the spiral trails finish fading
		for _, t in ipairs(v.Helix:GetChildren()) do
			if t:IsA("Trail") then
				t.Enabled = false
			end
		end
	end
	v.Model:Destroy()
end

local function endBall(data)
	local v = balls[data.Id]
	if v then
		balls[data.Id] = nil
		removeBall(v)
	end
	local style = data.Visual and data.Visual.Style or "Throw"
	if style == "Breaker" then
		return -- the vortex event takes over
	end
	if style == "Wrecking" then
		VFXLib.burst(data.Position, { Count = 10, Color = Color3.fromRGB(255, 170, 70), Speed = 25, Lifetime = 0.3, Acceleration = Vector3.new(0, -50, 0) })
		VFXLib.sound(sounds.NailImpact, data.Position, 0.4, 1.3)
	elseif style == "Throw" then
		TuskVFX.CreateImpact(data.Position, data.Normal, { Size = 1.3, Radius = 4.5, Layers = 3, Color = pal.Main, Color2 = pal.Light, Sound = sounds.NailImpact, Pitch = 0.8 })
		-- The Spin keeps drilling: two late ripples spiral out from the hit.
		local normal = data.Normal or Vector3.new(0, 1, 0)
		local axis = CFrame.lookAt(data.Position, data.Position + normal) * CFrame.Angles(-math.pi / 2, 0, 0)
		for i = 1, 2 do
			task.delay(0.08 * i, function()
				TuskVFX.CreateRotationalShockwave(axis, { Radius = 3 + i * 2, Layers = 1, Color = pal.Light, Color2 = pal.Main, Particles = 0.5, Width = 0.2, Duration = 0.35, Spin = 8 })
			end)
		end
		if normal.Y > 0.6 then
			TuskVFX.CreateGroundCracks(data.Position, { Radius = 5, Count = 5, Color = pal.Main, Duration = 1.2 })
		end
		CameraFX.shakeAt(data.Position, 0.4, 50)
	end
end

local function stepBalls(dt)
	local serverNow = workspace:GetServerTimeNow()
	local now = os.clock()
	for id, v in pairs(balls) do
		local distance = math.min(v.Speed * (serverNow - v.ServerTime), v.Range)
		local pos = v.Origin + v.Direction * distance
		v.Spin = v.Spin + dt * (v.Style == "Breaker" and 10 or 25)
		local facing = CFrame.lookAt(pos, pos + v.Direction)
		v.Model:PivotTo(facing * CFrame.Angles(-v.Spin, 0, v.Spin * 0.2))
		local axis = facing * CFrame.Angles(math.pi / 2, 0, 0)
		for i, ring in ipairs(v.Rings) do
			ring:SetCFrame(axis * CFrame.Angles(0.5 * i * math.sin(v.Spin * 0.2), v.Spin * (0.4 + i * 0.2) * (i % 2 == 0 and -1 or 1), 0.3 * i))
		end
		if v.Style == "Breaker" and now >= v.NextGhost then
			v.NextGhost = now + 0.05
			VFXLib.afterimage(facing, 4, pal.Main)
			if math.random() < 0.2 then
				TuskVFX.CreateDistortion(pos, { Radius = 4, Duration = 0.25 })
			end
		end
		if v.Whirl then
			v.Whirl.CFrame = facing * CFrame.new(0, 0, 3.5) * CFrame.Angles(0, 0, v.Spin * 0.5)
		end
		if v.Glow then
			local pulse = 1.8 + math.sin(v.Spin * 0.8) * 0.25
			v.Glow.Size = Vector3.new(pulse, pulse, pulse)
			v.Glow.CFrame = facing
		end
		if v.Helix then
			v.Helix.CFrame = facing * CFrame.Angles(0, 0, v.Spin * 0.6)
			if v.Style == "Throw" and VFXQuality.get().Afterimages and now >= v.NextGhost then
				v.NextGhost = now + 0.05
				VFXLib.afterimage(facing, 1, pal.Light)
			end
		end
		if now > v.Expire then
			balls[id] = nil
			removeBall(v)
		end
	end
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local vibrationStartup, vibrationHit -- defined below (they use the spiral helpers)

-- STEEL BALL THROW bounce: the ball ricochets off a wall.
local function ricochet(data)
	local pos, n = data.Position, data.Normal or Vector3.new(0, 1, 0)
	local bounce = data.Bounce or 1
	local hot = pal.Main:Lerp(Color3.new(1, 1, 1), math.min(bounce * 0.2, 0.6))
	-- Ring flat against the wall + sparks spraying along the new direction.
	local wallAxis = CFrame.lookAt(pos, pos + n) * CFrame.Angles(-math.pi / 2, 0, 0)
	TuskVFX.CreateRotationalShockwave(wallAxis, { Radius = 3 + bounce, Layers = 2, Color = hot, Color2 = pal.Main, Particles = 0, Width = 0.3, Duration = 0.3, Spin = 9 })
	TuskVFX.CreateImpactStar(pos, { Size = 4 + bounce, Rays = 7, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Duration = 0.22 })
	VFXLib.burst(pos, { Count = 14 + bounce * 4, Color = hot, Speed = 38, Spread = 35, Direction = data.Direction or n, Lifetime = 0.3, Acceleration = Vector3.new(0, -30, 0) })
	VFXLib.burst(pos, { Count = 6, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(190, 170, 140), LightEmission = 0, Speed = 6, Lifetime = 0.7, Direction = n, Spread = 50 })
	VFXLib.flash(pos, hot, 5 + bounce, 18, 0.2)
	VFXLib.sound(sounds.NailImpact, pos, 0.55, 1.1 + bounce * 0.12)
	CameraFX.shakeAt(pos, 0.25 + bounce * 0.05, 45)
	-- Little "x2" popup so bank shots read clearly.
	local carrier = VFXLib.anchor(CFrame.new(pos + n * 1.5), 0.8)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(90, 40)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Parent = carrier
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Bangers
	label.TextScaled = true
	label.Text = "BOUNCE x" .. bounce
	label.TextColor3 = hot
	label.TextStrokeTransparency = 0
	label.Parent = billboard
	local start = carrier.Position
	VFXLib.animate(0.75, function(a)
		carrier.Position = start + Vector3.new(0, a * 2.5, 0)
		label.TextTransparency = math.max(0, (a - 0.55) / 0.45)
		label.TextStrokeTransparency = label.TextTransparency
		local pop = a < 0.12 and (1 + (0.12 - a) * 5) or 1
		billboard.Size = UDim2.fromOffset(90 * pop, 40 * pop)
	end)
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local entry = character and held[character]
	if data.Move == "SteelBallThrow" then
		if data.Phase == "Startup" and root then
			TuskAnimation.play(character, "GyroThrow")
			-- Wind-up: the ball spins faster and faster inside two whirling rings.
			for i = 1, 2 do
				TuskVFX.CreateSpinRing({
					Follow = function()
						local hand = handOf(character)
						return hand and hand.Parent and hand.CFrame * CFrame.new(0, -0.6, 0) or nil
					end,
					Tilt = CFrame.Angles(0.9 * i, 0, 0.6 * i),
					Radius = 0.9 + i * 0.3,
					Width = 0.08,
					Color = i == 1 and pal.Light or pal.Main,
					RotationSpeed = 10 + i * 4,
					Duration = data.Startup or 0.3,
				})
			end
			if entry then
				entry.Spin = 30
				task.delay(data.Startup, function()
					entry.HiddenUntil = os.clock() + 4 -- until it's caught again
					entry.Spin = 8
				end)
			end
		elseif data.Phase == "Bounce" then
			ricochet(data)
		elseif data.Phase == "Caught" and entry then
			entry.HiddenUntil = 0
			if root then
				VFXLib.burst(root.Position + Vector3.new(0, 1, 0), { Count = 8, Color = pal.Light, Speed = 6, Lifetime = 0.25 })
			end
		end
	elseif data.Move == "SpinTornado" and data.Phase == "Startup" and root then
		TuskAnimation.play(character, "GyroBowl")
		TuskVFX.CreateMagicCircle(CFrame.new(root.Position - Vector3.new(0, 2.9, 0)), { Radius = 4, Color = pal.Main, Color2 = pal.Light, Duration = (data.Startup or 0.3) + 0.3, RotationSpeed = 5, Points = 5 })
		VFXLib.burst(root.Position - Vector3.new(0, 2.5, 0), { Count = 12, Color = pal.Light, Speed = 10, Spread = 40, Direction = Vector3.new(0, 1, 0), Lifetime = 0.4 })
		if entry then
			entry.Spin = 40
			task.delay(data.Startup, function()
				entry.HiddenUntil = os.clock() + 2.6 -- the ball becomes the tornado
				entry.Spin = 8
			end)
		end
	elseif data.Move == "SpinVibration" then
		if data.Phase == "Startup" and root then
			TuskAnimation.play(character, "GyroPalm")
			if entry then
				entry.Spin = 45
				task.delay(0.6, function()
					entry.Spin = 8
				end)
			end
			vibrationStartup(character, root, data)
		elseif data.Phase == "Hit" then
			vibrationHit(character, root, data)
		end
	end
end

-- Golden ratio spiral / Golden Rectangle in Gyro's green (shared in TuskVFX).
local function spiral(cframe, size, duration)
	TuskVFX.CreateGoldenSpiral(cframe, { Size = size, Duration = duration, Color = pal.Main, Color2 = pal.Light })
end

local function goldenRectangle(cframe, size, duration)
	TuskVFX.CreateGoldenRectangle(cframe, { Size = size, Duration = duration, Color = pal.Main, Color2 = pal.Light })
end

---------------------------------------------------------------------------
-- SPIN VIBRATION: Gyro presses the spinning ball into the target and the
-- Spin shakes everything around it.
---------------------------------------------------------------------------
-- Zigzag "vibration" lines that jitter every frame while they shoot outward.
local function vibrationLines(axisCF, count, length, duration)
	local carrier = VFXLib.anchor(axisCF)
	local lines = {}
	local points = 7
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local dir = Vector3.new(math.cos(angle), math.sin(angle), -0.6).Unit
		local side = dir:Cross(Vector3.new(0, 0, 1))
		if side.Magnitude < 0.01 then
			side = Vector3.new(1, 0, 0)
		end
		local atts = {}
		for k = 0, points do
			local a = Instance.new("Attachment")
			a.Parent = carrier
			atts[k] = a
			if k > 0 then
				local b = Instance.new("Beam")
				b.Attachment0 = atts[k - 1]
				b.Attachment1 = a
				b.FaceCamera = true
				b.LightEmission = 1
				b.LightInfluence = 0
				b.Segments = 1
				b.Width0 = 0.22 * (1 - (k - 1) / points)
				b.Width1 = 0.22 * (1 - k / points)
				b.Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(pal.Main, k / points))
				b.Parent = carrier
			end
		end
		lines[i] = { Atts = atts, Dir = dir, Side = side.Unit }
	end
	VFXLib.animate(duration, function(a)
		local reach = length * VFXLib.easeOut(a)
		local shake = 0.45 * (1 - a)
		for _, line in ipairs(lines) do
			for k = 0, points do
				local t = k / points
				local zig = (k % 2 == 0 and 1 or -1) * shake * (0.6 + math.random() * 0.8)
				line.Atts[k].Position = line.Dir * (0.6 + reach * t) + line.Side * zig
			end
		end
		local fade = NumberSequence.new(math.clamp((a - 0.4) / 0.6, 0, 1))
		for _, b in ipairs(carrier:GetChildren()) do
			if b:IsA("Beam") then
				b.Transparency = fade
			end
		end
	end, function()
		carrier:Destroy()
	end)
end

function vibrationStartup(character, root, data)
	local windup = data.Windup or 0.35
	-- The ball in hand winds up inside tight, fast rings + gathering energy.
	for i = 1, 3 do
		TuskVFX.CreateSpinRing({
			Follow = function()
				local hand = handOf(character)
				return hand and hand.Parent and hand.CFrame * CFrame.new(0, -0.6, 0) or nil
			end,
			Tilt = CFrame.Angles(0.8 * i, 0.4 * i, 0.5 * i),
			Radius = 0.6 + i * 0.22,
			Width = 0.07,
			Color = i % 2 == 1 and pal.Light or pal.Main,
			RotationSpeed = 14 + i * 5,
			Duration = windup + 0.15,
		})
	end
	local charge = TuskVFX.CreateEnergyCharge({
		Follow = function()
			local hand = handOf(character)
			return hand and hand.Parent and hand.CFrame * CFrame.new(0, -0.6, 0) or nil
		end,
		Color = pal.Main,
		Color2 = pal.Light,
		MaxRadius = 0.9,
		Duration = windup,
		Rings = 2,
	})
	task.delay(windup, function()
		charge:Release(root and root.CFrame.LookVector)
	end)
	VFXLib.sound(sounds.ChargeLoop, root, 0.35, 1.8)
end

function vibrationHit(character, root, data)
	local pos = data.Position
	local look = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
	local facing = CFrame.lookAt(pos, pos + look)
	-- 1. contact: flash + starburst + a spinning golden spiral pressed into the air
	VFXLib.flash(pos, pal.Light, 6, 20, 0.25)
	TuskVFX.CreateImpactStar(pos, { Size = data.Hit and 6 or 3.5, Rays = 9, Color = pal.Main, Color2 = pal.Light, Duration = 0.3 })
	spiral(facing, data.Hit and 3.2 or 2.2, 0.45)
	if data.Hit then
		goldenRectangle(facing * CFrame.new(0, 0, -0.4), 2.4, 0.5)
	end
	-- 2. vibration: jittering zigzag lines + layered ripples pushed forward
	vibrationLines(facing, VFXQuality.get().RingSegments > 12 and 10 or 6, data.Hit and 7 or 4.5, 0.4)
	local axis = facing * CFrame.Angles(math.pi / 2, 0, 0)
	for i = 1, 4 do
		task.delay(i * 0.05, function()
			TuskVFX.CreateRotationalShockwave(axis * CFrame.new(0, -i * 0.9, 0), { Radius = 1.5 + i * 1.3, Layers = 1, Color = i % 2 == 1 and pal.Light or pal.Main, Color2 = pal.Main, Particles = i == 1 and 0.6 or 0, Width = 0.22, Duration = 0.28, Spin = (i % 2 == 1 and 7 or -7) })
		end)
	end
	TuskVFX.CreateDistortion(pos, { Radius = data.Hit and 4 or 2.5, Duration = 0.3 })
	-- 3. on hit: the ground trembles under the target
	if data.Hit then
		TuskVFX.CreateGroundCracks(pos, { Radius = 6, Count = 6, Color = pal.Main, Duration = 1.4 })
		VFXLib.burst(pos, { Count = 20, Color = pal.Light, Speed = 26, Lifetime = 0.35, Spread = 60, Direction = look })
	end
	VFXLib.sound(sounds.Hit, pos, 0.7, 0.7)
	VFXLib.sound(sounds.NailImpact, pos, 0.4, 1.4)
	if Common.isLocal(character) then
		CameraFX.shake(data.Hit and 0.55 or 0.25, 0.35)
		if data.Hit then
			CameraFX.fovPunch(6, 0.25)
		end
	end
	CameraFX.shakeAt(pos, 0.35, 40)
end


-- BALL BREAKER (the Stand, from the owner's picture, blocky): a green ribbed
-- figure with long arms and legs, a flat round "lid" head, pink bulbs all
-- over it and gold lightning crackling around it. Rises out of the vortex,
-- sways, then shatters into sparks.
local BB_GREEN = Color3.fromRGB(140, 215, 60)
local BB_DARK = Color3.fromRGB(70, 140, 40)
local BB_PINK = Color3.fromRGB(235, 150, 200)
local BB_GOLD = Color3.fromRGB(255, 220, 70)

local function breakerSpirit(position, duration)
	local quality = VFXQuality.get()
	local bits = {}
	-- Blocky like every Stand: round pieces become stepped "voxel-round" boxes
	-- (a core box plus crossing boxes), discs become stepped plates.
	local function block(size, offset, color, material)
		local p = VFXLib.part({ Material = material or Enum.Material.SmoothPlastic, Color = color, Size = size, Transparency = 0.1 })
		table.insert(bits, { Part = p, Offset = offset, Size = size })
		return p
	end
	local function piece(size, offset, color, shape, material)
		if shape == "Ball" then
			if math.max(size.X, size.Y, size.Z) < 0.7 then
				return block(size * 0.82, offset, color, material)
			end
			local core = block(size * 0.86, offset, color, material)
			block(Vector3.new(size.X, size.Y * 0.62, size.Z * 0.62), offset, color, material)
			block(Vector3.new(size.X * 0.62, size.Y, size.Z * 0.62), offset, color, material)
			block(Vector3.new(size.X * 0.62, size.Y * 0.62, size.Z), offset, color, material)
			return core
		elseif shape == "Cylinder" then
			-- Disc: thickness along X, round face in Y/Z.
			local core = block(Vector3.new(size.X, size.Y * 0.86, size.Z * 0.86), offset, color, material)
			block(Vector3.new(size.X, size.Y, size.Z * 0.62), offset, color, material)
			block(Vector3.new(size.X, size.Y * 0.62, size.Z), offset, color, material)
			return core
		end
		return block(size, offset, color, material)
	end
	local flat = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis -> up
	-- Body: ribbed green torso and hips.
	piece(Vector3.new(3.0, 3.6, 2.0), CFrame.new(0, 6.0, 0), BB_GREEN, "Ball")
	piece(Vector3.new(2.4, 1.6, 1.8), CFrame.new(0, 3.9, 0), BB_GREEN, "Ball")
	for i = 0, (quality.RingSegments > 12 and 4 or 2) do
		piece(Vector3.new(3.05 - i * 0.12, 0.18, 2.05 - i * 0.08), CFrame.new(0, 7.2 - i * 0.6, 0), BB_DARK, "Ball")
	end
	-- Head: short neck, wide flat lid with a raised cap and a second smaller lid.
	piece(Vector3.new(0.5, 1.2, 1.2), CFrame.new(0, 7.85, -0.2) * flat, BB_DARK, "Cylinder")
	piece(Vector3.new(0.35, 3.6, 3.6), CFrame.new(0, 8.25, -0.2) * CFrame.Angles(0.15, 0, 0) * flat, BB_GREEN, "Cylinder")
	piece(Vector3.new(0.9, 1.9, 1.9), CFrame.new(-0.3, 8.75, -0.2) * flat, BB_GREEN, "Cylinder")
	piece(Vector3.new(0.3, 2.2, 2.2), CFrame.new(1.7, 8.6, 0.4) * CFrame.Angles(0.1, 0, -0.2) * flat, BB_GREEN, "Cylinder")
	-- Long arms and legs.
	for _, side in ipairs({ -1, 1 }) do
		piece(Vector3.new(0.9, 2.6, 0.9), CFrame.new(side * 1.9, 6.4, -0.3) * CFrame.Angles(0.3, 0, side * 0.35), BB_GREEN, "Ball")
		piece(Vector3.new(0.75, 2.4, 0.75), CFrame.new(side * 2.6, 4.4, -0.9) * CFrame.Angles(0.6, 0, side * 0.15), BB_GREEN, "Ball")
		piece(Vector3.new(0.6, 0.5, 0.7), CFrame.new(side * 2.8, 3.2, -1.5), BB_PINK, "Ball") -- pink fingertips
		piece(Vector3.new(1.0, 2.6, 1.0), CFrame.new(side * 0.75, 2.4, 0.1) * CFrame.Angles(-0.1, 0, side * 0.1), BB_GREEN, "Ball")
		piece(Vector3.new(0.85, 2.4, 0.85), CFrame.new(side * 0.9, 0.5, 0.3) * CFrame.Angles(0.2, 0, -side * 0.05), BB_GREEN, "Ball")
		piece(Vector3.new(0.8, 0.5, 1.2), CFrame.new(side * 0.95, -0.7, -0.1), BB_PINK, "Ball") -- pink toes
	end
	-- Pink bulbs studded over the body.
	local bulbs = quality.RingSegments > 12 and 14 or 7
	for i = 1, bulbs do
		local a = i * 2.4
		local y = 4.4 + (i % 7) * 0.55
		piece(Vector3.new(0.34, 0.34, 0.34), CFrame.new(math.cos(a) * 1.35, y, math.sin(a) * 0.9 - 0.1), BB_PINK, "Ball")
		piece(Vector3.new(0.08, 0.35, 0.08), CFrame.new(math.cos(a) * 1.35, y - 0.25, math.sin(a) * 0.9 - 0.1), BB_DARK)
	end
	-- Gold lightning: zigzag beams crackling around the figure, re-drawn every frame.
	local carrier = VFXLib.anchor(CFrame.new(position))
	local bolts = {}
	for b = 1, (quality.RingSegments > 12 and 4 or 2) do
		local atts = {}
		for k = 0, 6 do
			local att = Instance.new("Attachment")
			att.Parent = carrier
			atts[k] = att
			if k > 0 then
				local beam = Instance.new("Beam")
				beam.Attachment0 = atts[k - 1]
				beam.Attachment1 = att
				beam.FaceCamera = true
				beam.LightEmission = 1
				beam.LightInfluence = 0
				beam.Segments = 1
				beam.Width0 = 0.3
				beam.Width1 = 0.3
				beam.Color = ColorSequence.new(BB_GOLD, Color3.fromRGB(255, 250, 200))
				beam.Parent = carrier
			end
		end
		bolts[b] = { Atts = atts, Side = (b % 2 == 0) and 1 or -1, Height = 2 + b * 1.6 }
	end
	local light
	if quality.Lights then
		light = Instance.new("PointLight")
		light.Color = BB_GREEN
		light.Range = 30
		light.Brightness = 4
		light.Parent = bits[1].Part
	end
	local sway = 0
	VFXLib.animate(duration, function(a, dt)
		sway = sway + (dt or 0)
		local rise = VFXLib.easeOut(math.min(a / 0.3, 1))
		local base = CFrame.new(position + Vector3.new(0, -4 + rise * 4, 0)) * CFrame.Angles(0, math.sin(sway * 1.3) * 0.4 + a * 1.2, math.sin(sway * 2) * 0.05)
		local fade = a > 0.85 and (a - 0.85) / 0.15 or 0
		for _, b in ipairs(bits) do
			b.Part.CFrame = base * b.Offset
			b.Part.Size = b.Size * (0.4 + rise * 0.6)
			b.Part.Transparency = 0.1 + fade * 0.9
		end
		carrier.CFrame = base
		-- New lightning shape every frame: jagged lines arcing around the body.
		for _, bolt in ipairs(bolts) do
			for k = 0, 6 do
				local t = k / 6
				local angle = bolt.Side * (t * 2.4 - 1.2) + sway * 2
				local r = 3.2 + (k % 2 == 0 and 0.6 or -0.4) + (math.random() - 0.5) * 0.8
				bolt.Atts[k].Position = Vector3.new(math.cos(angle) * r, bolt.Height + t * 3 + (math.random() - 0.5) * 0.8, math.sin(angle) * r) * (0.4 + rise * 0.6)
			end
		end
		for _, beam in ipairs(carrier:GetChildren()) do
			if beam:IsA("Beam") then
				beam.Transparency = NumberSequence.new(math.max(fade, math.random() < 0.15 and 0.8 or 0))
			end
		end
	end, function()
		-- Shatter: every piece bursts into sparks.
		for i, b in ipairs(bits) do
			if i % 6 == 1 then
				VFXLib.burst(b.Part.Position, { Count = 5, Color = i % 12 == 1 and BB_GREEN or BB_PINK, Speed = 30, Lifetime = 0.5 })
			end
			b.Part:Destroy()
		end
		VFXLib.burst(position + Vector3.new(0, 5, 0), { Count = 20, Color = BB_GOLD, Speed = 40, Lifetime = 0.4 })
		carrier:Destroy()
	end)
end


local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Start" and root then
		TuskAnimation.play(character, "GyroBreakerCharge")
		VFXLib.sound(sounds.AwakeningBuild, root, 0.9, 0.9)
		local entry = held[character]
		if entry then
			entry.Spin = 60
		end
		goldenRectangle(root.CFrame * CFrame.new(0, 2.2, -3.5), 3.2, data.Windup + 0.2)
		-- Three rings spin up around the held ball.
		for i = 1, 3 do
			TuskVFX.CreateSpinRing({
				Follow = function()
					local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
					return hand and hand.Parent and hand.CFrame * CFrame.new(0, -0.6, -0.2) or nil
				end,
				Tilt = CFrame.Angles(0.7 * i, 0, 0.5 * i),
				Radius = 0.9 + i * 0.35,
				Width = 0.1,
				Color = i % 2 == 1 and pal.Light or pal.Main,
				RotationSpeed = 6 + i * 3,
				Duration = data.Windup + 0.2,
			})
		end
		VFXLib.burst(root.Position - Vector3.new(0, 2.5, 0), { Count = 30, Color = pal.Light, Speed = 12, Spread = 25, Direction = Vector3.new(0, 1, 0), Lifetime = 1 })
		TuskVFX.CreateMagicCircle(CFrame.new(root.Position - Vector3.new(0, 2.9, 0)), { Radius = 8, Color = pal.Main, Color2 = pal.Light, Duration = data.Windup + 0.3, RotationSpeed = 2, Points = 5 })
		local charge = TuskVFX.CreateEnergyCharge({
			Follow = function()
				return root.Parent and root.CFrame * CFrame.new(0.9, 0.8, -1.8) or nil
			end,
			Color = pal.Main,
			Color2 = pal.Light,
			MaxRadius = 1.6,
			Duration = data.Windup,
			Rings = 3,
		})
		task.delay(data.Windup, function()
			charge:Release()
		end)
		if Common.isLocal(character) then
			CameraFX.setFovHold(-10)
		end
	elseif data.Phase == "Release" then
		local entry = character and held[character]
		if entry then
			entry.Spin = 8
		end
		if character then
			TuskAnimation.play(character, "GyroThrow")
		end
		VFXLib.flash(data.Position, pal.Light, 10, 40, 0.5)
		if Common.isLocal(character) then
			CameraFX.setFovHold(0)
			CameraFX.fovPunch(16, 0.6)
			CameraFX.speedLines(0.45, pal.Light)
		end
	elseif data.Phase == "Vortex" then
		local pos = data.Position
		local ground = CFrame.new(pos - Vector3.new(0, 1, 0))
		for i = 1, 3 do
			TuskVFX.CreateSpinRing({ CFrame = ground * CFrame.new(0, i * 1.6, 0), Tilt = CFrame.Angles(0.15 * i, 0, 0), Radius = data.Radius * (1.05 - i * 0.2), Width = 0.4, Color = i % 2 == 1 and pal.Main or pal.Light, RotationSpeed = (5 + i * 2) * (i % 2 == 0 and -1 or 1), Duration = data.Duration })
		end
		TuskVFX.CreateMagicCircle(ground, { Radius = data.Radius, Color = pal.Main, Color2 = pal.Light, Duration = data.Duration, RotationSpeed = 3, Points = 6 })
		local vortexCore = TuskVFX.CreateEnergyCharge({ CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)), Color = pal.Main, Color2 = pal.Light, MaxRadius = 3, Duration = data.Duration, Rings = 3 })
		task.delay(data.Duration, function()
			vortexCore:Release()
		end)
		spiral(CFrame.new(pos + Vector3.new(0, 0.5, 0)) * CFrame.Angles(-math.pi / 2, 0, 0), data.Radius * 0.8, data.Duration)
		VFXLib.sound(sounds.ChargeLoop, pos, 0.8, 0.6)
		breakerSpirit(pos, data.Duration)
		-- Rings that shrink inward show the pull.
		local pulses = math.floor(data.Duration / 0.4)
		for i = 0, pulses - 1 do
			task.delay(i * 0.4, function()
				local ring = VFXLib.ring({ CFrame = ground * CFrame.new(0, 0.3, 0), Radius = data.Radius * 1.3, Width = 0.3, Color = pal.Light, Transparency = 0.2 })
				VFXLib.animate(0.4, function(a)
					ring:SetRadius(data.Radius * 1.3 * (1 - a * 0.85))
					ring:SetTransparency(0.2 + a * 0.8)
				end, function()
					ring:Destroy()
				end)
			end)
		end
		-- Dust swirling in.
		local swirl = VFXLib.anchor(CFrame.new(pos), data.Duration + 1)
		swirl.Shape = Enum.PartType.Ball
		swirl.Size = Vector3.new(data.Radius * 2.4, data.Radius * 2.4, data.Radius * 2.4)
		local dust = Instance.new("ParticleEmitter")
		dust.Texture = VFXLib.Textures.Smoke
		dust.Shape = Enum.ParticleEmitterShape.Sphere
		dust.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		dust.Color = ColorSequence.new(Color3.fromRGB(205, 185, 140))
		dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 1) })
		dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.6), NumberSequenceKeypoint.new(1, 1) })
		dust.Lifetime = NumberRange.new(0.6, 0.8)
		dust.Speed = NumberRange.new(data.Radius * 1.8, data.Radius * 2.2)
		dust.RotSpeed = NumberRange.new(200, 300)
		dust.Rate = 25 * VFXQuality.get().Particles
		dust.Parent = swirl
		task.delay(data.Duration, function()
			dust.Enabled = false
		end)
	elseif data.Phase == "Burst" then
		local pos = data.Position
		TuskVFX.CreateRotationalShockwave(CFrame.new(pos - Vector3.new(0, 1, 0)), { Radius = data.Radius * 1.6, Layers = 4, Color = pal.Main, Color2 = pal.Light, Ground = true, Particles = 3, Width = 1, Duration = 0.7 })
		TuskVFX.CreateDistortion(pos, { Radius = 10, Duration = 0.5 })
		TuskVFX.CreateRotationalShockwave(CFrame.new(pos + Vector3.new(0, 5, 0)) * CFrame.Angles(math.pi / 2, 0, 0), { Radius = data.Radius, Layers = 2, Color = pal.Light, Color2 = pal.Main, Particles = 0, Width = 0.6 })
		TuskVFX.CreateEnergyPillar(pos - Vector3.new(0, 2, 0), { Radius = data.Radius * 0.8, Height = 70, Color = pal.Light, Color2 = pal.Main, Duration = 0.7 })
		TuskVFX.CreateGroundCracks(pos, { Radius = data.Radius * 1.2, Color = pal.Main, Duration = 2.2 })
		TuskVFX.CreateImpactStar(pos + Vector3.new(0, 1.5, 0), { Size = 16, Rays = 12, Color = pal.Main, Color2 = pal.Light, Duration = 0.45, Width = 1.8 })
		VFXLib.burst(pos, { Count = 60, Color = pal.Light, Speed = 55, Lifetime = 0.7 })
		VFXLib.flash(pos, pal.Light, 14, 60, 0.7)
		VFXLib.sound(sounds.AwakeningBurst, pos, 1, 0.8)
		CameraFX.shakeAt(pos, 1.5, 110)
		local camera = workspace.CurrentCamera
		if Common.isLocal(character) or (camera and (camera.CFrame.Position - pos).Magnitude < 60) then
			CameraFX.impactFrame(pal.Light)
			CameraFX.speedLines(0.35, pal.Light)
		end
	end
end

---------------------------------------------------------------------------
-- SPIN TORNADO visual: a funnel of spinning rings that follows the server's
-- position updates, with a ground swirl, dust and green sparkles.
---------------------------------------------------------------------------
local tornadoes = {}

local function startTornado(data)
	local r = data.Radius
	local t = { Pos = data.Position, Target = data.Position, Rings = {}, Angle = 0, Radius = r }
	local layers = VFXQuality.get().RingSegments > 12 and 7 or 4
	for i = 1, layers do
		local k = (i - 1) / (layers - 1)
		t.Rings[i] = {
			Ring = VFXLib.ring({ Radius = r * (0.25 + k * 0.75), Width = 0.3 + k * 0.25, Color = (i % 2 == 0) and pal.Light or pal.Main, Transparency = 0.1 + k * 0.3 }),
			Height = -2.5 + k * 11,
			Speed = (9 - k * 4) * (i % 2 == 0 and -1 or 1),
			Tilt = (math.random() - 0.5) * 0.3,
		}
	end
	-- Swirling dust + sparkles on a carrier that moves with the tornado.
	local carrier = VFXLib.anchor(CFrame.new(data.Position))
	carrier.Size = Vector3.new(r * 1.2, 10, r * 1.2)
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = VFXLib.Textures.Smoke
	dust.Color = ColorSequence.new(Color3.fromRGB(205, 180, 135))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 5) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.6, 1.1)
	dust.Speed = NumberRange.new(6, 10)
	dust.RotSpeed = NumberRange.new(250, 400)
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Shape = Enum.ParticleEmitterShape.Cylinder
	dust.Rate = 30 * VFXQuality.get().Particles
	dust.Parent = carrier
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = VFXLib.Textures.Sparkle
	sparks.Color = ColorSequence.new(pal.Light, pal.Main)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparks.Lifetime = NumberRange.new(0.4, 0.7)
	sparks.Speed = NumberRange.new(8, 14)
	sparks.EmissionDirection = Enum.NormalId.Top
	sparks.Shape = Enum.ParticleEmitterShape.Cylinder
	sparks.Rate = 40 * VFXQuality.get().Particles
	sparks.Parent = carrier
	t.Carrier = carrier
	local high = VFXQuality.get().RingSegments > 12
	-- Spiral strands of light winding up the funnel (rotated every frame).
	local helix = VFXLib.anchor(CFrame.new(data.Position))
	local strands = high and 3 or 2
	local points = high and 14 or 8
	for sIdx = 1, strands do
		local prev
		for i = 0, points do
			local k = i / points
			local th = k * math.pi * 3 + (sIdx - 1) / strands * math.pi * 2
			local rad = r * (0.2 + k * 0.85)
			local a = Instance.new("Attachment")
			a.Position = Vector3.new(math.cos(th) * rad, -2.5 + k * 12, math.sin(th) * rad)
			a.Parent = helix
			if prev then
				local b = Instance.new("Beam")
				b.Attachment0 = prev
				b.Attachment1 = a
				b.FaceCamera = true
				b.LightEmission = 1
				b.LightInfluence = 0
				b.Segments = 1
				b.Width0 = 0.35 + k * 0.3
				b.Width1 = 0.35 + k * 0.3
				b.Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(pal.Main, k))
				b.Transparency = NumberSequence.new(0.15 + k * 0.45)
				b.Parent = helix
			end
			prev = a
		end
	end
	t.Helix = helix
	-- See-through wind body: stacked force-field rings of air.
	t.Body = {}
	for i = 1, (high and 3 or 2) do
		local k = (i - 1) / 2
		local d = r * (0.6 + k * 1.1)
		t.Body[i] = {
			Part = VFXLib.part({ Shape = Enum.PartType.Cylinder, Material = Enum.Material.ForceField, Color = i == 2 and pal.Light or pal.Main, Transparency = 0.15, Size = Vector3.new(4, d, d) }),
			Height = -1 + k * 8,
			Speed = (i % 2 == 0) and -7 or 9,
		}
	end
	-- Ground swirl: a flat ring of churned dust at the base.
	t.Ground = VFXLib.ring({ Radius = r * 1.3, Width = 0.5, Color = Color3.fromRGB(225, 205, 160), Transparency = 0.35, LightEmission = 0.2 })
	-- Debris sucked up the funnel: rocks and planks that orbit and rise.
	t.Debris = {}
	local debrisCount = high and 8 or 4
	for i = 1, debrisCount do
		local isPlank = i % 3 == 0
		t.Debris[i] = {
			Part = VFXLib.part({ Material = isPlank and Enum.Material.Wood or Enum.Material.Sandstone, Color = isPlank and Color3.fromRGB(120, 84, 52) or Color3.fromRGB(180, 150, 110), Size = isPlank and Vector3.new(0.3, 0.3, 1.6) or Vector3.new(0.7, 0.6, 0.7), CastShadow = true }),
			Phase = i / debrisCount * math.pi * 2,
			Rise = math.random(),
			Speed = 0.35 + math.random() * 0.3,
		}
	end
	t.NextBolt = os.clock() + 0.2
	t.Sound = VFXLib.sound(sounds.ChargeLoop, carrier, 0.6, 0.6, true)
	t.Expire = os.clock() + data.Duration + 1
	tornadoes[data.Id] = t
	VFXLib.burst(data.Position, { Count = 24, Color = pal.Light, Speed = 22, Lifetime = 0.45 })
	TuskVFX.CreateRotationalShockwave(CFrame.new(data.Position - Vector3.new(0, 2.5, 0)), { Radius = r * 1.6, Layers = 2, Color = pal.Light, Color2 = pal.Main, Ground = true, Particles = 0.5, Width = 0.4, Duration = 0.4 })
end

local function endTornado(data)
	local t = tornadoes[data.Id]
	if t then
		tornadoes[data.Id] = nil
		for _, layer in ipairs(t.Rings) do
			layer.Ring:Destroy()
		end
		if t.Sound then
			t.Sound:Destroy()
		end
		t.Carrier:Destroy()
		t.Helix:Destroy()
		t.Ground:Destroy()
		for _, b in ipairs(t.Body) do
			b.Part:Destroy()
		end
		-- Debris is flung outward when the tornado bursts.
		for _, d in ipairs(t.Debris) do
			local part = d.Part
			local from = part.Position
			local out = Vector3.new(from.X - t.Pos.X, 0, from.Z - t.Pos.Z)
			out = (out.Magnitude > 0.01 and out.Unit or Vector3.new(1, 0, 0)) * (18 + math.random() * 10) + Vector3.new(0, 12, 0)
			local spin = Vector3.new(math.random() * 10, math.random() * 10, math.random() * 10)
			VFXLib.animate(0.9, function(a)
				local p = from + out * a + Vector3.new(0, -30 * a * a, 0)
				part.CFrame = CFrame.new(p) * CFrame.Angles(spin.X * a, spin.Y * a, spin.Z * a)
				part.Transparency = math.max(0, (a - 0.6) / 0.4)
			end, function()
				part:Destroy()
			end)
		end
	end
	local pos = data.Position
	TuskVFX.CreateRotationalShockwave(CFrame.new(pos - Vector3.new(0, 2.5, 0)), { Radius = data.Radius * 1.6, Layers = 3, Color = pal.Main, Color2 = pal.Light, Ground = true, Particles = 2, Width = 0.7 })
	VFXLib.burst(pos, { Count = 30, Color = pal.Light, Speed = 40, Lifetime = 0.5 })
	TuskVFX.CreateImpactStar(pos, { Size = 9, Rays = 10, Color = pal.Main, Color2 = pal.Light, Duration = 0.35, Width = 1 })
	TuskVFX.CreateEnergyPillar(pos - Vector3.new(0, 2.5, 0), { Radius = data.Radius * 0.9, Height = 35, Color = pal.Light, Color2 = pal.Main, Duration = 0.5 })
	TuskVFX.CreateGroundCracks(pos, { Radius = data.Radius * 1.4, Color = pal.Main, Duration = 1.6 })
	VFXLib.flash(pos, pal.Light, 8, 30, 0.4)
	VFXLib.sound(sounds.Finisher, pos, 0.8, 0.9)
	CameraFX.shakeAt(pos, 0.8, 70)
end

local function stepTornadoes(dt)
	local now = os.clock()
	for id, t in pairs(tornadoes) do
		t.Pos = t.Pos:Lerp(t.Target, math.min(1, dt * 10))
		t.Angle = t.Angle + dt
		for _, layer in ipairs(t.Rings) do
			local sway = math.sin(now * 3 + layer.Height) * 0.6
			layer.Ring:SetCFrame(CFrame.new(t.Pos + Vector3.new(sway, layer.Height, 0)) * CFrame.Angles(layer.Tilt, t.Angle * layer.Speed, 0))
		end
		t.Carrier.CFrame = CFrame.new(t.Pos + Vector3.new(0, 2, 0))
		t.Helix.CFrame = CFrame.new(t.Pos) * CFrame.Angles(0, -t.Angle * 7, 0)
		t.Ground:SetCFrame(CFrame.new(t.Pos - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, t.Angle * 5, 0))
		for _, b in ipairs(t.Body) do
			-- Upright cylinder (axis X -> world up), spun around its axis for a shimmer.
			b.Part.CFrame = CFrame.new(t.Pos + Vector3.new(0, b.Height, 0)) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(t.Angle * b.Speed, 0, 0)
		end
		for _, d in ipairs(t.Debris) do
			d.Rise = (d.Rise + dt * d.Speed) % 1
			local th = d.Phase + t.Angle * (8 - d.Rise * 3)
			local rad = t.Radius * (0.3 + d.Rise * 0.8)
			d.Part.CFrame = CFrame.new(t.Pos + Vector3.new(math.cos(th) * rad, -2 + d.Rise * 11, math.sin(th) * rad)) * CFrame.Angles(th * 2, th, 0)
		end
		-- Green Spin sparks crackling inside the funnel.
		if now >= t.NextBolt then
			t.NextBolt = now + 0.18 + math.random() * 0.2
			local th = math.random() * math.pi * 2
			local p = t.Pos + Vector3.new(math.cos(th) * t.Radius * 0.5, math.random() * 8 - 1, math.sin(th) * t.Radius * 0.5)
			TuskVFX.CreateImpactStar(p, { Size = 2, Rays = 4, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Duration = 0.15 })
		end
		if now > t.Expire then
			endTornado({ Id = id, Position = t.Pos, Radius = t.Radius })
		end
	end
end

function Gyro.handle(name, data)
	if name == "Tornado" then
		if data.Phase == "Start" then
			startTornado(data)
		elseif data.Phase == "Move" then
			local t = tornadoes[data.Id]
			if t then
				t.Target = data.Position
			end
		elseif data.Phase == "Burst" then
			endTornado(data)
		end
		return
	end
	if name == "M1" then
		Common.m1(data, pal, { AnimPrefix = "G_M1_" })
	elseif name == "M1Finisher" then
		Common.finisher(data, pal)
		local entry = data.Character and held[data.Character]
		if entry then
			entry.Spin = 50
			task.delay(0.4, function()
				entry.Spin = 8
			end)
		end
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local shakeTimer = 0
function Gyro.step(dt)
	dt = dt or 1 / 60
	updateHeld(dt)
	stepBalls(dt)
	stepTornadoes(dt)
	shakeTimer = shakeTimer + dt
	if shakeTimer > 0.25 then
		shakeTimer = 0
		updateShakes()
	end
end

-- Ball projectiles come through the shared SpinFX channel.
Net.get("SpinFX").OnClientEvent:Connect(function(name, data)
	if typeof(data) ~= "table" or data.Kind ~= "GyroBall" then
		return
	end
	if name == "ProjectileSpawn" then
		spawnBall(data)
	elseif name == "ProjectileEnd" then
		endBall(data)
	end
end)

return Gyro
end

-- ======================================================================
-- MODULE: SteelBallModel
-- ======================================================================
__modules["SteelBallModel"] = function()
--[[
	SteelBallModel  (ReplicatedStorage.SpinShared.SteelBallModel)

	Procedurally builds the Steel Ball from the owner's reference images:
	a glossy green metal sphere with raised hexagon panels (dark outer edge
	plus a bright inner edge, so they read as raised plates), round
	panels, and curved parallel grooves sweeping around the surface.

	SteelBallModel.build(diameter, detailed) -> Model (PrimaryPart = "Core")
	  detailed = false (Low quality) keeps only the hexagon outer edges.

	All parts are visual only: no collision, no queries, no touch events,
	massless, and welded to the Core. Anchor the Core to move it with
	PivotTo, or weld the Core to a hand.

	Swapping in a real mesh later: put a Model named "SteelBall" (with a
	PrimaryPart) in ReplicatedStorage.SpinShared.Assets and build() will
	clone and resize it instead of generating one.
]]

local SpinConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("SpinConfig"))

local SteelBallModel = {}

-- Panel layout (unit directions on the ball, angular radius in radians).
-- Kept as data so the look can be tuned without touching the builder.
SteelBallModel.Layout = {
	Hexagons = {
		{ Dir = Vector3.new(-0.45, 0.35, 0.82), Radius = 0.55, Spin = 0.2 },
		{ Dir = Vector3.new(0.6, -0.2, -0.77), Radius = 0.5, Spin = 0.5 },
		{ Dir = Vector3.new(-0.3, -0.85, -0.4), Radius = 0.45, Spin = 0.0 },
	},
	Circles = {
		{ Dir = Vector3.new(0.45, -0.4, 0.8), Radius = 0.3 },
		{ Dir = Vector3.new(0.2, 0.85, -0.45), Radius = 0.35 },
	},
	-- Grooves: arcs of a circle around Axis at angular radius Radius,
	-- from angle From to To (radians).
	Grooves = {
		{ Axis = Vector3.new(0.95, 0.25, 0.15), Radius = 0.5, From = -1.2, To = 1.3 },
		{ Axis = Vector3.new(0.95, 0.25, 0.15), Radius = 0.78, From = -1.0, To = 1.1 },
		{ Axis = Vector3.new(-0.75, 0.15, -0.6), Radius = 0.6, From = 0.6, To = 3.2 },
	},
}

local function visualPart(props)
	local p = Instance.new("Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

local function weld(core, part)
	local w = Instance.new("WeldConstraint")
	w.Part0 = core
	w.Part1 = part
	w.Parent = part
end

-- Two unit vectors perpendicular to dir.
local function basis(dir)
	local helper = math.abs(dir.Y) > 0.9 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local u = dir:Cross(helper).Unit
	local v = dir:Cross(u).Unit
	return u, v
end

-- Point on the unit sphere at angular distance `radius` from `center`, around angle `theta`.
local function around(center, radius, theta)
	local u, v = basis(center)
	return (center * math.cos(radius) + (u * math.cos(theta) + v * math.sin(theta)) * math.sin(radius)).Unit
end

local function fromOverride(diameter)
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("SpinAssets")
	local custom = assets and assets:FindFirstChild("SteelBall")
	if custom and custom:IsA("Model") and custom.PrimaryPart then
		local clone = custom:Clone()
		local size = clone:GetExtentsSize()
		local largest = math.max(size.X, size.Y, size.Z)
		if largest > 0 then
			clone:ScaleTo(clone:GetScale() * diameter / largest)
		end
		clone.PrimaryPart.Name = "Core"
		return clone
	end
	return nil
end

function SteelBallModel.build(diameter, detailed)
	diameter = diameter or 1
	if detailed == nil then
		detailed = true
	end

	local override = fromOverride(diameter)
	if override then
		return override
	end

	local colors = SpinConfig.Colors
	local r = diameter / 2

	local model = Instance.new("Model")
	model.Name = "SteelBall"

	local core = visualPart({
		Name = "Core",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		Color = colors.Ball,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.18,
		Massless = false,
	})
	core.CFrame = CFrame.new()
	core.Parent = model
	model.PrimaryPart = core

	-- Attachments other systems hook effects onto.
	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = core
	local top = Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, r * 0.9, 0)
	top.Parent = core
	local bottom = Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -r * 0.9, 0)
	bottom.Parent = core

	-- One straight raised line between two directions on the surface.
	local function line(a, b, width, color, name)
		local lift = r * 1.012
		local pa, pb = a * lift, b * lift
		local mid = (pa + pb) / 2
		local seg = visualPart({
			Name = name,
			Size = Vector3.new(width, width * 0.5, (pb - pa).Magnitude + width * 0.6),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Reflectance = 0.1,
		})
		seg.CFrame = CFrame.lookAt(mid, pb, mid.Unit)
		seg.Parent = model
		weld(core, seg)
	end

	local function polygon(dirCenter, radius, sides, spin, width, color, name)
		local c = dirCenter.Unit
		for i = 0, sides - 1 do
			local a = around(c, radius, spin + i / sides * math.pi * 2)
			local b = around(c, radius, spin + (i + 1) / sides * math.pi * 2)
			line(a, b, width, color, name)
		end
	end

	local layout = SteelBallModel.Layout

	-- Hexagon plates: dark outer edge, bright inner edge.
	for _, hex in ipairs(layout.Hexagons) do
		polygon(hex.Dir, hex.Radius, 6, hex.Spin, diameter * 0.04, colors.BallDark, "HexEdge")
		if detailed then
			polygon(hex.Dir, hex.Radius * 0.84, 6, hex.Spin, diameter * 0.025, colors.BallLight, "HexHighlight")
		end
	end

	if detailed then
		-- Round panels.
		for _, circle in ipairs(layout.Circles) do
			polygon(circle.Dir, circle.Radius, 10, 0, diameter * 0.035, colors.BallDark, "RoundPanel")
		end
		-- Curved grooves.
		for _, groove in ipairs(layout.Grooves) do
			local axis = groove.Axis.Unit
			local steps = 6
			for i = 0, steps - 1 do
				local t0 = groove.From + (groove.To - groove.From) * i / steps
				local t1 = groove.From + (groove.To - groove.From) * (i + 1) / steps
				line(around(axis, groove.Radius, t0), around(axis, groove.Radius, t1), diameter * 0.03, colors.BallDark, "Groove")
			end
		end
	end

	return model
end

return SteelBallModel
end

-- ======================================================================
-- MODULE: WreckingBallModel
-- ======================================================================
__modules["WreckingBallModel"] = function()
--[[
	WreckingBallModel  (ReplicatedStorage.SpinShared.WreckingBallModel)

	Procedurally builds a Wrecking Ball from the owner's reference image:
	a glossy orange metal sphere, ten raised gold studs sitting in darker
	gold collars, and a dark seam groove wrapping around the surface.
	Not used yet: kept for the Wrecking Ball phase.

	WreckingBallModel.build(diameter, withGrooves) -> Model (PrimaryPart = "Core")

	All parts are visual only: no collision, no queries, no touch events,
	massless, and welded to the Core. Anchor the Core to move it with
	PivotTo, or weld the Core to a hand.

	Swapping in a real mesh later: put a Model named "WreckingBall" (with a
	PrimaryPart) in ReplicatedStorage.SpinShared.Assets and build() will
	clone it instead of generating one.
]]

local WreckingBallModel = {}

WreckingBallModel.Colors = {
	Ball = Color3.fromRGB(226, 96, 24),
	BallDark = Color3.fromRGB(150, 52, 12),
	Stud = Color3.fromRGB(255, 205, 70),
}

local GOLDEN_ANGLE = math.pi * (3 - math.sqrt(5))
local STUD_COUNT = 10
local SEAM_SEGMENTS = 22

local function visualPart(props)
	local p = Instance.new("Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

local function weld(core, part)
	local w = Instance.new("WeldConstraint")
	w.Part0 = core
	w.Part1 = part
	w.Parent = part
end

local function fromOverride(diameter)
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("SpinAssets")
	local custom = assets and assets:FindFirstChild("WreckingBall")
	if custom and custom:IsA("Model") and custom.PrimaryPart then
		local clone = custom:Clone()
		local size = clone:GetExtentsSize()
		local largest = math.max(size.X, size.Y, size.Z)
		if largest > 0 then
			clone:ScaleTo(clone:GetScale() * diameter / largest)
		end
		clone.PrimaryPart.Name = "Core"
		return clone
	end
	return nil
end

function WreckingBallModel.build(diameter, withGrooves)
	diameter = diameter or 1
	if withGrooves == nil then
		withGrooves = true
	end

	local override = fromOverride(diameter)
	if override then
		return override
	end

	local colors = WreckingBallModel.Colors
	local r = diameter / 2

	local model = Instance.new("Model")
	model.Name = "WreckingBall"

	local core = visualPart({
		Name = "Core",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		Color = colors.Ball,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.2,
		Massless = false,
	})
	core.CFrame = CFrame.new()
	core.Parent = model
	model.PrimaryPart = core

	-- Attachments other systems hook effects onto.
	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = core
	local top = Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, r * 0.9, 0)
	top.Parent = core
	local bottom = Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -r * 0.9, 0)
	bottom.Parent = core

	-- Gold studs on a Fibonacci sphere so they spread evenly.
	for i = 0, STUD_COUNT - 1 do
		local y = 1 - (i + 0.5) / STUD_COUNT * 2
		local ring = math.sqrt(1 - y * y)
		local theta = i * GOLDEN_ANGLE
		local dir = Vector3.new(math.cos(theta) * ring, y, math.sin(theta) * ring)
		local up = math.abs(dir.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)

		local collar = visualPart({
			Name = "StudCollar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(diameter * 0.05, diameter * 0.2, diameter * 0.2),
			Color = colors.BallDark:Lerp(colors.Stud, 0.35),
			Material = Enum.Material.Metal,
			Reflectance = 0.1,
		})
		-- Cylinder axis is X, so point RightVector along the surface normal.
		local right = dir
		local back = right:Cross(up).Unit
		local realUp = back:Cross(right).Unit
		collar.CFrame = CFrame.fromMatrix(dir * r * 0.985, right, realUp)
		collar.Parent = model
		weld(core, collar)

		local stud = visualPart({
			Name = "Stud",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(diameter * 0.15, diameter * 0.15, diameter * 0.15),
			Color = colors.Stud,
			Material = Enum.Material.Metal,
			Reflectance = 0.35,
		})
		stud.CFrame = CFrame.new(dir * r * 1.01)
		stud.Parent = model
		weld(core, stud)
	end

	-- Seam groove: a wave wrapping the ball like a tennis-ball seam.
	if withGrooves then
		local function seamPoint(t)
			local lon = t * math.pi * 2
			local lat = 0.55 * math.sin(2 * lon)
			return Vector3.new(math.cos(lat) * math.cos(lon), math.sin(lat), math.cos(lat) * math.sin(lon)) * r * 1.003
		end
		for i = 0, SEAM_SEGMENTS - 1 do
			local a = seamPoint(i / SEAM_SEGMENTS)
			local b = seamPoint((i + 1) / SEAM_SEGMENTS)
			local mid = (a + b) / 2
			local len = (b - a).Magnitude
			local seg = visualPart({
				Name = "Groove",
				Size = Vector3.new(diameter * 0.035, diameter * 0.012, len * 1.08),
				Color = colors.BallDark,
				Material = Enum.Material.SmoothPlastic,
			})
			seg.CFrame = CFrame.lookAt(mid, b, mid.Unit)
			seg.Parent = model
			weld(core, seg)
		end
	end

	-- Everything was laid out around the origin; move the model as one piece from here on.
	return model
end

return WreckingBallModel
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">HotPants_Client</string><ProtectedString name="Source"><![CDATA[--[[
	HotPants_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Hot Pants: Cream Starter.
	Its other half is HotPants_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: HotPantsVFX
-- ======================================================================
__modules["HotPantsVFX"] = function()
--[[
	TuskActVFX.HotPantsVFX  (StarterPlayerScripts.SpinClient.TuskActVFX.HotPantsVFX)

	Client visuals for Hot Pants / CREAM STARTER, a spray can that sprays
	flesh. Blocky like the rest of the game.
	  * the CREAM STARTER can appears in her hand whenever she uses it
	  * FLESH SPRAY: a pink mist stream with flesh blobs; coated enemies have
	    lumps of flesh stuck all over them while it lasts
	  * FLESH SEAL: a flesh mask over the victim's mouth and nose, "MMPH!",
	    and a pink haze for the victim while they suffocate
	  * FLESH MEND: she sprays herself; mist swirls round her and "+5" heals pop up
	  * FLESH STORM: a flesh cloud swells in front of her, hardens into a
	    cocoon round everyone caught, then bursts into chunks
]]

local Players = game:GetService("Players")

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")
local Fighters = __require("Fighters")

local HotPantsVFX = {}
local ACT = 10
local pal = Common.palette(ACT)
local sounds = TuskConfig.Sounds
local localPlayer = Players.LocalPlayer

local FLESH = Color3.fromRGB(236, 160, 150)
local FLESH_DARK = Color3.fromRGB(196, 110, 110)
local CAN = Color3.fromRGB(242, 140, 172)
local CAP = Color3.fromRGB(245, 245, 245)
local LABEL = Color3.fromRGB(255, 225, 120)

local held = {} -- [character] = { Model, Until }
local coats = {} -- [model] = flesh lumps stuck on a coated enemy
local masks = {} -- [model] = flesh mask over a sealed face
local cocoons = {} -- [model] = Flesh Storm cocoon
local stanced = {}

---------------------------------------------------------------------------
-- CREAM STARTER: the spray can
---------------------------------------------------------------------------
local function box(model, size, cf, color, material, transparency)
	local p = VFXLib.part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, Transparency = transparency or 0 })
	p.Parent = model
	return p
end

local function buildCan(scale)
	local s = scale or 1
	local m = Instance.new("Model")
	m.Name = "CreamStarter"
	m.Parent = VFXLib.Folder
	-- Stepped round body (blocky), label band, white cap, nozzle.
	-- The can's up is +Y; the nozzle points along -Z.
	local body = box(m, Vector3.new(0.5, 1.0, 0.5) * s, CFrame.new(), CAN, Enum.Material.Metal)
	box(m, Vector3.new(0.58, 0.92, 0.38) * s, CFrame.new(), CAN, Enum.Material.Metal)
	box(m, Vector3.new(0.38, 0.92, 0.58) * s, CFrame.new(), CAN, Enum.Material.Metal)
	box(m, Vector3.new(0.6, 0.3, 0.6) * s, CFrame.new(0, 0.05 * s, 0), LABEL)
	box(m, Vector3.new(0.4, 0.26, 0.4) * s, CFrame.new(0, 0.62 * s, 0), CAP)
	local nozzle = box(m, Vector3.new(0.14, 0.12, 0.22) * s, CFrame.new(0, 0.8 * s, -0.12 * s), Color3.fromRGB(60, 60, 66))
	nozzle.Name = "Nozzle"
	m.PrimaryPart = body
	return m, nozzle
end

local function handOf(character)
	return character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
end

-- Where the can sits in her fist: upright against the hand, nozzle pointing
-- down the arm (so when she aims her arm, she aims the spray).
local function canCF(hand)
	local down = hand.Name == "Right Arm" and -hand.Size.Y / 2 + 0.25 or -0.2
	return hand.CFrame * CFrame.new(0, down, -0.18) * CFrame.Angles(-math.pi / 2, 0, 0)
end

-- The spray comes out of the real nozzle; aimed where she faces.
local function nozzleCF(character)
	local root = Common.rootOf(character)
	if not root then
		return nil
	end
	local entry = held[character]
	local pos
	if entry and entry.Nozzle and entry.Nozzle.Parent then
		pos = entry.Nozzle.Position
	else
		local hand = handOf(character)
		pos = hand and hand.Position or (root.CFrame * CFrame.new(1, 0.5, -1)).Position
	end
	return CFrame.lookAt(pos, pos + root.CFrame.LookVector)
end

-- Spray direction: follows the nozzle as her arm sweeps, leaning toward
-- where the move was aimed (so the mist matches the hitbox).
local function sprayDir(character, aimed)
	local entry = held[character]
	local fallback = aimed or Vector3.new(0, 0, -1)
	if not (entry and entry.Nozzle and entry.Nozzle.Parent) then
		return fallback
	end
	local n = entry.Nozzle.CFrame.LookVector
	n = Vector3.new(n.X, n.Y * 0.3, n.Z)
	if n.Magnitude < 0.1 then
		return fallback
	end
	return (fallback * 0.55 + n.Unit * 0.45).Unit
end

-- Every Hot Pants (players and NPCs) holds Cream Starter all the time.
local function stepCans()
	local seen = {}
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		if character and character:GetAttribute("TuskAct") == ACT then
			local hand = handOf(character)
			if hand then
				seen[character] = true
				local entry = held[character]
				if not entry then
					local model, nozzle = buildCan(0.85)
					entry = { Model = model, Nozzle = nozzle }
					held[character] = entry
				end
				entry.Model:PivotTo(canCF(hand))
			end
		end
	end
	for character, entry in pairs(held) do
		if not seen[character] then
			entry.Model:Destroy()
			held[character] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Spray
---------------------------------------------------------------------------
local function mist(position, direction, cone, count, speed)
	VFXLib.burst(position, { Count = count or 8, Texture = VFXLib.Textures.Smoke, Color = FLESH, LightEmission = 0.1, Speed = speed or 26, Lifetime = 0.45, Spread = cone or 25, Direction = direction, Drag = 3 })
	VFXLib.burst(position, { Count = math.max(2, math.floor((count or 8) / 3)), Color = Color3.fromRGB(255, 210, 220), Speed = (speed or 26) * 0.8, Lifetime = 0.3, Spread = cone or 25, Direction = direction })
end

-- Lumps of flesh flying out of the can.
local function blobs(origin, direction, range, count)
	for i = 1, count do
		local spreadDir = (CFrame.lookAt(origin, origin + direction) * CFrame.Angles((math.random() - 0.5) * 0.6, (math.random() - 0.5) * 0.8, 0)).LookVector
		local size = 0.2 + math.random() * 0.25
		local p = VFXLib.part({ Size = Vector3.new(size, size, size), Color = i % 2 == 0 and FLESH or FLESH_DARK, Material = Enum.Material.SmoothPlastic })
		local dist = range * (0.5 + math.random() * 0.5)
		VFXLib.animate(0.3 + math.random() * 0.15, function(a)
			p.CFrame = CFrame.new(origin + spreadDir * dist * a - Vector3.new(0, 2 * a * a, 0)) * CFrame.Angles(a * 6, a * 4, 0)
			p.Transparency = a > 0.8 and (a - 0.8) / 0.2 or 0
		end, function()
			p:Destroy()
		end)
	end
end

---------------------------------------------------------------------------
-- Status visuals driven by attributes (coated / sealed / encased)
---------------------------------------------------------------------------
local function candidates()
	local list = {}
	for _, f in ipairs(Fighters.list()) do
		if f.Character then
			table.insert(list, f.Character)
		end
	end
	local dummies = workspace:FindFirstChild("SpinTestDummies")
	if dummies then
		for _, d in ipairs(dummies:GetChildren()) do
			table.insert(list, d)
		end
	end
	return list
end

local LUMP_PARTS = { "UpperTorso", "Torso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm", "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg", "Head" }

local function makeCoat(model)
	local lumps = {}
	for i, name in ipairs(LUMP_PARTS) do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			local size = 0.35 + (i % 3) * 0.12
			local lump = VFXLib.part({ Size = Vector3.new(size, size * 0.8, size), Color = i % 2 == 0 and FLESH or FLESH_DARK, Material = Enum.Material.SmoothPlastic })
			local offset = CFrame.new((i % 2 == 0 and 1 or -1) * part.Size.X * 0.4, ((i * 37) % 10 / 10 - 0.5) * part.Size.Y * 0.6, -part.Size.Z * 0.45)
			table.insert(lumps, { Part = lump, On = part, Offset = offset })
		end
	end
	return lumps
end

local function makeMask(model)
	local head = model:FindFirstChild("Head")
	if not head then
		return nil
	end
	local s = head.Size.Y / 1.2
	local m = Instance.new("Model")
	m.Parent = VFXLib.Folder
	local main = box(m, Vector3.new(head.Size.X * 0.9, 0.55 * s, 0.3 * s), CFrame.new(), FLESH)
	box(m, Vector3.new(head.Size.X * 0.7, 0.35 * s, 0.38 * s), CFrame.new(0, 0.05 * s, 0), FLESH_DARK)
	m.PrimaryPart = main
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(110, 34)
	gui.StudsOffset = Vector3.new(0, 1.2, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = main
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Bangers
	label.TextScaled = true
	label.Text = "MMPH!"
	label.TextColor3 = FLESH_DARK
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return { Model = m, Head = head, Label = label, S = s }
end

local function makeCocoon(model)
	local root = Common.rootOf(model)
	if not root then
		return nil
	end
	local m = Instance.new("Model")
	m.Parent = VFXLib.Folder
	local main = box(m, Vector3.new(4.2, 6.2, 4.2), CFrame.new(), FLESH, Enum.Material.SmoothPlastic, 0.12)
	box(m, Vector3.new(4.8, 5.4, 3.4), CFrame.new(), FLESH, Enum.Material.SmoothPlastic, 0.12)
	box(m, Vector3.new(3.4, 5.4, 4.8), CFrame.new(), FLESH, Enum.Material.SmoothPlastic, 0.12)
	-- Darker veins wrapping it.
	for i = 0, 3 do
		box(m, Vector3.new(4.9, 0.25, 4.9), CFrame.new(0, -2 + i * 1.3, 0) * CFrame.Angles(0, i * 0.4, 0.15 * (i % 2 == 0 and 1 or -1)), FLESH_DARK, Enum.Material.SmoothPlastic, 0.05)
	end
	m.PrimaryPart = main
	m:ScaleTo(0.2)
	return { Model = m, Born = os.clock() }
end

local function stepStatus()
	local t = workspace:GetServerTimeNow()
	local seenCoat, seenMask, seenCocoon = {}, {}, {}
	for _, model in ipairs(candidates()) do
		if (model:GetAttribute("FleshCoatedUntil") or 0) > t then
			seenCoat[model] = true
			coats[model] = coats[model] or makeCoat(model)
		end
		if (model:GetAttribute("FleshSealedUntil") or 0) > t then
			seenMask[model] = true
			if not masks[model] then
				masks[model] = makeMask(model)
				if model == localPlayer.Character then
					TuskVFX.ScreenTint((model:GetAttribute("FleshSealedUntil") or t) - t, { Tint = Color3.fromRGB(255, 190, 190), Saturation = -0.4, Brightness = -0.15 })
				end
			end
		end
		if (model:GetAttribute("FleshEncasedUntil") or 0) > t then
			seenCocoon[model] = true
			cocoons[model] = cocoons[model] or makeCocoon(model)
		end
	end
	for model, lumps in pairs(coats) do
		if not seenCoat[model] then
			coats[model] = nil
			for _, l in ipairs(lumps) do
				VFXLib.burst(l.Part.Position, { Count = 2, Color = FLESH, Speed = 6, Lifetime = 0.25 })
				l.Part:Destroy()
			end
		end
	end
	for model, mask in pairs(masks) do
		if not seenMask[model] then
			masks[model] = nil
			if mask then
				mask.Model:Destroy()
			end
		end
	end
	for model, c in pairs(cocoons) do
		if not seenCocoon[model] then
			cocoons[model] = nil
			if c then
				c.Model:Destroy()
			end
		end
	end
end

local function stepAttached()
	local now = os.clock()
	for _, lumps in pairs(coats) do
		for _, l in ipairs(lumps) do
			if l.On.Parent then
				l.Part.CFrame = l.On.CFrame * l.Offset
			end
		end
	end
	for _, mask in pairs(masks) do
		if mask and mask.Head.Parent then
			mask.Model:PivotTo(mask.Head.CFrame * CFrame.new(0, -0.22 * mask.S, -mask.Head.Size.Z / 2 - 0.08 * mask.S))
			mask.Label.Rotation = math.sin(now * 18) * 6
		end
	end
	for model, c in pairs(cocoons) do
		local root = c and Common.rootOf(model)
		if root then
			local grow = math.min((now - c.Born) / 0.25, 1)
			c.Model:ScaleTo(0.2 + 0.8 * grow + math.sin(now * 14) * 0.02)
			c.Model:PivotTo(CFrame.new(root.Position) * CFrame.Angles(0, now * 0.5, 0))
		end
	end
end

local function popHeal(position, amount)
	local carrier = VFXLib.anchor(CFrame.new(position + Vector3.new((math.random() - 0.5) * 1.5, 2, 0)), 1)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(90, 36)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = carrier
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Bangers
	label.TextScaled = true
	label.Text = "+" .. amount
	label.TextColor3 = Color3.fromRGB(150, 240, 150)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	local start = carrier.Position
	VFXLib.animate(0.9, function(a)
		carrier.Position = start + Vector3.new(0, a * 2.5, 0)
		label.TextTransparency = math.max(0, (a - 0.6) / 0.4)
		label.TextStrokeTransparency = label.TextTransparency
	end)
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	TuskAnimation.play(character, "H_M1_" .. index)
	VFXLib.sound(sounds.Swing, root, 0.5, 1.1 + index * 0.06)
	if index <= 2 then
		Common.swipe(root, index == 1 and 1 or -1, index == 1 and pal.Main or pal.Light)
	elseif index == 3 then
		-- A quick spray burst in the face.
		task.delay(0.08, function()
			local cf = character.Parent and nozzleCF(character)
			if cf then
				local dir = sprayDir(character, cf.LookVector)
				mist(cf.Position, dir, 20, 10, 22)
				blobs(cf.Position, dir, 6, 4)
			end
		end)
	end
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local move, phase = data.Move, data.Phase
	if move == "FleshSpray" and phase == "Spray" and root then
		TuskAnimation.play(character, "HPSpray")
		local total = (data.Startup or 0.12) + (data.Duration or 0.6)
		VFXLib.sound(sounds.ChargeLoop, root, 0.4, 1.4)
		local nextPuff = 0
		VFXLib.animate(total, function(a, dt)
			nextPuff = nextPuff - (dt or 1 / 60)
			if a * total < (data.Startup or 0.12) or nextPuff > 0 then
				return
			end
			nextPuff = 0.06
			local cf = character.Parent and nozzleCF(character)
			if cf then
				local dir = sprayDir(character, data.Direction or cf.LookVector)
				mist(cf.Position, dir, (data.Cone or 55) / 2, 9, (data.Range or 15) * 2)
				blobs(cf.Position, dir, data.Range or 15, 2)
			end
		end)
	elseif move == "FleshSeal" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "HPSeal")
		elseif phase == "Seal" and data.Target then
			local head = data.Target:FindFirstChild("Head")
			local cf = character and nozzleCF(character)
			if head and cf then
				blobs(cf.Position, (head.Position - cf.Position).Unit, (head.Position - cf.Position).Magnitude, 6)
				VFXLib.burst(head.Position, { Count = 14, Texture = VFXLib.Textures.Smoke, Color = FLESH, LightEmission = 0, Speed = 8, Lifetime = 0.5 })
			end
			VFXLib.sound(sounds.Hit, head or root, 0.5, 0.8)
		elseif phase == "Miss" and root then
			local cf = nozzleCF(character)
			if cf then
				mist(cf.Position, data.Direction or cf.LookVector, 15, 8, 20)
			end
		end
	elseif move == "FleshMend" and phase == "Mend" and root then
		TuskAnimation.play(character, "HPMend")
		local ticks = 4
		for i = 1, ticks do
			task.delay(i * (data.Duration or 1.2) / ticks, function()
				local r = Common.rootOf(character)
				if r then
					popHeal(r.Position, math.floor((data.Heal or 22) / ticks * 10 + 0.5) / 10)
				end
			end)
		end
		-- Pink mist swirling round her.
		VFXLib.animate(data.Duration or 1.2, function(a)
			local r = Common.rootOf(character)
			local cf = nozzleCF(character)
			if cf and r and math.random() < 0.6 then
				mist(cf.Position, (r.Position + Vector3.new(0, 1 - a * 2.5, 0) - cf.Position).Unit, 15, 2, 8)
			end
			if r and math.random() < 0.5 then
				local ang = a * 18
				local p = r.Position + Vector3.new(math.cos(ang) * 2, (a * 4) % 4 - 2, math.sin(ang) * 2)
				VFXLib.burst(p, { Count = 2, Texture = VFXLib.Textures.Smoke, Color = FLESH, LightEmission = 0.2, Speed = 2, Lifetime = 0.5 })
			end
		end)
		VFXLib.flash(root.Position, pal.Light, 2, 14, 0.4)
	end
end

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Cloud" then
		TuskAnimation.play(character, "HPStorm")
		-- The flesh cloud swells in front of her.
		local cloud = Instance.new("Model")
		cloud.Parent = VFXLib.Folder
		local center = data.Position + Vector3.new(0, 2.5, 0)
		local puffs = {}
		for i = 1, 7 do
			local a = i / 7 * math.pi * 2
			local p = box(cloud, Vector3.new(5, 4, 5), CFrame.new(center + Vector3.new(math.cos(a) * 5, (i % 3) * 1.2, math.sin(a) * 5)), i % 2 == 0 and FLESH or FLESH_DARK, Enum.Material.SmoothPlastic, 0.35)
			puffs[i] = { Part = p, Base = p.CFrame }
		end
		local windup = data.Windup or 0.7
		VFXLib.animate(windup + 1.8, function(a)
			local t = a * (windup + 1.8)
			local grow = math.min(t / windup, 1)
			for i, puff in ipairs(puffs) do
				local w = 1 + math.sin(t * 6 + i) * 0.08
				puff.Part.Size = Vector3.new(5, 4, 5) * (0.3 + grow) * w
				puff.Part.Transparency = t > windup + 1.2 and 0.35 + (t - windup - 1.2) / 0.6 * 0.65 or 0.35
			end
			if root and root.Parent and t < windup then
				local cf = nozzleCF(character)
				if cf and math.random() < 0.6 then
					mist(cf.Position, (center - cf.Position).Unit, 15, 6, 30)
				end
			end
		end, function()
			cloud:Destroy()
		end)
		if Common.isLocal(character) then
			CameraFX.fovPunch(-5, 0.4)
		end
	elseif data.Phase == "Encase" then
		VFXLib.sound(sounds.Hit, data.Position, 0.8, 0.7)
		CameraFX.shakeAt(data.Position, 0.5, 50)
	elseif data.Phase == "Burst" then
		-- Every cocoon bursts into chunks.
		for _, target in ipairs(data.Targets or {}) do
			local r = Common.rootOf(target)
			if r then
				for i = 1, 8 do
					local dir = Vector3.new(math.cos(i), 0.6 + (i % 3) * 0.3, math.sin(i)).Unit
					local chunk = VFXLib.part({ Size = Vector3.new(0.9, 0.7, 0.9), Color = i % 2 == 0 and FLESH or FLESH_DARK, Material = Enum.Material.SmoothPlastic })
					local from = r.Position
					VFXLib.animate(0.6, function(a)
						chunk.CFrame = CFrame.new(from + dir * 14 * a - Vector3.new(0, 18 * a * a, 0)) * CFrame.Angles(a * 8, a * 5, 0)
						chunk.Transparency = a > 0.7 and (a - 0.7) / 0.3 or 0
					end, function()
						chunk:Destroy()
					end)
				end
				VFXLib.burst(r.Position, { Count = 20, Texture = VFXLib.Textures.Smoke, Color = FLESH, LightEmission = 0, Speed = 24, Lifetime = 0.6 })
			end
		end
		Common.finisher({ Character = character, Position = data.Position + Vector3.new(0, 2.5, 0), Radius = data.Radius, Hit = true }, pal, { Size = 1.6, Layers = 3, Shake = 0.9 })
		if Common.isLocal(character) then
			CameraFX.impactFrame(pal.Light)
		end
	end
end

---------------------------------------------------------------------------
local function stepStance()
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		if character then
			local want = character:GetAttribute("TuskAct") == ACT
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "HPStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "HPStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
end

function HotPantsVFX.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		Common.finisher(data, pal)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function HotPantsVFX.step(dt)
	dt = dt or 1 / 60
	stepCans()
	stepAttached()
	slowTimer = slowTimer + dt
	if slowTimer > 0.15 then
		slowTimer = 0
		stepStatus()
		stepStance()
	end
end

return HotPantsVFX
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">MountainTim_Client</string><ProtectedString name="Source"><![CDATA[--[[
	MountainTim_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Mountain Tim: Oh! Lonesome Me.
	Its other half is MountainTim_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: MountainTimVFX
-- ======================================================================
__modules["MountainTimVFX"] = function()
--[[
	TuskActVFX.MountainTimVFX  (StarterPlayerScripts.SpinClient.TuskActVFX.MountainTimVFX)

	Client visuals for Mountain Tim / OH! LONESOME ME: bodies come apart into
	pieces strung along his lasso rope.
	Models:
	  * a BRAIDED rope (twisted two-tone segments) that sags under its weight
	  * a thick lasso LOOP with a honda knot and a tail
	  * BODY PIECES: real copies of the character's own parts (with the outfit
	    bits welded to them, e.g. his hat rides on his head) strung on the rope
	Moves:
	  * LASSO SNARE: the loop whirls overhead and flies; a catch cinches the
	    loop round them and their body splits apart along the rope, then snaps
	    back together as they're dragged in
	  * SPLIT DODGE: he bursts into pieces hanging on a ring of rope. Attacked:
	    the pieces zip along a rope to behind the attacker and reform with a
	    rope-slam. Not attacked: the pieces slide forward along the rope.
	  * SPLIT BARRAGE: his arm comes apart (shoulder, forearm, fist on the
	    rope) and jabs down a line, then reels back in
	  * LONESOME ROUNDUP: a giant lasso spins overhead while a rope ring
	    tightens on the ground, ropes shoot out, everyone roped is split apart,
	    his pieces ride the ropes in, then a rope slam
]]

local Players = game:GetService("Players")

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local Net = __require("Net")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")
local Fighters = __require("Fighters")

local TimVFX = {}
local ACT = 9
local pal = Common.palette(ACT)
local sounds = TuskConfig.Sounds
local ROPE = Color3.fromRGB(212, 176, 116)
local ROPE_DARK = Color3.fromRGB(156, 120, 74)
local KNOT = Color3.fromRGB(120, 88, 52)

local lassos = {} -- [projectile id] = flying lasso
local lines = {} -- ropes held between two moving points
local scattered = {} -- [character] = his pieces during Split Dodge
local stanced = {}
local hiddenUntil = {} -- [character] = os.clock() after which it must be visible again

---------------------------------------------------------------------------
-- Braided rope: twisted two-tone segments along a sagging curve
---------------------------------------------------------------------------
local function newRope(width, segments)
	local rope = { Parts = {}, Width = width or 0.16 }
	for i = 1, segments or 12 do
		rope.Parts[i] = VFXLib.part({ Size = Vector3.new(rope.Width, rope.Width, 1), Color = i % 2 == 0 and ROPE or ROPE_DARK, Material = Enum.Material.Fabric })
	end
	return rope
end

local function setRope(rope, a, b, sag)
	local d = (b - a).Magnitude
	local n = #rope.Parts
	sag = sag or math.min(d * 0.05, 1.4)
	local function at(t)
		return a:Lerp(b, t) - Vector3.new(0, sag * 4 * t * (1 - t), 0)
	end
	for i, p in ipairs(rope.Parts) do
		if d < 0.05 then
			p.Transparency = 1
		else
			p.Transparency = 0
			local p0, p1 = at((i - 1) / n), at(i / n)
			local len = (p1 - p0).Magnitude
			p.Size = Vector3.new(rope.Width, rope.Width, len + 0.03)
			-- Each segment is turned a little more: reads as a braid.
			p.CFrame = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(0, 0, i * 0.7)
		end
	end
end

local function destroyRope(rope)
	for _, p in ipairs(rope.Parts) do
		p:Destroy()
	end
end

-- Lasso loop: a thick ring of rope with a honda knot and a short tail.
local function newLoop(radius)
	local m = Instance.new("Model")
	m.Name = "Lasso"
	m.Parent = VFXLib.Folder
	local n = 14
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local seg = VFXLib.part({ Size = Vector3.new(0.22, 0.22, radius * 2 * math.pi / n + 0.06), Color = i % 2 == 0 and ROPE or ROPE_DARK, Material = Enum.Material.Fabric })
		seg.CFrame = CFrame.new(math.cos(a) * radius, 0, math.sin(a) * radius) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, i * 0.7)
		seg.Parent = m
	end
	local knot = VFXLib.part({ Size = Vector3.new(0.42, 0.34, 0.5), Color = KNOT, Material = Enum.Material.Fabric })
	knot.CFrame = CFrame.new(radius, 0, 0)
	knot.Parent = m
	local tail = VFXLib.part({ Size = Vector3.new(0.18, 0.18, 0.7), Color = ROPE, Material = Enum.Material.Fabric })
	tail.CFrame = CFrame.new(radius + 0.4, -0.1, 0.3) * CFrame.Angles(0.3, 0.6, 0)
	tail.Parent = m
	local center = VFXLib.part({ Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 })
	center.CFrame = CFrame.new()
	center.Parent = m
	m.PrimaryPart = center
	return m
end

---------------------------------------------------------------------------
-- Body pieces: real copies of a character's parts (plus outfit bits)
---------------------------------------------------------------------------
local PIECES = {
	"Head", "UpperTorso", "LowerTorso", "Torso",
	"RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperArm", "LeftLowerArm", "LeftHand",
	"RightUpperLeg", "RightLowerLeg", "RightFoot", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
	"Right Arm", "Left Arm", "Right Leg", "Left Leg",
}
local ARM = { "RightUpperArm", "RightLowerArm", "RightHand", "Right Arm" }

local function copyPart(src)
	local ok, copy = pcall(function()
		local was = src.Archivable
		src.Archivable = true
		local c = src:Clone()
		src.Archivable = was
		return c
	end)
	if not ok or not copy then
		return nil
	end
	for _, d in ipairs(copy:GetChildren()) do
		if d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("Attachment") or d:IsA("LuaSourceContainer") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	copy.Anchored = true
	copy.CanCollide = false
	copy.CanQuery = false
	copy.CanTouch = false
	copy.LocalTransparencyModifier = 0
	copy.Parent = VFXLib.Folder
	return copy
end

-- Outfit bits (the hat, the vest...) welded to `src` travel with its piece.
local function weldedTo(character, src)
	local list = {}
	for _, d in ipairs(character:GetDescendants()) do
		-- Outfit bits (WeldConstraint from the part) and accessories (hats,
		-- hair: a weld between the accessory's Handle and the part).
		if d:IsA("WeldConstraint") and d.Part0 == src and d.Part1 and d.Part1.Parent and d.Part1.Parent ~= character then
			table.insert(list, d.Part1)
		elseif d:IsA("JointInstance") and d.Parent and d.Parent.Name == "Handle" and d.Parent.Parent and d.Parent.Parent:IsA("Accessory") then
			if d.Part1 == src or d.Part0 == src then
				table.insert(list, d.Parent)
			end
		end
	end
	return list
end

local function cutPieces(character, names)
	local root = Common.rootOf(character)
	if not root then
		return {}
	end
	local pieces = {}
	for _, name in ipairs(names or PIECES) do
		local src = character:FindFirstChild(name)
		if src and src:IsA("BasePart") then
			local main = copyPart(src)
			if main then
				local piece = { Main = main, Extras = {}, Offset = root.CFrame:Inverse() * src.CFrame }
				for _, bit in ipairs(weldedTo(character, src)) do
					local c = copyPart(bit)
					if c then
						table.insert(piece.Extras, { Part = c, Offset = src.CFrame:Inverse() * bit.CFrame })
					end
				end
				table.insert(pieces, piece)
			end
		end
	end
	return pieces
end

local function placePiece(piece, cf)
	piece.Main.CFrame = cf
	for _, e in ipairs(piece.Extras) do
		e.Part.CFrame = cf * e.Offset
	end
end

local function dropPieces(pieces)
	for _, piece in ipairs(pieces) do
		piece.Main:Destroy()
		for _, e in ipairs(piece.Extras) do
			e.Part:Destroy()
		end
	end
end

-- Hide a character (or just some of its parts) on this client. Remembers
-- what it hid and puts exactly that back (faces an outfit hid stay hidden),
-- and keeps it hidden every frame so the camera can't un-hide it.
local hidden = {} -- [character] = { Parts = { [part] = true }, Decals = { [decal] = original } }

local function partSet(character, onlyNames)
	local list = {}
	local set
	if onlyNames then
		set = {}
		for _, n in ipairs(onlyNames) do
			set[n] = true
		end
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			local own = set == nil or set[d.Name]
			if not own then
				-- outfit bits and accessories attached to a hidden part hide with it
				for _, w in ipairs(d:GetChildren()) do
					if (w:IsA("WeldConstraint") or w:IsA("JointInstance")) and ((w.Part0 and set[w.Part0.Name]) or (w.Part1 and set[w.Part1.Name])) then
						own = true
					end
				end
			end
			if own then
				table.insert(list, d)
			end
		end
	end
	return list
end

local function hideBody(character, hide, seconds, onlyNames)
	if not onlyNames then
		hiddenUntil[character] = hide and (os.clock() + (seconds or 0.5) + 0.8) or nil
	end
	local entry = hidden[character]
	if hide then
		entry = entry or { Parts = {}, Decals = {} }
		hidden[character] = entry
		for _, part in ipairs(partSet(character, onlyNames)) do
			entry.Parts[part] = true
			part.LocalTransparencyModifier = 1
		end
		if not onlyNames then
			for _, d in ipairs(character:GetDescendants()) do
				if d:IsA("Decal") and entry.Decals[d] == nil then
					entry.Decals[d] = d.Transparency
					d.Transparency = 1
				end
			end
		end
		return
	end
	if not entry then
		return
	end
	if onlyNames then
		for _, part in ipairs(partSet(character, onlyNames)) do
			entry.Parts[part] = nil
			part.LocalTransparencyModifier = 0
		end
		if next(entry.Parts) == nil and next(entry.Decals) == nil then
			hidden[character] = nil
		end
		return
	end
	hidden[character] = nil
	for part in pairs(entry.Parts) do
		if part.Parent then
			part.LocalTransparencyModifier = 0
		end
	end
	for decal, original in pairs(entry.Decals) do
		if decal.Parent then
			decal.Transparency = original
		end
	end
end

-- Runs after the camera each frame: keeps hidden parts hidden.
local function enforceHidden()
	for character, entry in pairs(hidden) do
		if not character.Parent then
			hidden[character] = nil
		else
			for part in pairs(entry.Parts) do
				if part.Parent and part.LocalTransparencyModifier ~= 1 then
					part.LocalTransparencyModifier = 1
				end
			end
		end
	end
end

-- Oh! Lonesome Me on a victim: their body spreads apart along the rope
-- toward `getAnchor()` (Tim's hand), wobbles, then snaps back together.
local function splitApart(model, getAnchor, duration)
	local root = Common.rootOf(model)
	if not root then
		return
	end
	local pieces = cutPieces(model)
	if #pieces == 0 then
		return
	end
	hideBody(model, true, duration)
	local n = #pieces
	VFXLib.animate(duration, function(a)
		local r = Common.rootOf(model)
		if not r then
			return
		end
		local anchor = getAnchor() or (r.Position + r.CFrame.LookVector * 5)
		local toward = anchor - r.Position
		toward = toward.Magnitude > 0.1 and toward.Unit or r.CFrame.LookVector
		local spread = math.sin(math.min(a / 0.85, 1) * math.pi) * 4.5
		for i, piece in ipairs(pieces) do
			local t = (i - 1) / math.max(n - 1, 1)
			local wob = Vector3.new(math.sin(a * 20 + i), math.cos(a * 17 + i * 2), 0) * 0.25 * spread / 4.5
			local cf = r.CFrame * piece.Offset
			placePiece(piece, cf + toward * spread * t + wob)
		end
	end, function()
		dropPieces(pieces)
		if model.Parent then
			hideBody(model, false)
			local rr = Common.rootOf(model)
			if rr then
				VFXLib.burst(rr.Position, { Count = 8, Color = ROPE, Speed = 10, Lifetime = 0.25 })
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function handPos(character)
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	if hand then
		return hand.Position
	end
	local root = Common.rootOf(character)
	return root and (root.CFrame * CFrame.new(0.9, 0.4, -1)).Position
end

local function torsoPos(model)
	local part = model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart"))
	return part and part.Position
end

local function holdRope(getA, getB, duration, loopRadius)
	local entry = { GetA = getA, GetB = getB, Rope = newRope(0.17), Loop = loopRadius and newLoop(loopRadius) or nil, Expire = os.clock() + duration, T = 0, Radius = loopRadius }
	table.insert(lines, entry)
	return entry
end

local function stepLines(dt)
	local now = os.clock()
	for i = #lines, 1, -1 do
		local e = lines[i]
		local a, b = e.GetA(), e.GetB()
		if now > e.Expire or not a or not b then
			table.remove(lines, i)
			destroyRope(e.Rope)
			if e.Loop then
				e.Loop:Destroy()
			end
		else
			e.T = e.T + dt
			-- Taut while it pulls: little sag, a thrum along it.
			setRope(e.Rope, a, b + Vector3.new(0, math.sin(e.T * 30) * 0.05, 0), 0.25)
			if e.Loop then
				-- The loop cinches tight round them.
				e.Loop:PivotTo(CFrame.new(b) * CFrame.Angles(0, e.T * 2, 0))
				e.Loop:ScaleTo(math.max(0.7, 1.3 - e.T * 2))
			end
		end
	end
end

---------------------------------------------------------------------------
-- Lasso projectile (server Kind "TimLasso")
---------------------------------------------------------------------------
local function spawnLasso(data)
	local p = data.OwnerId and Players:GetPlayerByUserId(data.OwnerId)
	lassos[data.Id] = {
		Loop = newLoop(1.3),
		Rope = newRope(0.16),
		Owner = (data.Visual and data.Visual.Character) or (p and p.Character),
		Origin = data.Origin,
		Direction = data.Direction,
		Speed = data.Speed,
		Range = data.Range,
		ServerTime = data.ServerTime,
		Spin = 0,
		Expire = os.clock() + data.Range / math.max(data.Speed, 1) + 1,
	}
end

local function removeLasso(v)
	v.Loop:Destroy()
	destroyRope(v.Rope)
end

local function endLasso(data)
	local v = lassos[data.Id]
	if not v then
		return
	end
	lassos[data.Id] = nil
	removeLasso(v)
	if not data.HitCharacter then
		-- Miss: the loop flops in the dirt and the rope snaps back.
		local loop, rope = newLoop(1.3), newRope(0.16)
		local from = data.Position
		VFXLib.burst(from, { Count = 6, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(210, 190, 150), LightEmission = 0, Speed = 6, Lifetime = 0.5 })
		VFXLib.animate(0.32, function(a)
			local h = v.Owner and v.Owner.Parent and handPos(v.Owner)
			if not h then
				return
			end
			local p = from:Lerp(h, a * a)
			loop:PivotTo(CFrame.new(p) * CFrame.Angles(a * 2, a * 6, 0))
			loop:ScaleTo(math.max(0.1, 1 - a))
			setRope(rope, h, p, 1.5 * (1 - a))
		end, function()
			loop:Destroy()
			destroyRope(rope)
		end)
	end
end

local function stepLassos(dt)
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	for id, v in pairs(lassos) do
		local distance = math.min(v.Speed * (serverNow - v.ServerTime), v.Range)
		local pos = v.Origin + v.Direction * math.max(distance, 0)
		v.Spin = v.Spin + dt * 14
		v.Loop:PivotTo(CFrame.lookAt(pos, pos + v.Direction) * CFrame.Angles(math.pi / 2, v.Spin, 0))
		local h = v.Owner and v.Owner.Parent and handPos(v.Owner)
		setRope(v.Rope, h or v.Origin, pos, 0.6)
		if now > v.Expire then
			lassos[id] = nil
			removeLasso(v)
		end
	end
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	TuskAnimation.play(character, "T_M1_" .. index)
	VFXLib.sound(sounds.Swing, root, 0.5, 1 + index * 0.06)
	if index <= 2 then
		Common.swipe(root, index == 1 and 1 or -1, index == 1 and pal.Main or pal.Light)
	elseif index == 3 then
		-- Rope whip: the rope cracks out in a curve and snaps.
		local rope = newRope(0.14, 10)
		VFXLib.animate(0.26, function(a)
			local h = root.Parent and handPos(character)
			if not h then
				return
			end
			local reach = math.sin(a * math.pi) * 7.5
			local tip = (root.CFrame * CFrame.new(math.sin(a * math.pi * 2) * 2.8, 0.5, -reach)).Position
			setRope(rope, h, tip, -0.6 * math.sin(a * math.pi))
		end, function()
			destroyRope(rope)
		end)
		TuskVFX.CreateCrescent(root.CFrame * CFrame.new(0, 0.6, -2.6), { Radius = 3.6, Width = 0.25, Color = ROPE, Color2 = pal.Light, Sweep = 2.2, Duration = 0.22 })
		task.delay(0.13, function()
			if root.Parent then
				local tip = (root.CFrame * CFrame.new(0, 0.6, -7)).Position
				TuskVFX.CreateImpactStar(tip, { Size = 2.4, Rays = 6, Color = pal.Light, Color2 = Color3.new(1, 1, 1), Duration = 0.12 })
			end
		end)
	elseif index == 4 then
		-- Lasso slam: the loop drops onto the spot in front and snaps shut.
		local spot = (root.CFrame * CFrame.new(0, -2.4, -3.6)).Position
		local loop = newLoop(2)
		VFXLib.animate(0.24, function(a)
			loop:PivotTo(CFrame.new(spot + Vector3.new(0, 3 * (1 - a), 0)) * CFrame.Angles(0, a * 3, 0))
			loop:ScaleTo(math.max(0.2, 1.2 - a * 0.9))
		end, function()
			loop:Destroy()
		end)
	end
end

-- SPLIT DODGE: the pieces hang on a slowly turning ring of rope.
local function scatter(character, window)
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local old = scattered[character]
	if old then
		dropPieces(old.Pieces)
		destroyRope(old.Ring)
	end
	local pieces = cutPieces(character)
	hideBody(character, true, window + 0.5)
	local entry = { Pieces = pieces, Ring = newRope(0.12, 16), Center = root.Position, Start = os.clock(), Window = window }
	scattered[character] = entry
	VFXLib.burst(root.Position, { Count = 16, Color = pal.Main, Speed = 18, Lifetime = 0.35 })
	VFXLib.sound(sounds.Swing, root, 0.6, 0.7)
	return entry
end

local function stepScattered()
	local now = os.clock()
	for character, e in pairs(scattered) do
		local t = now - e.Start
		local n = #e.Pieces
		local ringPoints = {}
		for i, piece in ipairs(e.Pieces) do
			local ang = (i - 1) / math.max(n, 1) * math.pi * 2 + t * 1.6
			local out = math.min(t / 0.15, 1)
			local r = 2.6 * out
			local pos = e.Center + Vector3.new(math.cos(ang) * r, (i % 4) * 0.7 - 0.6 + math.sin(t * 6 + i) * 0.2, math.sin(ang) * r)
			local home = (CFrame.new(e.Center) * piece.Offset)
			local cf = home:Lerp(CFrame.new(pos) * CFrame.Angles(t * 2 + i, t + i * 0.5, 0), out)
			placePiece(piece, cf)
			ringPoints[i] = cf.Position
		end
		-- One rope threaded through every piece.
		for k, p in ipairs(e.Ring.Parts) do
			local a = ringPoints[((k - 1) % math.max(n, 1)) + 1]
			local b = ringPoints[(k % math.max(n, 1)) + 1]
			if a and b and k <= n then
				local len = (b - a).Magnitude
				p.Transparency = 0
				p.Size = Vector3.new(0.12, 0.12, len)
				p.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, 0, k * 0.7)
			elseif k > n then
				p.Transparency = 1
			end
		end
		if t > e.Window + 1 then
			-- (safety) nobody resolved it
			scattered[character] = nil
			dropPieces(e.Pieces)
			destroyRope(e.Ring)
			hideBody(character, false)
		end
	end
end

-- Pieces ride a rope from `from` to `to` over `travel`, then reform.
local function rideRope(character, pieces, from, to, travel, done)
	local rope = newRope(0.14, 14)
	setRope(rope, from + Vector3.new(0, 0.5, 0), to + Vector3.new(0, 0.5, 0), 0.4)
	local n = #pieces
	local startCFs = {}
	for i, piece in ipairs(pieces) do
		startCFs[i] = piece.Main.CFrame
	end
	VFXLib.animate(travel, function(a)
		for i, piece in ipairs(pieces) do
			local k = math.clamp(a * 1.5 - (i - 1) / math.max(n, 1) * 0.5, 0, 1)
			local along = from:Lerp(to, k) + Vector3.new(0, 0.5 + math.sin(k * math.pi) * (0.6 + (i % 3) * 0.3), 0)
			local endCF = CFrame.lookAt(to, to + (to - from)) * piece.Offset
			local cf
			if k < 1 then
				cf = startCFs[i]:Lerp(CFrame.new(along) * CFrame.Angles(k * 7 + i, k * 5, 0), math.min(k * 4, 1))
			else
				cf = endCF
			end
			placePiece(piece, cf)
		end
	end, function()
		dropPieces(pieces)
		task.delay(0.12, function()
			destroyRope(rope)
		end)
		if done then
			done()
		end
	end)
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local move, phase = data.Move, data.Phase
	if move == "LassoSnare" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "TimLassoThrow")
			if root then
				local loop = newLoop(1.4)
				local rope = newRope(0.14, 6)
				VFXLib.animate(data.Startup or 0.28, function(a)
					if root.Parent then
						local c = root.CFrame * CFrame.new(0.6, 3.3, 0) * CFrame.Angles(0, a * 16, 0)
						loop:PivotTo(c)
						local h = handPos(character)
						if h then
							setRope(rope, h, (c * CFrame.new(1.4, 0, 0)).Position, 0)
						end
					end
				end, function()
					loop:Destroy()
					destroyRope(rope)
				end)
			end
		elseif phase == "Snag" and data.Target then
			TuskAnimation.play(character, "TimReel")
			local getHand = function()
				return character.Parent and handPos(character)
			end
			holdRope(getHand, function()
				return data.Target.Parent and torsoPos(data.Target)
			end, (data.Duration or 0.6) + 0.2, 1.3)
			if data.SplitTime then
				splitApart(data.Target, getHand, data.SplitTime)
			end
			local tp = torsoPos(data.Target)
			if tp then
				VFXLib.burst(tp, { Count = 12, Color = ROPE, Speed = 18, Lifetime = 0.3 })
				TuskVFX.CreateImpactStar(tp, { Size = 4, Rays = 7, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Duration = 0.2 })
			end
			VFXLib.sound(sounds.Hit, root or data.Target, 0.6, 1)
		end
	elseif move == "SplitDodge" and character then
		if phase == "Scatter" then
			TuskAnimation.play(character, "TimSplit")
			scatter(character, data.Window or 0.6)
		elseif phase == "Counter" or phase == "Slide" then
			local e = scattered[character]
			scattered[character] = nil
			local pieces = e and e.Pieces or cutPieces(character)
			if e then
				destroyRope(e.Ring)
			end
			hideBody(character, true, (data.Travel or 0.18) + 0.3)
			local travel = phase == "Counter" and 0.16 or (data.Travel or 0.3)
			rideRope(character, pieces, data.From, data.To, travel, function()
				if phase == "Counter" and character.Parent then
					hideBody(character, false)
					VFXLib.burst(data.To, { Count = 16, Color = pal.Main, Speed = 18, Lifetime = 0.3 })
				end
			end)
			if phase == "Counter" then
				-- Reformed behind them: rope slam.
				local attackerRoot = data.Attacker and Common.rootOf(data.Attacker)
				task.delay(0.14, function()
					local r = Common.rootOf(character)
					if r then
						TuskAnimation.play(character, "T_M1_4")
						TuskVFX.CreateCrescent(r.CFrame * CFrame.new(0, 1, -2.4) * CFrame.Angles(0, 0, math.pi / 2), { Radius = 3.6, Width = 0.35, Color = ROPE, Color2 = pal.Light, Sweep = 2.6, Duration = 0.22 })
					end
					if attackerRoot then
						TuskVFX.CreateImpactStar(attackerRoot.Position, { Size = 6, Rays = 9, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Duration = 0.25 })
						CameraFX.shakeAt(attackerRoot.Position, 0.5, 40)
					end
				end)
				if Common.isLocal(character) then
					CameraFX.impactFrame(pal.Light)
				end
			elseif Common.isLocal(character) then
				CameraFX.fovPunch(6, 0.25)
			end
		elseif phase == "Rejoin" then
			local e = scattered[character]
			if e then
				scattered[character] = nil
				dropPieces(e.Pieces)
				destroyRope(e.Ring)
			end
			hideBody(character, false)
			local pos = data.Position
			if pos then
				VFXLib.burst(pos, { Count = 16, Color = pal.Main, Speed = 18, Lifetime = 0.35 })
				TuskVFX.CreateRotationalShockwave(CFrame.new(pos - Vector3.new(0, 2.5, 0)), { Radius = 4, Layers = 1, Color = pal.Main, Color2 = ROPE, Ground = true, Particles = 0.4, Width = 0.15, Duration = 0.3 })
			end
		end
	elseif move == "SplitBarrage" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "TimPunch")
		elseif phase == "Fly" and root then
			-- His arm comes apart along the rope and jabs down the line.
			local arm = cutPieces(character, ARM)
			hideBody(character, true, nil, ARM)
			local rope = newRope(0.12, 12)
			local range = data.Range or 26
			local hits, every = data.Hits or 5, data.HitEvery or 0.1
			local punchTime = hits * every
			local total = punchTime + (data.ReelTime or 0.45)
			local nextHit = 0
			VFXLib.animate(total, function(a, dt)
				local r = Common.rootOf(character)
				if not r then
					return
				end
				local t = a * total
				local dir = data.Direction
				local shoulder = (r.CFrame * CFrame.new(1, 0.6, 0)).Position
				local out
				if t < punchTime then
					out = math.min(t / 0.12, 1) * (0.85 + 0.15 * math.sin(t / every * math.pi * 2))
				else
					out = 1 - (t - punchTime) / (total - punchTime) -- reel back in
				end
				local reach = range * math.max(out, 0)
				local tip = shoulder + dir * reach
				for i, piece in ipairs(arm) do
					local k = #arm == 1 and 1 or i / #arm
					local pos = shoulder + dir * reach * k
					placePiece(piece, CFrame.lookAt(pos, pos + dir) * CFrame.Angles(-math.pi / 2, 0, 0))
				end
				setRope(rope, shoulder, tip, 0.2)
				nextHit = nextHit - (dt or 1 / 60)
				if t < punchTime and nextHit <= 0 and out > 0.6 then
					nextHit = every
					TuskVFX.CreateImpactStar(tip, { Size = 3, Rays = 6, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Duration = 0.12 })
					VFXLib.sound(sounds.Hit, tip, 0.4, 1.2)
				end
			end, function()
				dropPieces(arm)
				destroyRope(rope)
				if character.Parent then
					hideBody(character, false, nil, ARM)
				end
			end)
		end
	end
end

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Start" then
		TuskAnimation.play(character, "TimRoundup")
		if root then
			local loop = newLoop(1.4)
			-- A rope ring on the ground, tightening toward him.
			local ring = newRope(0.18, 24)
			local radius = data.Radius or 24
			VFXLib.animate(data.Windup or 0.9, function(a)
				if not root.Parent then
					return
				end
				loop:PivotTo(root.CFrame * CFrame.new(0, 4.4, 0) * CFrame.Angles(0, a * 22, 0))
				loop:ScaleTo(1 + a * 2.2)
				local r = radius * (1 - a * 0.35)
				local center = root.Position - Vector3.new(0, 2.7, 0)
				local n = #ring.Parts
				for i, p in ipairs(ring.Parts) do
					local a0 = (i - 1) / n * math.pi * 2 + a
					local a1 = i / n * math.pi * 2 + a
					local p0 = center + Vector3.new(math.cos(a0) * r, 0, math.sin(a0) * r)
					local p1 = center + Vector3.new(math.cos(a1) * r, 0, math.sin(a1) * r)
					p.Transparency = 0
					p.Size = Vector3.new(0.18, 0.18, (p1 - p0).Magnitude + 0.05)
					p.CFrame = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(0, 0, i * 0.7)
				end
			end, function()
				loop:Destroy()
				destroyRope(ring)
			end)
			VFXLib.flash(root.Position, pal.Main, 3, 25, 0.4)
		end
		if Common.isLocal(character) then
			CameraFX.fovPunch(-6, 0.4)
		end
	elseif data.Phase == "Rope" then
		local hold = (data.RideHits or 4) * (data.RideEvery or 0.18) + (data.ReelTime or 0.8) + 0.1
		local getHand = function()
			return character.Parent and handPos(character)
		end
		for _, target in ipairs(data.Targets or {}) do
			holdRope(getHand, function()
				return target.Parent and torsoPos(target)
			end, hold, 1.4)
			if data.SplitTime then
				splitApart(target, getHand, data.SplitTime)
			end
			-- His pieces ride the rope in, again and again.
			local pieces = cutPieces(character, { "Head", "RightHand", "LeftHand", "RightFoot", "LeftFoot", "Right Arm", "Left Arm" })
			VFXLib.animate(hold - 0.1, function(a)
				local h = getHand()
				local t = target.Parent and torsoPos(target)
				if not h or not t then
					return
				end
				for i, piece in ipairs(pieces) do
					local k = ((a * 4) + i * 0.17) % 1
					placePiece(piece, CFrame.new(h:Lerp(t, k) + Vector3.new(0, math.sin(k * math.pi) * 0.8, 0)) * CFrame.Angles(k * 8, i, 0))
				end
			end, function()
				dropPieces(pieces)
			end)
		end
		if root then
			VFXLib.sound(sounds.Hit, root, 0.8, 0.9)
		end
		if Common.isLocal(character) then
			CameraFX.shake(0.5, hold)
		end
	elseif data.Phase == "Slam" then
		Common.finisher({ Character = character, Position = data.Position, Radius = data.Radius, Hit = true }, pal, { Size = 1.6, Layers = 3, Shake = 0.9 })
		VFXLib.burst(data.Position, { Count = 24, Color = ROPE, Speed = 30, Lifetime = 0.5 })
		local loop = newLoop(3)
		VFXLib.animate(0.3, function(a)
			loop:PivotTo(CFrame.new(data.Position - Vector3.new(0, 2.4 - 0, 0)) * CFrame.Angles(0, a * 4, 0))
			loop:ScaleTo(math.max(0.1, 1.3 - a))
		end, function()
			loop:Destroy()
		end)
		if Common.isLocal(character) then
			CameraFX.impactFrame(pal.Light)
		end
	end
end

---------------------------------------------------------------------------
local function stepStance()
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		if character then
			local want = character:GetAttribute("TuskAct") == ACT
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "TimStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "TimStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
	-- Never leave anyone invisible (e.g. if a Rejoin event was missed).
	local now = os.clock()
	for character, untilT in pairs(hiddenUntil) do
		if now > untilT and not scattered[character] then
			hideBody(character, false)
		end
	end
end

function TimVFX.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		Common.finisher(data, pal)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function TimVFX.step(dt)
	dt = dt or 1 / 60
	stepLassos(dt)
	stepLines(dt)
	stepScattered()
	slowTimer = slowTimer + dt
	if slowTimer > 0.2 then
		slowTimer = 0
		stepStance()
	end
end

-- Keep split bodies hidden after the camera's own transparency update.
pcall(function()
	game:GetService("RunService"):BindToRenderStep("TimKeepHidden", Enum.RenderPriority.Camera.Value + 2, enforceHidden)
end)

Net.get("SpinFX").OnClientEvent:Connect(function(name, data)
	if typeof(data) ~= "table" or data.Kind ~= "TimLasso" then
		return
	end
	if name == "ProjectileSpawn" then
		spawnLasso(data)
	elseif name == "ProjectileEnd" then
		endLasso(data)
	end
end)

return TimVFX
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">PorkPie_Client</string><ProtectedString name="Source"><![CDATA[--[[
	PorkPie_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Pork Pie Hat Kid: Wired.
	Its other half is PorkPie_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: PorkPie
-- ======================================================================
__modules["PorkPie"] = function()
--[[
	TuskActVFX.PorkPie  (StarterPlayerScripts.SpinClient.TuskActVFX.PorkPie)

	Client visuals for Pork Pie Hat Kid / WIRED (from the owner's pictures):
	  * blocky fish hooks (barbed J hook, ring eye, feather bait) on steel
	    cables that run out of his MOUTH
	  * the winch: a cable drum that spins in front of his mouth while he reels
	  * WIRED HOOK: the hook flies out, snags, the cable reels the enemy in
	    (a miss whips the hook back into his mouth)
	  * BAIT PAN: a frying pan of water with a feather bait bobbing over it;
	    hooks burst out of the water at whoever comes near
	  * DOUBLE HOOK LIFT: both hooks snag, hoist the enemies up, slam them down
	  * WIRED WINCH: puddles all round him, hooks erupt from every puddle, the
	    cables swing over to his mouth and the winch reels everyone in, slam
	Everything is blocky to match the game's look.
]]

local Players = game:GetService("Players")
local Fighters = __require("Fighters")

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local Net = __require("Net")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")

local PorkPie = {}
local ACT = 7
local pal = Common.palette(ACT)
local sounds = TuskConfig.Sounds

local STEEL = Color3.fromRGB(205, 210, 222)
local CABLE = Color3.fromRGB(165, 170, 182)
local WATER = Color3.fromRGB(70, 150, 230)
local WATER_LIGHT = Color3.fromRGB(190, 230, 255)
local PAN = Color3.fromRGB(60, 62, 68)
local FEATHER = Color3.fromRGB(150, 110, 70)
local FEATHER_LIGHT = Color3.fromRGB(225, 200, 150)

local hooks = {} -- [projectile id] = flying hook
local lines = {} -- list of cables held taut between two moving points
local pans = {} -- [pan id] = bait pan
local puddles = {} -- list of the ultimate's puddles
local winches = {} -- [character] = spinning cable drum at the mouth
local stanced = {}

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------
local function box(model, size, cf, color, material, transparency)
	local p = VFXLib.part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, Transparency = transparency or 0 })
	p.Parent = model
	return p
end

-- Stepped (pixel-art) round plate lying in the XZ plane.
local function roundPlate(model, diameter, thickness, cf, color, material, transparency)
	local core = box(model, Vector3.new(diameter * 0.86, thickness, diameter * 0.86), cf, color, material, transparency)
	box(model, Vector3.new(diameter, thickness, diameter * 0.62), cf, color, material, transparency)
	box(model, Vector3.new(diameter * 0.62, thickness, diameter), cf, color, material, transparency)
	return core
end

local function newModel(name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = VFXLib.Folder
	return m
end

-- The fish hook from the pictures: shank, J bend with a barbed point, a ring
-- eye at the back and a feather bait. Points along -Z (the bend leads).
local function buildHook(scale)
	scale = scale or 1
	local m = newModel("WiredHook")
	local s = scale
	local metal = Enum.Material.Metal
	local shank = box(m, Vector3.new(0.14, 0.14, 1.4) * s, CFrame.new(), STEEL, metal)
	box(m, Vector3.new(0.14, 0.9, 0.14) * s, CFrame.new(0, -0.38 * s, -0.7 * s), STEEL, metal) -- bend down
	box(m, Vector3.new(0.14, 0.14, 0.52) * s, CFrame.new(0, -0.8 * s, -0.5 * s), STEEL, metal) -- bottom of the J
	box(m, Vector3.new(0.14, 0.5, 0.14) * s, CFrame.new(0, -0.57 * s, -0.27 * s) * CFrame.Angles(0.15, 0, 0), STEEL, metal) -- point
	box(m, Vector3.new(0.1, 0.26, 0.1) * s, CFrame.new(0, -0.42 * s, -0.37 * s) * CFrame.Angles(-0.75, 0, 0), STEEL, metal) -- barb
	-- Ring eye.
	for _, o in ipairs({ { 0.14, 0, 0.1, 0.34 }, { -0.14, 0, 0.1, 0.34 }, { 0, 0.14, 0.34, 0.1 }, { 0, -0.14, 0.34, 0.1 } }) do
		box(m, Vector3.new(o[3], o[4], 0.1) * s, CFrame.new(o[1] * s, o[2] * s, 0.8 * s), STEEL, metal)
	end
	-- Feather bait.
	box(m, Vector3.new(0.06, 0.32, 0.8) * s, CFrame.new(0, 0.22 * s, 0.95 * s) * CFrame.Angles(0.35, 0, 0), FEATHER)
	box(m, Vector3.new(0.07, 0.18, 0.6) * s, CFrame.new(0, 0.3 * s, 0.9 * s) * CFrame.Angles(0.35, 0, 0), FEATHER_LIGHT)
	m.PrimaryPart = shank
	return m
end

-- The winch from the picture: a cable drum with side wheels, axis along X.
local function buildWinch(scale)
	local m = newModel("WiredWinch")
	local s = scale or 1
	local metal = Enum.Material.Metal
	local hub = box(m, Vector3.new(0.9, 0.5, 0.5) * s, CFrame.new(), CABLE, metal)
	for _, side in ipairs({ -1, 1 }) do
		local cf = CFrame.new(side * 0.5 * s, 0, 0)
		box(m, Vector3.new(0.12, 1.0, 0.86) * s, cf, STEEL, metal)
		box(m, Vector3.new(0.12, 0.62, 1.0) * s, cf, STEEL, metal)
		box(m, Vector3.new(0.12, 1.0, 0.62) * s, cf, STEEL, metal)
		box(m, Vector3.new(0.14, 0.2, 0.2) * s, cf, PAN, metal) -- axle cap
	end
	-- Cable wound round the drum (stripes so the spin reads).
	for i = 0, 3 do
		box(m, Vector3.new(0.86, 0.08, 0.62) * s, CFrame.Angles(i * math.pi / 4, 0, 0), Color3.fromRGB(120, 124, 135), metal)
	end
	m.PrimaryPart = hub
	return m
end

local function mouthCF(character)
	local head = character and character:FindFirstChild("Head")
	if not head then
		local root = Common.rootOf(character)
		return root and root.CFrame * CFrame.new(0, 1.3, -0.8)
	end
	local s = head.Size.Y / 1.2
	return head.CFrame * CFrame.new(0, -0.3 * s, -0.65 * s)
end

local function torsoPos(model)
	local part = model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart"))
	return part and part.Position
end

local function characterById(userId)
	local player = userId and Players:GetPlayerByUserId(userId)
	return player and player.Character
end

---------------------------------------------------------------------------
-- Cables: a thin steel bar stretched between two points, updated every frame
---------------------------------------------------------------------------
local function newCable(width)
	return VFXLib.part({ Size = Vector3.new(width or 0.09, width or 0.09, 1), Color = CABLE, Material = Enum.Material.Metal })
end

local function setCable(cable, a, b)
	local d = (b - a).Magnitude
	if d < 0.05 then
		cable.Transparency = 1
		return
	end
	cable.Transparency = 0
	local w = cable.Size.X
	cable.Size = Vector3.new(w, w, d)
	cable.CFrame = CFrame.lookAt((a + b) / 2, b)
end

--[[ A cable from `getA()` to `getB()` with a hook at the B end, for `duration`
     seconds. getA/getB return a Vector3 or nil (nil = that end is gone). ]]
local function holdLine(getA, getB, duration, opts)
	opts = opts or {}
	local entry = {
		GetA = getA,
		GetB = getB,
		Cable = newCable(opts.Width),
		Hook = opts.NoHook and nil or buildHook(opts.HookScale or 1),
		Expire = os.clock() + duration,
		Shake = opts.Shake or 0,
	}
	table.insert(lines, entry)
	return entry
end

local function dropLine(entry)
	entry.Cable:Destroy()
	if entry.Hook then
		entry.Hook:Destroy()
	end
end

local function stepLines()
	local now = os.clock()
	for i = #lines, 1, -1 do
		local e = lines[i]
		local a, b = e.GetA(), e.GetB()
		if now > e.Expire or not a or not b then
			table.remove(lines, i)
			dropLine(e)
		else
			if e.Shake > 0 then
				-- A taut cable thrums.
				b = b + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * e.Shake
			end
			setCable(e.Cable, a, b)
			if e.Hook then
				local dir = (b - a).Magnitude > 0.1 and (b - a).Unit or Vector3.new(0, 0, -1)
				e.Hook:PivotTo(CFrame.lookAt(b, b + dir))
			end
		end
	end
end

---------------------------------------------------------------------------
-- Winch at the mouth
---------------------------------------------------------------------------
local function startWinch(character, duration)
	local w = winches[character]
	if w then
		w.Expire = math.max(w.Expire, os.clock() + duration)
		return
	end
	winches[character] = { Model = buildWinch(0.9), Angle = 0, Expire = os.clock() + duration }
end

local function stepWinches(dt)
	local now = os.clock()
	for character, w in pairs(winches) do
		local cf = character.Parent and mouthCF(character)
		if not cf or now > w.Expire then
			w.Model:Destroy()
			winches[character] = nil
		else
			w.Angle = w.Angle + dt * 25
			w.Model:PivotTo(cf * CFrame.new(0, 0, -0.55) * CFrame.Angles(w.Angle, 0, 0))
		end
	end
end

---------------------------------------------------------------------------
-- Water
---------------------------------------------------------------------------
local function splash(position, size)
	size = size or 1
	VFXLib.burst(position, { Count = math.floor(16 * size), Texture = VFXLib.Textures.Smoke, Color = WATER_LIGHT, LightEmission = 0.3, Speed = 22 * size, Lifetime = 0.55, Spread = 35, Direction = Vector3.new(0, 1, 0), Acceleration = Vector3.new(0, -60, 0) })
	VFXLib.burst(position, { Count = math.floor(10 * size), Color = WATER, Speed = 16 * size, Lifetime = 0.4 })
	TuskVFX.CreateRotationalShockwave(CFrame.new(position), { Radius = 3.5 * size, Layers = 1, Color = WATER_LIGHT, Color2 = WATER, Ground = true, Particles = 0.3, Width = 0.2, Duration = 0.4 })
end

local function buildPuddle(position, diameter)
	local m = newModel("WiredPuddle")
	local cf = CFrame.new(position + Vector3.new(0, 0.06, 0))
	local water = roundPlate(m, diameter, 0.1, cf, WATER, Enum.Material.Glass, 0.25)
	roundPlate(m, diameter * 0.55, 0.12, cf, WATER_LIGHT, Enum.Material.Neon, 0.6)
	m.PrimaryPart = water
	return m
end

-- A frying pan of water with a feather bait bobbing above it.
local function buildPan(position)
	local m = newModel("BaitPan")
	local base = CFrame.new(position + Vector3.new(0, 0.15, 0))
	local metal = Enum.Material.Metal
	local core = roundPlate(m, 3.2, 0.25, base, PAN, metal)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		box(m, Vector3.new(1.3, 0.45, 0.22), base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.25, -1.5), PAN, metal)
	end
	box(m, Vector3.new(0.35, 0.2, 2.2), base * CFrame.new(0, 0.3, 2.5), Color3.fromRGB(90, 60, 40)) -- handle
	roundPlate(m, 2.8, 0.1, base * CFrame.new(0, 0.32, 0), WATER, Enum.Material.Glass, 0.2)
	m.PrimaryPart = core
	local bait = buildHook(0.8)
	return m, bait
end

---------------------------------------------------------------------------
-- Hook projectiles (server Kind "WiredHook")
---------------------------------------------------------------------------
local function spawnHook(data)
	local owner = characterById(data.OwnerId)
	local v = {
		Model = buildHook(1.1),
		Cable = newCable(0.1),
		Owner = owner,
		Origin = data.Origin,
		Direction = data.Direction,
		Speed = data.Speed,
		Range = data.Range,
		ServerTime = data.ServerTime,
		Expire = os.clock() + data.Range / math.max(data.Speed, 1) + 1,
	}
	hooks[data.Id] = v
	if owner then
		startWinch(owner, data.Range / math.max(data.Speed, 1) + 0.2)
	end
end

local function hookPos(v)
	local distance = math.min(v.Speed * (workspace:GetServerTimeNow() - v.ServerTime), v.Range)
	return v.Origin + v.Direction * math.max(distance, 0)
end

local function removeHook(v)
	v.Model:Destroy()
	v.Cable:Destroy()
end

-- A miss: the hook whips back into his mouth.
local function retract(owner, from)
	local model = buildHook(1.1)
	local cable = newCable(0.1)
	VFXLib.animate(0.25, function(a)
		local m = owner and owner.Parent and mouthCF(owner)
		if not m then
			return
		end
		local p = from:Lerp(m.Position, VFXLib.easeInOut(a))
		local dir = (p - m.Position).Magnitude > 0.1 and (p - m.Position).Unit or Vector3.new(0, 0, -1)
		model:PivotTo(CFrame.lookAt(p, p + dir) * CFrame.Angles(0, 0, a * 6))
		setCable(cable, m.Position, p)
	end, function()
		model:Destroy()
		cable:Destroy()
	end)
end

local function endHook(data)
	local v = hooks[data.Id]
	if not v then
		return
	end
	hooks[data.Id] = nil
	removeHook(v)
	if not data.HitCharacter then
		VFXLib.burst(data.Position, { Count = 8, Color = STEEL, Speed = 18, Lifetime = 0.25 })
		VFXLib.sound(sounds.NailImpact, data.Position, 0.3, 1.5)
		retract(v.Owner, data.Position)
	end
end

local function stepHooks()
	local now = os.clock()
	for id, v in pairs(hooks) do
		local pos = hookPos(v)
		v.Model:PivotTo(CFrame.lookAt(pos, pos + v.Direction))
		local m = v.Owner and v.Owner.Parent and mouthCF(v.Owner)
		setCable(v.Cable, m and m.Position or v.Origin, pos)
		if now > v.Expire then
			hooks[id] = nil
			removeHook(v)
		end
	end
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local function mouthGetter(character)
	return function()
		local m = character and character.Parent and mouthCF(character)
		return m and m.Position
	end
end

local function targetGetter(target)
	return function()
		return target and target.Parent and torsoPos(target)
	end
end

local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	TuskAnimation.play(character, "P_M1_" .. index)
	VFXLib.sound(sounds.Swing, root, 0.5, 1.1 + index * 0.06)
	if index <= 2 then
		Common.swipe(root, index == 1 and 1 or -1, index == 1 and pal.Main or pal.Light)
	elseif index == 3 then
		-- A hook lashes out of his mouth and snaps back.
		local model = buildHook(0.9)
		local cable = newCable(0.08)
		VFXLib.animate(0.28, function(a)
			local m = character.Parent and mouthCF(character)
			if not m then
				return
			end
			local reach = math.sin(a * math.pi) * 6
			local p = (m * CFrame.new(math.sin(a * math.pi * 2) * 0.8, 0, -reach)).Position
			model:PivotTo(CFrame.lookAt(p, p + m.LookVector) * CFrame.Angles(0, 0, a * 8))
			setCable(cable, m.Position, p)
		end, function()
			model:Destroy()
			cable:Destroy()
		end)
		TuskVFX.CreateCrescent(root.CFrame * CFrame.new(0, 1.2, -2.4), { Radius = 3, Width = 0.2, Color = STEEL, Color2 = pal.Light, Sweep = 2, Duration = 0.2 })
	end
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local move, phase = data.Move, data.Phase
	if move == "WiredHook" then
		if phase == "Startup" and root then
			TuskAnimation.play(character, "PPHookSpit")
			VFXLib.sound(sounds.Warning, root, 0.3, 1.6)
		elseif phase == "Snag" and data.Target then
			TuskAnimation.play(character, "PPReel")
			startWinch(character, data.Duration + 0.2)
			holdLine(mouthGetter(character), targetGetter(data.Target), data.Duration + 0.15, { Width = 0.1, HookScale = 1.1, Shake = 0.08 })
			local tp = torsoPos(data.Target)
			if tp then
				VFXLib.burst(tp, { Count = 14, Color = STEEL, Speed = 24, Lifetime = 0.3 })
				TuskVFX.CreateImpactStar(tp, { Size = 4, Rays = 7, Color = pal.Main, Color2 = STEEL, Duration = 0.2 })
			end
			VFXLib.sound(sounds.Hit, root or data.Target, 0.6, 1.2)
			if Common.isLocal(character) or Common.isLocal(data.Target) then
				CameraFX.shake(0.3, 0.25)
			end
		end
	elseif move == "BaitPan" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "PPBaitToss")
		elseif phase == "Place" then
			local model, bait = buildPan(data.Position)
			pans[data.Id] = { Model = model, Bait = bait, Position = data.Position, Expire = os.clock() + (data.Duration or 10) + 1, T = 0, NextRipple = 0 }
			splash(data.Position + Vector3.new(0, 0.5, 0), 0.7)
			VFXLib.sound(sounds.NailImpact, data.Position, 0.4, 0.7)
		elseif phase == "Trigger" or phase == "Expire" then
			local pan = pans[data.Id]
			if pan then
				pans[data.Id] = nil
				pan.Model:Destroy()
				pan.Bait:Destroy()
			end
			local water = data.Position + Vector3.new(0, 0.5, 0)
			splash(water, phase == "Trigger" and 1.3 or 0.6)
			if phase == "Trigger" then
				-- Hooks burst out of the water and hoist whoever went for the bait.
				for _, target in ipairs(data.Targets or {}) do
					holdLine(function()
						return water
					end, targetGetter(target), (data.SlamAfter or 0.5) + 0.35, { Width = 0.1, HookScale = 1.1, Shake = 0.05 })
					task.delay((data.SlamAfter or 0.5) + 0.25, function()
						local tp = torsoPos(target)
						if tp then
							TuskVFX.CreateImpact(tp - Vector3.new(0, 2.5, 0), Vector3.new(0, 1, 0), { Size = 1.2, Radius = 5, Layers = 2, Color = pal.Main, Color2 = STEEL, Sound = sounds.NailImpact, Pitch = 0.7 })
							TuskVFX.CreateGroundCracks(tp, { Radius = 4.5, Count = 5, Color = pal.Second, Duration = 1.2 })
							CameraFX.shakeAt(tp, 0.45, 40)
						end
					end)
				end
				VFXLib.sound(sounds.Hit, data.Position, 0.7, 0.9)
				CameraFX.shakeAt(data.Position, 0.35, 40)
			end
		end
	elseif move == "DoubleHookLift" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "PPHoist")
			VFXLib.sound(sounds.Warning, root or character, 0.35, 1.3)
		elseif phase == "Hoist" and root then
			local targets = data.Targets or {}
			startWinch(character, (data.SlamAfter or 0.55) + 0.3)
			if #targets == 0 then
				-- Both hooks shoot out, catch nothing, and whip back.
				for side = -1, 1, 2 do
					local reach = data.Range or 20
					local model = buildHook(1)
					local cable = newCable(0.09)
					VFXLib.animate(0.45, function(a)
						local m = character.Parent and mouthCF(character)
						if not m then
							return
						end
						local out = math.sin(a * math.pi)
						local p = (m * CFrame.new(side * out * 2.5, 0, -out * reach)).Position
						model:PivotTo(CFrame.lookAt(p, p + m.LookVector))
						setCable(cable, m.Position, p)
					end, function()
						model:Destroy()
						cable:Destroy()
					end)
				end
			else
				for _, target in ipairs(targets) do
					holdLine(mouthGetter(character), targetGetter(target), (data.SlamAfter or 0.55) + 0.3, { Width = 0.11, HookScale = 1.15, Shake = 0.1 })
					local tp = torsoPos(target)
					if tp then
						VFXLib.burst(tp, { Count = 14, Color = STEEL, Speed = 24, Lifetime = 0.3 })
					end
				end
				VFXLib.sound(sounds.Hit, root, 0.7, 0.9)
				if Common.isLocal(character) then
					CameraFX.shake(0.35, 0.3)
				end
			end
		elseif phase == "Slam" then
			TuskVFX.CreateImpact(data.Position - Vector3.new(0, 2.5, 0), Vector3.new(0, 1, 0), { Size = 1.4, Radius = data.Radius or 6, Layers = 2, Color = pal.Main, Color2 = STEEL, Sound = sounds.NailImpact, Pitch = 0.6 })
			TuskVFX.CreateGroundCracks(data.Position, { Radius = data.Radius or 6, Count = 6, Color = pal.Second, Duration = 1.4 })
			CameraFX.shakeAt(data.Position, 0.6, 50)
		end
	end
end

local function clearPuddles()
	for _, p in ipairs(puddles) do
		p.Model:Destroy()
		if p.Bait then
			p.Bait:Destroy()
		end
	end
	puddles = {}
end

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Start" then
		TuskAnimation.play(character, "PPWinch")
		clearPuddles()
		for i, pos in ipairs(data.Puddles or {}) do
			task.delay((i - 1) * 0.08, function()
				local bait = buildHook(0.7)
				table.insert(puddles, { Model = buildPuddle(pos, 4), Bait = bait, Position = pos, T = i, Expire = os.clock() + 4 })
				splash(pos + Vector3.new(0, 0.3, 0), 0.6)
			end)
		end
		if root then
			VFXLib.flash(root.Position, WATER_LIGHT, 3, 30, 0.5)
		end
		if Common.isLocal(character) then
			TuskVFX.ScreenTint(data.Windup or 1, { Tint = WATER_LIGHT })
			CameraFX.fovPunch(-6, 0.5)
		end
	elseif data.Phase == "Snag" then
		local reel = data.ReelTime or 1.3
		startWinch(character, reel + 0.6)
		for k, target in ipairs(data.Targets or {}) do
			local puddle = data.Puddles and data.Puddles[data.From and data.From[k] or 1]
			if puddle then
				local water = puddle + Vector3.new(0, 0.3, 0)
				splash(water, 1.2)
				-- Out of the water first...
				holdLine(function()
					return water
				end, targetGetter(target), 0.3, { Width = 0.11, HookScale = 1.1 })
			end
			-- ...then the cable swings over to his mouth and the winch reels.
			task.delay(0.25, function()
				holdLine(mouthGetter(character), targetGetter(target), reel + 0.1, { Width = 0.12, HookScale = 1.15, Shake = 0.12 })
			end)
		end
		if root then
			VFXLib.sound(sounds.Hit, root, 0.8, 0.8)
		end
		if Common.isLocal(character) then
			CameraFX.shake(0.5, reel)
		end
	elseif data.Phase == "Slam" then
		clearPuddles()
		Common.finisher({ Character = character, Position = data.Position, Radius = data.Radius, Hit = true }, pal, { Size = 1.6, Layers = 3, Shake = 0.9 })
		splash(data.Position, 1.6)
		if Common.isLocal(character) then
			CameraFX.impactFrame(WATER_LIGHT)
		end
	end
end

---------------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------------
local function stepPans(dt)
	local now = os.clock()
	for id, pan in pairs(pans) do
		if now > pan.Expire then
			pans[id] = nil
			pan.Model:Destroy()
			pan.Bait:Destroy()
		else
			pan.T = pan.T + dt
			local p = pan.Position + Vector3.new(0, 2.6 + math.sin(pan.T * 2.4) * 0.35, 0)
			pan.Bait:PivotTo(CFrame.new(p) * CFrame.Angles(math.pi / 2, pan.T * 0.8, math.sin(pan.T * 3) * 0.3))
			if now >= pan.NextRipple then
				pan.NextRipple = now + 0.8
				TuskVFX.CreateRotationalShockwave(CFrame.new(pan.Position + Vector3.new(0, 0.5, 0)), { Radius = 1.6, Layers = 1, Color = WATER_LIGHT, Color2 = WATER, Ground = true, Particles = 0, Width = 0.08, Duration = 0.7 })
			end
		end
	end
	for i = #puddles, 1, -1 do
		local pd = puddles[i]
		if now > pd.Expire then
			pd.Model:Destroy()
			pd.Bait:Destroy()
			table.remove(puddles, i)
		else
			pd.T = pd.T + dt
			pd.Bait:PivotTo(CFrame.new(pd.Position + Vector3.new(0, 2 + math.sin(pd.T * 3) * 0.3, 0)) * CFrame.Angles(math.pi / 2, pd.T, 0))
		end
	end
end

local function stepStance()
	for _, player in ipairs(Fighters.list()) do
		local character = player.Character
		if character then
			local want = character:GetAttribute("TuskAct") == ACT
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "PPStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "PPStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
end

function PorkPie.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		Common.finisher(data, pal)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function PorkPie.step(dt)
	dt = dt or 1 / 60
	stepHooks()
	stepLines()
	stepWinches(dt)
	stepPans(dt)
	slowTimer = slowTimer + dt
	if slowTimer > 0.2 then
		slowTimer = 0
		stepStance()
	end
end

-- Hook projectiles come through the shared SpinFX channel.
Net.get("SpinFX").OnClientEvent:Connect(function(name, data)
	if typeof(data) ~= "table" or data.Kind ~= "WiredHook" then
		return
	end
	if name == "ProjectileSpawn" then
		spawnHook(data)
	elseif name == "ProjectileEnd" then
		endHook(data)
	end
end)

return PorkPie
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">Sandman_Client</string><ProtectedString name="Source"><![CDATA[--[[
	Sandman_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Sandman (Soundman): In a Silent Way.
	Its other half is Sandman_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: SandmanVFX
-- ======================================================================
__modules["SandmanVFX"] = function()
--[[
	TuskActVFX.SandmanVFX  (StarterPlayerScripts.SpinClient.TuskActVFX.SandmanVFX)

	Client visuals for Sandman (Soundman) / IN A SILENT WAY: sounds become
	solid, written sound effects (blocky 3D words) that do what they say.
	  * M1: chops and a kick, each hit pops a written sound ("ZAN!", "DOGO!")
	  * SOUND SLASH: "ZBAAK!" skims along the ground, cutting what it touches
	  * SOUND TRAP: "DOGOOON" lies on the ground, pulsing; it explodes when stepped near
	  * SAND RUN: a sprint with a sand trail, "ZAZAZA" along the path
	  * the IN A SILENT WAY Stand (SilentWayStand) floats behind him and
	    strikes with his moves
	  * SILENT SYMPHONY: sounds gather around him, rain down, then "DOOOOM!!"
]]

local Fighters = __require("Fighters")

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local Net = __require("Net")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")
local TuskStand = __require("TuskStand")
local SilentWayStand = __require("SilentWayStand")
local TuskStandModels = __require("TuskStandModels")

-- IN A SILENT WAY floats behind him (players and NPCs), like Tusk does.
TuskStandModels.register(8, SilentWayStand.build, { Aura = SilentWayStand.Aura, AuraLight = SilentWayStand.AuraLight, Offset = SilentWayStand.Offset })

local SandmanVFX = {}
local ACT = 8
local pal = Common.palette(ACT)
local sounds = TuskConfig.Sounds

local SAND = Color3.fromRGB(225, 190, 130)
local INK = Color3.fromRGB(30, 25, 35)
local FIRE = Color3.fromRGB(255, 120, 50)

local words = {} -- [projectile id] = flying word
local traps = {} -- [trap id] = word lying on the ground
local stanced = {}

---------------------------------------------------------------------------
-- Written sounds: a blocky 3D word (front face + a darker "extruded" back)
---------------------------------------------------------------------------
local function face(part, normal, text, color, stroke)
	local gui = Instance.new("SurfaceGui")
	gui.Face = normal
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Bangers
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = stroke
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return label
end

local function newWord(text, height, color)
	color = color or pal.Main
	local m = Instance.new("Model")
	m.Name = "SoundWord"
	m.Parent = VFXLib.Folder
	local size = Vector3.new(math.max(#text, 2) * height * 0.62, height, 0.1)
	local front = VFXLib.part({ Size = size, Transparency = 1 })
	front.Parent = m
	local labels = { face(front, Enum.NormalId.Front, text, color, INK), face(front, Enum.NormalId.Back, text, color, INK) }
	-- The "solid" depth: the same word, darker, a little behind.
	for k = 1, 2 do
		local depth = VFXLib.part({ Size = size, Transparency = 1, CFrame = front.CFrame * CFrame.new(0, -0.06 * k * height, 0.12 * k * height) })
		depth.Parent = m
		local dark = color:Lerp(INK, 0.35 + k * 0.2)
		table.insert(labels, face(depth, Enum.NormalId.Front, text, dark, dark))
		table.insert(labels, face(depth, Enum.NormalId.Back, text, dark, dark))
	end
	m.PrimaryPart = front
	return { Model = m, Labels = labels, Height = height }
end

local function setWordFade(w, t)
	for _, l in ipairs(w.Labels) do
		l.TextTransparency = t
		l.TextStrokeTransparency = math.max(t, 0)
	end
end

-- A word that pops out at `position`, grows, floats up and fades.
local function popWord(text, position, height, color, facing, duration)
	local w = newWord(text, height or 1.6, color)
	local look = facing or (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position) or position + Vector3.new(0, 0, -1)
	local tilt = (math.random() - 0.5) * 0.5
	VFXLib.animate(duration or 0.55, function(a)
		local grow = a < 0.2 and VFXLib.easeOut(a / 0.2) * 1.15 or 1.15 - (a - 0.2) * 0.2
		local p = position + Vector3.new(0, a * 1.6, 0)
		w.Model:PivotTo(CFrame.lookAt(p, Vector3.new(look.X, p.Y, look.Z)) * CFrame.Angles(0, 0, tilt) * CFrame.new(0, 0, 0))
		w.Model:ScaleTo(math.max(grow, 0.05))
		setWordFade(w, a > 0.65 and (a - 0.65) / 0.35 or 0)
	end, function()
		w.Model:Destroy()
	end)
end

local function sandBurst(position, count, speed)
	VFXLib.burst(position, { Count = count or 12, Texture = VFXLib.Textures.Smoke, Color = SAND, LightEmission = 0, Speed = speed or 14, Lifetime = 0.7, Acceleration = Vector3.new(0, -10, 0) })
end

---------------------------------------------------------------------------
-- Flying words (server Kind "SoundWord")
---------------------------------------------------------------------------
local function spawnWord(data)
	local text = data.Visual and data.Visual.Text or "ZBAAK!"
	words[data.Id] = {
		Word = newWord(text, 2.2, pal.Main),
		Origin = data.Origin,
		Direction = data.Direction,
		Speed = data.Speed,
		Range = data.Range,
		ServerTime = data.ServerTime,
		Expire = os.clock() + data.Range / math.max(data.Speed, 1) + 1,
		NextDust = 0,
	}
end

local function endWord(data)
	local v = words[data.Id]
	if v then
		words[data.Id] = nil
		v.Word.Model:Destroy()
	end
	local pos = data.Position
	TuskVFX.CreateCrescent(CFrame.lookAt(pos, pos + (v and v.Direction or Vector3.new(0, 0, -1))), { Radius = 3, Width = 0.35, Color = pal.Main, Color2 = Color3.new(1, 1, 1), Sweep = 2.4, Duration = 0.22 })
	popWord(data.HitCharacter and "ZAN!!" or "ZAK", pos + Vector3.new(0, 1.5, 0), data.HitCharacter and 1.8 or 1.2, data.HitCharacter and pal.Main or SAND)
	sandBurst(pos, 10, 16)
	VFXLib.sound(sounds.NailImpact, pos, 0.4, 1.2)
	if data.HitCharacter then
		CameraFX.shakeAt(pos, 0.35, 40)
	end
end

local function stepWords()
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	for id, v in pairs(words) do
		local distance = math.min(v.Speed * (serverNow - v.ServerTime), v.Range)
		local pos = v.Origin + v.Direction * math.max(distance, 0)
		local wobble = math.sin(distance * 0.6) * 0.15
		-- Skims along edge-on like a blade, tilted slightly.
		v.Word.Model:PivotTo(CFrame.lookAt(pos, pos + v.Direction) * CFrame.Angles(0, math.pi / 2, wobble))
		if now >= v.NextDust then
			v.NextDust = now + 0.06
			sandBurst(pos - Vector3.new(0, 1, 0), 3, 6)
		end
		if now > v.Expire then
			words[id] = nil
			v.Word.Model:Destroy()
		end
	end
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local M1_WORDS = { "ZAN!", "ZASH!", "DOGO!", "DOGOOO!" }

local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	TuskAnimation.play(character, "S_M1_" .. index)
	-- The Stand strikes with him.
	TuskStand.action(character, "Lunge", { Target = CFrame.new(index % 2 == 0 and -0.8 or 0.8, 1, -3), Duration = 0.3 })
	VFXLib.sound(sounds.Swing, root, 0.5, 1.05 + index * 0.06)
	local side = index % 2 == 1 and 1 or -1
	if index <= 2 then
		Common.swipe(root, side, index == 1 and pal.Main or pal.Light)
	elseif index == 3 then
		TuskVFX.CreateCrescent(root.CFrame * CFrame.new(0, -1.4, 0), { Radius = 4, Width = 0.4, Arc = math.rad(220), Sweep = 3, Color = pal.Main, Color2 = SAND, Duration = 0.26 })
		sandBurst(root.Position - Vector3.new(0, 2.6, 0), 10, 12)
	end
	task.delay(0.1, function()
		if root.Parent and index < 4 then
			popWord(M1_WORDS[index], (root.CFrame * CFrame.new(side * 0.8, 1, -3)).Position, 1.1, index == 3 and SAND or pal.Main)
		end
	end)
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local move, phase = data.Move, data.Phase
	if move == "SoundSlash" and phase == "Startup" and character then
		TuskAnimation.play(character, "SandSlash")
		TuskStand.action(character, "Lunge", { Duration = 0.4 })
		if root then
			popWord("SHH...", (root.CFrame * CFrame.new(0, 2.5, -1)).Position, 0.9, pal.Light, nil, 0.4)
		end
	elseif move == "SoundTrap" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "SandTrap")
			TuskStand.action(character, "Lunge", { Duration = 0.45 })
		elseif phase == "Place" then
			local w = newWord("DOGOOON", 1.6, FIRE)
			local spin = math.random() * math.pi * 2
			traps[data.Id] = { Word = w, Position = data.Position, Spin = spin, T = 0, Expire = os.clock() + (data.Lifetime or 15) + 1 }
			sandBurst(data.Position, 8, 8)
			VFXLib.sound(sounds.Warning, data.Position, 0.25, 0.8)
		elseif phase == "Boom" or phase == "Expire" then
			local trap = traps[data.Id]
			if trap then
				traps[data.Id] = nil
				trap.Word.Model:Destroy()
			end
			if phase == "Boom" then
				local pos = data.Position + Vector3.new(0, 1, 0)
				TuskVFX.CreateImpact(pos, Vector3.new(0, 1, 0), { Size = 1.8, Radius = data.Radius or 8, Layers = 3, Color = FIRE, Color2 = pal.Light, Sound = sounds.Finisher, Pitch = 0.8 })
				VFXLib.burst(pos, { Count = 30, Color = FIRE, Speed = 40, Lifetime = 0.6 })
				VFXLib.burst(pos, { Count = 16, Texture = VFXLib.Textures.Smoke, Color = Color3.fromRGB(70, 60, 55), LightEmission = 0, Speed = 18, Lifetime = 1.2, Acceleration = Vector3.new(0, 8, 0) })
				TuskVFX.CreateGroundCracks(data.Position, { Radius = (data.Radius or 8) * 0.9, Count = 7, Color = FIRE, Duration = 1.4 })
				VFXLib.flash(pos, FIRE, 6, 30, 0.3)
				popWord("DOGOOON!!", pos + Vector3.new(0, 3, 0), 3, FIRE, nil, 0.8)
				CameraFX.shakeAt(pos, 0.7, 60)
			end
		end
	elseif move == "SandRun" then
		if phase == "Startup" and character then
			TuskAnimation.play(character, "SandRun")
			TuskStand.action(character, "Lunge", { Duration = 0.5 })
			if root then
				sandBurst(root.Position - Vector3.new(0, 2.6, 0), 14, 18)
			end
		elseif phase == "Run" then
			local from, to = data.From, data.To
			local steps = math.max(3, math.floor((to - from).Magnitude / 4))
			for i = 0, steps do
				local p = from:Lerp(to, i / steps)
				task.delay(i * 0.015, function()
					sandBurst(p - Vector3.new(0, 2.4, 0), 6, 10)
					VFXLib.afterimage(CFrame.lookAt(p, p + data.Direction), 2, SAND)
				end)
			end
			popWord("ZAZAZAZA", from:Lerp(to, 0.5) + Vector3.new(0, 3, 0), 1.6, SAND, nil, 0.7)
			for _, target in ipairs(data.Targets or {}) do
				local tr = Common.rootOf(target)
				if tr then
					popWord("DOM!", tr.Position + Vector3.new(0, 2, 0), 1.4, pal.Main)
					TuskVFX.CreateImpactStar(tr.Position, { Size = 4, Rays = 7, Color = pal.Main, Color2 = SAND, Duration = 0.2 })
				end
			end
			VFXLib.sound(sounds.Swing, to, 0.6, 0.8)
			if Common.isLocal(character) then
				CameraFX.speedLines(0.3, SAND)
				CameraFX.fovPunch(8, 0.25)
			end
		end
	end
end

local GATHER = { "GOGOGO", "ZZZ", "DOOO", "KIN", "BAAN", "ZAA" }

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Start" then
		TuskAnimation.play(character, "SandSymphony")
		TuskStand.action(character, "Manifest", { Duration = 0.9 })
		if root then
			-- Sounds gather round him, orbiting.
			local list = {}
			for i, text in ipairs(GATHER) do
				list[i] = newWord(text, 1.2, i % 2 == 0 and pal.Main or pal.Light)
			end
			VFXLib.animate(data.Windup or 1, function(a)
				if not root.Parent then
					return
				end
				for i, w in ipairs(list) do
					local ang = i / #list * math.pi * 2 + a * 6
					local r = 6 - a * 3
					local p = root.Position + Vector3.new(math.cos(ang) * r, 1 + math.sin(a * 8 + i) * 0.6, math.sin(ang) * r)
					w.Model:PivotTo(CFrame.lookAt(p, root.Position + Vector3.new(0, 1, 0)))
					setWordFade(w, a > 0.85 and (a - 0.85) / 0.15 or 0)
				end
			end, function()
				for _, w in ipairs(list) do
					w.Model:Destroy()
				end
			end)
			TuskVFX.CreateGroundCracks(data.Position, { Radius = data.Radius or 13, Count = 4, Color = pal.Second, Duration = (data.Windup or 1) + 1.5 })
		end
		if Common.isLocal(character) then
			TuskVFX.ScreenTint(data.Windup or 1, { Tint = Color3.fromRGB(255, 230, 190), Saturation = -0.5 })
		end
	elseif data.Phase == "Wave" then
		-- Written sounds rain down on the area.
		local center, radius = data.Position, data.Radius or 13
		for k = 1, 3 do
			local a = math.random() * math.pi * 2
			local d = math.random() * radius * 0.8
			local spot = center + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
			local w = newWord(GATHER[math.random(1, #GATHER)], 1.8, k % 2 == 0 and pal.Main or FIRE)
			VFXLib.animate(0.22, function(t)
				local p = spot + Vector3.new(0, 14 * (1 - t), 0)
				w.Model:PivotTo(CFrame.new(p) * CFrame.Angles(-math.pi / 2 * t, a, 0))
			end, function()
				w.Model:Destroy()
				VFXLib.burst(spot + Vector3.new(0, 0.5, 0), { Count = 10, Color = k % 2 == 0 and pal.Main or FIRE, Speed = 24, Lifetime = 0.35 })
				sandBurst(spot, 6, 10)
			end)
		end
		CameraFX.shakeAt(center, 0.35, 50)
	elseif data.Phase == "Final" then
		local pos = data.Position + Vector3.new(0, 1, 0)
		Common.finisher({ Character = character, Position = pos, Radius = data.Radius, Hit = true }, pal, { Size = 1.8, Layers = 3, Shake = 1 })
		VFXLib.burst(pos, { Count = 40, Color = FIRE, Speed = 50, Lifetime = 0.7 })
		popWord("DOOOOM!!", pos + Vector3.new(0, 5, 0), 4, FIRE, nil, 1.1)
		if Common.isLocal(character) then
			CameraFX.impactFrame(pal.Light)
		end
	end
end

---------------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------------
local function stepTraps(dt)
	local now = os.clock()
	for id, trap in pairs(traps) do
		if now > trap.Expire then
			traps[id] = nil
			trap.Word.Model:Destroy()
		else
			trap.T = trap.T + dt
			-- Lies flat on the ground, breathing like it's about to go off.
			local p = trap.Position + Vector3.new(0, 0.25, 0)
			trap.Word.Model:PivotTo(CFrame.new(p) * CFrame.Angles(0, trap.Spin, 0) * CFrame.Angles(-math.pi / 2, 0, 0))
			trap.Word.Model:ScaleTo(1 + math.sin(trap.T * 6) * 0.08)
		end
	end
end

local function stepStance()
	for _, player in ipairs(Fighters.list()) do
		local character = player.Character
		if character then
			local want = character:GetAttribute("TuskAct") == ACT
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "SandStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "SandStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
end

function SandmanVFX.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		Common.finisher(data, pal)
		popWord("DOGOOO!", data.Position + Vector3.new(0, 2, 0), 2, pal.Main, nil, 0.7)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function SandmanVFX.step(dt)
	dt = dt or 1 / 60
	stepWords()
	stepTraps(dt)
	slowTimer = slowTimer + dt
	if slowTimer > 0.2 then
		slowTimer = 0
		stepStance()
	end
end

Net.get("SpinFX").OnClientEvent:Connect(function(name, data)
	if typeof(data) ~= "table" or data.Kind ~= "SoundWord" then
		return
	end
	if name == "ProjectileSpawn" then
		spawnWord(data)
	elseif name == "ProjectileEnd" then
		endWord(data)
	end
end)

return SandmanVFX
end

-- ======================================================================
-- MODULE: SilentWayStand
-- ======================================================================
__modules["SilentWayStand"] = function()
--[[
	TuskActVFX.SilentWayStand  (StarterPlayerScripts.SpinClient.TuskActVFX.SilentWayStand)

	The IN A SILENT WAY Stand model (Sandman), blocky, matched to the art:
	  * a golden armoured body with six orange roses down the chest
	  * a skull face under a gold helmet with round orange goggle eyes and a
	    spiral emblem on the forehead
	  * a huge feather headdress: white feathers with dark red tips
	  * big gold shoulder pads, gold arms with zigzag bands, bony white hands
	  * a gold skirt with zigzags and spirals, patterned gold legs
	Registered with TuskStandModels by SandmanVFX, so TuskStand floats it
	behind Sandman (players and NPCs) with a golden aura, exactly like Tusk.
	A custom model at ReplicatedStorage.SpinAssets.TuskAct8 replaces it.
]]

local SilentWayStand = {}

local GOLD = Color3.fromRGB(232, 182, 52)
local GOLD_DARK = Color3.fromRGB(170, 116, 30)
local ORANGE = Color3.fromRGB(236, 120, 44)
local ROSE = Color3.fromRGB(214, 84, 44)
local ROSE_DARK = Color3.fromRGB(140, 40, 28)
local BONE = Color3.fromRGB(238, 230, 212)
local BONE_DARK = Color3.fromRGB(190, 178, 156)
local DARK = Color3.fromRGB(46, 28, 22)
local FEATHER = Color3.fromRGB(242, 238, 228)
local FEATHER_TIP = Color3.fromRGB(122, 38, 30)
local EYE = Color3.fromRGB(255, 120, 40)

SilentWayStand.Aura = Color3.fromRGB(255, 196, 70)
SilentWayStand.AuraLight = Color3.fromRGB(255, 240, 180)
SilentWayStand.Offset = CFrame.new(2.7, 1.7, 3.3) -- big: floats further back

local function newPart(model, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.Color = color
	p.Parent = model
	return p
end

-- A box welded to `parent` at local `cf` (the Weld's C0 can be animated).
local function box(model, parent, name, size, color, cf, material)
	local p = newPart(model, name, size, color, material)
	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = p
	w.C0 = cf
	w.Parent = p
	p.CFrame = parent.CFrame * cf
	return p, w
end

-- A blocky rose facing -Z at `cf`.
local function rose(model, parent, cf, s)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		box(model, parent, "Petal", Vector3.new(0.3, 0.3, 0.12) * s, i % 2 == 0 and ROSE or ORANGE, cf * CFrame.new(math.cos(a) * 0.13 * s, math.sin(a) * 0.13 * s, 0) * CFrame.Angles(0, 0, a))
	end
	box(model, parent, "Petal", Vector3.new(0.26, 0.26, 0.12) * s, ORANGE, cf * CFrame.new(0, 0, -0.05 * s) * CFrame.Angles(0, 0, math.pi / 4))
	box(model, parent, "RoseCore", Vector3.new(0.13, 0.13, 0.1) * s, ROSE_DARK, cf * CFrame.new(0, 0, -0.1 * s))
end

-- A square spiral (ring + centre) facing -Z at `cf`.
local function spiral(model, parent, cf, size, color)
	local t = size * 0.18
	box(model, parent, "Spiral", Vector3.new(size, t, 0.05), color, cf * CFrame.new(0, size / 2 - t / 2, 0))
	box(model, parent, "Spiral", Vector3.new(size, t, 0.05), color, cf * CFrame.new(0, -size / 2 + t / 2, 0))
	box(model, parent, "Spiral", Vector3.new(t, size, 0.05), color, cf * CFrame.new(size / 2 - t / 2, 0, 0))
	box(model, parent, "Spiral", Vector3.new(t, size * 0.6, 0.05), color, cf * CFrame.new(-size / 2 + t / 2, -size * 0.2, 0))
	box(model, parent, "Spiral", Vector3.new(t * 1.4, t * 1.4, 0.05), color, cf)
end

-- A row of zigzag diamonds across a face.
local function zigzag(model, parent, cf, width, count, color, s)
	for i = 0, count - 1 do
		local x = (i - (count - 1) / 2) * width / count
		box(model, parent, "Zigzag", Vector3.new(0.16, 0.16, 0.04) * s, color, cf * CFrame.new(x, 0, 0) * CFrame.Angles(0, 0, math.pi / 4))
	end
end

function SilentWayStand.build(scale)
	local s = (scale or 1) * 0.85
	local model = Instance.new("Model")
	model.Name = "InASilentWay"
	local rig = { Joints = {} }

	-- Torso (the anchored root the Stand is moved by).
	local torso = newPart(model, "Body", Vector3.new(2.4, 2.2, 1.2) * s, GOLD)
	torso.Anchored = true
	torso.Massless = false
	torso.CFrame = CFrame.new()
	model.PrimaryPart = torso
	rig.Body = torso
	local front = -0.6 * s
	box(model, torso, "Collar", Vector3.new(2.6, 0.32, 1.32) * s, GOLD_DARK, CFrame.new(0, 1.0 * s, 0))
	box(model, torso, "Chest", Vector3.new(1.9, 1.5, 0.12) * s, GOLD_DARK, CFrame.new(0, 0.1 * s, front - 0.04 * s))
	-- Six roses down the chest.
	for _, x in ipairs({ -0.5, 0.5 }) do
		for _, y in ipairs({ 0.6, 0.05, -0.5 }) do
			rose(model, torso, CFrame.new(x * s, y * s, front - 0.14 * s), s * 1.1)
		end
	end
	box(model, torso, "Belt", Vector3.new(2.5, 0.3, 1.3) * s, GOLD_DARK, CFrame.new(0, -1.0 * s, 0))
	-- Skirt with zigzags and spirals.
	box(model, torso, "Skirt", Vector3.new(2.5, 1.5, 1.36) * s, GOLD, CFrame.new(0, -1.85 * s, 0))
	box(model, torso, "SkirtHem", Vector3.new(2.6, 0.18, 1.44) * s, GOLD_DARK, CFrame.new(0, -2.55 * s, 0))
	zigzag(model, torso, CFrame.new(0, -1.4 * s, -0.7 * s), 2.2 * s, 9, ORANGE, s)
	zigzag(model, torso, CFrame.new(0, -2.25 * s, -0.7 * s), 2.2 * s, 9, DARK, s)
	for _, x in ipairs({ -0.7, 0.7 }) do
		spiral(model, torso, CFrame.new(x * s, -1.85 * s, -0.71 * s), 0.42 * s, DARK)
	end

	-- Head: a skull under a gold helmet.
	local headBase = CFrame.new(0, 1.15 * s, 0)
	local headOffset = CFrame.new(0, 0.62 * s, 0)
	local head, headWeld = box(model, torso, "Head", Vector3.new(1.1, 1.2, 1.1) * s, BONE, headBase * headOffset)
	rig.Joints.Head = { Weld = headWeld, Base = headBase, Offset = headOffset }
	local hf = -0.55 * s
	box(model, head, "Helmet", Vector3.new(1.26, 0.6, 1.26) * s, GOLD, CFrame.new(0, 0.38 * s, 0))
	box(model, head, "Visor", Vector3.new(1.24, 0.46, 0.12) * s, GOLD, CFrame.new(0, 0.12 * s, hf - 0.06 * s))
	for _, side in ipairs({ -1, 1 }) do
		box(model, head, "Eye", Vector3.new(0.34, 0.34, 0.08) * s, EYE, CFrame.new(side * 0.28 * s, 0.1 * s, hf - 0.14 * s), Enum.Material.Neon)
		box(model, head, "EyeRim", Vector3.new(0.42, 0.06, 0.06) * s, GOLD_DARK, CFrame.new(side * 0.28 * s, 0.3 * s, hf - 0.14 * s))
		box(model, head, "Pupil", Vector3.new(0.12, 0.12, 0.06) * s, DARK, CFrame.new(side * 0.28 * s, 0.1 * s, hf - 0.19 * s))
		-- Cheekbones.
		box(model, head, "Cheek", Vector3.new(0.28, 0.14, 0.06) * s, BONE_DARK, CFrame.new(side * 0.32 * s, -0.16 * s, hf - 0.03 * s))
	end
	spiral(model, head, CFrame.new(0, 0.5 * s, hf - 0.14 * s), 0.3 * s, GOLD_DARK)
	-- Skull: nose hole and a grin of teeth.
	box(model, head, "Nose", Vector3.new(0.14, 0.16, 0.05) * s, DARK, CFrame.new(0, -0.14 * s, hf - 0.03 * s))
	box(model, head, "Mouth", Vector3.new(0.78, 0.24, 0.05) * s, DARK, CFrame.new(0, -0.4 * s, hf - 0.03 * s))
	for i = -2, 2 do
		box(model, head, "Tooth", Vector3.new(0.11, 0.2, 0.06) * s, BONE, CFrame.new(i * 0.15 * s, -0.4 * s, hf - 0.05 * s))
	end
	-- Feather headdress: a big fan behind the helmet, a shorter inner row.
	box(model, head, "Band", Vector3.new(1.34, 0.16, 1.34) * s, GOLD_DARK, CFrame.new(0, 0.2 * s, 0))
	local fanRoot = CFrame.new(0, 0.45 * s, 0.4 * s) * CFrame.Angles(-0.35, 0, 0)
	local count = 13
	for i = 0, count - 1 do
		local a = math.rad(-84 + i * 168 / (count - 1))
		local dir = fanRoot * CFrame.Angles(0, 0, a)
		box(model, head, "Feather", Vector3.new(0.26, 1.5, 0.06) * s, FEATHER, dir * CFrame.new(0, 1.15 * s, 0))
		box(model, head, "FeatherTip", Vector3.new(0.28, 0.5, 0.07) * s, FEATHER_TIP, dir * CFrame.new(0, 2.05 * s, 0))
	end
	for i = 0, 8 do
		local a = math.rad(-64 + i * 16)
		local dir = fanRoot * CFrame.new(0, 0, -0.08 * s) * CFrame.Angles(0, 0, a)
		box(model, head, "Feather", Vector3.new(0.22, 0.9, 0.06) * s, FEATHER, dir * CFrame.new(0, 0.85 * s, 0))
		box(model, head, "FeatherTip", Vector3.new(0.24, 0.3, 0.07) * s, ORANGE, dir * CFrame.new(0, 1.38 * s, 0))
	end

	-- Shoulders and arms (bony hands).
	for _, a in ipairs({ { "ArmL", -1 }, { "ArmR", 1 } }) do
		local side = a[2]
		box(model, torso, "ShoulderPad", Vector3.new(1.0, 0.7, 1.3) * s, GOLD, CFrame.new(side * 1.5 * s, 0.95 * s, 0))
		box(model, torso, "ShoulderTrim", Vector3.new(1.06, 0.14, 1.36) * s, GOLD_DARK, CFrame.new(side * 1.5 * s, 0.62 * s, 0))
		for k = -1, 1 do
			box(model, torso, "Spike", Vector3.new(0.16, 0.3, 0.16) * s, GOLD_DARK, CFrame.new(side * 1.55 * s, 1.38 * s, k * 0.38 * s) * CFrame.Angles(0, 0, side * -0.3))
		end
		local base = CFrame.new(side * 1.55 * s, 0.6 * s, 0)
		local offset = CFrame.new(0, -1.15 * s, 0)
		local arm, weld = box(model, torso, a[1], Vector3.new(0.72, 2.3, 0.72) * s, GOLD, base * offset)
		rig.Joints[a[1]] = { Weld = weld, Base = base, Offset = offset }
		box(model, arm, "ArmBand", Vector3.new(0.8, 0.22, 0.8) * s, ORANGE, CFrame.new(0, 0.1 * s, 0))
		box(model, arm, "Cuff", Vector3.new(0.82, 0.3, 0.82) * s, GOLD_DARK, CFrame.new(0, -0.95 * s, 0))
		zigzag(model, arm, CFrame.new(0, -0.5 * s, -0.37 * s), 0.6 * s, 3, DARK, s)
		local hand = box(model, arm, "Hand", Vector3.new(0.6, 0.42, 0.5) * s, BONE, CFrame.new(0, -1.35 * s, 0))
		for f = -1.5, 1.5 do
			box(model, hand, "Finger", Vector3.new(0.11, 0.42, 0.11) * s, BONE, CFrame.new(f * 0.14 * s, -0.36 * s, -0.08 * s))
			box(model, hand, "Knuckle", Vector3.new(0.13, 0.08, 0.13) * s, BONE_DARK, CFrame.new(f * 0.14 * s, -0.24 * s, -0.08 * s))
		end
		if a[1] == "ArmR" then
			local point = Instance.new("Attachment")
			point.Name = "NailPoint"
			point.Position = Vector3.new(0, -0.4 * s, 0)
			point.Parent = hand
			rig.NailPoint = point
		end
	end

	-- Legs: gold with zigzag knee bands and gold feet.
	for i, side in ipairs({ -1, 1 }) do
		local base = CFrame.new(side * 0.6 * s, -2.3 * s, 0)
		local offset = CFrame.new(0, -1.0 * s, 0)
		local leg, weld = box(model, torso, "Leg" .. i, Vector3.new(0.85, 2.0, 0.85) * s, GOLD, base * offset)
		rig.Joints["Leg" .. i] = { Weld = weld, Base = base, Offset = offset }
		box(model, leg, "KneeBand", Vector3.new(0.92, 0.36, 0.92) * s, GOLD_DARK, CFrame.new(0, 0.1 * s, 0))
		zigzag(model, leg, CFrame.new(0, 0.1 * s, -0.47 * s), 0.7 * s, 3, ORANGE, s)
		box(model, leg, "Foot", Vector3.new(0.9, 0.3, 1.2) * s, GOLD_DARK, CFrame.new(0, -1.05 * s, -0.15 * s))
	end
	return model, rig
end

return SilentWayStand
end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">Valentine_Client</string><ProtectedString name="Source"><![CDATA[--[[
	Valentine_Client  (ModuleScript)
	PUT IT IN: ReplicatedStorage > SpinCharacters   (make a Folder named SpinCharacters there if it doesn't exist)

	Funny Valentine: D4C (Dirty Deeds Done Dirt Cheap).
	Its other half is Valentine_Server in ServerScriptService > SpinCharacters.
	Loaded by Spin_Client: don't put any code in front of this.
]]

return function(__modules, __require, __hasModule)

-- ======================================================================
-- MODULE: D4CStand
-- ======================================================================
__modules["D4CStand"] = function()
--[[
	TuskActVFX.D4CStand  (StarterPlayerScripts.SpinClient.TuskActVFX.D4CStand)

	The D4C (Dirty Deeds Done Dirt Cheap) Stand model (Funny Valentine),
	blocky, matched to the art:
	  * a sleek, shiny ice-blue humanoid
	  * two long flat rabbit ears swept up and back from the head
	  * a narrow face with a ridge down the middle and dark eyes
	  * big pink balls on the shoulders, pink briefs at the hips
	  * white crosses on the chest, thin pink lines down the arms and legs
	Registered with TuskStandModels by ValentineVFX, so TuskStand floats it
	behind Valentine (players and NPCs) with an ice-blue aura. A custom model
	at ReplicatedStorage.SpinAssets.TuskAct13 replaces it.
]]

local D4CStand = {}

local BODY = Color3.fromRGB(176, 228, 240)
local BODY_SHADE = Color3.fromRGB(130, 194, 214)
local SHINE = Color3.fromRGB(236, 250, 255)
local PINK = Color3.fromRGB(234, 124, 166)
local WHITE = Color3.fromRGB(250, 252, 255)
local DARK = Color3.fromRGB(40, 60, 80)

D4CStand.Aura = Color3.fromRGB(140, 220, 240)
D4CStand.AuraLight = Color3.fromRGB(230, 240, 255)
D4CStand.Offset = CFrame.new(2.3, 1.6, 2.8)

local function newPart(model, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.Color = color
	p.Parent = model
	return p
end

local function box(model, parent, name, size, color, cf, material)
	local p = newPart(model, name, size, color, material)
	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = p
	w.C0 = cf
	w.Parent = p
	p.CFrame = parent.CFrame * cf
	return p, w
end

-- Thin pink lines down both sides of a limb.
local function pinkLines(model, parent, size, s)
	for _, side in ipairs({ -1, 1 }) do
		box(model, parent, "PinkLine", Vector3.new(0.05 * s, size.Y * 0.9, 0.08 * s), PINK, CFrame.new(side * (size.X / 2 + 0.01 * s), 0, 0))
	end
end

-- A white cross (+) on a face.
local function cross(model, parent, cf, size)
	box(model, parent, "Cross", Vector3.new(size, size * 0.28, 0.05), WHITE, cf)
	box(model, parent, "Cross", Vector3.new(size * 0.28, size, 0.05), WHITE, cf)
end

function D4CStand.build(scale)
	local s = (scale or 1) * 0.85
	local model = Instance.new("Model")
	model.Name = "D4C"
	local rig = { Joints = {} }

	-- Sleek torso (the anchored root the Stand is moved by), narrowing to the waist.
	local torso = newPart(model, "Body", Vector3.new(2.0, 1.7, 1.0) * s, BODY, Enum.Material.SmoothPlastic)
	torso.Reflectance = 0.12
	torso.Anchored = true
	torso.Massless = false
	torso.CFrame = CFrame.new()
	model.PrimaryPart = torso
	rig.Body = torso
	local front = -0.51 * s
	box(model, torso, "Chest", Vector3.new(1.7, 0.9, 0.1) * s, BODY_SHADE, CFrame.new(0, 0.3 * s, front - 0.02 * s))
	cross(model, torso, CFrame.new(-0.4 * s, 0.35 * s, front - 0.08 * s), 0.5 * s)
	cross(model, torso, CFrame.new(0.4 * s, 0.35 * s, front - 0.08 * s), 0.5 * s)
	box(model, torso, "Waist", Vector3.new(1.4, 0.7, 0.8) * s, BODY_SHADE, CFrame.new(0, -1.1 * s, 0))
	for k = 0, 1 do
		box(model, torso, "Ab", Vector3.new(0.9, 0.22, 0.06) * s, BODY, CFrame.new(0, (-0.95 - k * 0.28) * s, -0.42 * s))
	end
	-- Pink briefs at the hips.
	box(model, torso, "Briefs", Vector3.new(1.5, 0.5, 0.86) * s, PINK, CFrame.new(0, -1.6 * s, 0))
	box(model, torso, "Neck", Vector3.new(0.45, 0.45, 0.45) * s, BODY_SHADE, CFrame.new(0, 1.05 * s, 0))

	-- Head: narrow, a ridge down the face, dark eyes, long flat rabbit ears swept back.
	local headBase = CFrame.new(0, 1.15 * s, 0)
	local headOffset = CFrame.new(0, 0.55 * s, 0)
	local head, headWeld = box(model, torso, "Head", Vector3.new(0.8, 1.1, 0.9) * s, BODY, headBase * headOffset)
	head.Reflectance = 0.12
	rig.Joints.Head = { Weld = headWeld, Base = headBase, Offset = headOffset }
	local hf = -0.45 * s
	box(model, head, "Ridge", Vector3.new(0.1, 0.9, 0.08) * s, SHINE, CFrame.new(0, 0, hf - 0.03 * s))
	box(model, head, "Jaw", Vector3.new(0.6, 0.3, 0.8) * s, BODY_SHADE, CFrame.new(0, -0.5 * s, -0.04 * s))
	for _, side in ipairs({ -1, 1 }) do
		box(model, head, "Eye", Vector3.new(0.24, 0.12, 0.06) * s, DARK, CFrame.new(side * 0.2 * s, 0.1 * s, hf - 0.02 * s) * CFrame.Angles(0, 0, side * 0.2))
		-- Long flat ear: three tapering plates, swept up and back.
		local earBase = CFrame.new(side * 0.22 * s, 0.5 * s, 0.1 * s) * CFrame.Angles(-0.35, 0, side * -0.08)
		for k = 0, 2 do
			local w = (0.34 - k * 0.07) * s
			box(model, head, "Ear", Vector3.new(w, 0.75 * s, 0.12 * s), BODY, earBase * CFrame.new(0, (0.37 + k * 0.72) * s, 0))
		end
		box(model, head, "EarInner", Vector3.new(0.08, 1.7, 0.04) * s, PINK, earBase * CFrame.new(0, 1.05 * s, -0.08 * s))
	end

	-- Big pink shoulder balls and sleek arms with pink lines.
	for _, a in ipairs({ { "ArmL", -1 }, { "ArmR", 1 } }) do
		local side = a[2]
		box(model, torso, "ShoulderBall", Vector3.new(1.0, 1.0, 1.0) * s, PINK, CFrame.new(side * 1.3 * s, 0.65 * s, 0), Enum.Material.SmoothPlastic).Shape = Enum.PartType.Ball
		local base = CFrame.new(side * 1.35 * s, 0.35 * s, 0)
		local offset = CFrame.new(0, -1.1 * s, 0)
		local size = Vector3.new(0.5, 2.2, 0.5) * s
		local arm, weld = box(model, torso, a[1], size, BODY, base * offset)
		rig.Joints[a[1]] = { Weld = weld, Base = base, Offset = offset }
		pinkLines(model, arm, size, s)
		box(model, arm, "Forearm", Vector3.new(0.58, 0.9, 0.58) * s, BODY_SHADE, CFrame.new(0, -0.5 * s, 0))
		local hand = box(model, arm, "Hand", Vector3.new(0.5, 0.5, 0.45) * s, BODY, CFrame.new(0, -1.3 * s, 0))
		for f = -1.5, 1.5 do
			box(model, hand, "Finger", Vector3.new(0.09, 0.4, 0.09) * s, BODY_SHADE, CFrame.new(f * 0.11 * s, -0.4 * s, -0.05 * s))
		end
		if a[1] == "ArmR" then
			local point = Instance.new("Attachment")
			point.Name = "NailPoint"
			point.Position = Vector3.new(0, -0.3 * s, 0)
			point.Parent = hand
			rig.NailPoint = point
		end
	end

	-- Long legs with pink lines.
	for i, side in ipairs({ -1, 1 }) do
		local base = CFrame.new(side * 0.42 * s, -1.75 * s, 0)
		local offset = CFrame.new(0, -1.25 * s, 0)
		local size = Vector3.new(0.6, 2.5, 0.6) * s
		local leg, weld = box(model, torso, "Leg" .. i, size, BODY, base * offset)
		rig.Joints["Leg" .. i] = { Weld = weld, Base = base, Offset = offset }
		pinkLines(model, leg, size, s)
		box(model, leg, "Knee", Vector3.new(0.5, 0.3, 0.1) * s, SHINE, CFrame.new(0, 0.2 * s, -0.32 * s))
		box(model, leg, "Foot", Vector3.new(0.5, 0.25, 0.9) * s, BODY_SHADE, CFrame.new(0, -1.35 * s, -0.15 * s))
	end
	return model, rig
end

return D4CStand
end

-- ======================================================================
-- MODULE: ValentineVFX
-- ======================================================================
__modules["ValentineVFX"] = function()
--[[
	TuskActVFX.ValentineVFX  (StarterPlayerScripts.SpinClient.TuskActVFX.ValentineVFX)

	Client visuals for Funny Valentine / D4C. Blocky.
	  * the D4C Stand (D4CStand) floats behind him with a pale-blue aura and
	    strikes with his moves
	  * DIMENSION HOP: a striped flag sweeps round him and he's gone; where he
	    steps out, a flag unfurls and falls away; a flag on a pole stays
	    planted where he left from while he can hop back to it
	  * PARALLEL VALENTINE: a shimmering Valentine from another world (pink
	    coat, blond ringlets) steps out of a flag, chases the nearest enemy
	    and punches, then leaves; when they SWAP, flags flash at both spots
	  * MENGER SPONGE: the target's other-world double stands where it
	    appeared, flickering; near it their body crumbles into little cubes
	    (Menger sponges orbit them), then bursts; get away and the double
	    shatters
	  * D4C LOVE TRAIN: a column of light falls on him and a shell of light
	    surrounds him; every hit on him bounces off as a bolt of light into
	    someone else; it ends with a ring of light
]]

local Shared = nil -- (bundled: modules are inlined)
local TuskConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("TuskConfig"))
local TuskStandModels = __require("TuskStandModels")
local VFXLib = __require("VFXLib")
local CameraFX = __require("CameraFX")
local TuskVFX = __require("TuskVFX")
local TuskAnimation = __require("TuskAnimation")
local Common = __require("TuskActCommon")
local Fighters = __require("Fighters")
local TuskStand = __require("TuskStand")
local D4CStand = __require("D4CStand")

local ValentineVFX = {}
local ACT = 13
local pal = Common.palette(ACT)
local sounds = TuskConfig.Sounds

-- D4C floats behind him (players and NPCs), like Tusk does.
TuskStandModels.register(ACT, D4CStand.build, { Aura = D4CStand.Aura, AuraLight = D4CStand.AuraLight, Offset = D4CStand.Offset })

local RED = Color3.fromRGB(190, 40, 50)
local WHITE = Color3.fromRGB(245, 245, 240)
local BLUE = Color3.fromRGB(40, 60, 140)
local LIGHT = Color3.fromRGB(255, 250, 225)
local SHIMMER = Color3.fromRGB(170, 200, 255)
local CUBE = Color3.fromRGB(200, 196, 190)

local clones = {} -- [id] = a parallel Valentine
local anchors = {} -- [character] = flag planted where he hopped from
local crumbling = {} -- [character] = cubes and double
local trains = {} -- [character] = light shell
local stanced = {}

---------------------------------------------------------------------------
-- Pieces
---------------------------------------------------------------------------
local function box(model, size, cf, color, material, transparency)
	local p = VFXLib.part({ Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic, Transparency = transparency or 0 })
	p.Parent = model
	return p
end

local function newModel(name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = VFXLib.Folder
	return m
end

local function finish(m)
	local item = { Model = m, Parts = {}, Offsets = {} }
	for _, p in ipairs(m:GetChildren()) do
		if p:IsA("BasePart") then
			table.insert(item.Parts, p)
			item.Offsets[p] = p.CFrame
		end
	end
	return item
end

local function place(item, cf)
	for _, p in ipairs(item.Parts) do
		p.CFrame = cf * item.Offsets[p]
	end
end

local function fade(item, a)
	for _, p in ipairs(item.Parts) do
		p.Transparency = math.max(p.Transparency, a)
	end
end

-- A striped flag (7 stripes, a blue canton with white stars), built round its centre.
local function buildFlag(w, h)
	local m = newModel("Flag")
	local stripeH = h / 7
	for i = 0, 6 do
		box(m, Vector3.new(w, stripeH, 0.08), CFrame.new(0, h / 2 - stripeH * (i + 0.5), 0), i % 2 == 0 and RED or WHITE, Enum.Material.Fabric)
	end
	local cw, ch = w * 0.4, stripeH * 4
	box(m, Vector3.new(cw, ch, 0.1), CFrame.new(-w / 2 + cw / 2, h / 2 - ch / 2, -0.01), BLUE, Enum.Material.Fabric)
	for i = 0, 2 do
		for j = 0, 1 do
			box(m, Vector3.new(0.18, 0.18, 0.12), CFrame.new(-w / 2 + cw * (0.2 + i * 0.3), h / 2 - ch * (0.3 + j * 0.4), -0.02), WHITE, Enum.Material.Neon)
		end
	end
	return finish(m)
end

-- A Valentine from another world: his look (pink coat, blond ringlets,
-- magenta trousers), shimmering.
local function buildValentine()
	local m = newModel("ParallelValentine")
	local coat, coatShade = Color3.fromRGB(232, 150, 196), Color3.fromRGB(200, 116, 166)
	local hair, hairDark = Color3.fromRGB(238, 218, 130), Color3.fromRGB(204, 180, 96)
	local skin, pants, grey = Color3.fromRGB(240, 210, 190), Color3.fromRGB(196, 96, 210), Color3.fromRGB(120, 116, 124)
	box(m, Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), coat)
	box(m, Vector3.new(1.2, 0.45, 1.1), CFrame.new(0, 4.15, 0), grey) -- high collar
	box(m, Vector3.new(0.08, 2.1, 0.05), CFrame.new(0.15, 3, -0.52) * CFrame.Angles(0, 0, -0.18), coatShade)
	-- Long coat skirt flaring to the calves, open at the front.
	box(m, Vector3.new(2.5, 2.4, 0.14), CFrame.new(0, 1, 0.62) * CFrame.Angles(0.06, 0, 0), coat)
	for _, side in ipairs({ -1, 1 }) do
		box(m, Vector3.new(0.7, 2.3, 0.14), CFrame.new(side * 0.95, 1, -0.58) * CFrame.Angles(0, side * 0.35, 0), coat)
		box(m, Vector3.new(0.14, 2.3, 1.3), CFrame.new(side * 1.16, 1, 0.05), coatShade)
	end
	box(m, Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 4.9, 0), skin)
	box(m, Vector3.new(1.4, 0.4, 1.4), CFrame.new(0, 5.55, 0), hair)
	box(m, Vector3.new(1.5, 1.6, 0.3), CFrame.new(0, 4.5, 0.65), hair)
	for _, side in ipairs({ -1, 1 }) do
		box(m, Vector3.new(0.2, 1.2, 1.1), CFrame.new(side * 0.7, 4.6, 0.05), hair)
		-- Spiral ringlets at the sides.
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			box(m, Vector3.new(0.14, 0.2, 0.2), CFrame.new(side * 0.95, 4.9 + math.sin(a) * 0.3, math.cos(a) * 0.3), k % 2 == 0 and hair or hairDark)
		end
		box(m, Vector3.new(1, 2, 1), CFrame.new(side * 1.5, 3, 0), coat)
		box(m, Vector3.new(1.1, 0.25, 1.1), CFrame.new(side * 1.5, 2.1, 0), grey)
		box(m, Vector3.new(1, 0.4, 1), CFrame.new(side * 1.5, 1.8, 0), Color3.fromRGB(214, 110, 196))
		box(m, Vector3.new(1, 2, 1), CFrame.new(side * 0.5, 1, 0), pants)
	end
	local item = finish(m)
	local hl = Instance.new("Highlight")
	hl.FillColor = SHIMMER
	hl.FillTransparency = 0.6
	hl.OutlineColor = SHIMMER
	hl.Adornee = m
	hl.Parent = m
	return item
end

-- A level-1 Menger sponge: a cube of 20 little cubes (the centre and face centres missing).
local function buildSponge(size)
	local m = newModel("MengerSponge")
	local c = size / 3
	for x = -1, 1 do
		for y = -1, 1 do
			for z = -1, 1 do
				local zeros = (x == 0 and 1 or 0) + (y == 0 and 1 or 0) + (z == 0 and 1 or 0)
				if zeros < 2 then
					box(m, Vector3.new(c, c, c) * 0.96, CFrame.new(x * c, y * c, z * c), (x + y + z) % 2 == 0 and CUBE or CUBE:Lerp(SHIMMER, 0.4))
				end
			end
		end
	end
	return finish(m)
end

local function flash(position, size)
	TuskVFX.CreateImpactStar(position, { Size = size or 3, Rays = 8, Color = LIGHT, Color2 = SHIMMER, Duration = 0.15 })
end

---------------------------------------------------------------------------
-- Moves
---------------------------------------------------------------------------
local function onM1(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if not root then
		return
	end
	local index = data.Index
	TuskAnimation.play(character, "V_M1_" .. index)
	TuskStand.action(character, "Lunge", { Target = CFrame.new(index % 2 == 0 and -0.8 or 0.8, 1, -3.1), Duration = 0.28 })
	VFXLib.sound(sounds.Swing, root, 0.5, 1.0 + index * 0.05)
	Common.swipe(root, index % 2 == 1 and 1 or -1, index % 2 == 1 and pal.Main or pal.Second)
end

local function onFinisher(data)
	Common.finisher(data, pal)
end

-- The flag sweeps round him and he slips away.
local function flagWrap(position)
	local flag = buildFlag(6, 4)
	VFXLib.animate(0.35, function(a)
		local angle = a * math.pi * 2.2
		local r = 1.6 * (1 - a * 0.6)
		place(flag, CFrame.new(position) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.5, -r) * CFrame.Angles(0, 0, math.sin(a * 8) * 0.15))
		fade(flag, a * a)
	end, function()
		flag.Model:Destroy()
	end)
	flash(position + Vector3.new(0, 1, 0), 3.5)
end

-- Where he steps out, a flag unfurls and drops away.
local function flagUnfurl(position)
	local flag = buildFlag(6, 4)
	VFXLib.animate(0.5, function(a)
		local open = math.min(a / 0.3, 1)
		place(flag, CFrame.new(position + Vector3.new(0, 0.5 - a * a * 3, 0)) * CFrame.Angles(0, (1 - open) * math.pi, 0) * CFrame.new(0, 0, -1.2))
		fade(flag, math.max(0, (a - 0.5) * 2))
	end, function()
		flag.Model:Destroy()
	end)
	flash(position + Vector3.new(0, 1, 0), 3.5)
end

local function cloneStep(dt)
	local now = os.clock()
	for id, c in pairs(clones) do
		if now > c.Until then
			clones[id] = nil
			flagWrap(c.Pos + Vector3.new(0, 1.5, 0))
			c.Item.Model:Destroy()
		else
			local tr = c.Target and Common.rootOf(c.Target)
			local goal = tr and tr.Position or (c.Owner and Common.rootOf(c.Owner) and (Common.rootOf(c.Owner).CFrame * CFrame.new(-3, 0, 2)).Position) or c.Pos
			local to = goal - c.Pos
			local reach = tr and 4 or 2
			if to.Magnitude > reach then
				c.Pos = c.Pos + to.Unit * math.min(c.Speed * dt, to.Magnitude - reach * 0.8)
			end
			local look = Vector3.new(to.X, 0, to.Z)
			local cf = CFrame.lookAt(c.Pos, c.Pos + (look.Magnitude > 0.1 and look or Vector3.new(0, 0, -1)))
			local punch = math.max(0, 1 - (now - c.PunchAt) / 0.25)
			place(c.Item, cf * CFrame.new(0, -3 + math.abs(math.sin(now * 9)) * 0.2, -punch * 1.2))
			-- Shimmers between worlds.
			for _, p in ipairs(c.Item.Parts) do
				p.Transparency = 0.15 + 0.15 * math.abs(math.sin(now * 6 + id))
			end
		end
	end
end

-- The target's other-world double flickers beside them; their body crumbles into cubes.
local function startCrumble(target, duration, doublePos, leash)
	local tr = Common.rootOf(target)
	if not tr then
		return
	end
	local old = crumbling[target]
	if old then
		for _, sp in ipairs(old.Sponges) do
			sp.Model:Destroy()
		end
		old.Double.Model:Destroy()
	end
	local torso = target:FindFirstChild("UpperTorso") or target:FindFirstChild("Torso")
	local color = torso and torso.Color or Color3.fromRGB(150, 150, 160)
	local dm = newModel("OtherWorldDouble")
	box(dm, Vector3.new(2, 2, 1), CFrame.new(0, 0, 0), color, Enum.Material.Glass, 0.4)
	box(dm, Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 1.6, 0), color:Lerp(WHITE, 0.4), Enum.Material.Glass, 0.4)
	for _, side in ipairs({ -1, 1 }) do
		box(dm, Vector3.new(1, 2, 1), CFrame.new(side * 1.5, 0, 0), color, Enum.Material.Glass, 0.4)
		box(dm, Vector3.new(1, 2, 1), CFrame.new(side * 0.5, -2, 0), color:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.Glass, 0.4)
	end
	local sponges = {}
	for i = 1, 4 do
		sponges[i] = buildSponge(0.9)
	end
	crumbling[target] = { Double = finish(dm), Sponges = sponges, Born = os.clock(), Duration = duration or 3, Next = 0, DoublePos = doublePos, Leash = leash or 10 }
	flash(tr.Position, 3)
end

local function crumbleStep(dt)
	local now = os.clock()
	for target, c in pairs(crumbling) do
		local tr = Common.rootOf(target)
		if not tr or now - c.Born > c.Duration + 0.3 then
			crumbling[target] = nil
			for _, sp in ipairs(c.Sponges) do
				sp.Model:Destroy()
			end
			c.Double.Model:Destroy()
		else
			local t = now - c.Born
			-- The double stands where it appeared, facing them, flickering.
			local at = c.DoublePos or (tr.CFrame * CFrame.new(3.2, 0, 0)).Position
			local face = Vector3.new(tr.Position.X, at.Y, tr.Position.Z)
			place(c.Double, (face - at).Magnitude > 0.1 and CFrame.lookAt(at, face) or CFrame.new(at))
			local near = (tr.Position - at).Magnitude <= c.Leash
			local flick = (math.floor(t * 14) % 3 == 0) and 0.75 or 0.4
			for _, p in ipairs(c.Double.Parts) do
				p.Transparency = flick
			end
			-- Menger sponges orbit them.
			for i, sp in ipairs(c.Sponges) do
				local a = t * 2.5 + i / #c.Sponges * math.pi * 2
				place(sp, CFrame.new(tr.Position + Vector3.new(math.cos(a) * 2.4, math.sin(t * 3 + i) * 1.2, math.sin(a) * 2.4)) * CFrame.Angles(t * 2, t * 3, 0))
			end
			-- Little cubes break off the body and drift away (only near the double).
			c.Next = near and c.Next - dt or 0.06
			while c.Next <= 0 and near do
				c.Next = c.Next + 0.06
				local from = tr.Position + Vector3.new((math.random() - 0.5) * 2, (math.random() - 0.5) * 4, (math.random() - 0.5) * 1.4)
				local cube = VFXLib.part({ Size = Vector3.new(0.35, 0.35, 0.35), Color = CUBE, Material = Enum.Material.SmoothPlastic })
				local drift = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5) * 6
				VFXLib.animate(0.6, function(a)
					cube.CFrame = CFrame.new(from + drift * a) * CFrame.Angles(a * 5, a * 3, 0)
					cube.Transparency = a
				end, function()
					cube:Destroy()
				end)
			end
		end
	end
end

-- A flag on a pole planted where he hopped from (he can hop back to it).
local function plantAnchor(character, position, duration)
	local old = anchors[character]
	if old then
		old.Flag.Model:Destroy()
		old.Pole:Destroy()
	end
	local pole = VFXLib.part({ Size = Vector3.new(0.2, 7, 0.2), CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)), Color = Color3.fromRGB(220, 220, 225), Material = Enum.Material.Metal })
	local flag = buildFlag(3.2, 2)
	anchors[character] = { Flag = flag, Pole = pole, Pos = position, Until = os.clock() + (duration or 4) }
end

local function removeAnchor(character)
	local a = anchors[character]
	if a then
		anchors[character] = nil
		flagWrap(a.Pos)
		a.Flag.Model:Destroy()
		a.Pole:Destroy()
	end
end

local function anchorStep()
	local now = os.clock()
	for character, a in pairs(anchors) do
		if now > a.Until or not character.Parent then
			anchors[character] = nil
			a.Flag.Model:Destroy()
			a.Pole:Destroy()
		else
			-- The flag waves at the top of the pole.
			place(a.Flag, CFrame.new(a.Pos + Vector3.new(1.7, 3, 0)) * CFrame.Angles(0, math.sin(now * 3) * 0.25, math.sin(now * 5) * 0.05))
			-- Blinks in its last second.
			local blink = (a.Until - now) < 1 and (math.floor(now * 8) % 2 == 0)
			for _, p in ipairs(a.Flag.Parts) do
				p.Transparency = blink and 0.6 or 0
			end
		end
	end
end

local function onAbility(data)
	local character = data.Character
	local root = Common.rootOf(character)
	local move, phase = data.Move, data.Phase
	if move == "DimensionHop" then
		if phase == "Wrap" then
			TuskAnimation.play(character, "VHop")
			flagWrap(data.Position or (root and root.Position))
		elseif phase == "Anchor" and character then
			plantAnchor(character, data.Position, data.Duration)
		elseif phase == "AnchorGone" and character then
			removeAnchor(character)
		elseif phase == "Unwrap" then
			flagUnfurl(data.Position)
			TuskStand.action(character, "Lunge", { Duration = 0.35 })
			if Common.isLocal(character) then
				CameraFX.fovPunch(6, 0.2)
			end
		end
	elseif move == "ParallelClone" then
		if phase == "Call" and character then
			TuskAnimation.play(character, "VCall")
			TuskStand.action(character, "Manifest", { Duration = 0.5 })
		elseif phase == "Arrive" then
			local item = buildValentine()
			clones[data.Id] = { Item = item, Pos = data.From, Speed = data.Speed or 20, Until = os.clock() + (data.Duration or 6) + 0.6, Owner = character, PunchAt = 0 }
			flagUnfurl(data.From + Vector3.new(0, 1.5, 0))
		elseif phase == "Chase" then
			local c = clones[data.Id]
			if c then
				c.Target = data.Target
			end
		elseif phase == "Punch" then
			local c = clones[data.Id]
			if c then
				c.PunchAt = os.clock()
			end
			if data.Position then
				TuskVFX.CreateImpactStar(data.Position, { Size = 2.6, Rays = 6, Color = pal.Main, Color2 = WHITE, Duration = 0.12 })
			end
		elseif phase == "Swap" then
			-- They trade places: flags at both spots, and the other one is gone.
			local c = clones[data.Id]
			if c then
				clones[data.Id] = nil
				c.Item.Model:Destroy()
			end
			flagWrap(data.From)
			flagUnfurl(data.To)
			flash(data.To + Vector3.new(0, 1, 0), 5)
			if character and Common.isLocal(character) then
				CameraFX.impactFrame(SHIMMER)
			end
		elseif phase == "Leave" then
			local c = clones[data.Id]
			if c then
				c.Until = 0 -- wraps itself in a flag and goes next frame
			end
		end
	elseif move == "MengerSponge" then
		if phase == "Cast" and character then
			TuskAnimation.play(character, "VMenger")
			TuskStand.action(character, "Lunge", { Duration = 0.45 })
		elseif phase == "Crumble" and data.Target then
			startCrumble(data.Target, data.Duration, data.DoublePos, data.Leash)
		elseif phase == "Escape" and data.Target then
			-- They got away from their double: it shatters into cubes.
			local c = crumbling[data.Target]
			if c then
				crumbling[data.Target] = nil
				local at = c.DoublePos or data.Position
				for _, sp in ipairs(c.Sponges) do
					sp.Model:Destroy()
				end
				c.Double.Model:Destroy()
				VFXLib.burst(at, { Count = 24, Color = CUBE, Speed = 16, Lifetime = 0.45 })
			end
		elseif phase == "Burst" and data.Position then
			VFXLib.burst(data.Position, { Count = 30, Color = CUBE, Speed = 22, Lifetime = 0.5 })
			flash(data.Position, 5)
			if data.Target and crumbling[data.Target] then
				crumbling[data.Target].Duration = 0
			end
		elseif phase == "Miss" and root then
			flash((root.CFrame * CFrame.new(0, 0, -6)).Position, 2)
		end
	end
end

-- Love Train: a column of light, then a shell of light that follows him.
local function startTrain(character, duration)
	local m = newModel("LoveTrain")
	local shell = box(m, Vector3.new(5, 7, 5), CFrame.new(), LIGHT, Enum.Material.ForceField, 0.2)
	local rays = {}
	for i = 1, 6 do
		rays[i] = box(m, Vector3.new(0.25, 9, 0.25), CFrame.new(), LIGHT, Enum.Material.Neon, 0.35)
	end
	local light = Instance.new("PointLight")
	light.Color = LIGHT
	light.Range = 16
	light.Brightness = 2
	light.Parent = shell
	trains[character] = { Model = m, Shell = shell, Rays = rays, Until = os.clock() + duration + 0.5 }
end

local function trainStep()
	local now = os.clock()
	for character, tr in pairs(trains) do
		local root = Common.rootOf(character)
		-- Ends on time, or once the server has switched it off.
		if not root or now > tr.Until or (tr.Started and now > tr.Started + 1 and not character:GetAttribute("LoveTrain")) then
			trains[character] = nil
			tr.Model:Destroy()
		else
			tr.Started = tr.Started or now
			local pulse = 1 + math.sin(now * 6) * 0.04
			tr.Shell.Size = Vector3.new(5, 7, 5) * pulse
			tr.Shell.CFrame = root.CFrame
			for i, ray in ipairs(tr.Rays) do
				local a = now * 1.6 + i / #tr.Rays * math.pi * 2
				ray.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a) * 3, 0.5, math.sin(a) * 3)) * CFrame.Angles(0, -a, 0.15)
			end
		end
	end
end

-- A bolt of light from him to whoever gets the misfortune.
local function bolt(from, to)
	local segments = 6
	local prev = from + Vector3.new(0, 1, 0)
	for i = 1, segments do
		local t = i / segments
		local p = (from + Vector3.new(0, 1, 0)):Lerp(to + Vector3.new(0, 1, 0), t) + (i < segments and Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 or Vector3.new())
		local seg = VFXLib.part({ Size = Vector3.new(0.3, 0.3, (p - prev).Magnitude), CFrame = CFrame.lookAt((prev + p) / 2, p), Color = LIGHT, Material = Enum.Material.Neon })
		VFXLib.animate(0.25, function(a)
			seg.Transparency = a
		end, function()
			seg:Destroy()
		end)
		prev = p
	end
end

local function onUltimate(data)
	local character = data.Character
	local root = Common.rootOf(character)
	if data.Phase == "Board" then
		TuskAnimation.play(character, "VLoveTrain")
		TuskStand.action(character, "Manifest", { Duration = 0.8 })
		if root then
			-- A column of light comes down on him.
			local column = VFXLib.part({ Size = Vector3.new(6, 60, 6), Color = LIGHT, Material = Enum.Material.Neon, Transparency = 0.4 })
			local at = root.Position
			VFXLib.animate(data.Windup or 0.7, function(a)
				column.CFrame = CFrame.new(at + Vector3.new(0, 30 - a * 2, 0))
				column.Size = Vector3.new(6 - a * 2, 60, 6 - a * 2)
				column.Transparency = 0.4 + 0.6 * a
			end, function()
				column:Destroy()
			end)
			flash(at + Vector3.new(0, 2, 0), 6)
		end
		task.delay(data.Windup or 0.7, function()
			if character and character.Parent then
				startTrain(character, data.Duration or 6)
			end
		end)
		if Common.isLocal(character) then
			TuskVFX.ScreenTint((data.Windup or 0.7) + (data.Duration or 6), { Tint = Color3.fromRGB(255, 250, 230), Saturation = 0.1, Brightness = 0.06 })
		end
		if root then
			VFXLib.sound(sounds.AwakeningBuild, root, 0.5, 1.2)
		end
	elseif data.Phase == "Redirect" then
		if data.From then
			flash(data.From + Vector3.new(0, 1, 0), 3)
		end
		if data.From and data.To then
			bolt(data.From, data.To)
			TuskVFX.CreateImpactStar(data.To, { Size = 3.5, Rays = 7, Color = LIGHT, Color2 = pal.Second, Duration = 0.15 })
		end
	elseif data.Phase == "Pulse" then
		local tr = trains[character]
		if tr then
			trains[character] = nil
			tr.Model:Destroy()
		end
		local ring = VFXLib.part({ Size = Vector3.new(0.6, 1, 1), Color = LIGHT, Material = Enum.Material.Neon, Transparency = 0.2, Shape = Enum.PartType.Cylinder })
		local at = data.Position
		local r = data.Radius or 14
		VFXLib.animate(0.45, function(a)
			ring.Size = Vector3.new(0.6, r * 2 * a, r * 2 * a)
			ring.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2)
			ring.Transparency = 0.2 + 0.8 * a
		end, function()
			ring:Destroy()
		end)
		Common.finisher({ Character = character, Position = at, Hit = true }, pal, { Size = 1.3, Layers = 2, Shake = 0.6 })
	end
end

---------------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------------
local function stepStance()
	for _, fighter in ipairs(Fighters.list()) do
		local character = fighter.Character
		if character then
			local want = character:GetAttribute("TuskAct") == ACT
			if want and not stanced[character] then
				stanced[character] = true
				TuskAnimation.hold(character, "VStance")
			elseif not want and stanced[character] then
				stanced[character] = nil
				TuskAnimation.stopHold(character, "VStance")
			end
		end
	end
	for character in pairs(stanced) do
		if not character.Parent then
			stanced[character] = nil
		end
	end
end

function ValentineVFX.handle(name, data)
	if name == "M1" then
		onM1(data)
	elseif name == "M1Finisher" then
		onFinisher(data)
	elseif name == "Ability" then
		onAbility(data)
	elseif name == "Ultimate" then
		onUltimate(data)
	end
end

local slowTimer = 0
function ValentineVFX.step(dt)
	dt = dt or 1 / 60
	cloneStep(dt)
	crumbleStep(dt)
	anchorStep()
	trainStep()
	slowTimer = slowTimer + dt
	if slowTimer > 0.2 then
		slowTimer = 0
		stepStance()
	end
end

return ValentineVFX
end
end
]]></ProtectedString></Properties></Item></Item></roblox>