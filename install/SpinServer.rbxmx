<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Script" referent="RBX52"><Properties><string name="Name">SpinServer</string><ProtectedString name="Source"><![CDATA[--[[
	SpinServer  (ServerScriptService.SpinServer — Script)
	Boots every server system: characters (Johnny/Tusk, Gyro/Ball Breaker,
	Diego/Scary Monsters, Pork Pie Hat Kid/Wired, Sandman/In a Silent Way),
	Stand-user NPCs that fight you,
	custom Stand models, NPCs and Studio test dummies.
]]

local ProjectileService = require(script.ProjectileService)
local TuskService = require(script.TuskService)
local NPCService = require(script.NPCService)
local TestDummies = require(script.TestDummies)
local StandAssetLoader = require(script.StandAssetLoader)
local JohnnyOutfit = require(script.JohnnyOutfit)
local GyroOutfit = require(script.GyroOutfit)
local DiegoOutfit = require(script.DiegoOutfit)
local PorkPieOutfit = require(script.PorkPieOutfit)
local SandmanOutfit = require(script.SandmanOutfit)
local MountainTimOutfit = require(script.MountainTimOutfit)
local HotPantsOutfit = require(script.HotPantsOutfit)
local BlackmoreOutfit = require(script.BlackmoreOutfit)
local AxlOutfit = require(script.AxlOutfit)
local ValentineOutfit = require(script.ValentineOutfit)
local StandBots = require(script.StandBots)
local BountyService = require(script.BountyService)
local WeatherService = require(script.WeatherService)

-- Shared projectile budget (barrages and wrecking balls fire several at once).
ProjectileService.MaxActivePerPlayer = 20

StandAssetLoader.init()
TuskService.init()
JohnnyOutfit.init()
GyroOutfit.init()
DiegoOutfit.init()
PorkPieOutfit.init()
SandmanOutfit.init()
MountainTimOutfit.init()
HotPantsOutfit.init()
BlackmoreOutfit.init()
AxlOutfit.init()
ValentineOutfit.init()
StandBots.init(TuskService)
BountyService.init()
WeatherService.init()
NPCService.init()
TestDummies.init()
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">AxlOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	AxlOutfit  (ServerScriptService.SpinServer.AxlOutfit)

	Gives a character Axl RO's look while they play him (TuskAct 12), built
	from blocky parts (no catalog asset ids), matched to his art:
	  * an olive military helmet covered in a dark net, chin straps hanging
	  * a cream hood lining framing his face, short brown hair at the back
	  * the dotted band across his eyes
	  * a khaki hooded parka: the hood bunched round his neck and shoulders
	  * a yellow chest plate with gold buttons along its edges and a V of
	    gold scales hanging down the front
	  * black clips down the outside of both sleeves
	  * khaki trousers and dark boots
	The player's own hats/hair are hidden while they play him and come back
	when they switch. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local AxlOutfit = {}
AxlOutfit.Act = 12

local C = {
	Helmet = Color3.fromRGB(120, 132, 108),
	Net = Color3.fromRGB(96, 52, 40),
	Strap = Color3.fromRGB(110, 70, 44),
	Lining = Color3.fromRGB(236, 228, 204),
	Hair = Color3.fromRGB(90, 62, 44),
	Band = Color3.fromRGB(98, 84, 110),
	Dot = Color3.fromRGB(240, 236, 228),
	Parka = Color3.fromRGB(176, 160, 112),
	ParkaDark = Color3.fromRGB(140, 126, 86),
	Plate = Color3.fromRGB(226, 210, 112),
	Gold = Color3.fromRGB(214, 170, 60),
	GoldDark = Color3.fromRGB(170, 128, 40),
	Clip = Color3.fromRGB(30, 30, 34),
	ClipShine = Color3.fromRGB(120, 124, 132),
	Pants = Color3.fromRGB(150, 136, 96),
	Boot = Color3.fromRGB(50, 40, 32),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	local fz = -d - 0.03 * s
	-- Short brown hair at the back under the helmet.
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.08 * s, 0.6 * s, 0.12 * s), C.Hair, CFrame.new(0, 0.05 * s, d + 0.04 * s))
	-- Cream hood lining framing the face (sides, back and under the chin).
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Lining", Vector3.new(0.16 * s, head.Size.Y * 0.95, head.Size.Z + 0.12 * s), C.Lining, CFrame.new(side * (w + 0.08 * s), -0.08 * s, 0.04 * s))
	end
	piece(head, outfit, "Lining", Vector3.new(head.Size.X + 0.3 * s, head.Size.Y * 0.8, 0.14 * s), C.Lining, CFrame.new(0, -0.12 * s, d + 0.14 * s))
	-- Olive helmet with a dark net over it.
	local helmY = h + 0.06 * s
	piece(head, outfit, "Helmet", Vector3.new(head.Size.X + 0.42 * s, 0.5 * s, head.Size.Z + 0.42 * s), C.Helmet, CFrame.new(0, helmY, 0.02 * s))
	piece(head, outfit, "Helmet", Vector3.new(head.Size.X * 0.86, 0.22 * s, head.Size.Z * 0.86), C.Helmet, CFrame.new(0, helmY + 0.34 * s, 0.02 * s))
	piece(head, outfit, "Rim", Vector3.new(head.Size.X + 0.5 * s, 0.08 * s, head.Size.Z + 0.5 * s), C.Helmet, CFrame.new(0, helmY - 0.24 * s, 0.02 * s))
	local span = head.Size.X + 0.44 * s
	for i = -3, 3 do
		-- Net strands both ways over the top and down the sides.
		piece(head, outfit, "Net", Vector3.new(0.04 * s, 0.04 * s, span), C.Net, CFrame.new(i * span / 7, helmY + 0.26 * s, 0.02 * s))
		piece(head, outfit, "Net", Vector3.new(span, 0.04 * s, 0.04 * s), C.Net, CFrame.new(0, helmY + 0.26 * s, i * span / 7 + 0.02 * s))
		piece(head, outfit, "Net", Vector3.new(0.04 * s, 0.5 * s, 0.03 * s), C.Net, CFrame.new(i * span / 7, helmY, -span / 2 + 0.01 * s))
		piece(head, outfit, "Net", Vector3.new(0.04 * s, 0.5 * s, 0.03 * s), C.Net, CFrame.new(i * span / 7, helmY, span / 2 + 0.03 * s))
		piece(head, outfit, "Net", Vector3.new(0.03 * s, 0.5 * s, 0.04 * s), C.Net, CFrame.new(-span / 2 - 0.01 * s, helmY, i * span / 7))
		piece(head, outfit, "Net", Vector3.new(0.03 * s, 0.5 * s, 0.04 * s), C.Net, CFrame.new(span / 2 + 0.01 * s, helmY, i * span / 7))
	end
	for _, y in ipairs({ -0.1, 0.1 }) do
		piece(head, outfit, "Net", Vector3.new(span + 0.02 * s, 0.04 * s, span + 0.02 * s), C.Net, CFrame.new(0, helmY + y * s, 0.02 * s))
	end
	-- Chin straps hanging loose.
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "ChinStrap", Vector3.new(0.05 * s, 1.1 * s, 0.05 * s), C.Strap, CFrame.new(side * (w + 0.1 * s), -0.45 * s, -0.25 * s) * CFrame.Angles(0.15, 0, side * -0.05))
	end
	-- The dotted band across his eyes (gaps left for the eyes).
	piece(head, outfit, "EyeBand", Vector3.new(head.Size.X * 0.96, 0.12 * s, 0.05 * s), C.Band, CFrame.new(0, 0.26 * s, fz))
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "EyeBand", Vector3.new(0.18 * s, 0.34 * s, 0.05 * s), C.Band, CFrame.new(side * 0.44 * s, 0.1 * s, fz))
		piece(head, outfit, "EyeBand", Vector3.new(0.3 * s, 0.1 * s, 0.05 * s), C.Band, CFrame.new(side * 0.2 * s, -0.04 * s, fz))
	end
	piece(head, outfit, "EyeBand", Vector3.new(0.12 * s, 0.22 * s, 0.05 * s), C.Band, CFrame.new(0, 0.1 * s, fz))
	for _, spot in ipairs({ { -0.36, 0.26 }, { -0.12, 0.26 }, { 0.12, 0.26 }, { 0.36, 0.26 }, { -0.44, 0.08 }, { 0.44, 0.08 }, { -0.22, -0.04 }, { 0.22, -0.04 } }) do
		piece(head, outfit, "Dot", Vector3.new(0.05 * s, 0.05 * s, 0.03 * s), C.Dot, CFrame.new(spot[1] * s, spot[2] * s, fz - 0.03 * s))
	end
end

local function body(character, outfit)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		local s = upper.Size
		local top, front = s.Y / 2, -s.Z / 2
		piece(upper, outfit, "Parka", s + Vector3.new(0.12, 0.02, 0.12), C.Parka, CFrame.new())
		-- The hood bunched round his neck and shoulders.
		piece(upper, outfit, "Hood", Vector3.new(s.X + 0.3, 0.42, s.Z + 0.4), C.Parka, CFrame.new(0, top - 0.05, 0.04))
		piece(upper, outfit, "Hood", Vector3.new(s.X * 0.75, 0.5, s.Z + 0.3), C.ParkaDark, CFrame.new(0, top + 0.2, 0.12))
		piece(upper, outfit, "HoodBack", Vector3.new(s.X * 0.7, 0.7, 0.3), C.Parka, CFrame.new(0, top - 0.2, -front + 0.2))
		-- Yellow chest plate (a V shield) with gold buttons along its edges.
		piece(upper, outfit, "Plate", Vector3.new(s.X * 0.8, s.Y * 0.38, 0.06), C.Plate, CFrame.new(0, top - s.Y * 0.28, front - 0.08))
		piece(upper, outfit, "Plate", Vector3.new(s.X * 0.48, s.Y * 0.2, 0.06), C.Plate, CFrame.new(0, top - s.Y * 0.55, front - 0.08))
		piece(upper, outfit, "Plate", Vector3.new(s.X * 0.2, s.Y * 0.12, 0.06), C.Plate, CFrame.new(0, top - s.Y * 0.7, front - 0.08))
		for _, side in ipairs({ -1, 1 }) do
			for k = 0, 3 do
				piece(upper, outfit, "Button", Vector3.new(0.16, 0.16, 0.06), C.Gold, CFrame.new(side * (s.X * 0.42 - k * 0.16), top - 0.12 - k * 0.24, front - 0.12))
			end
			-- A V of gold scales hanging below the plate.
			for k = 0, 4 do
				local x = side * (s.X * 0.46 - k * 0.2)
				local y = top - s.Y * 0.5 - k * 0.14
				piece(upper, outfit, "Scale", Vector3.new(0.18, 0.18, 0.05), k % 2 == 0 and C.Gold or C.GoldDark, CFrame.new(x, y, front - 0.11))
				piece(upper, outfit, "Scale", Vector3.new(0.18, 0.18, 0.05), k % 2 == 0 and C.GoldDark or C.Gold, CFrame.new(x, y - 0.2, front - 0.1))
			end
		end
	end
	local waist = lower or upper
	if waist then
		local ws = waist.Size
		local waistTop = lower and ws.Y / 2 or -upper.Size.Y / 2 + 0.3
		if lower then
			piece(lower, outfit, "Parka", ws + Vector3.new(0.12, 0.02, 0.12), C.Parka, CFrame.new())
		end
		-- Parka hem down over the hips.
		piece(waist, outfit, "Hem", Vector3.new(ws.X + 0.2, 0.7, ws.Z + 0.2), C.Parka, CFrame.new(0, waistTop - 0.45, 0))
		piece(waist, outfit, "HemEdge", Vector3.new(ws.X + 0.24, 0.1, ws.Z + 0.24), C.ParkaDark, CFrame.new(0, waistTop - 0.8, 0))
	end
	-- Khaki sleeves with black clips down the outside.
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local as = arm.Size
			local out = name:find("Left") and -1 or 1
			local tall = as.Y > 1.8
			local h = tall and as.Y - 0.3 or as.Y
			piece(arm, outfit, "Sleeve", Vector3.new(as.X + 0.12, h + 0.02, as.Z + 0.12), C.Parka, CFrame.new(0, as.Y / 2 - h / 2, 0))
			local count = tall and 3 or 2
			for k = 1, count do
				local y = as.Y / 2 - k * h / (count + 1)
				piece(arm, outfit, "Clip", Vector3.new(0.1, 0.26, 0.4), C.Clip, CFrame.new(out * (as.X / 2 + 0.1), y, 0))
				piece(arm, outfit, "Clip", Vector3.new(0.06, 0.08, 0.42), C.ClipShine, CFrame.new(out * (as.X / 2 + 0.14), y + 0.06, 0))
			end
			if name:find("Lower") or tall then
				piece(arm, outfit, "Cuff", Vector3.new(as.X + 0.18, 0.2, as.Z + 0.18), C.ParkaDark, CFrame.new(0, as.Y / 2 - h + 0.1, 0))
			end
		end
	end
	-- Khaki trousers and dark boots.
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			local ls = leg.Size
			piece(leg, outfit, "Pants", ls + Vector3.new(0.05, 0.02, 0.05), C.Pants, CFrame.new())
			if name:find("Lower") or ls.Y > 1.8 then
				local bh = ls.Y > 1.8 and 0.8 or ls.Y * 0.7
				piece(leg, outfit, "Boot", Vector3.new(ls.X + 0.14, bh, ls.Z + 0.14), C.Boot, CFrame.new(0, -ls.Y / 2 + bh / 2, 0))
			end
		end
	end
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(name)
		if foot then
			piece(foot, outfit, "Boot", foot.Size + Vector3.new(0.1, 0.06, 0.14), C.Boot, CFrame.new(0, 0, -0.03))
		end
	end
end

function AxlOutfit.apply(character)
	if character:FindFirstChild("AxlOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "AxlOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function AxlOutfit.remove(character)
	local outfit = character:FindFirstChild("AxlOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == AxlOutfit.Act then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == AxlOutfit.Act then
					AxlOutfit.apply(character)
				end
			end)
		else
			AxlOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function AxlOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return AxlOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">BlackmoreOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	BlackmoreOutfit  (ServerScriptService.SpinServer.BlackmoreOutfit)

	Gives a character Blackmore's look while they play him (TuskAct 11),
	built from blocky parts (no catalog asset ids), matched to his art:
	  * a dark navy hood wrapped round the head and neck, a gold ring on top
	    and a long blond ponytail sweeping up and back out of it
	  * his white mask with the diagonal rainbow stripe and black slits
	  * a navy capelet down to the elbows covered in gold grommets, two rows
	    of grommets down the front
	  * a long navy coat skirt to the calves (split at the front)
	  * pale grey-blue sleeves and leggings with dark raindrop marks
	  * grey studded boots
	  (his umbrella is drawn in his hand by the client)
	The player's own hats/hair are hidden while they play him and come back
	when they switch. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local BlackmoreOutfit = {}
BlackmoreOutfit.Act = 11

local C = {
	Hood = Color3.fromRGB(40, 40, 72),
	HoodDark = Color3.fromRGB(28, 28, 52),
	Ring = Color3.fromRGB(214, 172, 70),
	Hair = Color3.fromRGB(238, 222, 160),
	HairDark = Color3.fromRGB(206, 186, 120),
	Mask = Color3.fromRGB(236, 240, 244),
	Slit = Color3.fromRGB(20, 20, 24),
	Rainbow = { Color3.fromRGB(235, 80, 100), Color3.fromRGB(250, 220, 70), Color3.fromRGB(70, 190, 230) },
	Coat = Color3.fromRGB(46, 44, 82),
	CoatDark = Color3.fromRGB(32, 30, 60),
	Grommet = Color3.fromRGB(214, 172, 70),
	GrommetHole = Color3.fromRGB(24, 22, 40),
	Sleeve = Color3.fromRGB(190, 198, 214),
	Leg = Color3.fromRGB(200, 206, 220),
	Drop = Color3.fromRGB(60, 56, 96),
	Boot = Color3.fromRGB(150, 156, 170),
	Stud = Color3.fromRGB(225, 228, 236),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

-- A gold grommet (ring with a dark hole) facing -Z of `cf`.
local function grommet(parent, outfit, cf)
	piece(parent, outfit, "Grommet", Vector3.new(0.17, 0.17, 0.05), C.Grommet, cf)
	piece(parent, outfit, "Grommet", Vector3.new(0.08, 0.08, 0.06), C.GrommetHole, cf * CFrame.new(0, 0, -0.01))
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	-- Hood: wraps the top, sides and back; the face stays open.
	piece(head, outfit, "Hood", Vector3.new(head.Size.X + 0.24 * s, 0.3 * s, head.Size.Z + 0.24 * s), C.Hood, CFrame.new(0, h + 0.04 * s, 0.02 * s))
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Hood", Vector3.new(0.14 * s, head.Size.Y + 0.1 * s, head.Size.Z + 0.2 * s), C.Hood, CFrame.new(side * (w + 0.06 * s), -0.04 * s, 0.03 * s))
	end
	piece(head, outfit, "Hood", Vector3.new(head.Size.X + 0.24 * s, head.Size.Y + 0.1 * s, 0.14 * s), C.Hood, CFrame.new(0, -0.04 * s, d + 0.06 * s))
	piece(head, outfit, "HoodRim", Vector3.new(head.Size.X + 0.26 * s, 0.12 * s, 0.1 * s), C.HoodDark, CFrame.new(0, h - 0.04 * s, -d - 0.04 * s))
	-- Gold ring on top with a long blond ponytail sweeping up and back.
	piece(head, outfit, "Ring", Vector3.new(0.34 * s, 0.12 * s, 0.34 * s), C.Ring, CFrame.new(0, h + 0.24 * s, 0.05 * s))
	-- The tail is a chain of blocks along a curve: up out of the ring, then back and down.
	local pts = {}
	for i = 0, 7 do
		local t = i / 7
		pts[i] = Vector3.new(0, h + 0.3 * s + math.sin(t * math.pi * 0.75) * 0.9 * s, 0.05 * s + t * t * 2.1 * s)
	end
	for i = 1, 7 do
		local a0, a1 = pts[i - 1], pts[i]
		local thick = (0.26 - i * 0.022) * s
		piece(head, outfit, "Ponytail", Vector3.new(thick, thick, (a1 - a0).Magnitude + 0.06 * s), i % 2 == 0 and C.HairDark or C.Hair, CFrame.lookAt((a0 + a1) / 2, a1))
	end
	-- White mask: rainbow stripe across it diagonally, black slits under the eyes.
	local fz = -d - 0.07 * s
	piece(head, outfit, "Mask", Vector3.new(head.Size.X * 0.92, head.Size.Y * 0.88, 0.08 * s), C.Mask, CFrame.new(0, -0.04 * s, fz))
	for i, color in ipairs(C.Rainbow) do
		piece(head, outfit, "MaskStripe", Vector3.new(head.Size.X * 0.95, 0.09 * s, 0.04 * s), color, CFrame.new(0, (0.02 - (i - 2) * 0.1) * s, fz - 0.05 * s) * CFrame.Angles(0, 0, 0.42))
	end
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "MaskEye", Vector3.new(0.26 * s, 0.06 * s, 0.04 * s), C.Slit, CFrame.new(side * 0.22 * s, 0.16 * s, fz - 0.05 * s) * CFrame.Angles(0, 0, side * -0.15))
	end
	for i = -1, 1 do
		piece(head, outfit, "MaskSlit", Vector3.new(0.05 * s, 0.3 * s, 0.04 * s), C.Slit, CFrame.new(i * 0.12 * s, -0.32 * s, fz - 0.05 * s))
	end
end

local function body(character, outfit)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		local s = upper.Size
		local top, front = s.Y / 2, -s.Z / 2
		piece(upper, outfit, "Coat", s + Vector3.new(0.1, 0.02, 0.1), C.Coat, CFrame.new())
		-- Hood wraps down round the neck like a cowl.
		piece(upper, outfit, "Cowl", Vector3.new(s.X * 0.62, 0.36, s.Z + 0.26), C.Hood, CFrame.new(0, top + 0.12, 0))
		-- Capelet over the shoulders (the arm parts are on the arms so they move with them).
		local capeH = s.Y * 0.72
		piece(upper, outfit, "Capelet", Vector3.new(s.X + 0.3, capeH, s.Z + 0.42), C.Coat, CFrame.new(0, top - capeH / 2 + 0.02, 0))
		piece(upper, outfit, "CapeHem", Vector3.new(s.X + 0.34, 0.08, s.Z + 0.46), C.CoatDark, CFrame.new(0, top - capeH, 0))
		-- Two rows of grommets down the front, and a few more beside them.
		for row = 0, 3 do
			for _, side in ipairs({ -1, 1 }) do
				grommet(upper, outfit, CFrame.new(side * 0.22, top - 0.25 - row * 0.3, front - 0.24))
			end
		end
		for _, spot in ipairs({ { -0.75, -0.35 }, { 0.75, -0.35 }, { -0.6, -0.8 }, { 0.6, -0.8 } }) do
			grommet(upper, outfit, CFrame.new(spot[1] * s.X / 2, top + spot[2] * s.Y / 1.6, front - 0.24))
		end
	end
	-- The capelet drapes over each upper arm, down to the elbow, with grommets.
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local as = arm.Size
			local ch = as.Y > 1.8 and as.Y * 0.55 or as.Y
			local outward = name:find("Left") and -1 or 1
			piece(arm, outfit, "CapeArm", Vector3.new(as.X + 0.34, ch, as.Z + 0.42), C.Coat, CFrame.new(outward * 0.06, as.Y / 2 - ch / 2 + 0.04, 0))
			piece(arm, outfit, "CapeHem", Vector3.new(as.X + 0.38, 0.08, as.Z + 0.46), C.CoatDark, CFrame.new(outward * 0.06, as.Y / 2 - ch + 0.04, 0))
			for _, y in ipairs({ 0.3, 0.65 }) do
				grommet(arm, outfit, CFrame.new(outward * 0.1, as.Y / 2 - ch * y, -as.Z / 2 - 0.26))
			end
		end
	end
	-- Long coat skirt to the calves, split at the front.
	local waist = lower or upper
	if waist then
		local ws = waist.Size
		local waistTop = lower and ws.Y / 2 or -upper.Size.Y / 2 + 0.3
		local skirtH = lower and 1.85 or 1.6
		for _, side in ipairs({ -1, 1 }) do
			piece(waist, outfit, "Skirt", Vector3.new(ws.X / 2 + 0.12, skirtH, 0.14), C.Coat, CFrame.new(side * (ws.X / 4 + 0.14), waistTop - skirtH / 2, -ws.Z / 2 - 0.1) * CFrame.Angles(0, side * 0.12, 0))
			piece(waist, outfit, "Skirt", Vector3.new(0.14, skirtH, ws.Z + 0.2), C.CoatDark, CFrame.new(side * (ws.X / 2 + 0.12), waistTop - skirtH / 2, 0.02))
		end
		piece(waist, outfit, "Skirt", Vector3.new(ws.X + 0.36, skirtH, 0.14), C.Coat, CFrame.new(0, waistTop - skirtH / 2, ws.Z / 2 + 0.1))
		piece(waist, outfit, "Waist", Vector3.new(ws.X + 0.14, 0.4, ws.Z + 0.14), C.Coat, CFrame.new(0, waistTop - 0.2, 0))
	end
	-- Pale grey-blue sleeves (gloves the same colour).
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			piece(arm, outfit, "Sleeve", arm.Size + Vector3.new(0.06, 0.02, 0.06), C.Sleeve, CFrame.new())
		end
	end
	-- Pale leggings with dark raindrop marks.
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			local ls = leg.Size
			piece(leg, outfit, "Legging", ls + Vector3.new(0.05, 0.02, 0.05), C.Leg, CFrame.new())
			local i = 0
			for y = ls.Y / 2 - 0.3, -ls.Y / 2 + 0.25, -0.45 do
				i = i + 1
				local x = (i % 2 == 0 and 0.2 or -0.2) * ls.X
				piece(leg, outfit, "Drop", Vector3.new(0.16, 0.16, 0.04), C.Drop, CFrame.new(x, y, -ls.Z / 2 - 0.04))
				piece(leg, outfit, "Drop", Vector3.new(0.06, 0.14, 0.04), C.Drop, CFrame.new(x + 0.08, y - 0.12, -ls.Z / 2 - 0.04) * CFrame.Angles(0, 0, 0.5))
				piece(leg, outfit, "Drop", Vector3.new(0.04, 0.16, 0.16), C.Drop, CFrame.new(ls.X / 2 + 0.04, y - 0.2, x * 0.6))
				piece(leg, outfit, "Drop", Vector3.new(0.04, 0.16, 0.16), C.Drop, CFrame.new(-ls.X / 2 - 0.04, y - 0.1, -x * 0.6))
			end
			-- Grey boots over the lower leg.
			if name:find("Lower") or ls.Y > 1.8 then
				local bh = ls.Y > 1.8 and 0.7 or 0.6
				piece(leg, outfit, "Boot", Vector3.new(ls.X + 0.14, bh, ls.Z + 0.14), C.Boot, CFrame.new(0, -ls.Y / 2 + bh / 2, 0))
			end
		end
	end
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(name)
		if foot then
			local fs = foot.Size
			piece(foot, outfit, "Boot", fs + Vector3.new(0.12, 0.08, 0.14), C.Boot, CFrame.new())
			-- Studs on the toe and sole.
			for _, x in ipairs({ -0.25, 0.25 }) do
				piece(foot, outfit, "Stud", Vector3.new(0.12, 0.12, 0.08), C.Stud, CFrame.new(x * fs.X, 0, -fs.Z / 2 - 0.1))
			end
		end
	end
end

function BlackmoreOutfit.apply(character)
	if character:FindFirstChild("BlackmoreOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "BlackmoreOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function BlackmoreOutfit.remove(character)
	local outfit = character:FindFirstChild("BlackmoreOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == BlackmoreOutfit.Act then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == BlackmoreOutfit.Act then
					BlackmoreOutfit.apply(character)
				end
			end)
		else
			BlackmoreOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function BlackmoreOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return BlackmoreOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">BountyService</string><ProtectedString name="Source"><![CDATA[--[[
	BountyService  (ServerScriptService.SpinServer.BountyService)

	The BOUNTY BOARD by the spawn (owner's design):
	  * a blocky board: two brown posts with grass at their feet, a brown
	    plank back, and parchment wanted posters pinned on it. The posters on
	    the board show the faces of the current top bounties.
	  * walk up and press E ("View Bounties"): the client opens the board UI
	    with a wanted poster for every other player and every Stand-user NPC
	  * accept one: you get a bounty tracker and a TARGET marker on them.
	    Land the killing blow (your hit within KillCreditTime) and you're paid
	    in Cash (leaderstats). Players are worth more the longer their kill
	    streak. Bounties run out after Duration seconds.
	Numbers: TuskConfig.Bounty. Remote: Net "Bounty".
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Net = require(Shared.Net)

local BountyService = {}
local cfg = TuskConfig.Bounty or {}
local Remote
local active = {} -- [hunter Player] = bounty
local npcIds = setmetatable({}, { __mode = "k" }) -- [model] = id
local npcById = {} -- [id] = model
local nextNpcId = 0
local posterGuis = {} -- the posters on the physical board

local WOOD = Color3.fromRGB(112, 74, 44)
local WOOD_DARK = Color3.fromRGB(88, 57, 34)
local WOOD_LIGHT = Color3.fromRGB(130, 88, 54)
local GRASS = Color3.fromRGB(88, 125, 52)
local PAPER = Color3.fromRGB(234, 205, 160) -- "skin colour" parchment
local INK = Color3.fromRGB(60, 36, 20)
local NAIL = Color3.fromRGB(60, 58, 62)

---------------------------------------------------------------------------
-- The board model
---------------------------------------------------------------------------
local function block(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.Wood
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function posterGui(poster)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.6
	gui.Parent = poster
	local function text(name, y, h, size, font, value)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0.05, y)
		l.Size = UDim2.fromScale(0.9, h)
		l.Font = font
		l.TextScaled = true
		l.TextColor3 = INK
		l.Text = value
		l.Parent = gui
		return l
	end
	text("Title", 0.03, 0.14, 1, Enum.Font.Bangers, "WANTED")
	local photo = Instance.new("ImageLabel")
	photo.Name = "Photo"
	photo.BackgroundColor3 = Color3.fromRGB(205, 175, 130)
	photo.BorderSizePixel = 0
	photo.Position = UDim2.fromScale(0.15, 0.19)
	photo.Size = UDim2.fromScale(0.7, 0.45)
	photo.ImageColor3 = Color3.fromRGB(235, 215, 185) -- old-photo tint
	photo.Parent = gui
	text("PosterName", 0.66, 0.12, 1, Enum.Font.GothamBlack, "")
	text("Reward", 0.8, 0.14, 1, Enum.Font.Bangers, "")
	return gui
end

local function buildBoard(cf)
	local model = Instance.new("Model")
	model.Name = "BountyBoard"
	-- Two posts on grassy mounds.
	for _, x in ipairs({ -4.2, 4.2 }) do
		block(model, "Post", Vector3.new(0.9, 8.6, 0.9), cf * CFrame.new(x, 4.3, 0.6), WOOD_DARK)
		block(model, "Grass", Vector3.new(2.2, 0.5, 2.2), cf * CFrame.new(x, 0.25, 0.6), GRASS, Enum.Material.Grass)
		block(model, "Grass", Vector3.new(1.4, 0.8, 1.2), cf * CFrame.new(x + 0.3, 0.4, 0.9), GRASS, Enum.Material.Grass)
	end
	-- Plank back: uneven planks, ends sticking out like the picture.
	local planks = {
		{ 7.9, 11.2, 0.4, 0.03 }, { 6.8, 10.4, -0.3, -0.02 }, { 5.7, 10.9, 0.2, 0.015 }, { 4.6, 10.2, -0.1, -0.03 },
	}
	for i, pl in ipairs(planks) do
		block(model, "Plank", Vector3.new(pl[2], 1.08, 0.35), cf * CFrame.new(pl[3], pl[1], 0) * CFrame.Angles(0, 0, pl[4]), i % 2 == 0 and WOOD or WOOD_LIGHT, Enum.Material.WoodPlanks)
	end
	-- Title board on top.
	local title = block(model, "Title", Vector3.new(6, 1.2, 0.3), cf * CFrame.new(0, 9.2, -0.05), WOOD_DARK, Enum.Material.WoodPlanks)
	local tg = Instance.new("SurfaceGui")
	tg.Face = Enum.NormalId.Front
	tg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	tg.PixelsPerStud = 50
	tg.Parent = title
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.Bangers
	tl.TextScaled = true
	tl.TextColor3 = PAPER
	tl.TextStrokeTransparency = 0.4
	tl.Text = "BOUNTIES"
	tl.Parent = tg
	-- Parchment posters pinned on the front.
	local spots = { { -3.3, 6.5, 0.06 }, { -1.1, 6.9, -0.04 }, { 1.2, 6.4, 0.05 }, { 3.4, 6.8, -0.06 }, { 0, 4.7, 0.02 } }
	for i, sp in ipairs(spots) do
		local poster = block(model, "Poster", Vector3.new(1.8, 2.3, 0.05), cf * CFrame.new(sp[1], sp[2], -0.22) * CFrame.Angles(0, 0, sp[3]), PAPER, Enum.Material.SmoothPlastic)
		block(model, "Nail", Vector3.new(0.14, 0.14, 0.1), poster.CFrame * CFrame.new(0, 1.0, -0.05), NAIL, Enum.Material.Metal)
		posterGuis[i] = posterGui(poster)
	end
	-- The prompt.
	local hit = block(model, "PromptPart", Vector3.new(8, 5, 1), cf * CFrame.new(0, 5.5, -0.6), WOOD)
	hit.Transparency = 1
	hit.CanCollide = false
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "View Bounties"
	prompt.ObjectText = "Bounty Board"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = hit
	model.PrimaryPart = hit
	return model, prompt
end

---------------------------------------------------------------------------
-- Bounties
---------------------------------------------------------------------------
local function leaderstats(player)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
		local cash = Instance.new("IntValue")
		cash.Name = "Cash"
		cash.Value = cfg.StartingCash or 0
		cash.Parent = ls
		local claimed = Instance.new("IntValue")
		claimed.Name = "Bounties"
		claimed.Value = 0
		claimed.Parent = ls
	end
	return ls
end

local function aliveModel(model)
	local h = model and model.Parent and model:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0
end

local function npcId(model)
	local id = npcIds[model]
	if not id then
		nextNpcId = nextNpcId + 1
		id = "N" .. nextNpcId
		npcIds[model] = id
		npcById[id] = model
	end
	return id
end

-- Every bounty on offer (optionally hiding the viewer).
local function listBounties(viewer)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= viewer and aliveModel(p.Character) then
			local streak = p:GetAttribute("KillStreak") or 0
			table.insert(list, {
				Key = "P" .. p.UserId,
				Kind = "Player",
				UserId = p.UserId,
				Name = p.DisplayName,
				Reward = (cfg.BaseReward or 100) + streak * (cfg.StreakReward or 50),
				Streak = streak,
				Act = p.Character:GetAttribute("TuskAct"),
			})
		end
	end
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		if aliveModel(model) then
			local h = model:FindFirstChildOfClass("Humanoid")
			table.insert(list, {
				Key = npcId(model),
				Kind = "NPC",
				Model = model,
				Name = h.DisplayName ~= "" and h.DisplayName or model.Name,
				Reward = cfg.NPCReward or 75,
				Act = model:GetAttribute("TuskAct"),
			})
		end
	end
	table.sort(list, function(a, b)
		return a.Reward > b.Reward
	end)
	while #list > (cfg.MaxPosters or 12) do
		table.remove(list)
	end
	return list
end

local function send(player, kind, data)
	Remote:FireClient(player, kind, data)
end

local function publicBounty(b)
	return { Key = b.Key, Kind = b.Kind, UserId = b.UserId, Model = b.Model, Name = b.Name, Reward = b.Reward, Expires = b.Expires, Act = b.Act }
end

local function accept(player, key)
	if typeof(key) ~= "string" then
		return
	end
	for _, entry in ipairs(listBounties(player)) do
		if entry.Key == key then
			local b = entry
			b.Expires = workspace:GetServerTimeNow() + (cfg.Duration or 300)
			active[player] = b
			send(player, "Active", publicBounty(b))
			return
		end
	end
	send(player, "Lost", { Reason = "That bounty isn't on the board any more." })
end

local function targetsThis(b, victimPlayer, model)
	if b.Kind == "Player" then
		return victimPlayer ~= nil and victimPlayer.UserId == b.UserId
	end
	return b.Model == model
end

local function onDeath(model)
	local victimPlayer = Players:GetPlayerFromCharacter(model)
	local killerId = model:GetAttribute("LastAttackerId")
	local when = model:GetAttribute("LastAttackTime") or -math.huge
	if workspace:GetServerTimeNow() - when > (cfg.KillCreditTime or 6) then
		killerId = nil
	end
	local killer = killerId and Players:GetPlayerByUserId(killerId)
	-- Kill streaks (they make players worth more on the board).
	if victimPlayer then
		victimPlayer:SetAttribute("KillStreak", 0)
	end
	if killer and killer ~= victimPlayer then
		killer:SetAttribute("KillStreak", (killer:GetAttribute("KillStreak") or 0) + 1)
	end
	for hunter, b in pairs(active) do
		if targetsThis(b, victimPlayer, model) then
			if killer == hunter then
				local ls = leaderstats(hunter)
				local cash, claimed = ls:FindFirstChild("Cash"), ls:FindFirstChild("Bounties")
				if cash then
					cash.Value = cash.Value + b.Reward
				end
				if claimed then
					claimed.Value = claimed.Value + 1
				end
				active[hunter] = nil
				send(hunter, "Complete", { Name = b.Name, Reward = b.Reward })
			elseif b.Kind == "NPC" then
				active[hunter] = nil
				send(hunter, "Lost", { Reason = "Someone else took down " .. b.Name .. "." })
			end
		end
	end
end

local function watchCharacter(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.Died:Connect(function()
			onDeath(model)
		end)
	end
end

local shownOn = {} -- [poster index] = model whose face it shows

-- An NPC's face on a poster: the model copied into a ViewportFrame.
local function setFace(photo, model)
	local old = photo:FindFirstChild("Face")
	if old then
		old:Destroy()
	end
	local head = model and model:FindFirstChild("Head")
	if not head then
		return
	end
	local was = model.Archivable
	model.Archivable = true
	local ok, copy = pcall(function()
		return model:Clone()
	end)
	model.Archivable = was
	if not ok or not copy then
		return
	end
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("BillboardGui") then
			d:Destroy()
		end
	end
	local view = Instance.new("ViewportFrame")
	view.Name = "Face"
	view.BackgroundTransparency = 1
	view.Size = UDim2.fromScale(1, 1)
	view.Ambient = Color3.fromRGB(190, 175, 160)
	view.Parent = photo
	copy.Parent = view
	local camera = Instance.new("Camera")
	camera.FieldOfView = 34
	local copyHead = copy:FindFirstChild("Head") or head
	camera.CFrame = CFrame.lookAt((copyHead.CFrame * CFrame.new(0, 0.25, -3.2)).Position, copyHead.Position + Vector3.new(0, 0.1, 0))
	camera.Parent = view
	view.CurrentCamera = camera
end

local function refreshPosters()
	local list = listBounties(nil)
	for i, gui in ipairs(posterGuis) do
		local e = list[i]
		gui.PosterName.Text = e and string.upper(e.Name) or ""
		gui.Reward.Text = e and ("$" .. e.Reward) or "NO BOUNTY"
		gui.Photo.Image = (e and e.Kind == "Player") and ("rbxthumb://type=AvatarHeadShot&id=" .. e.UserId .. "&w=150&h=150") or ""
		gui.Photo.BackgroundTransparency = e and 0 or 0.6
		local model = e and e.Kind == "NPC" and e.Model or nil
		if shownOn[i] ~= model then
			shownOn[i] = model
			setFace(gui.Photo, model)
		end
	end
end

function BountyService.init()
	if cfg.Enabled == false then
		return
	end
	Remote = Net.get("Bounty")
	-- Board by the spawn (or by any SpawnLocation without the map).
	local map = workspace:FindFirstChild("SBRMap")
	local base
	if map then
		base = (map:GetAttribute("Origin") or Vector3.new()) + (cfg.BoardOffset or Vector3.new(-20, 0, 140))
	else
		local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		base = spawn and (spawn.Position + Vector3.new(-14, -0.5, -8)) or Vector3.new(-20, 0, 0)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ground = workspace:Raycast(base + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0), params)
	if ground then
		base = ground.Position
	end
	local facing = cfg.BoardFacing or Vector3.new(1, 0, 0.5)
	local model, prompt = buildBoard(CFrame.lookAt(base, base + Vector3.new(facing.X, 0, facing.Z)))
	model.Parent = map or workspace

	prompt.Triggered:Connect(function(player)
		send(player, "Open", { Bounties = listBounties(player), Active = active[player] and publicBounty(active[player]) or nil })
	end)
	Remote.OnServerEvent:Connect(function(player, action, key)
		if action == "Accept" then
			accept(player, key)
		elseif action == "Abandon" then
			active[player] = nil
			send(player, "Cleared", {})
		end
	end)

	local function onPlayer(player)
		leaderstats(player)
		player.CharacterAdded:Connect(watchCharacter)
		if player.Character then
			task.spawn(watchCharacter, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		for hunter, b in pairs(active) do
			if b.Kind == "Player" and b.UserId == player.UserId then
				active[hunter] = nil
				send(hunter, "Lost", { Reason = b.Name .. " left the game." })
			end
		end
	end)
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		task.spawn(watchCharacter, model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(function(model)
		task.spawn(watchCharacter, model)
	end)

	-- Expiry, vanished NPC targets, and the posters on the board.
	local acc, posterAcc = 0, 5
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		posterAcc = posterAcc + dt
		if acc >= 1 then
			acc = 0
			local now = workspace:GetServerTimeNow()
			for hunter, b in pairs(active) do
				if now > b.Expires then
					active[hunter] = nil
					send(hunter, "Lost", { Reason = "Your bounty on " .. b.Name .. " ran out." })
				elseif b.Kind == "NPC" and not (b.Model and b.Model.Parent) then
					active[hunter] = nil
					send(hunter, "Lost", { Reason = b.Name .. " is gone." })
				end
			end
		end
		if posterAcc >= 5 then
			posterAcc = 0
			refreshPosters()
		end
	end)
end

return BountyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">CombatAdapter</string><ProtectedString name="Source"><![CDATA[--[[
	CombatAdapter  (ServerScriptService.SpinServer.CombatAdapter)

	THE ONE PLACE the Spin system touches combat. If SPIN BATTLEGROUNDS
	already has a combat framework (damage, stun, block), plug it into the
	Hooks table below instead of letting this file use its defaults. That
	way there is never a second, competing combat system.

	Example (in your own server code, before players join):
		local Adapter = require(ServerScriptService.SpinServer.CombatAdapter)
		Adapter.Hooks.ApplyDamage = function(attacker, humanoid, amount, info)
			YourCombat.Damage(attacker, humanoid, amount)
		end
		Adapter.Hooks.IsBlocking = function(character)
			return YourCombat.IsBlocking(character)
		end
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")

local Net = require(game:GetService("ReplicatedStorage").SpinShared.Net)
local TuskConfig = require(game:GetService("ReplicatedStorage").SpinShared.TuskConfig)
local FX = Net.get("SpinFX")

local Adapter = {}

Adapter.Settings = {
	FriendlyFire = false, -- same-Team players can't hit each other
	BlockAttribute = "Blocking", -- character attribute your block sets
	BlockDamageMultiplier = 0.35,
	BlockKnockbackMultiplier = 0.3,
	IFrameAttribute = "IFrames", -- character attribute = invulnerable (dashes etc.)
	ArmorAttribute = "Armored", -- character attribute = takes damage but no stun/knockback (ult wind-ups)
	MaxKnockback = 90, -- hard cap so no move can fling players across the map
	MaxStun = 1.0, -- hard cap on any single stun
	StunAttribute = "Stunned",
	StunWalkSpeedMultiplier = 0.15,
	StunImmunityAfter = 0.5, -- seconds after a stun ends where no new stun applies
	KnockbackDuration = 0.18,
}

-- Optional overrides. Leave nil to use the defaults in this file.
Adapter.Hooks = {
	ApplyDamage = nil, -- function(attackerPlayer, humanoid, amount, info)
	ApplyStun = nil, -- function(humanoid, duration) -> applied:boolean
	IsBlocking = nil, -- function(character) -> boolean
	CanAct = nil, -- function(player) -> boolean (extra checks: ragdoll, menus...)
	CanBeHit = nil, -- function(attackerPlayer, targetCharacter) -> boolean
}

local moveMods = setmetatable({}, { __mode = "k" }) -- humanoid -> { mods = {}, product = 1 }
local stunState = setmetatable({}, { __mode = "k" }) -- humanoid -> { token, immuneUntil }

function Adapter.getAlive(player)
	local character = player and player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil
	end
	return character, humanoid, root
end

function Adapter.isStunned(character)
	return character:GetAttribute(Adapter.Settings.StunAttribute) == true
end

function Adapter.canAct(player)
	local character = Adapter.getAlive(player)
	if not character then
		return false
	end
	if Adapter.isStunned(character) then
		return false
	end
	-- Turned into Diego's dinosaur (Scary Monsters): Diego is in control.
	if character:GetAttribute("DinoThrall") then
		return false
	end
	if Adapter.Hooks.CanAct and not Adapter.Hooks.CanAct(player) then
		return false
	end
	return true
end

function Adapter.canBeHit(attackerPlayer, targetCharacter)
	if not targetCharacter or (attackerPlayer and targetCharacter == attackerPlayer.Character) then
		return false
	end
	local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if targetCharacter:GetAttribute(Adapter.Settings.IFrameAttribute) == true then
		return false
	end
	if targetCharacter:FindFirstChildOfClass("ForceField") then
		return false
	end
	-- Diego can't hurt the dinosaur he is commanding.
	if attackerPlayer and targetCharacter:GetAttribute("DinoThrall") == attackerPlayer.UserId then
		return false
	end
	if not Adapter.Settings.FriendlyFire and attackerPlayer then
		local targetPlayer = Players:GetPlayerFromCharacter(targetCharacter)
		if targetPlayer and not attackerPlayer.Neutral and not targetPlayer.Neutral and targetPlayer.Team == attackerPlayer.Team then
			return false
		end
	end
	if Adapter.Hooks.CanBeHit and not Adapter.Hooks.CanBeHit(attackerPlayer, targetCharacter) then
		return false
	end
	return true
end

-- Stackable walk-speed multipliers keyed by source ("SpinCharge", "Stun"...).
function Adapter.setMoveModifier(humanoid, key, multiplier)
	local state = moveMods[humanoid]
	if not state then
		state = { mods = {}, product = 1 }
		moveMods[humanoid] = state
	end
	local base = humanoid.WalkSpeed / state.product
	state.mods[key] = multiplier
	local product = 1
	for _, m in pairs(state.mods) do
		product = product * m
	end
	state.product = product
	humanoid.WalkSpeed = base * product
end

-- True when the hit comes from in front of the target (blocks only face forward).
function Adapter.isFrontal(attackerPlayer, targetCharacter, info)
	local d = TuskConfig.Defense or {}
	if d.FrontOnly == false then
		return true
	end
	local root = targetCharacter:FindFirstChild("HumanoidRootPart")
	local attacker = attackerPlayer and attackerPlayer.Character
	local from = attacker and attacker:FindFirstChild("HumanoidRootPart")
	local source = from and from.Position or (info and info.Position)
	if not root or not source then
		return true
	end
	local offset = Vector3.new(source.X - root.Position.X, 0, source.Z - root.Position.Z)
	if offset.Magnitude < 0.5 then
		return true
	end
	return root.CFrame.LookVector:Dot(offset.Unit) >= -0.1
end

function Adapter.isBlocking(character)
	if Adapter.Hooks.IsBlocking then
		return Adapter.Hooks.IsBlocking(character) == true
	end
	return character:GetAttribute(Adapter.Settings.BlockAttribute) == true
end

function Adapter.applyStun(humanoid, duration)
	duration = math.min(duration, Adapter.Settings.MaxStun)
	if duration <= 0 then
		return false
	end
	if humanoid.Parent and humanoid.Parent:GetAttribute(Adapter.Settings.ArmorAttribute) == true then
		return false
	end
	if Adapter.Hooks.ApplyStun then
		return Adapter.Hooks.ApplyStun(humanoid, duration)
	end
	local character = humanoid.Parent
	local state = stunState[humanoid] or { token = 0, immuneUntil = 0 }
	stunState[humanoid] = state
	local now = os.clock()
	if now < state.immuneUntil and not Adapter.isStunned(character) then
		return false -- anti stun-lock
	end
	state.token = state.token + 1
	local token = state.token
	character:SetAttribute(Adapter.Settings.StunAttribute, true)
	Adapter.setMoveModifier(humanoid, "Stun", Adapter.Settings.StunWalkSpeedMultiplier)
	task.delay(duration, function()
		if state.token ~= token or not humanoid.Parent then
			return
		end
		character:SetAttribute(Adapter.Settings.StunAttribute, nil)
		Adapter.setMoveModifier(humanoid, "Stun", nil)
		state.immuneUntil = os.clock() + Adapter.Settings.StunImmunityAfter
	end)
	return true
end

function Adapter.applyKnockback(character, direction, strength, upward)
	local root = character:FindFirstChild("HumanoidRootPart")
	strength = math.min(strength or 0, Adapter.Settings.MaxKnockback)
	upward = upward or strength * 0.3
	if not root or (strength <= 0 and upward <= 0) then
		return
	end
	if character:GetAttribute(Adapter.Settings.ArmorAttribute) == true then
		return
	end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 1e-3 then
		flat = -root.CFrame.LookVector
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "SpinKnockback"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = flat.Unit * strength + Vector3.new(0, math.min(upward, Adapter.Settings.MaxKnockback), 0)
	velocity.Parent = attachment
	Debris:AddItem(attachment, Adapter.Settings.KnockbackDuration)
end

--[[
	dealHit: the only entry point for Spin damage. Server only.
	info = { Damage, Stun, Knockback, Launch?, Direction, Position, Level, Perfect, Source }
	Returns: hit:boolean, damageDealt:number
]]
-- Counter-dodges (e.g. Mountain Tim's Split Dodge): while the target has
-- the attribute, an incoming hit is cancelled and the handler runs instead.
-- Adapter.DodgeHandlers[attributeName] = function(attackerPlayer, target, info)
Adapter.DodgeHandlers = {}

function Adapter.dealHit(attackerPlayer, targetCharacter, info)
	if targetCharacter and attackerPlayer and targetCharacter ~= attackerPlayer.Character then
		for attribute, handler in pairs(Adapter.DodgeHandlers) do
			if targetCharacter:GetAttribute(attribute) then
				pcall(handler, attackerPlayer, targetCharacter, info)
				return false
			end
		end
	end
	if not Adapter.canBeHit(attackerPlayer, targetCharacter) then
		return false
	end
	local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	local blocked = Adapter.isBlocking(targetCharacter) and Adapter.isFrontal(attackerPlayer, targetCharacter, info)
	local s = Adapter.Settings
	local d = TuskConfig.Defense or {}
	local guardBreak = false
	if blocked then
		local now = workspace:GetServerTimeNow()
		local start = targetCharacter:GetAttribute("BlockStart")
		-- PERFECT BLOCK: no damage, the attacker is stunned.
		if attackerPlayer and start and now - start <= (d.ParryWindow or 0.2) and targetCharacter:GetAttribute("BlockCanParry") then
			targetCharacter:SetAttribute("BlockCanParry", nil)
			local attacker = attackerPlayer.Character
			local ah = attacker and attacker:FindFirstChildOfClass("Humanoid")
			if ah then
				Adapter.applyStun(ah, d.ParryStun or 1)
				local ar = attacker:FindFirstChild("HumanoidRootPart")
				local tr = targetCharacter:FindFirstChild("HumanoidRootPart")
				if ar and tr then
					Adapter.applyKnockback(attacker, ar.Position - tr.Position, 22, 6)
				end
			end
			FX:FireAllClients("Parry", { Defender = targetCharacter, Attacker = attacker, Position = info.Position })
			return false
		end
		-- The guard bar takes the hit; when it runs out the guard breaks.
		local meter = (targetCharacter:GetAttribute("BlockMeter") or d.MaxMeter or 100) - info.Damage * (d.MeterPerDamage or 4)
		targetCharacter:SetAttribute("BlockMeter", math.max(meter, 0))
		targetCharacter:SetAttribute("LastBlockHit", now)
		if meter <= 0 then
			guardBreak = true
			blocked = false
			targetCharacter:SetAttribute(s.BlockAttribute, nil)
			targetCharacter:SetAttribute("GuardBrokenUntil", now + (d.GuardBreakLockout or 3))
			Adapter.setMoveModifier(humanoid, "Block", nil)
		end
	end

	local damage = info.Damage * (blocked and s.BlockDamageMultiplier or 1)
	local knockback = info.Knockback * (blocked and s.BlockKnockbackMultiplier or 1)

	-- Who hit them last (kill credit for bounties and kill streaks).
	if attackerPlayer then
		targetCharacter:SetAttribute("LastAttackerId", attackerPlayer.UserId)
		targetCharacter:SetAttribute("LastAttackTime", workspace:GetServerTimeNow())
	end
	if Adapter.Hooks.ApplyDamage then
		Adapter.Hooks.ApplyDamage(attackerPlayer, humanoid, damage, info)
	else
		humanoid:TakeDamage(damage)
	end
	if guardBreak then
		Adapter.applyStun(humanoid, math.max(info.Stun or 0, d.GuardBreakStun or 1))
		FX:FireAllClients("GuardBreak", { Victim = targetCharacter, Position = info.Position })
	elseif not blocked then
		Adapter.applyStun(humanoid, info.Stun or 0)
	end
	local launch = info.Launch and info.Launch * (blocked and s.BlockKnockbackMultiplier or 1) or nil
	Adapter.applyKnockback(targetCharacter, info.Direction, knockback, launch)

	FX:FireAllClients("Hit", {
		Position = info.Position,
		Level = info.Level,
		Perfect = info.Perfect,
		Blocked = blocked,
		Victim = targetCharacter,
		Source = info.Source,
		AttackerId = attackerPlayer and attackerPlayer.UserId or 0,
	})
	if attackerPlayer and typeof(attackerPlayer) == "Instance" then
		FX:FireClient(attackerPlayer, "Damage", {
			Position = info.Position,
			Amount = math.floor(damage + 0.5),
			Blocked = blocked,
			Perfect = info.Perfect,
		})
	end
	return true, damage
end

return Adapter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">CooldownService</string><ProtectedString name="Source"><![CDATA[--[[
	CooldownService  (ServerScriptService.SpinServer.CooldownService)
	Server-owned cooldowns. Clients only ever display what the server says.
	Reusable by any ability: CooldownService.start(player, "AbilityKey", seconds)
]]

local Players = game:GetService("Players")

local CooldownService = {}
local readyAt = {} -- [player] = { [key] = os.clock() time when ready }

function CooldownService.remaining(player, key)
	local list = readyAt[player]
	local t = list and list[key]
	if not t then
		return 0
	end
	return math.max(0, t - os.clock())
end

function CooldownService.isReady(player, key)
	return CooldownService.remaining(player, key) <= 0
end

function CooldownService.start(player, key, duration)
	local list = readyAt[player]
	if not list then
		list = {}
		readyAt[player] = list
	end
	list[key] = os.clock() + duration
end

function CooldownService.reset(player, key)
	if readyAt[player] then
		readyAt[player][key] = nil
	end
end

Players.PlayerRemoving:Connect(function(player)
	readyAt[player] = nil
end)

return CooldownService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">DefenseService</string><ProtectedString name="Source"><![CDATA[--[[
	DefenseService  (ServerScriptService.SpinServer.DefenseService)

	BLOCK and DASH for every character (players and Stand-user NPCs).
	  BLOCK (hold F): sets the "Blocking" attribute; CombatAdapter then cuts
	    damage, skips the stun and drains the guard bar (BlockMeter). Hits from
	    behind aren't blocked. Starting a block just before a hit lands is a
	    PERFECT BLOCK (no damage, the attacker is stunned). An empty guard bar
	    is a GUARD BREAK (stunned, can't block for a few seconds). Attacking or
	    dashing drops the block. The bar refills while you aren't blocking.
	  DASH (Q): a short burst in the direction you're moving, with a moment
	    you can't be hit. The server checks the cooldown and grants it; the
	    player's own client moves them (smooth, replicates to everyone).
	    NPCs are moved by the server.
	Numbers: TuskConfig.Defense.
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)

local DefenseService = {}
local S -- TuskService
local cfg = TuskConfig.Defense or {}
local dashReady = setmetatable({}, { __mode = "k" }) -- [player] = os.clock() when the next dash is allowed
local lastRelease = setmetatable({}, { __mode = "k" }) -- [character] = server time of the last block release

local function now()
	return workspace:GetServerTimeNow()
end

function DefenseService.isBlocking(character)
	return character ~= nil and character:GetAttribute(S.Adapter.Settings.BlockAttribute) == true
end

function DefenseService.release(player, state)
	local character = state and state.Character or (player and player.Character)
	if not character or not DefenseService.isBlocking(character) then
		return
	end
	character:SetAttribute(S.Adapter.Settings.BlockAttribute, nil)
	character:SetAttribute("BlockCanParry", nil)
	lastRelease[character] = now()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		S.Adapter.setMoveModifier(humanoid, "Block", nil)
	end
end

function DefenseService.block(player, state, on)
	local character, humanoid = S.Adapter.getAlive(player)
	if not character then
		return
	end
	if not on then
		DefenseService.release(player, state)
		return
	end
	if DefenseService.isBlocking(character) then
		return
	end
	if not S.Adapter.canAct(player) or state.Charging or S.isBusy(state) or state.Sneaking then
		return
	end
	if (character:GetAttribute("GuardBrokenUntil") or 0) > now() then
		S.tell(player, "Denied", { Reason = "GuardBroken" })
		return
	end
	local t = now()
	character:SetAttribute("BlockStart", t)
	-- Perfect blocks only count if this isn't block spam.
	character:SetAttribute("BlockCanParry", (t - (lastRelease[character] or -math.huge)) >= (cfg.ParryRetry or 0.6) or nil)
	if character:GetAttribute("BlockMeter") == nil then
		character:SetAttribute("BlockMeter", cfg.MaxMeter or 100)
	end
	character:SetAttribute(S.Adapter.Settings.BlockAttribute, true)
	S.Adapter.setMoveModifier(humanoid, "Block", cfg.BlockWalkSpeed or 0.45)
end

function DefenseService.dash(player, state, direction)
	local character, _, root = S.Adapter.getAlive(player)
	if not character or typeof(direction) ~= "Vector3" or direction ~= direction then
		return
	end
	if not S.Adapter.canAct(player) or state.Charging or S.isBusy(state) or state.Sneaking then
		return
	end
	local clock = os.clock()
	if (dashReady[player] or 0) > clock then
		S.tell(player, "Denied", { Reason = "DashCooldown" })
		return
	end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	end
	flat = flat.Unit
	DefenseService.release(player, state)
	local cooldown = cfg.DashCooldown or 2.2
	dashReady[player] = clock + cooldown
	character:SetAttribute("DashReadyAt", now() + cooldown)
	local iframes = S.Adapter.Settings.IFrameAttribute
	character:SetAttribute(iframes, true)
	task.delay(cfg.DashIFrames or 0.2, function()
		character:SetAttribute(iframes, nil)
	end)
	local speed, time = cfg.DashSpeed or 75, cfg.DashTime or 0.2
	S.fx("Dash", { Character = character, Direction = flat, Speed = speed, Time = time })
	-- NPCs have no client to move them: the server does it.
	if typeof(player) ~= "Instance" then
		local attachment = Instance.new("Attachment")
		attachment.Parent = root
		local velocity = Instance.new("LinearVelocity")
		velocity.Attachment0 = attachment
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.MaxForce = math.huge
		velocity.VectorVelocity = flat * speed
		velocity.Parent = attachment
		game:GetService("Debris"):AddItem(attachment, time)
	end
end

-- Guard bars refill while not blocking.
local function regen(dt)
	local max = cfg.MaxMeter or 100
	local t = now()
	local function tick(character)
		local meter = character and character:GetAttribute("BlockMeter")
		if meter and meter < max and not DefenseService.isBlocking(character) and t - (character:GetAttribute("LastBlockHit") or 0) >= (cfg.RegenDelay or 1.2) then
			local nextValue = math.min(max, meter + (cfg.MeterRegen or 30) * dt)
			character:SetAttribute("BlockMeter", nextValue >= max and nil or nextValue)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		tick(player.Character)
	end
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		tick(model)
	end
end

function DefenseService.init(TuskService)
	S = TuskService
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc >= 0.1 then
			regen(acc)
			acc = 0
		end
	end)
end

return DefenseService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">DiegoOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	DiegoOutfit  (ServerScriptService.SpinServer.DiegoOutfit)

	Gives a character Diego Brando's half-dinosaur look while they play Diego
	(TuskAct 6), built from parts so no catalog asset ids are needed
	(from the owner's references):
	  * green scaled racing cap with "DIO" on the front
	  * spiky blond hair sticking out under it
	  * a long blue dinosaur tail with a pale belly and yellow markings
	The player's own clothes stay on. Their own hats/hair are hidden while
	they play Diego and come back when they switch. Built on the server so
	every player sees it. (In full raptor form the client hides all of this
	and draws the raptor instead.)
]]

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("SpinShared")
local TuskConfig = require(Shared.TuskConfig)
local Blockify = require(Shared.Blockify)

local DiegoOutfit = {}
DiegoOutfit.DiegoAct = 6

local C = {
	Cap = Color3.fromRGB(70, 160, 120),
	CapDark = Color3.fromRGB(40, 110, 85),
	Scale = Color3.fromRGB(110, 200, 150),
	Letters = Color3.fromRGB(240, 230, 200),
	Hair = Color3.fromRGB(245, 214, 110),
	HairDark = Color3.fromRGB(214, 176, 72),
	TailTeal = Color3.fromRGB(95, 205, 212),
	TailBlue = Color3.fromRGB(38, 62, 190),
	Pale = Color3.fromRGB(242, 234, 172),
	Yellow = Color3.fromRGB(246, 212, 62),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, props, offset, ellipsoid)
	local p = Instance.new("Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	if ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

local function cap(head, outfit)
	local s = head.Size.Y / 1.2
	local top = head.Size.Y * 0.5
	-- Dome with a ridge of scales, short brim, "DIO" on the front.
	piece(head, outfit, { Name = "CapDome", Size = Vector3.new(1.42, 0.95, 1.42) * s, Color = C.Cap }, CFrame.new(0, top - 0.12 * s, 0.02 * s), true)
	piece(head, outfit, { Name = "CapBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.22 * s, 1.36 * s, 1.36 * s), Color = C.CapDark }, CFrame.new(0, top - 0.32 * s, 0.02 * s) * CFrame.Angles(0, 0, math.pi / 2))
	piece(head, outfit, { Name = "CapBrim", Size = Vector3.new(1.0, 0.08, 0.5) * s, Color = C.CapDark }, CFrame.new(0, top - 0.36 * s, -0.78 * s) * CFrame.Angles(-0.12, 0, 0))
	for i = 0, 6 do
		local a = (i / 6 - 0.5) * 2.2
		piece(head, outfit, { Name = "CapScale", Size = Vector3.new(0.3, 0.16, 0.3) * s, Color = C.Scale }, CFrame.new(0, top - 0.12 * s, 0.02 * s) * CFrame.Angles(a, 0, 0) * CFrame.new(0, 0.46 * s, 0), true)
	end
	local plate = piece(head, outfit, { Name = "CapLetters", Size = Vector3.new(1.0, 0.36, 0.05) * s, Color = C.Cap, Transparency = 1 }, CFrame.new(0, top + 0.02 * s, -0.68 * s) * CFrame.Angles(-0.35, 0, 0))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.Parent = plate
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Bangers
	label.TextScaled = true
	label.TextColor3 = C.Letters
	label.TextStrokeTransparency = 0.3
	label.Text = "DIO"
	label.Parent = gui
end

local function hair(head, outfit)
	local s = head.Size.Y / 1.2
	-- Spiky blond hair sticking out the sides and back under the cap.
	local spikes = {
		{ -0.62, 0.05, 0.1, 0, 0, 0.9 }, { 0.62, 0.05, 0.1, 0, 0, -0.9 },
		{ -0.55, -0.2, 0.35, 0.4, 0, 0.7 }, { 0.55, -0.2, 0.35, 0.4, 0, -0.7 },
		{ 0, -0.1, 0.62, 1.0, 0, 0 }, { -0.3, -0.25, 0.58, 1.1, 0, 0.4 }, { 0.3, -0.25, 0.58, 1.1, 0, -0.4 },
		{ -0.35, 0.15, -0.6, -0.9, 0, 0.3 }, { 0.35, 0.15, -0.6, -0.9, 0, -0.3 },
	}
	for i, sp in ipairs(spikes) do
		piece(head, outfit, { Name = "HairSpike", Size = Vector3.new(0.3, 0.8, 0.3) * s, Color = (i % 2 == 0) and C.Hair or C.HairDark },
			CFrame.new(sp[1] * s, sp[2] * s, sp[3] * s) * CFrame.Angles(sp[4], sp[5], sp[6]) * CFrame.new(0, 0.25 * s, 0), true)
	end
	piece(head, outfit, { Name = "HairBack", Size = Vector3.new(1.25, 0.9, 0.5) * s, Color = C.Hair }, CFrame.new(0, 0.05 * s, 0.45 * s), true)
end

local function tail(character, outfit)
	local hip = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
	if not hip then
		return
	end
	local s = hip.Size.X / 2
	local back = hip.Size.Z / 2
	-- Starts at the lower back, sweeps down and back, the tip curls up.
	local cf = CFrame.new(0, -hip.Size.Y * 0.2, back) * CFrame.Angles(0.75, 0, 0) -- (+X tips the backward-pointing tail down)
	local count = 8
	for i = 1, count do
		local k = (i - 1) / count
		local d = 0.85 * (1 - k * 0.8) * s
		local len = 0.85 * s
		local color = i <= 2 and C.TailTeal:Lerp(C.TailBlue, (i - 1) / 2) or C.TailBlue
		local segCF = cf * CFrame.new(0, 0, len / 2)
		piece(hip, outfit, { Name = "Tail", Size = Vector3.new(d, d * 0.92, len * 1.6), Color = color }, segCF, true)
		piece(hip, outfit, { Name = "TailBelly", Size = Vector3.new(d * 0.7, d * 0.4, len * 1.5), Color = C.Pale }, segCF * CFrame.new(0, -d * 0.3, 0), true)
		if i >= 2 and i <= 7 then
			piece(hip, outfit, { Name = "TailMark", Size = Vector3.new(d * 0.35, d * 0.12, len * 0.7), Color = C.Yellow }, segCF * CFrame.new(0, d * 0.44, 0), true)
		end
		local bend = (i <= 4) and -0.16 or (i >= 6 and -0.22 or 0) -- level out, then the tip curls up
		cf = cf * CFrame.new(0, 0, len) * CFrame.Angles(bend, 0, 0)
	end
end

function DiegoOutfit.apply(character)
	if character:FindFirstChild("DiegoOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "DiegoOutfit"
	outfit.Parent = character
	cap(head, outfit)
	hair(head, outfit)
	tail(character, outfit)
	-- The dinosaur tail is Scary Monsters' and follows its blocky look.
	if Blockify.enabled(TuskConfig) then
		for _, p in ipairs(outfit:GetChildren()) do
			if p.Name:sub(1, 4) == "Tail" then
				Blockify.apply(p)
			end
		end
	end
end

function DiegoOutfit.remove(character)
	local outfit = character:FindFirstChild("DiegoOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for handle, transparency in pairs(store.Hidden) do
		if handle.Parent then
			handle.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == DiegoOutfit.DiegoAct then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == DiegoOutfit.DiegoAct then
					DiegoOutfit.apply(character)
				end
			end)
		else
			DiegoOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function DiegoOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return DiegoOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">GyroOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	GyroOutfit  (ServerScriptService.SpinServer.GyroOutfit)

	Gives a character Gyro Zeppeli's hat and hair while they play Gyro
	(TuskAct 5), built from parts so no catalog asset ids are needed:
	  * tan wide-brimmed hat with slots cut round the brim, slits round the
	    crown, a domed top and two big ridged silver goggles on a strap
	  * long blond hair with side locks, braids and a fringe
	The player's own clothes stay on. Their own hats/hair are hidden while
	they play Gyro and come back when they switch. Built on the server so
	every player sees it.
]]

local Players = game:GetService("Players")

local GyroOutfit = {}
GyroOutfit.GyroAct = 5

local C = {
	Hat = Color3.fromRGB(206, 168, 128),
	HatShade = Color3.fromRGB(150, 105, 70),
	Slot = Color3.fromRGB(55, 38, 26),
	Strap = Color3.fromRGB(80, 84, 92),
	Goggle = Color3.fromRGB(176, 182, 192),
	HatBand = Color3.fromRGB(60, 40, 90),
	Gold = Color3.fromRGB(235, 190, 70),
	Hair = Color3.fromRGB(240, 205, 110),
	HairDark = Color3.fromRGB(210, 170, 80),
	Shirt = Color3.fromRGB(102, 64, 150),
	Pants = Color3.fromRGB(70, 46, 110),
}

local saved = setmetatable({}, { __mode = "k" }) -- character -> what to restore

local function piece(parent, outfit, props, offset, ellipsoid)
	local p = Instance.new("Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	if ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

-- Gyro's hat (from the owner's pictures): tan, a wide brim with slots cut
-- all the way round, slits around the crown, a domed top, and two big silver
-- goggles with ridged lenses strapped to the front.
local function hat(head, outfit)
	local s = head.Size.Y / 1.2
	local top = head.Size.Y * 0.5
	local base = CFrame.new(0, top - 0.05 * s, 0.05 * s) * CFrame.Angles(-0.12, 0, 0)
	local tan, tanDark = C.Hat, C.HatShade
	piece(head, outfit, { Name = "HatBrim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1 * s, 2.9 * s, 2.9 * s), Color = tan }, base * CFrame.Angles(0, 0, math.pi / 2))
	piece(head, outfit, { Name = "HatBrimEdge", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.09 * s, 2.96 * s, 2.96 * s), Color = tanDark }, base * CFrame.new(0, -0.01 * s, 0) * CFrame.Angles(0, 0, math.pi / 2))
	-- Slots cut into the brim, all the way round.
	for i = 0, 21 do
		local a = i / 22 * math.pi * 2
		local r = 1.08 * s
		piece(head, outfit, { Name = "BrimSlot", Size = Vector3.new(0.08 * s, 0.03 * s, 0.34 * s), Color = C.Slot }, base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.055 * s, -r))
	end
	-- Crown with slits, domed top.
	piece(head, outfit, { Name = "HatCrown", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.72 * s, 1.45 * s, 1.45 * s), Color = tan }, base * CFrame.new(0, 0.4 * s, 0) * CFrame.Angles(0, 0, math.pi / 2))
	piece(head, outfit, { Name = "HatTop", Size = Vector3.new(1.45, 0.42, 1.45) * s, Color = Color3.fromRGB(226, 196, 160) }, base * CFrame.new(0, 0.76 * s, 0), true)
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		piece(head, outfit, { Name = "CrownSlit", Size = Vector3.new(0.06 * s, 0.34 * s, 0.03 * s), Color = C.Slot }, base * CFrame.new(0, 0.48 * s, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -0.73 * s))
	end
	-- Goggle strap around the crown.
	piece(head, outfit, { Name = "GoggleStrap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.16 * s, 1.5 * s, 1.5 * s), Color = C.Strap }, base * CFrame.new(0, 0.24 * s, 0) * CFrame.Angles(0, 0, math.pi / 2))
	-- Two big silver goggles with horizontal ridges, joined by a bridge.
	for _, side in ipairs({ -1, 1 }) do
		local lensCF = base * CFrame.new(side * 0.4 * s, 0.38 * s, -0.8 * s) * CFrame.Angles(0, side * 0.35, 0)
		piece(head, outfit, { Name = "GoggleRim", Size = Vector3.new(0.8, 0.62, 0.28) * s, Color = C.Strap, Material = Enum.Material.Metal }, lensCF * CFrame.new(0, 0, 0.04 * s), true)
		piece(head, outfit, { Name = "GoggleLens", Size = Vector3.new(0.72, 0.55, 0.32) * s, Color = C.Goggle, Material = Enum.Material.Metal, Reflectance = 0.25 }, lensCF, true)
		for r = -1, 1 do
			piece(head, outfit, { Name = "GoggleRidge", Size = Vector3.new(0.58 * s, 0.04 * s, 0.05 * s), Color = C.Strap, Material = Enum.Material.Metal }, lensCF * CFrame.new(0, r * 0.13 * s, -0.15 * s))
		end
	end
	piece(head, outfit, { Name = "GoggleBridge", Size = Vector3.new(0.22, 0.14, 0.14) * s, Color = C.Strap, Material = Enum.Material.Metal }, base * CFrame.new(0, 0.38 * s, -0.84 * s))
end

local function hair(head, outfit)
	local s = head.Size.Y / 1.2
	piece(head, outfit, { Name = "HairBack", Size = Vector3.new(1.25, 1.5, 0.55) * s, Color = C.Hair }, CFrame.new(0, -0.25 * s, 0.45 * s), true)
	piece(head, outfit, { Name = "HairTop", Size = Vector3.new(1.28, 0.6, 1.25) * s, Color = C.Hair }, CFrame.new(0, 0.38 * s, 0.05 * s), true)
	-- Long side locks framing the face, and two braids hanging past the shoulders.
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, { Name = "SideHair", Size = Vector3.new(0.32, 1.5, 0.7) * s, Color = C.Hair }, CFrame.new(side * 0.66 * s, -0.35 * s, 0.12 * s), true)
		for i = 0, 5 do
			piece(head, outfit, { Name = "Braid", Size = Vector3.new(0.26, 0.34, 0.26) * s, Color = (i % 2 == 0) and C.Hair or C.HairDark }, CFrame.new(side * 0.78 * s, (-0.55 - i * 0.28) * s, -0.05 * s), true)
		end
	end
	-- Short fringe peeking out under the hat brim.
	piece(head, outfit, { Name = "Fringe", Size = Vector3.new(1.1, 0.25, 0.3) * s, Color = C.Hair }, CFrame.new(0, 0.42 * s, -0.5 * s), true)
end

function GyroOutfit.apply(character)
	if character:FindFirstChild("GyroOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	-- Hide the player's own hats and hair so they don't poke through Gyro's.
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "GyroOutfit"
	outfit.Parent = character
	hat(head, outfit)
	hair(head, outfit)
end

function GyroOutfit.remove(character)
	local outfit = character:FindFirstChild("GyroOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for handle, transparency in pairs(store.Hidden) do
		if handle.Parent then
			handle.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == GyroOutfit.GyroAct then
			-- Wait for the avatar's clothes/accessories to load before swapping them.
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == GyroOutfit.GyroAct then
					GyroOutfit.apply(character)
				end
			end)
		else
			GyroOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function GyroOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return GyroOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">HotPantsOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	HotPantsOutfit  (ServerScriptService.SpinServer.HotPantsOutfit)

	Gives a character Hot Pants' look while they play her (TuskAct 10),
	built from blocky parts (no catalog asset ids), matched to her art:
	  * a pink-purple bob with bangs
	  * a black cap with a gold front plate, gold visor, rivets and a gold
	    spike on top
	  * a thick cream scarf wrapped round her neck
	  * a pink tunic dress with a shoulder capelet, gold four-petal flower
	    clasps, gold leaf studs, a darker pink round panel on the front and a
	    black fur hem
	  * a gold chain belt with square links, a round "HP" buckle and a
	    holster on her hip
	  * cream ribbed sleeves and leggings
	  * tall pink flared boots with pointed cream toes
	  * (CREAM STARTER, her Stand, is drawn in her hand by the client)
	The player's own hats/hair are hidden while they play her and come back
	when she switches. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local HotPantsOutfit = {}
HotPantsOutfit.Act = 10

local C = {
	Hair = Color3.fromRGB(206, 112, 188),
	HairDark = Color3.fromRGB(160, 80, 150),
	Cap = Color3.fromRGB(28, 26, 30),
	Gold = Color3.fromRGB(226, 182, 64),
	GoldDark = Color3.fromRGB(170, 128, 40),
	Scarf = Color3.fromRGB(236, 228, 208),
	ScarfLine = Color3.fromRGB(196, 186, 164),
	Dress = Color3.fromRGB(226, 96, 150),
	DressDark = Color3.fromRGB(184, 64, 120),
	Fur = Color3.fromRGB(26, 24, 28),
	Rib = Color3.fromRGB(232, 224, 202),
	RibLine = Color3.fromRGB(196, 188, 166),
	Boot = Color3.fromRGB(232, 108, 160),
	BootDark = Color3.fromRGB(190, 78, 128),
	Toe = Color3.fromRGB(238, 232, 214),
	Holster = Color3.fromRGB(120, 82, 46),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

-- A four-petal gold flower clasp facing forward (-Z of `cf`).
local function flower(parent, outfit, cf, size)
	for _, a in ipairs({ math.pi / 4, -math.pi / 4 }) do
		piece(parent, outfit, "Flower", Vector3.new(size, size * 0.38, 0.06), C.Gold, cf * CFrame.Angles(0, 0, a))
	end
	piece(parent, outfit, "Flower", Vector3.new(size * 0.3, size * 0.3, 0.08), C.GoldDark, cf * CFrame.new(0, 0, -0.02))
end

-- A cream ribbed tube over a limb from `top` down to `bottom` (local Y).
local function ribbed(part, outfit, top, bottom, grow)
	local h = top - bottom
	local sz = part.Size
	piece(part, outfit, "Rib", Vector3.new(sz.X + grow, h, sz.Z + grow), C.Rib, CFrame.new(0, (top + bottom) / 2, 0))
	local y = top - 0.18
	while y > bottom + 0.08 do
		piece(part, outfit, "RibLine", Vector3.new(sz.X + grow + 0.03, 0.05, sz.Z + grow + 0.03), C.RibLine, CFrame.new(0, y, 0))
		y = y - 0.24
	end
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	-- Pink-purple bob: sides down to the jaw, the back, and bangs under the cap.
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Hair", Vector3.new(0.2 * s, 0.95 * s, head.Size.Z + 0.1 * s), C.Hair, CFrame.new(side * (w + 0.08 * s), -0.05 * s, 0.04 * s))
		piece(head, outfit, "Hair", Vector3.new(0.22 * s, 0.14 * s, head.Size.Z * 0.6), C.HairDark, CFrame.new(side * (w + 0.1 * s), -0.48 * s, 0.1 * s))
	end
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.36 * s, 1.0 * s, 0.2 * s), C.Hair, CFrame.new(0, -0.02 * s, d + 0.08 * s))
	piece(head, outfit, "Bangs", Vector3.new(head.Size.X * 0.9, 0.14 * s, 0.12 * s), C.Hair, CFrame.new(-0.08 * s, h - 0.3 * s, -d - 0.04 * s) * CFrame.Angles(0, 0, 0.12))
	-- Black cap...
	piece(head, outfit, "Cap", Vector3.new(head.Size.X + 0.24 * s, 0.42 * s, head.Size.Z + 0.24 * s), C.Cap, CFrame.new(0, h - 0.06 * s, 0.02 * s))
	piece(head, outfit, "CapTop", Vector3.new(head.Size.X * 0.82, 0.18 * s, head.Size.Z * 0.82), C.Cap, CFrame.new(0, h + 0.22 * s, 0.04 * s))
	-- ...with a gold front plate, rivets, visor and a spike on top.
	piece(head, outfit, "Plate", Vector3.new(head.Size.X * 0.7, 0.3 * s, 0.1 * s), C.Gold, CFrame.new(0, h + 0.04 * s, -d - 0.13 * s) * CFrame.Angles(0.12, 0, 0))
	for i = -1, 1 do
		piece(head, outfit, "Rivet", Vector3.new(0.08 * s, 0.08 * s, 0.06 * s), C.GoldDark, CFrame.new(i * 0.3 * s, h + 0.08 * s, -d - 0.2 * s))
	end
	piece(head, outfit, "Visor", Vector3.new(head.Size.X * 0.95, 0.08 * s, 0.5 * s), C.Gold, CFrame.new(0, h - 0.24 * s, -d - 0.36 * s) * CFrame.Angles(-0.2, 0, 0))
	piece(head, outfit, "Spike", Vector3.new(0.14 * s, 0.3 * s, 0.14 * s), C.Gold, CFrame.new(0, h + 0.44 * s, 0.04 * s))
	piece(head, outfit, "Spike", Vector3.new(0.1 * s, 0.1 * s, 0.22 * s), C.Gold, CFrame.new(0, h + 0.6 * s, 0.1 * s))
end

local function body(character, outfit)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		local s = upper.Size
		local top, front = s.Y / 2, -s.Z / 2
		-- Tunic.
		piece(upper, outfit, "Dress", s + Vector3.new(0.1, 0.02, 0.1), C.Dress, CFrame.new())
		-- Capelet over the shoulders (drapes a little lower at the front).
		piece(upper, outfit, "Capelet", Vector3.new(s.X + 0.5, 0.42, s.Z + 0.4), C.Dress, CFrame.new(0, top - 0.18, 0))
		piece(upper, outfit, "Capelet", Vector3.new(s.X + 0.36, 0.3, 0.12), C.DressDark, CFrame.new(0, top - 0.48, front - 0.16))
		-- Thick cream scarf wrapped round the neck.
		piece(upper, outfit, "Scarf", Vector3.new(s.X * 0.62, 0.24, s.Z + 0.24), C.Scarf, CFrame.new(0, top + 0.06, 0))
		piece(upper, outfit, "Scarf", Vector3.new(s.X * 0.52, 0.14, s.Z + 0.14), C.Scarf, CFrame.new(0, top + 0.22, 0))
		piece(upper, outfit, "ScarfLine", Vector3.new(s.X * 0.61, 0.04, s.Z + 0.23), C.ScarfLine, CFrame.new(0, top + 0.1, 0))
		piece(upper, outfit, "ScarfLine", Vector3.new(s.X * 0.51, 0.04, s.Z + 0.13), C.ScarfLine, CFrame.new(0, top + 0.24, 0))
		-- Gold four-petal flowers on each shoulder.
		for _, side in ipairs({ -1, 1 }) do
			flower(upper, outfit, CFrame.new(side * s.X * 0.33, top - 0.22, front - 0.3), 0.42)
		end
		-- Darker pink round panel on the front (blocky octagon).
		piece(upper, outfit, "Panel", Vector3.new(0.8, 0.55, 0.06), C.DressDark, CFrame.new(0, -s.Y * 0.18, front - 0.07))
		piece(upper, outfit, "Panel", Vector3.new(0.55, 0.8, 0.06), C.DressDark, CFrame.new(0, -s.Y * 0.18, front - 0.07))
		-- Gold leaf studs scattered on the dress.
		for _, spot in ipairs({ { -0.68, -0.05, 0.5 }, { 0.68, -0.05, -0.5 }, { -0.62, -0.5, -0.4 }, { 0.62, -0.5, 0.4 } }) do
			piece(upper, outfit, "Leaf", Vector3.new(0.2, 0.13, 0.06), C.Gold, CFrame.new(spot[1], spot[2] * s.Y / 1.6, front - 0.07) * CFrame.Angles(0, 0, spot[3]))
		end
	end
	-- Skirt with a black fur hem, gold chain belt, round HP buckle, holster.
	local waist = lower or upper
	if waist then
		local ws = waist.Size
		local waistTop = lower and ws.Y / 2 or -upper.Size.Y / 2 + 0.3
		local skirtH = lower and 0.75 or 0.6
		local skirtY = waistTop - skirtH / 2
		piece(waist, outfit, "Skirt", Vector3.new(ws.X + 0.22, skirtH, ws.Z + 0.22), C.Dress, CFrame.new(0, skirtY, 0))
		piece(waist, outfit, "Fur", Vector3.new(ws.X + 0.4, 0.26, ws.Z + 0.4), C.Fur, CFrame.new(0, waistTop - skirtH - 0.04, 0)).Material = Enum.Material.Fabric
		local beltY = waistTop - 0.12
		piece(waist, outfit, "Belt", Vector3.new(ws.X + 0.28, 0.14, ws.Z + 0.28), C.GoldDark, CFrame.new(0, beltY, 0))
		for i = -2, 2 do
			if i ~= 0 then
				piece(waist, outfit, "Link", Vector3.new(0.26, 0.2, 0.05), C.Gold, CFrame.new(i * 0.4, beltY, -ws.Z / 2 - 0.16))
				piece(waist, outfit, "Link", Vector3.new(0.14, 0.09, 0.06), C.Dress, CFrame.new(i * 0.4, beltY, -ws.Z / 2 - 0.17))
			end
		end
		piece(waist, outfit, "Buckle", Vector3.new(0.4, 0.34, 0.06), C.Gold, CFrame.new(0, beltY, -ws.Z / 2 - 0.17))
		piece(waist, outfit, "Buckle", Vector3.new(0.3, 0.42, 0.06), C.Gold, CFrame.new(0, beltY, -ws.Z / 2 - 0.17))
		piece(waist, outfit, "BuckleHP", Vector3.new(0.18, 0.18, 0.07), C.GoldDark, CFrame.new(0, beltY, -ws.Z / 2 - 0.18))
		-- Holster hanging off her right hip.
		piece(waist, outfit, "Holster", Vector3.new(0.22, 0.7, 0.36), C.Holster, CFrame.new(ws.X / 2 + 0.2, beltY - 0.4, -0.1) * CFrame.Angles(0, 0, 0.1))
	end
	-- Cream ribbed sleeves.
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local tall = arm.Size.Y > 1.8
			local bottom = tall and -arm.Size.Y / 2 + 0.35 or -arm.Size.Y / 2
			ribbed(arm, outfit, arm.Size.Y / 2, bottom, 0.06)
			if name:find("Upper") or tall then
				-- The capelet covers the top of the shoulder.
				piece(arm, outfit, "Shoulder", Vector3.new(arm.Size.X + 0.16, 0.36, arm.Size.Z + 0.16), C.Dress, CFrame.new(0, arm.Size.Y / 2 - 0.12, 0))
			end
		end
	end
	-- Cream ribbed leggings, then tall pink boots that flare at the top.
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			ribbed(leg, outfit, leg.Size.Y / 2, -leg.Size.Y / 2, 0.04)
		end
	end
	for _, name in ipairs({ "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			local tall = leg.Size.Y > 1.8
			if not tall then
				ribbed(leg, outfit, leg.Size.Y / 2, -leg.Size.Y / 2, 0.04)
			end
			local h = tall and 1.1 or leg.Size.Y + 0.1
			local bootTop = -leg.Size.Y / 2 + h
			piece(leg, outfit, "Boot", Vector3.new(leg.Size.X + 0.14, h, leg.Size.Z + 0.16), C.Boot, CFrame.new(0, bootTop - h / 2, 0))
			-- Flared cuff with a darker fold.
			piece(leg, outfit, "BootCuff", Vector3.new(leg.Size.X + 0.42, 0.34, leg.Size.Z + 0.42), C.Boot, CFrame.new(0, bootTop - 0.05, 0))
			piece(leg, outfit, "BootFold", Vector3.new(0.08, h * 0.6, 0.06), C.BootDark, CFrame.new(leg.Size.X * 0.25, bootTop - h * 0.4, -leg.Size.Z / 2 - 0.1))
		end
	end
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(name)
		if foot then
			piece(foot, outfit, "Boot", foot.Size + Vector3.new(0.12, 0.06, 0.1), C.Boot, CFrame.new())
			piece(foot, outfit, "Toe", Vector3.new(foot.Size.X * 0.7, foot.Size.Y * 0.8, 0.4), C.Toe, CFrame.new(0, -foot.Size.Y * 0.1, -foot.Size.Z / 2 - 0.15))
		end
	end
end

function HotPantsOutfit.apply(character)
	if character:FindFirstChild("HotPantsOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "HotPantsOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function HotPantsOutfit.remove(character)
	local outfit = character:FindFirstChild("HotPantsOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == HotPantsOutfit.Act then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == HotPantsOutfit.Act then
					HotPantsOutfit.apply(character)
				end
			end)
		else
			HotPantsOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function HotPantsOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return HotPantsOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">JohnnyOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	JohnnyOutfit  (ServerScriptService.SpinServer.JohnnyOutfit)

	Gives a character Johnny Joestar's look while they play him (Tusk, Acts
	1-4), built from blocky parts (no catalog asset ids), matched to his art:
	  * a light-blue knit cap covered in pink stars, a gold horseshoe on the
	    front with a black horse head inside it, little frayed tips
	  * wavy blond hair to his shoulders
	  * a lavender scarf round his neck
	  * a light-blue top with a black V across the chest, a purple star
	    patch on the sleeve, sleeves pushed up to lavender cuffs at the elbow,
	    bare forearms and black wristbands
	  * light-blue trousers covered in pink stars
	The player's own hats/hair are hidden while they play him and come back
	when they switch. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local JohnnyOutfit = {}
JohnnyOutfit.Act = 1 -- (any Tusk Act: 1-4)

local C = {
	Cap = Color3.fromRGB(176, 214, 236),
	CapShade = Color3.fromRGB(140, 182, 210),
	Star = Color3.fromRGB(236, 140, 186),
	Gold = Color3.fromRGB(222, 180, 64),
	GoldDark = Color3.fromRGB(170, 130, 40),
	Horse = Color3.fromRGB(26, 24, 28),
	Hair = Color3.fromRGB(232, 206, 140),
	HairDark = Color3.fromRGB(196, 168, 104),
	Scarf = Color3.fromRGB(184, 160, 222),
	Suit = Color3.fromRGB(170, 208, 232),
	SuitShade = Color3.fromRGB(134, 174, 204),
	Chevron = Color3.fromRGB(26, 28, 34),
	Patch = Color3.fromRGB(120, 90, 170),
	Band = Color3.fromRGB(30, 30, 34),
	Shoe = Color3.fromRGB(60, 54, 70),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

-- Little pink stars (a diamond and a cross) scattered over one face.
local function stars(part, outfit, faceCF, w, h, count, seed)
	for i = 1, count do
		local u = ((i * 37 + seed * 17) % 100) / 100 - 0.5
		local v = ((i * 59 + seed * 31) % 100) / 100 - 0.5
		local cf = faceCF * CFrame.new(u * w * 0.85, v * h * 0.85, 0)
		piece(part, outfit, "Star", Vector3.new(0.12, 0.12, 0.03), C.Star, cf * CFrame.Angles(0, 0, math.pi / 4))
		piece(part, outfit, "Star", Vector3.new(0.2, 0.05, 0.03), C.Star, cf)
	end
end

-- Stars all round a box laid over a part.
local function starry(part, outfit, size, cf, count, seed)
	local x, z = size.X / 2 + 0.015, size.Z / 2 + 0.015
	stars(part, outfit, cf * CFrame.new(0, 0, -z), size.X, size.Y, count, seed)
	stars(part, outfit, cf * CFrame.new(0, 0, z) * CFrame.Angles(0, math.pi, 0), size.X, size.Y, count, seed + 1)
	stars(part, outfit, cf * CFrame.new(x, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), size.Z, size.Y, math.max(1, count - 1), seed + 2)
	stars(part, outfit, cf * CFrame.new(-x, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), size.Z, size.Y, math.max(1, count - 1), seed + 3)
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	-- Wavy blond hair down to the shoulders.
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Hair", Vector3.new(0.18 * s, 1.0 * s, head.Size.Z * 0.85), C.Hair, CFrame.new(side * (w + 0.08 * s), -0.3 * s, 0.06 * s))
		piece(head, outfit, "HairWave", Vector3.new(0.22 * s, 0.3 * s, head.Size.Z * 0.5), C.HairDark, CFrame.new(side * (w + 0.12 * s), -0.75 * s, 0.1 * s) * CFrame.Angles(0, 0, side * 0.3))
	end
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.3 * s, 1.0 * s, 0.22 * s), C.Hair, CFrame.new(0, -0.4 * s, d + 0.1 * s))
	piece(head, outfit, "Bangs", Vector3.new(head.Size.X * 0.5, 0.18 * s, 0.1 * s), C.Hair, CFrame.new(0.15 * s, h - 0.42 * s, -d - 0.03 * s) * CFrame.Angles(0, 0, -0.25))
	-- The knit cap, pulled down low, with a folded band and little frayed tips.
	local capSize = Vector3.new(head.Size.X + 0.2 * s, 0.75 * s, head.Size.Z + 0.2 * s)
	local capCF = CFrame.new(0, h - 0.12 * s, 0.02 * s)
	piece(head, outfit, "Cap", capSize, C.Cap, capCF)
	piece(head, outfit, "CapTop", Vector3.new(head.Size.X * 0.8, 0.2 * s, head.Size.Z * 0.8), C.Cap, CFrame.new(0, h + 0.34 * s, 0.04 * s))
	piece(head, outfit, "CapBand", Vector3.new(head.Size.X + 0.26 * s, 0.18 * s, head.Size.Z + 0.26 * s), C.CapShade, CFrame.new(0, h - 0.42 * s, 0.02 * s))
	starry(head, outfit, capSize, capCF, 3, 4)
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "CapTip", Vector3.new(0.1 * s, 0.3 * s, 0.1 * s), C.CapShade, CFrame.new(side * (w + 0.02 * s), h + 0.24 * s, 0.2 * s) * CFrame.Angles(0, 0, side * -0.5))
	end
	-- Gold horseshoe on the front, opening upward, a black horse head inside.
	local hf = -d - 0.14 * s
	local hy = h - 0.02 * s
	piece(head, outfit, "Horseshoe", Vector3.new(0.5 * s, 0.1 * s, 0.06 * s), C.Gold, CFrame.new(0, hy - 0.26 * s, hf))
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Horseshoe", Vector3.new(0.1 * s, 0.5 * s, 0.06 * s), C.Gold, CFrame.new(side * 0.22 * s, hy, hf) * CFrame.Angles(0, 0, side * 0.08))
		piece(head, outfit, "Nail", Vector3.new(0.04 * s, 0.04 * s, 0.04 * s), C.GoldDark, CFrame.new(side * 0.22 * s, hy + 0.05 * s, hf - 0.04 * s))
	end
	piece(head, outfit, "HorseHead", Vector3.new(0.18 * s, 0.34 * s, 0.04 * s), C.Horse, CFrame.new(0, hy - 0.02 * s, hf + 0.02 * s) * CFrame.Angles(0, 0, 0.3))
	piece(head, outfit, "HorseHead", Vector3.new(0.18 * s, 0.1 * s, 0.04 * s), C.Horse, CFrame.new(0.05 * s, hy + 0.14 * s, hf + 0.02 * s))
end

local function body(character, outfit)
	local headPart = character:FindFirstChild("Head")
	local skin = headPart and headPart.Color or Color3.fromRGB(238, 200, 170)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		local s = upper.Size
		local top, front = s.Y / 2, -s.Z / 2
		piece(upper, outfit, "Top", s + Vector3.new(0.1, 0.02, 0.1), C.Suit, CFrame.new())
		-- Lavender scarf round the neck.
		piece(upper, outfit, "Scarf", Vector3.new(s.X * 0.62, 0.34, s.Z + 0.22), C.Scarf, CFrame.new(0, top + 0.1, 0))
		piece(upper, outfit, "ScarfDrape", Vector3.new(0.5, 0.36, 0.08), C.Scarf, CFrame.new(0.1, top - 0.14, front - 0.06))
		-- The black V across the chest (and a matching one at the back).
		for _, side in ipairs({ -1, 1 }) do
			piece(upper, outfit, "Chevron", Vector3.new(0.22, s.Y * 0.75, 0.05), C.Chevron, CFrame.new(side * s.X * 0.22, top - s.Y * 0.3, front - 0.06) * CFrame.Angles(0, 0, side * -0.9))
			piece(upper, outfit, "Chevron", Vector3.new(0.22, s.Y * 0.75, 0.05), C.Chevron, CFrame.new(side * s.X * 0.22, top - s.Y * 0.3, -front + 0.06) * CFrame.Angles(0, 0, side * 0.9))
		end
		stars(upper, outfit, CFrame.new(0, -s.Y * 0.3, front - 0.06), s.X * 0.9, s.Y * 0.3, 2, 9)
	end
	local waist = lower or upper
	if waist and lower then
		piece(lower, outfit, "Pants", lower.Size + Vector3.new(0.06, 0.02, 0.06), C.Suit, CFrame.new())
	end
	-- Sleeves pushed up to the elbow (lavender cuffs), bare forearms, black wristbands.
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local as = arm.Size
			local tall = as.Y > 1.8
			local out = name:find("Left") and -1 or 1
			if name:find("Upper") or tall then
				local h = tall and as.Y * 0.55 or as.Y
				piece(arm, outfit, "Sleeve", Vector3.new(as.X + 0.12, h, as.Z + 0.12), C.Suit, CFrame.new(0, as.Y / 2 - h / 2, 0))
				piece(arm, outfit, "Cuff", Vector3.new(as.X + 0.18, 0.28, as.Z + 0.18), C.Scarf, CFrame.new(0, as.Y / 2 - h, 0))
				if name:find("Right") or name == "Right Arm" then
					piece(arm, outfit, "Patch", Vector3.new(0.05, 0.36, 0.36), C.Patch, CFrame.new(out * (as.X / 2 + 0.08), as.Y / 2 - 0.4, 0))
				end
			end
			if name:find("Lower") or tall then
				-- Bare forearm (covers whatever shirt the avatar wears).
				local fh = tall and as.Y * 0.45 or as.Y
				piece(arm, outfit, "Skin", Vector3.new(as.X + 0.04, fh, as.Z + 0.04), skin, CFrame.new(0, -as.Y / 2 + fh / 2, 0))
				piece(arm, outfit, "Wristband", Vector3.new(as.X + 0.12, 0.3, as.Z + 0.12), C.Band, CFrame.new(0, -as.Y / 2 + 0.25, 0))
			end
		end
	end
	-- Light-blue trousers covered in pink stars.
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			local size = leg.Size + Vector3.new(0.06, 0.02, 0.06)
			piece(leg, outfit, "Pants", size, C.Suit, CFrame.new())
			starry(leg, outfit, size, CFrame.new(), leg.Size.Y > 1.8 and 3 or 2, #name)
		end
	end
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(name)
		if foot then
			piece(foot, outfit, "Shoe", foot.Size + Vector3.new(0.08, 0.06, 0.1), C.Shoe, CFrame.new())
		end
	end
end

function JohnnyOutfit.apply(character)
	if character:FindFirstChild("JohnnyOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "JohnnyOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function JohnnyOutfit.remove(character)
	local outfit = character:FindFirstChild("JohnnyOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		local function isJohnny()
			local act = character:GetAttribute("TuskAct")
			return type(act) == "number" and act >= 1 and act <= 4
		end
		if isJohnny() then
			task.delay(0.3, function()
				if character.Parent and isJohnny() then
					JohnnyOutfit.apply(character)
				end
			end)
		else
			JohnnyOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function JohnnyOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return JohnnyOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">MountainTimOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	MountainTimOutfit  (ServerScriptService.SpinServer.MountainTimOutfit)

	Gives a character Mountain Tim's cowboy look while they play him (TuskAct 9),
	built from blocky parts (no catalog asset ids), matched to his art:
	  * a zebra-striped cowboy hat with a band of gold conchos, a cow skull
	    on the front and hat cords hanging down to his chest
	  * shoulder-length blond hair, sideburns and a chin beard
	  * a leopard-print jacket (fur collar and sleeves) over a pale grey
	    shirt with big lapels, an open neck and fringed chest pockets
	  * a brown belt with bullet loops, a round gold "MT" buckle and a
	    holster with a revolver on his right hip
	  * dark grey gloves with studs, grey trousers, dark boots
	The player's own hats/hair are hidden while they play him and come back
	when they switch. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local MountainTimOutfit = {}
MountainTimOutfit.Act = 9

local C = {
	Hat = Color3.fromRGB(228, 226, 218),
	Stripe = Color3.fromRGB(40, 38, 40),
	Concho = Color3.fromRGB(214, 164, 64),
	Skull = Color3.fromRGB(236, 232, 220),
	Cord = Color3.fromRGB(70, 56, 40),
	Hair = Color3.fromRGB(232, 206, 120),
	HairDark = Color3.fromRGB(196, 168, 90),
	Leopard = Color3.fromRGB(214, 172, 92),
	Spot = Color3.fromRGB(60, 40, 22),
	Shirt = Color3.fromRGB(200, 200, 196),
	ShirtDark = Color3.fromRGB(160, 160, 156),
	Fringe = Color3.fromRGB(220, 200, 150),
	Belt = Color3.fromRGB(150, 84, 46),
	Bullet = Color3.fromRGB(222, 190, 90),
	Buckle = Color3.fromRGB(226, 180, 60),
	BuckleDark = Color3.fromRGB(150, 110, 30),
	Gun = Color3.fromRGB(120, 124, 132),
	Glove = Color3.fromRGB(70, 66, 78),
	Pants = Color3.fromRGB(110, 112, 120),
	Boot = Color3.fromRGB(52, 40, 32),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

-- Dark leopard spots scattered over one face of a part (deterministic).
local function spots(part, outfit, w, h, faceCF, count, seed)
	for i = 1, count do
		local u = ((i * 37 + seed * 13) % 100) / 100 - 0.5
		local v = ((i * 61 + seed * 29) % 100) / 100 - 0.5
		local big = i % 3 == 0
		piece(part, outfit, "Spot", Vector3.new(big and 0.2 or 0.13, big and 0.14 or 0.1, 0.03), C.Spot, faceCF * CFrame.new(u * w * 0.85, v * h * 0.85, 0) * CFrame.Angles(0, 0, (i % 4) * 0.4))
	end
end

-- Leopard print on every side of a box laid over `part`.
local function leopard(part, outfit, size, cf, seed)
	piece(part, outfit, "Leopard", size, C.Leopard, cf)
	local x, y, z = size.X / 2 + 0.015, size.Y, size.Z / 2 + 0.015
	spots(part, outfit, size.X, y, cf * CFrame.new(0, 0, -z), 4, seed)
	spots(part, outfit, size.X, y, cf * CFrame.new(0, 0, z) * CFrame.Angles(0, math.pi, 0), 4, seed + 1)
	spots(part, outfit, size.Z, y, cf * CFrame.new(x, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 3, seed + 2)
	spots(part, outfit, size.Z, y, cf * CFrame.new(-x, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), 3, seed + 3)
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	-- Shoulder-length blond hair, sideburns and a chin beard.
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.14 * s, 0.9 * s, 0.22 * s), C.Hair, CFrame.new(0, -0.15 * s, d + 0.08 * s))
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.24 * s, 0.35 * s, 0.3 * s), C.HairDark, CFrame.new(0, -0.62 * s, d + 0.1 * s))
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Hair", Vector3.new(0.14 * s, 0.85 * s, head.Size.Z * 0.6), C.Hair, CFrame.new(side * (w + 0.05 * s), -0.1 * s, 0.18 * s))
		piece(head, outfit, "Sideburn", Vector3.new(0.06 * s, 0.4 * s, 0.14 * s), C.HairDark, CFrame.new(side * (w + 0.02 * s), -0.1 * s, -d + 0.2 * s))
	end
	piece(head, outfit, "Beard", Vector3.new(0.22 * s, 0.14 * s, 0.06 * s), C.HairDark, CFrame.new(0, -h + 0.08 * s, -d - 0.02 * s))
	-- Zebra cowboy hat: wide brim curled up at the sides, a pinched crown.
	local brimY = h - 0.02 * s
	piece(head, outfit, "Brim", Vector3.new(head.Size.X + 1.1 * s, 0.08 * s, head.Size.Z + 1.0 * s), C.Hat, CFrame.new(0, brimY, 0))
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "BrimCurl", Vector3.new(0.3 * s, 0.08 * s, head.Size.Z + 0.9 * s), C.Hat, CFrame.new(side * (w + 0.62 * s), brimY + 0.1 * s, 0) * CFrame.Angles(0, 0, side * 0.7))
	end
	local crownH = 0.62 * s
	piece(head, outfit, "Crown", Vector3.new(head.Size.X + 0.06 * s, crownH, head.Size.Z + 0.06 * s), C.Hat, CFrame.new(0, brimY + crownH / 2, 0))
	piece(head, outfit, "Crown", Vector3.new(head.Size.X * 0.7, 0.12 * s, head.Size.Z * 0.9), C.Hat, CFrame.new(0, brimY + crownH + 0.04 * s, 0))
	-- Black stripes round the crown and across the brim.
	for i = 0, 2 do
		piece(head, outfit, "Stripe", Vector3.new(head.Size.X + 0.1 * s, 0.06 * s, head.Size.Z + 0.1 * s), C.Stripe, CFrame.new(0, brimY + 0.28 * s + i * 0.14 * s, 0) * CFrame.Angles(0, 0, (i % 2 == 0 and 0.08 or -0.08)))
	end
	for i = -2, 2 do
		piece(head, outfit, "Stripe", Vector3.new(0.08 * s, 0.09 * s, head.Size.Z + 0.96 * s), C.Stripe, CFrame.new(i * 0.34 * s, brimY, 0) * CFrame.Angles(0, 0.35, 0))
	end
	-- Band of gold conchos round the crown and a cow skull on the front.
	local bandY = brimY + 0.12 * s
	for i = -2, 2 do
		piece(head, outfit, "Concho", Vector3.new(0.16 * s, 0.16 * s, 0.06 * s), C.Concho, CFrame.new(i * 0.24 * s, bandY, -d - 0.06 * s))
	end
	for _, side in ipairs({ -1, 1 }) do
		for i = 0, 1 do
			piece(head, outfit, "Concho", Vector3.new(0.06 * s, 0.16 * s, 0.16 * s), C.Concho, CFrame.new(side * (w + 0.06 * s), bandY, -0.2 * s + i * 0.4 * s))
		end
	end
	piece(head, outfit, "Skull", Vector3.new(0.24 * s, 0.26 * s, 0.08 * s), C.Skull, CFrame.new(0.32 * s, bandY + 0.18 * s, -d - 0.1 * s))
	piece(head, outfit, "Skull", Vector3.new(0.46 * s, 0.07 * s, 0.06 * s), C.Skull, CFrame.new(0.32 * s, bandY + 0.3 * s, -d - 0.1 * s))
	-- Hat cords hanging down to the chest.
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Cord", Vector3.new(0.04 * s, 1.0 * s, 0.04 * s), C.Cord, CFrame.new(side * (w - 0.05 * s), -0.3 * s, -d - 0.1 * s) * CFrame.Angles(0, 0, side * -0.18))
	end
end

local function body(character, outfit)
	local headPart = character:FindFirstChild("Head")
	local skin = headPart and headPart.Color or Color3.fromRGB(230, 190, 150)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		local s = upper.Size
		local top, front = s.Y / 2, -s.Z / 2
		-- Pale grey shirt, open at the neck.
		piece(upper, outfit, "Shirt", s + Vector3.new(0.08, 0.02, 0.08), C.Shirt, CFrame.new())
		piece(upper, outfit, "Chest", Vector3.new(0.5, 0.6, 0.04), skin, CFrame.new(0, top - 0.32, front - 0.05))
		piece(upper, outfit, "Placket", Vector3.new(0.08, s.Y * 0.55, 0.04), C.ShirtDark, CFrame.new(0, -s.Y * 0.2, front - 0.05))
		-- Big lapels.
		for _, side in ipairs({ -1, 1 }) do
			piece(upper, outfit, "Lapel", Vector3.new(0.4, 0.7, 0.06), C.Shirt, CFrame.new(side * 0.42, top - 0.3, front - 0.09) * CFrame.Angles(0, 0, side * 0.35))
			-- Fringed chest pocket.
			piece(upper, outfit, "Pocket", Vector3.new(0.46, 0.1, 0.05), C.ShirtDark, CFrame.new(side * 0.55, top - 0.68, front - 0.07))
			for k = -2, 2 do
				piece(upper, outfit, "Fringe", Vector3.new(0.05, 0.36, 0.04), C.Fringe, CFrame.new(side * 0.55 + k * 0.09, top - 0.9, front - 0.08))
			end
		end
		-- Leopard fur collar across the shoulders and up the back of the neck.
		leopard(upper, outfit, Vector3.new(s.X + 0.2, 0.3, s.Z + 0.24), CFrame.new(0, top - 0.08, 0.02), 1)
		leopard(upper, outfit, Vector3.new(s.X * 0.7, 0.4, 0.2), CFrame.new(0, top + 0.12, -front + 0.08), 5)
	end
	local waist = lower or upper
	if waist then
		local ws = waist.Size
		local beltY = lower and ws.Y / 2 - 0.12 or -upper.Size.Y / 2 + 0.15
		if lower then
			piece(lower, outfit, "Pants", ws + Vector3.new(0.06, 0.02, 0.06), C.Pants, CFrame.new())
		end
		-- Belt with bullet loops, the round MT buckle, a holster on his right hip.
		piece(waist, outfit, "Belt", Vector3.new(ws.X + 0.14, 0.24, ws.Z + 0.14), C.Belt, CFrame.new(0, beltY, 0))
		for i = 1, 4 do
			piece(waist, outfit, "Bullet", Vector3.new(0.07, 0.2, 0.06), C.Bullet, CFrame.new(-0.35 - i * 0.12, beltY + 0.02, -ws.Z / 2 - 0.09))
		end
		piece(waist, outfit, "Buckle", Vector3.new(0.42, 0.34, 0.06), C.Buckle, CFrame.new(0, beltY, -ws.Z / 2 - 0.1))
		piece(waist, outfit, "Buckle", Vector3.new(0.34, 0.42, 0.06), C.Buckle, CFrame.new(0, beltY, -ws.Z / 2 - 0.1))
		piece(waist, outfit, "BuckleMT", Vector3.new(0.06, 0.24, 0.04), C.BuckleDark, CFrame.new(-0.06, beltY, -ws.Z / 2 - 0.14))
		piece(waist, outfit, "BuckleMT", Vector3.new(0.2, 0.05, 0.04), C.BuckleDark, CFrame.new(0, beltY + 0.1, -ws.Z / 2 - 0.14))
		piece(waist, outfit, "BuckleMT", Vector3.new(0.05, 0.22, 0.04), C.BuckleDark, CFrame.new(0.07, beltY - 0.01, -ws.Z / 2 - 0.14))
		local hip = CFrame.new(ws.X / 2 + 0.2, beltY - 0.42, -0.1)
		piece(waist, outfit, "Holster", Vector3.new(0.24, 0.72, 0.4), C.Belt, hip)
		piece(waist, outfit, "GunGrip", Vector3.new(0.16, 0.36, 0.2), C.Gun, hip * CFrame.new(0, 0.5, 0.06) * CFrame.Angles(-0.3, 0, 0))
		piece(waist, outfit, "GunHammer", Vector3.new(0.14, 0.12, 0.26), C.Gun, hip * CFrame.new(0, 0.38, -0.08))
	end
	-- Leopard jacket sleeves, dark studded gloves.
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local as = arm.Size
			local tall = as.Y > 1.8
			local h = tall and as.Y - 0.4 or as.Y
			leopard(arm, outfit, Vector3.new(as.X + 0.12, h + 0.02, as.Z + 0.12), CFrame.new(0, as.Y / 2 - h / 2, 0), #name)
			if tall then
				piece(arm, outfit, "Glove", Vector3.new(as.X + 0.1, 0.42, as.Z + 0.1), C.Glove, CFrame.new(0, -as.Y / 2 + 0.2, 0))
			end
		end
	end
	for _, name in ipairs({ "LeftHand", "RightHand" }) do
		local hand = character:FindFirstChild(name)
		if hand then
			piece(hand, outfit, "Glove", hand.Size + Vector3.new(0.08, 0.06, 0.08), C.Glove, CFrame.new())
			piece(hand, outfit, "Stud", Vector3.new(0.1, 0.1, 0.06), C.Buckle, CFrame.new(0, 0, -hand.Size.Z / 2 - 0.06))
		end
	end
	-- Grey trousers and dark boots.
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			local ls = leg.Size
			piece(leg, outfit, "Pants", ls + Vector3.new(0.05, 0.02, 0.05), C.Pants, CFrame.new())
			if name:find("Lower") or ls.Y > 1.8 then
				local bh = ls.Y > 1.8 and 0.8 or ls.Y * 0.7
				piece(leg, outfit, "Boot", Vector3.new(ls.X + 0.14, bh, ls.Z + 0.14), C.Boot, CFrame.new(0, -ls.Y / 2 + bh / 2, 0))
			end
		end
	end
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(name)
		if foot then
			piece(foot, outfit, "Boot", foot.Size + Vector3.new(0.1, 0.06, 0.16), C.Boot, CFrame.new(0, 0, -0.04))
		end
	end
end

function MountainTimOutfit.apply(character)
	if character:FindFirstChild("MountainTimOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "MountainTimOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function MountainTimOutfit.remove(character)
	local outfit = character:FindFirstChild("MountainTimOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == MountainTimOutfit.Act then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == MountainTimOutfit.Act then
					MountainTimOutfit.apply(character)
				end
			end)
		else
			MountainTimOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function MountainTimOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return MountainTimOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">NPCService</string><ProtectedString name="Source"><![CDATA[--[[
	NPCService  (ServerScriptService.SpinServer.NPCService)

	Turns the markers in workspace.SBRMap.NPCSpawns (made by SBRMapBuilder)
	into living NPCs:
	  * R15 characters with role-based outfits colours and a name tag
	  * "Talk" ProximityPrompt: cycles through that NPC's lines
	  * Racers jog the track waypoints; others wander near home
	  * occasional ambient lines to nearby players
	  * respawn if they fall out of the world
	NPCs carry the IFrames attribute, so no attack can hurt them, and an
	"NPC" attribute so other systems can recognise them.
	Does nothing if the map isn't in the place.
]]

local Players = game:GetService("Players")

local Net = require(game:GetService("ReplicatedStorage").SpinShared.Net)

local NPCService = {}

local ROLE_STYLE = {
	Announcer = { Torso = Color3.fromRGB(150, 30, 40), Legs = Color3.fromRGB(40, 35, 30), Speed = 0 },
	Official = { Torso = Color3.fromRGB(40, 50, 80), Legs = Color3.fromRGB(30, 30, 35), Speed = 8 },
	Racer = { Torso = Color3.fromRGB(70, 120, 170), Legs = Color3.fromRGB(110, 80, 50), Speed = 16 },
	Guard = { Torso = Color3.fromRGB(110, 80, 50), Legs = Color3.fromRGB(50, 40, 30), Speed = 9 },
	Spectator = { Torso = Color3.fromRGB(160, 140, 100), Legs = Color3.fromRGB(80, 60, 45), Speed = 7 },
}
local SKIN = { Color3.fromRGB(234, 184, 146), Color3.fromRGB(204, 142, 105), Color3.fromRGB(160, 105, 75), Color3.fromRGB(110, 70, 50) }

local npcs = {}
local WorldFX

local function splitLines(s)
	local lines = {}
	for line in string.gmatch(s or "", "[^|]+") do
		table.insert(lines, line)
	end
	return lines
end

local function say(npc, line, toPlayer)
	local payload = { NPC = npc.Model, Text = line }
	if toPlayer then
		WorldFX:FireClient(toPlayer, "NPCSay", payload)
	else
		WorldFX:FireAllClients("NPCSay", payload)
	end
end

local function spawnNPC(marker, waypoints, index)
	local role = marker:GetAttribute("Role") or "Spectator"
	local style = ROLE_STYLE[role] or ROLE_STYLE.Spectator
	local description = Instance.new("HumanoidDescription")
	local skin = SKIN[(index % #SKIN) + 1]
	description.HeadColor = skin
	description.LeftArmColor = style.Torso
	description.RightArmColor = style.Torso
	description.TorsoColor = style.Torso
	description.LeftLegColor = style.Legs
	description.RightLegColor = style.Legs
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[NPCService] could not create NPC:", model)
		return nil
	end
	local displayName = marker:GetAttribute("DisplayName") or marker.Name
	model.Name = displayName
	model:SetAttribute("NPC", true)
	model:SetAttribute("IFrames", true)
	model:SetAttribute("Role", role)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = displayName
	humanoid.NameDisplayDistance = 40
	humanoid.WalkSpeed = style.Speed
	humanoid.BreakJointsOnDeath = false
	local home = marker.Position + Vector3.new(0, 3, 0)
	model:PivotTo(CFrame.new(home) * CFrame.Angles(0, math.rad(index * 47), 0))
	model.Parent = marker.Parent.Parent:FindFirstChild("NPCs") or marker.Parent.Parent

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Talk"
	prompt.ObjectText = displayName
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = model:WaitForChild("HumanoidRootPart")

	local npc = {
		Model = model,
		Humanoid = humanoid,
		Marker = marker,
		Home = home,
		Role = role,
		Wander = marker:GetAttribute("WanderRadius") or 0,
		Lines = splitLines(marker:GetAttribute("Lines")),
		LineIndex = 0,
		NextMove = os.clock() + math.random() * 4,
		Waypoint = 1,
		Waypoints = waypoints,
		Index = index,
		Talking = 0,
	}
	prompt.Triggered:Connect(function(player)
		if #npc.Lines == 0 then
			return
		end
		npc.LineIndex = npc.LineIndex % #npc.Lines + 1
		npc.Talking = os.clock() + 4
		humanoid:MoveTo(model.HumanoidRootPart.Position) -- stop and chat
		local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if playerRoot then
			local pos = model.HumanoidRootPart.Position
			model:PivotTo(CFrame.lookAt(pos, Vector3.new(playerRoot.Position.X, pos.Y, playerRoot.Position.Z)))
		end
		say(npc, npc.Lines[npc.LineIndex], nil)
	end)
	return npc
end

local function think(npc, now)
	local model = npc.Model
	local root = model.Parent and model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if root.Position.Y < -60 then
		model:PivotTo(CFrame.new(npc.Home)) -- fell out of the world
		return
	end
	if now < npc.Talking or now < npc.NextMove then
		return
	end
	if npc.Role == "Racer" and #npc.Waypoints > 0 then
		local wp = npc.Waypoints[npc.Waypoint]
		npc.Humanoid:MoveTo(wp.Position + Vector3.new(npc.Index % 2 == 0 and 3 or -3, 0, 0))
		if (root.Position - wp.Position).Magnitude < 8 then
			npc.Waypoint = npc.Waypoint % #npc.Waypoints + 1
		end
		npc.NextMove = now + 0.5
	elseif npc.Wander > 0 then
		local angle = math.random() * math.pi * 2
		local dist = math.random() * npc.Wander
		npc.Humanoid:MoveTo(npc.Home + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist))
		npc.NextMove = now + 4 + math.random() * 5
	else
		npc.NextMove = now + 10
	end
end

-- Ambient line from an NPC close to a player, every so often.
local function ambientChatter()
	local candidates = {}
	for _, npc in ipairs(npcs) do
		local root = npc.Model:FindFirstChild("HumanoidRootPart")
		if root and #npc.Lines > 0 then
			for _, player in ipairs(Players:GetPlayers()) do
				local pr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if pr and (pr.Position - root.Position).Magnitude < 45 then
					table.insert(candidates, npc)
					break
				end
			end
		end
	end
	if #candidates > 0 then
		local npc = candidates[math.random(1, #candidates)]
		say(npc, npc.Lines[math.random(1, #npc.Lines)], nil)
	end
end

function NPCService.init()
	WorldFX = Net.get("WorldFX")
	task.spawn(function()
		local map = workspace:FindFirstChild("SBRMap") or workspace:WaitForChild("SBRMap", 10)
		local spawns = map and map:FindFirstChild("NPCSpawns")
		if not spawns then
			return -- no map in this place: nothing to do
		end
		local container = Instance.new("Folder")
		container.Name = "NPCs"
		container.Parent = map
		local waypoints = {}
		local wpFolder = map:FindFirstChild("RacerWaypoints")
		if wpFolder then
			waypoints = wpFolder:GetChildren()
			table.sort(waypoints, function(a, b)
				return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
			end)
		end
		for i, marker in ipairs(spawns:GetChildren()) do
			local npc = spawnNPC(marker, waypoints, i)
			if npc then
				table.insert(npcs, npc)
			end
		end
		-- One shared low-frequency loop for all NPC brains (no per-NPC Heartbeat).
		local nextChatter = os.clock() + 20
		while true do
			local now = os.clock()
			for _, npc in ipairs(npcs) do
				think(npc, now)
			end
			if now >= nextChatter then
				nextChatter = now + 20 + math.random() * 20
				ambientChatter()
			end
			task.wait(0.5)
		end
	end)
end

return NPCService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">PorkPieOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	PorkPieOutfit  (ServerScriptService.SpinServer.PorkPieOutfit)

	Gives a character Pork Pie Hat Kid's look while they play him (TuskAct 7),
	built from blocky parts so no catalog asset ids are needed (from the
	owner's pictures):
	  * green bamboo sticks tied round his bald head with a rope band,
	    sticking up and hanging down the sides like dreadlocks
	  * big round eyes with large black irises and bared teeth
	  * a green sleeveless suit with light-green studs in rows down both
	    sides of the chest and down both legs
	  * short golden feathers on the shoulders and a short frilly tutu
	  * big brown bracelets with leaves on both wrists
	The player's own hats/hair (and face) are hidden while they play him and
	come back when they switch. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local PorkPieOutfit = {}
PorkPieOutfit.Act = 7

local C = {
	Bamboo = Color3.fromRGB(130, 200, 70),
	BambooDark = Color3.fromRGB(80, 140, 45),
	BambooNode = Color3.fromRGB(175, 225, 110),
	Rope = Color3.fromRGB(150, 110, 70),
	Suit = Color3.fromRGB(95, 115, 45),
	SuitDark = Color3.fromRGB(70, 88, 32),
	Stud = Color3.fromRGB(165, 215, 80),
	Feather = Color3.fromRGB(215, 160, 60),
	FeatherDark = Color3.fromRGB(160, 105, 40),
	Bracelet = Color3.fromRGB(120, 75, 45),
	Leaf = Color3.fromRGB(200, 120, 50),
	EyeWhite = Color3.fromRGB(245, 245, 240),
	Iris = Color3.fromRGB(15, 15, 18),
	Teeth = Color3.fromRGB(250, 248, 235),
	Mouth = Color3.fromRGB(60, 25, 25),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

-- One bamboo stick: a green rod with lighter node bands.
local function bamboo(head, outfit, s, cf, length)
	piece(head, outfit, "Bamboo", Vector3.new(0.26, length, 0.26) * s, C.Bamboo, cf)
	piece(head, outfit, "BambooNode", Vector3.new(0.3, 0.06, 0.3) * s, C.BambooNode, cf * CFrame.new(0, length * 0.15 * s, 0))
	piece(head, outfit, "BambooTip", Vector3.new(0.3, 0.05, 0.3) * s, C.BambooDark, cf * CFrame.new(0, length * 0.5 * s, 0))
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	-- Rope band round the forehead (four sides) with a knot at the back.
	local bandY = h * 0.45
	piece(head, outfit, "Rope", Vector3.new(head.Size.X + 0.12 * s, 0.22 * s, 0.12 * s), C.Rope, CFrame.new(0, bandY, -d - 0.04 * s))
	piece(head, outfit, "Rope", Vector3.new(head.Size.X + 0.12 * s, 0.22 * s, 0.12 * s), C.Rope, CFrame.new(0, bandY, d + 0.04 * s))
	piece(head, outfit, "Rope", Vector3.new(0.12 * s, 0.22 * s, head.Size.Z + 0.12 * s), C.Rope, CFrame.new(-w - 0.04 * s, bandY, 0))
	piece(head, outfit, "Rope", Vector3.new(0.12 * s, 0.22 * s, head.Size.Z + 0.12 * s), C.Rope, CFrame.new(w + 0.04 * s, bandY, 0))
	piece(head, outfit, "RopeKnot", Vector3.new(0.3, 0.3, 0.2) * s, C.Rope, CFrame.new(0.2 * s, bandY, d + 0.12 * s))
	-- Bamboo crown: sticks pushed under the band, leaning out all round.
	local crown = {
		{ -0.45, -0.3, -0.25, 0.35 }, { -0.15, -0.35, -0.05, 0.1 }, { 0.15, -0.35, 0.05, -0.1 }, { 0.45, -0.3, 0.25, -0.35 },
		{ -0.5, 0.0, 0, 0.5 }, { 0.5, 0.0, 0, -0.5 }, { -0.3, 0.35, 0.35, 0.3 }, { 0.3, 0.35, 0.35, -0.3 }, { 0, 0.4, 0.4, 0 },
	}
	for _, b in ipairs(crown) do
		local base = CFrame.new(b[1] * head.Size.X, bandY + 0.2 * s, b[2] * head.Size.Z)
		bamboo(head, outfit, s, base * CFrame.Angles(b[3], 0, b[4]) * CFrame.new(0, 0.45 * s, 0), 1.0)
	end
	-- Sticks hanging down the sides and back like dreadlocks.
	local hang = { { -1, -0.25 }, { -1, 0.15 }, { 1, -0.25 }, { 1, 0.15 }, { -0.4, 1 }, { 0.4, 1 } }
	for _, b in ipairs(hang) do
		local x, z
		if math.abs(b[1]) == 1 then
			x, z = b[1] * (w + 0.18 * s), b[2] * head.Size.Z
		else
			x, z = b[1] * head.Size.X, d + 0.18 * s
		end
		local tilt = math.abs(b[1]) == 1 and CFrame.Angles(0, 0, b[1] * 0.25) or CFrame.Angles(-0.25, 0, 0)
		bamboo(head, outfit, s, CFrame.new(x, bandY - 0.45 * s, z) * tilt, 0.95)
	end
	-- Face: big round eyes with large black irises, bared teeth.
	local front = -d - 0.02 * s
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "EyeWhite", Vector3.new(0.4, 0.36, 0.04) * s, C.EyeWhite, CFrame.new(side * 0.25 * s, 0.08 * s, front))
		piece(head, outfit, "Iris", Vector3.new(0.28, 0.28, 0.04) * s, C.Iris, CFrame.new(side * 0.25 * s, 0.07 * s, front - 0.02 * s))
	end
	piece(head, outfit, "Mouth", Vector3.new(0.62, 0.24, 0.04) * s, C.Mouth, CFrame.new(0, -0.3 * s, front))
	piece(head, outfit, "Teeth", Vector3.new(0.58, 0.08, 0.04) * s, C.Teeth, CFrame.new(0, -0.23 * s, front - 0.02 * s))
	piece(head, outfit, "Teeth", Vector3.new(0.58, 0.08, 0.04) * s, C.Teeth, CFrame.new(0, -0.37 * s, front - 0.02 * s))
	-- Large angular jaw.
	piece(head, outfit, "Jaw", Vector3.new(head.Size.X * 0.9, 0.18 * s, head.Size.Z * 0.85), head.Color, CFrame.new(0, -h - 0.02 * s, -0.05 * s))
end

-- Green suit shell over a body part, with a row of studs on the front.
local function suit(part, outfit, studsX, studCount)
	local s = part.Size
	piece(part, outfit, "Suit", s + Vector3.new(0.1, 0.04, 0.1), C.Suit, CFrame.new())
	for _, x in ipairs(studsX) do
		for i = 1, studCount do
			local y = s.Y / 2 - (i - 0.5) * s.Y / studCount
			piece(part, outfit, "Stud", Vector3.new(0.24, 0.2, 0.12), C.Stud, CFrame.new(x * s.X / 2, y, -s.Z / 2 - 0.08))
		end
	end
end

local function body(character, outfit)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		suit(upper, outfit, { -0.55, 0.55 }, lower and 3 or 4)
		-- Short feathers on both shoulders.
		for _, side in ipairs({ -1, 1 }) do
			for k = 0, 2 do
				local cf = CFrame.new(side * (upper.Size.X / 2 - 0.1), upper.Size.Y / 2 - 0.05, -0.25 + k * 0.25)
					* CFrame.Angles(0, 0, side * (-0.9 - k * 0.15)) * CFrame.new(0, 0.35, 0)
				piece(upper, outfit, "Feather", Vector3.new(0.18, 0.8, 0.3), k % 2 == 0 and C.Feather or C.FeatherDark, cf)
			end
		end
	end
	local waist = lower or upper
	if waist then
		if lower then
			suit(lower, outfit, {}, 0)
		end
		-- Short frilly tutu round the waist.
		local y = lower and -lower.Size.Y * 0.25 or -upper.Size.Y / 2 + 0.1
		local rx, rz = waist.Size.X / 2 + 0.15, waist.Size.Z / 2 + 0.15
		for i = 0, 11 do
			local a = i / 12 * math.pi * 2
			local pos = Vector3.new(math.cos(a) * rx, y, math.sin(a) * rz)
			local cf = CFrame.lookAt(pos, pos + Vector3.new(math.cos(a), 0, math.sin(a))) * CFrame.Angles(-0.55, 0, 0)
			piece(waist, outfit, "Tutu", Vector3.new(0.7, 0.12, 0.7), i % 2 == 0 and C.Suit or C.SuitDark, cf)
		end
	end
	-- Legs: suit with studs down the front.
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			suit(leg, outfit, { 0 }, name:find("Leg") and leg.Size.Y > 1.8 and 4 or 2)
		end
	end
	-- Sleeveless: bare arms (skin-coloured sleeves over whatever shirt the avatar wears).
	local headPart = character:FindFirstChild("Head")
	local skin = headPart and headPart.Color or Color3.fromRGB(230, 185, 140)
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			piece(arm, outfit, "Skin", arm.Size + Vector3.new(0.04, 0.02, 0.04), skin, CFrame.new())
		end
	end
	-- Big bracelets with leaves on both wrists.
	for _, name in ipairs({ "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local y = -arm.Size.Y / 2 + (arm.Size.Y > 1.8 and 0.55 or 0.25)
			piece(arm, outfit, "Bracelet", Vector3.new(arm.Size.X + 0.22, 0.45, arm.Size.Z + 0.22), C.Bracelet, CFrame.new(0, y, 0))
			piece(arm, outfit, "Leaf", Vector3.new(0.5, 0.08, 0.32), C.Leaf, CFrame.new(0, y + 0.1, -arm.Size.Z / 2 - 0.16) * CFrame.Angles(0.4, 0, 0.5))
			piece(arm, outfit, "Leaf", Vector3.new(0.4, 0.08, 0.26), C.FeatherDark, CFrame.new(0.15, y - 0.08, -arm.Size.Z / 2 - 0.15) * CFrame.Angles(-0.3, 0, -0.6))
		end
	end
end

function PorkPieOutfit.apply(character)
	if character:FindFirstChild("PorkPieOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local face = head:FindFirstChildOfClass("Decal")
	if face then
		store.Hidden[face] = face.Transparency
		face.Transparency = 1
	end
	local outfit = Instance.new("Model")
	outfit.Name = "PorkPieOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function PorkPieOutfit.remove(character)
	local outfit = character:FindFirstChild("PorkPieOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == PorkPieOutfit.Act then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == PorkPieOutfit.Act then
					PorkPieOutfit.apply(character)
				end
			end)
		else
			PorkPieOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function PorkPieOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return PorkPieOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">ProjectileService</string><ProtectedString name="Source"><![CDATA[--[[
	ProjectileService  (ServerScriptService.SpinServer.ProjectileService)

	Server-simulated projectiles. The server owns position, collision and
	hits; clients only draw a matching visual (told via SpinFX
	"ProjectileSpawn" / "ProjectileEnd"). No physics parts are created on
	the server, so many projectiles at once stay cheap.

	Reusable for nails, wrecking balls, etc.:
		ProjectileService.fire(owner, {
			Kind = "SteelBall", Origin = Vector3, Direction = unit Vector3,
			Speed = 120, Radius = 1, Range = 150,
			Visual = { ...any data the client effect needs... },
			OnHit = function(targetCharacter, position, projectile) end,
		})
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Net = require(game:GetService("ReplicatedStorage").SpinShared.Net)
local Adapter = require(script.Parent.CombatAdapter)

local FX = Net.get("SpinFX")

local ProjectileService = {}
ProjectileService.MaxActivePerPlayer = 4

local active = {}
local countByPlayer = {}
local nextId = 0

local function characterFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

local function finish(p, position, normal, hitCharacter)
	if not active[p.Id] then
		return
	end
	active[p.Id] = nil
	if p.Owner then
		countByPlayer[p.Owner] = math.max(0, (countByPlayer[p.Owner] or 1) - 1)
	end
	-- Tell OnEnd why it stopped: hit a character, hit a wall/ground, or ran out of range.
	p.HitWall = hitCharacter == nil and normal ~= nil
	if hitCharacter and p.OnHit then
		local ok, err = pcall(p.OnHit, hitCharacter, position, p)
		if not ok then
			warn("[ProjectileService] OnHit error:", err)
		end
	end
	if p.OnEnd then
		local ok, err = pcall(p.OnEnd, position, normal or Vector3.new(0, 1, 0), hitCharacter, p)
		if not ok then
			warn("[ProjectileService] OnEnd error:", err)
		end
	end
	FX:FireAllClients("ProjectileEnd", {
		Id = p.Id,
		Kind = p.Kind,
		Position = position,
		Normal = normal or Vector3.new(0, 1, 0),
		HitCharacter = hitCharacter ~= nil,
		OwnerId = p.OwnerId,
		Visual = p.Visual,
	})
end

local function ignore(p, instance)
	local list = p.Params.FilterDescendantsInstances
	table.insert(list, instance)
	p.Params.FilterDescendantsInstances = list
end

-- Point-blank check: Spherecast misses parts already inside the start sphere.
local function overlapAtStart(p)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = p.Params.FilterDescendantsInstances
	for _, part in ipairs(workspace:GetPartBoundsInRadius(p.Position, p.Radius, overlap)) do
		local character = characterFromPart(part)
		if character and Adapter.canBeHit(p.Owner, character) then
			return character, part.Position
		end
	end
	return nil
end

function ProjectileService.activeCount(player)
	return countByPlayer[player] or 0
end

function ProjectileService.fire(owner, spec)
	if owner and ProjectileService.activeCount(owner) >= ProjectileService.MaxActivePerPlayer then
		return nil
	end
	nextId = nextId + 1

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local filter = {}
	if owner and owner.Character then
		table.insert(filter, owner.Character)
	end
	params.FilterDescendantsInstances = filter

	local p = {
		Id = nextId,
		Owner = owner,
		OwnerId = owner and owner.UserId or 0,
		Kind = spec.Kind or "Projectile",
		Position = spec.Origin,
		Direction = spec.Direction.Unit,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Traveled = 0,
		Params = params,
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd, -- function(position, normal, hitCharacter, projectile): always called once
		-- (projectile.HitWall is true when it stopped on a wall / the ground)
		Visual = spec.Visual or {},
	}
	active[p.Id] = p
	if owner then
		countByPlayer[owner] = (countByPlayer[owner] or 0) + 1
	end

	FX:FireAllClients("ProjectileSpawn", {
		Id = p.Id,
		Kind = p.Kind,
		Origin = p.Position,
		Direction = p.Direction,
		Speed = p.Speed,
		Range = p.Range,
		OwnerId = owner and owner.UserId or 0,
		ServerTime = workspace:GetServerTimeNow(),
		Visual = p.Visual,
	})

	local character, position = overlapAtStart(p)
	if character then
		finish(p, position, nil, character)
	end
	return p.Id
end

RunService.Heartbeat:Connect(function(dt)
	for _, p in pairs(active) do
		local step = math.min(p.Speed * dt, p.Range - p.Traveled)
		if step <= 0.01 then
			finish(p, p.Position, nil, nil)
		else
			local result = workspace:Spherecast(p.Position, p.Radius, p.Direction * step, p.Params)
			if result then
				local character = characterFromPart(result.Instance)
				if character then
					if Adapter.canBeHit(p.Owner, character) then
						finish(p, result.Position, result.Normal, character)
					else
						ignore(p, character) -- ally / i-frames / dead: pass through
					end
				else
					finish(p, result.Position, result.Normal, nil) -- wall / ground
				end
			else
				p.Position = p.Position + p.Direction * step
				p.Traveled = p.Traveled + step
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	countByPlayer[player] = nil
	for _, p in pairs(active) do
		if p.Owner == player then
			p.Owner = nil
			p.OnHit = nil
			p.OnEnd = nil
			finish(p, p.Position, nil, nil)
		end
	end
end)

return ProjectileService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">SandmanOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	SandmanOutfit  (ServerScriptService.SpinServer.SandmanOutfit)

	Gives a character Sandman's look while they play him (TuskAct 8), built
	from blocky parts (no catalog asset ids), matched to his art:
	  * mint-green hair over the top of his head with a black stripe down
	    the middle, two mint braids hanging in front tied with gold beads,
	    and a long black ponytail down his back
	  * a yellow collar round his shoulders with a black zigzag
	  * a bare chest with the red chevron tattoo and green shoulder tattoos
	  * a dark red corset studded with gold
	  * a sand-coloured loincloth with gold pyramid studs and hanging flaps
	  * yellow arm bands and long yellow gauntlets
	  * fringed sand leg wraps under the knees and at the ankles, black
	    shin bands and bare feet with sandal straps
	The player's own hats/hair are hidden while they play him and come back
	when they switch. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local SandmanOutfit = {}
SandmanOutfit.Act = 8

local C = {
	Mint = Color3.fromRGB(150, 210, 180),
	MintDark = Color3.fromRGB(110, 170, 145),
	Black = Color3.fromRGB(24, 22, 26),
	Bead = Color3.fromRGB(222, 178, 60),
	Yellow = Color3.fromRGB(240, 192, 50),
	YellowDark = Color3.fromRGB(200, 150, 30),
	Tattoo = Color3.fromRGB(180, 50, 60),
	TattooGreen = Color3.fromRGB(70, 140, 100),
	Corset = Color3.fromRGB(130, 46, 36),
	CorsetDark = Color3.fromRGB(96, 32, 26),
	Stud = Color3.fromRGB(222, 178, 60),
	Cloth = Color3.fromRGB(214, 196, 150),
	ClothDark = Color3.fromRGB(176, 156, 110),
	Wrap = Color3.fromRGB(205, 188, 145),
	Strap = Color3.fromRGB(120, 86, 56),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	-- Mint hair hugging the top of the head, a black stripe down the middle.
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.12 * s, 0.34 * s, head.Size.Z + 0.12 * s), C.Mint, CFrame.new(0, h - 0.1 * s, 0.02 * s))
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Hair", Vector3.new(0.1 * s, 0.55 * s, head.Size.Z * 0.75), C.Mint, CFrame.new(side * (w + 0.04 * s), h - 0.38 * s, 0.12 * s))
	end
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.12 * s, 0.7 * s, 0.1 * s), C.Mint, CFrame.new(0, h - 0.4 * s, d + 0.04 * s))
	piece(head, outfit, "Stripe", Vector3.new(0.22 * s, 0.06 * s, head.Size.Z + 0.14 * s), C.Black, CFrame.new(0, h + 0.08 * s, 0.02 * s))
	piece(head, outfit, "Stripe", Vector3.new(0.22 * s, 0.3 * s, 0.06 * s), C.Black, CFrame.new(0, h - 0.12 * s, -d - 0.06 * s))
	-- Two braids hanging down in front of the shoulders, tied off with gold beads.
	for _, side in ipairs({ -1, 1 }) do
		local x = side * (w - 0.02 * s)
		for i = 0, 5 do
			piece(head, outfit, "Braid", Vector3.new(0.2 * s, 0.24 * s, 0.2 * s), i % 2 == 0 and C.Mint or C.MintDark, CFrame.new(x, h - 0.5 * s - i * 0.22 * s, -d - 0.04 * s) * CFrame.Angles(0, 0, (i % 2 == 0 and 0.2 or -0.2)))
		end
		piece(head, outfit, "Bead", Vector3.new(0.16 * s, 0.14 * s, 0.16 * s), C.Bead, CFrame.new(x, h - 1.86 * s, -d - 0.04 * s))
		piece(head, outfit, "BraidTip", Vector3.new(0.12 * s, 0.2 * s, 0.12 * s), C.MintDark, CFrame.new(x, h - 2.02 * s, -d - 0.04 * s))
	end
	-- Long black ponytail down his back.
	for i = 0, 4 do
		piece(head, outfit, "Ponytail", Vector3.new((0.5 - i * 0.05) * s, 0.44 * s, 0.26 * s), C.Black, CFrame.new(0, h - 0.35 * s - i * 0.4 * s, d + 0.14 * s + i * 0.03 * s))
	end
end

local function body(character, outfit)
	local headPart = character:FindFirstChild("Head")
	local skin = headPart and headPart.Color or Color3.fromRGB(190, 130, 100)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		local s = upper.Size
		local top, front = s.Y / 2, -s.Z / 2
		local r6 = not lower
		-- Bare chest.
		piece(upper, outfit, "Skin", s + Vector3.new(0.04, 0.02, 0.04), skin, CFrame.new())
		-- Yellow collar with a black zigzag, wrapping the shoulders.
		piece(upper, outfit, "Collar", Vector3.new(s.X + 0.16, 0.34, s.Z + 0.18), C.Yellow, CFrame.new(0, top - 0.12, 0))
		for i = -4, 4 do
			piece(upper, outfit, "Zigzag", Vector3.new(0.16, 0.16, 0.04), C.Black, CFrame.new(i * 0.22, top - 0.14, front - 0.11) * CFrame.Angles(0, 0, math.pi / 4))
		end
		piece(upper, outfit, "Collar", Vector3.new(s.X * 0.5, 0.14, s.Z + 0.12), C.Black, CFrame.new(0, top + 0.08, 0))
		-- Red chevron tattoo on his chest (his left), green tattoos on the shoulders.
		for i = 0, 2 do
			piece(upper, outfit, "Tattoo", Vector3.new(0.42, 0.07, 0.03), C.Tattoo, CFrame.new(0.45, top - 0.45 - i * 0.13, front - 0.03) * CFrame.Angles(0, 0, -0.35))
		end
		-- Dark red corset from under the chest down, studded with gold.
		local corsetH = r6 and s.Y * 0.5 or s.Y * 0.48
		local corsetY = -s.Y / 2 + corsetH / 2
		piece(upper, outfit, "Corset", Vector3.new(s.X + 0.12, corsetH, s.Z + 0.12), C.Corset, CFrame.new(0, corsetY, 0))
		piece(upper, outfit, "Corset", Vector3.new(s.X * 0.5, 0.18, 0.06), C.Corset, CFrame.new(0, corsetY + corsetH / 2 + 0.06, front - 0.07))
		piece(upper, outfit, "CorsetSeam", Vector3.new(0.08, corsetH, 0.03), C.CorsetDark, CFrame.new(0, corsetY, front - 0.08))
		for _, x in ipairs({ -0.75, -0.4, 0.4, 0.75 }) do
			for k = 0, 1 do
				piece(upper, outfit, "Stud", Vector3.new(0.1, 0.1, 0.05), C.Stud, CFrame.new(x, corsetY + corsetH / 2 - 0.12 - k * (corsetH - 0.24), front - 0.08))
			end
		end
	end
	local waist = lower or upper
	if waist then
		local ws = waist.Size
		local waistTop = lower and ws.Y / 2 or -upper.Size.Y / 2 + 0.35
		if lower then
			piece(lower, outfit, "Corset", ws + Vector3.new(0.12, 0.02, 0.12), C.Corset, CFrame.new())
		end
		-- Loincloth: a band round the hips and flaps hanging front and back.
		local bandY = waistTop - 0.32
		piece(waist, outfit, "Loincloth", Vector3.new(ws.X + 0.22, 0.36, ws.Z + 0.22), C.Cloth, CFrame.new(0, bandY, 0))
		piece(waist, outfit, "Flap", Vector3.new(ws.X * 0.7, 0.9, 0.08), C.Cloth, CFrame.new(0, bandY - 0.6, -ws.Z / 2 - 0.13) * CFrame.Angles(-0.06, 0, 0))
		piece(waist, outfit, "Flap", Vector3.new(ws.X * 0.8, 0.8, 0.08), C.ClothDark, CFrame.new(0, bandY - 0.55, ws.Z / 2 + 0.13) * CFrame.Angles(0.06, 0, 0))
		for _, side in ipairs({ -1, 1 }) do
			piece(waist, outfit, "Flap", Vector3.new(0.08, 0.55, ws.Z * 0.8), C.ClothDark, CFrame.new(side * (ws.X / 2 + 0.13), bandY - 0.4, 0))
		end
		-- Gold pyramid studs on the cloth.
		for _, x in ipairs({ -0.65, 0, 0.65 }) do
			piece(waist, outfit, "Pyramid", Vector3.new(0.2, 0.2, 0.08), C.Stud, CFrame.new(x, bandY, -ws.Z / 2 - 0.14) * CFrame.Angles(0, 0, math.pi / 4))
		end
		piece(waist, outfit, "Pyramid", Vector3.new(0.2, 0.2, 0.08), C.Stud, CFrame.new(0, bandY - 0.95, -ws.Z / 2 - 0.2) * CFrame.Angles(0, 0, math.pi / 4))
	end
	-- Bare arms with a green tattoo on each shoulder, yellow band above the
	-- elbow and long yellow gauntlets.
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local as = arm.Size
			local out = name:find("Left") and -1 or 1
			piece(arm, outfit, "Skin", as + Vector3.new(0.04, 0.02, 0.04), skin, CFrame.new())
			local tall = as.Y > 1.8
			if name:find("Upper") or tall then
				piece(arm, outfit, "Tattoo", Vector3.new(0.04, 0.32, 0.4), C.TattooGreen, CFrame.new(out * (as.X / 2 + 0.03), as.Y / 2 - 0.3, 0))
				piece(arm, outfit, "Armband", Vector3.new(as.X + 0.14, 0.3, as.Z + 0.14), C.Yellow, CFrame.new(0, tall and 0.15 or -as.Y / 2 + 0.2, 0))
			end
			if name:find("Lower") or tall then
				local gh = tall and as.Y * 0.42 or as.Y - 0.05
				piece(arm, outfit, "Gauntlet", Vector3.new(as.X + 0.16, gh, as.Z + 0.16), C.Yellow, CFrame.new(0, -as.Y / 2 + gh / 2, 0))
				piece(arm, outfit, "GauntletBand", Vector3.new(as.X + 0.18, 0.08, as.Z + 0.18), C.Black, CFrame.new(0, -as.Y / 2 + gh - 0.12, 0))
				piece(arm, outfit, "GauntletBand", Vector3.new(as.X + 0.18, 0.08, as.Z + 0.18), C.YellowDark, CFrame.new(0, -as.Y / 2 + 0.12, 0))
			end
		end
	end
	-- Bare legs, fringed wraps under the knee and at the ankle, black shin bands.
	local function fringe(leg, y)
		local ls = leg.Size
		piece(leg, outfit, "Wrap", Vector3.new(ls.X + 0.16, 0.2, ls.Z + 0.16), C.Wrap, CFrame.new(0, y, 0))
		for i = -2, 2 do
			piece(leg, outfit, "Fringe", Vector3.new(0.1, 0.24, 0.05), C.Wrap, CFrame.new(i * ls.X * 0.2, y - 0.2, -ls.Z / 2 - 0.1))
			piece(leg, outfit, "Fringe", Vector3.new(0.1, 0.24, 0.05), C.Wrap, CFrame.new(i * ls.X * 0.2, y - 0.2, ls.Z / 2 + 0.1))
		end
	end
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			local ls = leg.Size
			piece(leg, outfit, "Skin", ls + Vector3.new(0.04, 0.02, 0.04), skin, CFrame.new())
			local tall = ls.Y > 1.8
			if name:find("Lower") or tall then
				local knee = tall and -0.05 or ls.Y / 2 - 0.12
				fringe(leg, knee)
				piece(leg, outfit, "ShinBand", Vector3.new(ls.X + 0.1, 0.34, ls.Z + 0.1), C.Black, CFrame.new(0, knee - 0.45, 0))
				fringe(leg, -ls.Y / 2 + 0.3)
			end
		end
	end
	-- Bare feet with a sandal strap.
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(name)
		if foot then
			local fs = foot.Size
			piece(foot, outfit, "Skin", fs + Vector3.new(0.04, 0.02, 0.04), skin, CFrame.new())
			piece(foot, outfit, "Strap", Vector3.new(fs.X + 0.08, 0.08, 0.14), C.Strap, CFrame.new(0, 0.02, -fs.Z * 0.15))
		end
	end
end

function SandmanOutfit.apply(character)
	if character:FindFirstChild("SandmanOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "SandmanOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function SandmanOutfit.remove(character)
	local outfit = character:FindFirstChild("SandmanOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == SandmanOutfit.Act then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == SandmanOutfit.Act then
					SandmanOutfit.apply(character)
				end
			end)
		else
			SandmanOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function SandmanOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return SandmanOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">StandAssetLoader</string><ProtectedString name="Source"><![CDATA[--[[
	StandAssetLoader  (ServerScriptService.SpinServer.StandAssetLoader)

	Loads the Stand models listed in TuskConfig.StandModels (by asset id)
	into ReplicatedStorage.SpinAssets as "TuskAct1", "TuskAct2"...
	Every client then uses that model instead of the built-in one.

	Safety: every Script, LocalScript and ModuleScript inside a loaded
	model is deleted before anyone can see it (free models sometimes hide
	harmful scripts).

	If Roblox refuses to load an asset (InsertService can only load models
	your account owns, or free models depending on Roblox's rules), the
	Output says so. Then insert the model yourself: Toolbox > search the id
	> drag it into ReplicatedStorage > put it in a Folder named SpinAssets
	> rename it TuskAct1.
]]

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TuskConfig = require(game:GetService("ReplicatedStorage").SpinShared.TuskConfig)

local StandAssetLoader = {}

local function assetsFolder()
	local folder = ReplicatedStorage:FindFirstChild("SpinAssets")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "SpinAssets"
		folder.Parent = ReplicatedStorage
	end
	return folder
end

local function sanitize(model)
	local removed = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
			removed = removed + 1
		end
	end
	return removed
end

local function load(act, entry)
	local name = "TuskAct" .. act
	local folder = assetsFolder()
	if folder:FindFirstChild(name) then
		return -- already placed by hand: keep it
	end
	local ok, container = pcall(function()
		return InsertService:LoadAsset(entry.AssetId)
	end)
	if not ok or not container then
		warn(("[Spin] Could not load Stand model %d for Act %d (%s). Insert it by hand: Toolbox > drag into ReplicatedStorage.SpinAssets > rename %s."):format(entry.AssetId, act, tostring(container), name))
		return
	end
	local model = container:FindFirstChildWhichIsA("Model", true) or container
	local removed = sanitize(model)
	model.Name = name
	if not model:IsA("Model") then
		local wrapper = Instance.new("Model")
		for _, child in ipairs(model:GetChildren()) do
			child.Parent = wrapper
		end
		model = wrapper
		model.Name = name
	end
	model.Parent = folder
	container:Destroy()
	print(("[Spin] Loaded Stand model %d as %s%s"):format(entry.AssetId, name, removed > 0 and (" (removed " .. removed .. " scripts for safety)") or ""))
end

function StandAssetLoader.init()
	for act, entry in pairs(TuskConfig.StandModels or {}) do
		if entry.AssetId and entry.AssetId ~= 0 then
			task.spawn(load, act, entry)
		end
	end
end

return StandAssetLoader
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">StandBots</string><ProtectedString name="Source"><![CDATA[--[[
	StandBots  (ServerScriptService.SpinServer.StandBots)

	Enemy NPCs that fight you with a Stand. Each one plays a real character
	(Johnny / Tusk, Gyro, Diego, Pork Pie Hat Kid, Sandman, Mountain Tim, Hot Pants, Blackmore, Axl RO, Funny Valentine:
	whichever are installed) through exactly the same move code as players, so their M1s,
	abilities and ultimates hit, stun and look the same.
	  * they're scattered round the map (TuskConfig.StandBots.Spots), chase
	    any player who comes within AggroRange and walk back to their spot
	    when the player gets away
	  * each respawn picks a new free spot, so they move around over time
	  * M1 combo up close, abilities on cooldown, ultimate when their meter is full
	  * hold abilities are charged and released automatically
	  * they block now and then, dash in to close the gap, and dash away when hurt
	  * every installed character has an NPC out: a new NPC is whichever
	    character has the fewest right now (TuskConfig.StandBots.Characters)
	  * Blackmore NPCs rain walk while it rains: they step up onto frozen
	    raindrops (an invisible step only NPCs collide with) and climb
	    toward players above them
	  * they respawn RespawnTime seconds after dying, as whoever is missing
	Settings: TuskConfig.StandBots (Enabled = false turns them off).
	Tagged "SpinFighter" so every client draws their Stand, outfit and effects.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Registry = require(Shared.TuskActRegistry)

local StandBots = {}
local S -- TuskService
local cfg
local folder
local bots = {}
local nextId = 0

-- Body colours per character so you can tell them apart before they attack.
local LOOKS = {
	Johnny = { Skin = Color3.fromRGB(234, 190, 150), Torso = Color3.fromRGB(60, 110, 190), Legs = Color3.fromRGB(40, 40, 60) },
	Gyro = { Skin = Color3.fromRGB(226, 180, 140), Torso = Color3.fromRGB(102, 64, 150), Legs = Color3.fromRGB(70, 46, 110) },
	Diego = { Skin = Color3.fromRGB(240, 200, 165), Torso = Color3.fromRGB(60, 120, 90), Legs = Color3.fromRGB(40, 50, 45) },
	PorkPie = { Skin = Color3.fromRGB(205, 150, 110), Torso = Color3.fromRGB(95, 115, 45), Legs = Color3.fromRGB(95, 115, 45) },
	Sandman = { Skin = Color3.fromRGB(170, 115, 80), Torso = Color3.fromRGB(200, 160, 100), Legs = Color3.fromRGB(120, 85, 55) },
	MountainTim = { Skin = Color3.fromRGB(226, 180, 140), Torso = Color3.fromRGB(70, 90, 130), Legs = Color3.fromRGB(60, 50, 70) },
	HotPants = { Skin = Color3.fromRGB(238, 196, 164), Torso = Color3.fromRGB(96, 60, 120), Legs = Color3.fromRGB(238, 196, 164) },
	Blackmore = { Skin = Color3.fromRGB(220, 196, 176), Torso = Color3.fromRGB(36, 44, 70), Legs = Color3.fromRGB(30, 30, 40) },
	Valentine = { Skin = Color3.fromRGB(240, 210, 190), Torso = Color3.fromRGB(236, 230, 220), Legs = Color3.fromRGB(40, 44, 70) },
	Axl = { Skin = Color3.fromRGB(230, 196, 160), Torso = Color3.fromRGB(110, 116, 128), Legs = Color3.fromRGB(46, 42, 50) },
}

local usedSpots = {} -- [spot index] = slot using it

local function groundAt(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	local hit = workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position + Vector3.new(0, 3, 0) or pos
end

-- A free spot round the map (or, with no map, a camp near the spawn).
local function findHome(slot, count)
	local map = workspace:FindFirstChild("SBRMap")
	local spots = cfg.Spots
	if map and spots and #spots > 0 then
		local origin = map:GetAttribute("Origin") or Vector3.new()
		local free = {}
		for i in ipairs(spots) do
			if not usedSpots[i] then
				table.insert(free, i)
			end
		end
		if #free > 0 then
			local i = free[math.random(1, #free)]
			usedSpots[i] = slot
			return groundAt(origin + spots[i]), i
		end
	end
	local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	local base = spawn and spawn.CFrame or CFrame.new(0, 5, 0)
	local spread = (slot - (count + 1) / 2) * (cfg.Spacing or 14)
	return groundAt((base * CFrame.new(spread, 0, cfg.Distance or 70)).Position), nil
end

-- Characters this server can actually play, as their start Acts.
local function playableActs()
	local list = {}
	for _, who in ipairs(cfg.Characters or {}) do
		local act = Registry.StartAct[who]
		if act and S.hasAct(act) then
			table.insert(list, { Who = who, Act = act })
		end
	end
	return list
end

-- A table that looks enough like a Player for the move code.
local function newBotPlayer(name, model)
	nextId = nextId + 1
	local attrs = {}
	return {
		Name = name,
		DisplayName = name,
		UserId = -1000 - nextId,
		Character = model,
		Neutral = true,
		IsBot = true,
		GetAttribute = function(_, k)
			return attrs[k]
		end,
		SetAttribute = function(_, k, v)
			attrs[k] = v
		end,
	}
end

local function buildModel(who)
	local look = LOOKS[who] or LOOKS.Johnny
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = look.Skin
	desc.LeftArmColor = look.Skin
	desc.RightArmColor = look.Skin
	desc.TorsoColor = look.Torso
	desc.LeftLegColor = look.Legs
	desc.RightLegColor = look.Legs
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[StandBots] couldn't create an NPC body: " .. tostring(model))
		return nil
	end
	return model
end

local spawnBot -- (defined below; respawn calls it)

local endRainWalk -- (rain walk, below)

local function removeBot(bot)
	endRainWalk(bot, false)
	bots[bot.Slot] = nil
	if bot.Spot and usedSpots[bot.Spot] == bot.Slot then
		usedSpots[bot.Spot] = nil
	end
	S.removeBot(bot.Player)
	if bot.Model then
		bot.Model:Destroy()
	end
end

function spawnBot(slot)
	local choices = playableActs()
	if #choices == 0 then
		return
	end
	-- Whoever has the fewest NPCs out right now, so every character shows up.
	local counts = {}
	for _, other in pairs(bots) do
		if other.Slot ~= slot then
			counts[other.Who] = (counts[other.Who] or 0) + 1
		end
	end
	local fewest = math.huge
	for _, c in ipairs(choices) do
		fewest = math.min(fewest, counts[c.Who] or 0)
	end
	local pool = {}
	for _, c in ipairs(choices) do
		if (counts[c.Who] or 0) == fewest then
			table.insert(pool, c)
		end
	end
	local pick = pool[math.random(1, #pool)]
	local model = buildModel(pick.Who)
	if not model then
		return
	end
	local roster
	for _, entry in ipairs(TuskConfig.Roster or {}) do
		if entry.Id == pick.Who then
			roster = entry
		end
	end
	local name = "Stand User: " .. (roster and roster.Name or pick.Who)
	model.Name = name
	local home, spot = findHome(slot, cfg.Count)
	model:PivotTo(CFrame.new(home))
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.NameDisplayDistance = 80
	humanoid.HealthDisplayDistance = 80
	humanoid.MaxHealth = cfg.Health or 200
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = cfg.WalkSpeed or 15
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil) -- the server drives NPCs
		end)
	end
	local botPlayer = newBotPlayer(name, model)
	local bot = { Slot = slot, Spot = spot, Player = botPlayer, Model = model, Humanoid = humanoid, Home = home, Who = pick.Who, NextThink = 0, NextAbility = os.clock() + 2, NextUlt = 0 }
	bots[slot] = bot
	bot.State = S.addBot(botPlayer, pick.Act)
	CollectionService:AddTag(model, "SpinFighter")
	humanoid.Died:Connect(function()
		endRainWalk(bot, false)
		task.delay(cfg.RespawnTime or 10, function()
			if bots[slot] == bot then
				removeBot(bot)
				spawnBot(slot)
			end
		end)
	end)
end

---------------------------------------------------------------------------
-- Blackmore NPCs: RAIN WALK (the server moves NPCs, so the server does it).
-- An invisible step under his feet that only Stand-user NPCs collide with.
---------------------------------------------------------------------------
local STEP_GROUP, BOT_GROUP = "SpinRainStep", "SpinStandBot"
local groupsReady = false

local function setupGroups()
	if groupsReady then
		return true
	end
	groupsReady = pcall(function()
		for _, g in ipairs({ STEP_GROUP, BOT_GROUP }) do
			if not PhysicsService:IsCollisionGroupRegistered(g) then
				PhysicsService:RegisterCollisionGroup(g)
			end
		end
		for _, g in ipairs(PhysicsService:GetRegisteredCollisionGroups()) do
			PhysicsService:CollisionGroupSetCollidable(STEP_GROUP, g.name, g.name == BOT_GROUP)
		end
	end)
	return groupsReady
end

local function rainingFor(model)
	if game:GetService("ReplicatedStorage"):GetAttribute("SpinRaining") == true then
		return true
	end
	return (model:GetAttribute("RainStormUntil") or 0) > workspace:GetServerTimeNow()
end

local function feetY(bot, root)
	return root.Position.Y - (bot.Humanoid.HipHeight + root.Size.Y / 2)
end

local function walkCfg()
	return (TuskConfig.Blackmore and TuskConfig.Blackmore.RainWalk) or { FloatTime = 6, MaxSteps = 8, Cooldown = 3 }
end

function endRainWalk(bot, cooldown)
	local rw = bot.RainWalk
	if not rw then
		return
	end
	bot.RainWalk = nil
	if rw.Step then
		rw.Step:Destroy()
	end
	if bot.Model and bot.Model.Parent then
		bot.Model:SetAttribute("RainFloating", nil)
	end
	if cooldown then
		bot.RainWalkReady = os.clock() + walkCfg().Cooldown + 2
	end
end

-- Jump, then a frozen raindrop catches his feet near the top of the jump.
local function rainHop(bot)
	local rw = bot.RainWalk
	if not rw or rw.Steps >= walkCfg().MaxSteps then
		return
	end
	rw.Steps = rw.Steps + 1
	rw.Hopping = true
	bot.Humanoid.Jump = true
	task.delay(0.32, function()
		if bot.RainWalk ~= rw then
			return
		end
		rw.Hopping = false
		local root = bot.Model:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		rw.Y = math.max(feetY(bot, root), rw.Y or -math.huge)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
	end)
end

local function startRainWalk(bot, root)
	if not setupGroups() then
		return
	end
	for _, d in ipairs(bot.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = BOT_GROUP
		end
	end
	local step = Instance.new("Part")
	step.Name = "RainStep"
	step.Anchored = true
	step.CanCollide = true
	step.CanQuery = false
	step.CanTouch = false
	step.Transparency = 1
	step.Size = Vector3.new(5, 0.4, 5)
	step.CollisionGroup = STEP_GROUP
	step.CFrame = CFrame.new(root.Position.X, -10000, root.Position.Z)
	step.Parent = folder
	local token = tostring({})
	bot.RainWalk = { Step = step, Start = os.clock(), Steps = 0, Token = token }
	bot.Model:SetAttribute("RainFloating", token)
	rainHop(bot)
end

-- Every frame: keep the step under his feet.
local function stepRainWalks()
	for _, bot in pairs(bots) do
		local rw = bot.RainWalk
		if rw and rw.Step and rw.Y then
			local root = bot.Model and bot.Model:FindFirstChild("HumanoidRootPart")
			if root then
				rw.Step.CFrame = CFrame.new(root.Position.X, rw.Y - 0.2, root.Position.Z)
			end
		end
	end
end

-- Each think: start, climb toward a target above him, or end.
local function thinkRainWalk(bot, root, target)
	if bot.Who ~= "Blackmore" then
		return
	end
	local now = os.clock()
	local rw = bot.RainWalk
	if rw then
		if now - rw.Start > walkCfg().FloatTime or not rainingFor(bot.Model) or bot.Model:GetAttribute("Stunned") or bot.Humanoid.Health <= 0 then
			endRainWalk(bot, true)
			return
		end
		-- Climb toward someone above him.
		local tr = target and target:FindFirstChild("HumanoidRootPart")
		if tr and not rw.Hopping and rw.Y and tr.Position.Y - 1 > feetY(bot, root) + 2 then
			rainHop(bot)
		end
		return
	end
	if not target or now < (bot.RainWalkReady or 0) or not rainingFor(bot.Model) then
		return
	end
	local tr = target:FindFirstChild("HumanoidRootPart")
	local above = tr and tr.Position.Y > root.Position.Y + 4
	if above or math.random() < (cfg.RainWalkChance or 0.05) then
		startRainWalk(bot, root)
	end
end

-- Nearest player in range.
local function findTarget(bot, root)
	local best, bestDist
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local tr = character and character:FindFirstChild("HumanoidRootPart")
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if tr and hum and hum.Health > 0 and S.Adapter.canBeHit(bot.Player, character) then
			local d = (tr.Position - root.Position).Magnitude
			local fromHome = (tr.Position - bot.Home).Magnitude
			if d <= (cfg.AggroRange or 70) and fromHome <= (cfg.LeashRange or 120) and (not bestDist or d < bestDist) then
				best, bestDist = character, d
			end
		end
	end
	return best, bestDist
end

local function useAbility(bot, module, slot, aim)
	local info = Registry.get(bot.State.Act)
	local kind = info and info.AbilityKinds and info.AbilityKinds[slot] or "Press"
	module.Ability(S, bot.Player, bot.State, slot, "Press", aim)
	if kind == "Hold" then
		local hold = 0.5 + math.random() * 0.9
		task.delay(hold, function()
			if bots[bot.Slot] == bot then
				module.Ability(S, bot.Player, bot.State, slot, "Release", aim)
			end
		end)
	end
end

local function think(bot, now)
	local model, humanoid = bot.Model, bot.Humanoid
	local root = model and model:FindFirstChild("HumanoidRootPart")
	if not root or humanoid.Health <= 0 then
		return
	end
	local state = bot.State
	local module = state.Act and S.actModule(state.Act)
	if not module then
		return
	end
	local target, dist = findTarget(bot, root)
	if not target then
		if bot.RainWalk then
			endRainWalk(bot, false)
		end
		if (root.Position - bot.Home).Magnitude > 6 then
			humanoid:MoveTo(bot.Home)
		end
		return
	end
	thinkRainWalk(bot, root, target)
	local tr = target:FindFirstChild("HumanoidRootPart")
	local flatTarget = Vector3.new(tr.Position.X, root.Position.Y, tr.Position.Z)
	local reach = cfg.AttackRange or 6
	if dist > reach - 1 then
		humanoid:MoveTo(tr.Position - (tr.Position - root.Position).Unit * (reach - 2))
	else
		humanoid:MoveTo(root.Position)
	end
	local Defense = S.Defense
	-- Holding a block: wait it out.
	if Defense and model:GetAttribute("Blocking") then
		if now >= (bot.BlockUntil or 0) then
			Defense.block(bot.Player, state, false)
		end
		return
	end
	if not S.Adapter.canAct(bot.Player) or S.isBusy(state) or state.Charging then
		return
	end
	if Defense then
		local hurt = humanoid.Health < humanoid.MaxHealth * 0.35
		-- Close in with a dash, or dash away when hurt.
		if dist > 14 and dist < 30 and math.random() < (cfg.DashChance or 0.06) then
			Defense.dash(bot.Player, state, tr.Position - root.Position)
			return
		elseif hurt and dist < 8 and math.random() < (cfg.DashChance or 0.06) then
			Defense.dash(bot.Player, state, root.Position - tr.Position)
			return
		end
		-- Block now and then when someone's right in front of them.
		if dist < reach + 2 and math.random() < (cfg.BlockChance or 0.05) then
			bot.BlockUntil = now + 0.4 + math.random() * 0.5
			Defense.block(bot.Player, state, true)
			return
		end
	end
	-- Face the target and attack.
	if (flatTarget - root.Position).Magnitude > 0.5 then
		root.CFrame = CFrame.lookAt(root.Position, flatTarget)
	end
	local aim = (tr.Position - root.Position).Unit
	if bot.Player:GetAttribute("TuskUlt") and bot.Player:GetAttribute("TuskUlt") >= TuskConfig.Ultimate.MaxMeter and dist < 22 and now >= bot.NextUlt then
		bot.NextUlt = now + 5
		module.Ultimate(S, bot.Player, state, aim)
		return
	end
	if now >= bot.NextAbility and dist < (cfg.AbilityRange or 35) then
		bot.NextAbility = now + (cfg.AbilityEvery or 2.5) * (0.7 + math.random() * 0.6)
		useAbility(bot, module, math.random(1, 3), aim)
		return
	end
	if dist <= reach then
		module.M1(S, bot.Player, state, aim)
	end
end

function StandBots.init(TuskService)
	S = TuskService
	cfg = TuskConfig.StandBots or {}
	if cfg.Enabled == false or (cfg.Count or 0) <= 0 then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "SpinStandBots"
	folder.Parent = workspace
	task.delay(cfg.StartDelay or 3, function()
		for slot = 1, cfg.Count do
			spawnBot(slot)
		end
	end)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		stepRainWalks()
		accumulator = accumulator + dt
		if accumulator < (cfg.ThinkEvery or 0.15) then
			return
		end
		accumulator = 0
		local now = os.clock()
		for _, bot in pairs(bots) do
			local ok, err = pcall(think, bot, now)
			if not ok then
				warn("[StandBots] " .. tostring(err))
			end
		end
	end)
end

return StandBots
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">TestDummies</string><ProtectedString name="Source"><![CDATA[--[[
	TestDummies  (ServerScriptService.SpinServer.TestDummies)
	Studio-only practice targets so Spin can be tested solo.
	Never runs in a live server (guarded by RunService:IsStudio()).
	Turn off with SpinConfig.Debug.SpawnTestDummies = false.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local SpinConfig = require(game:GetService("ReplicatedStorage").SpinShared.SpinConfig)

local TestDummies = {}

local function findSpawn()
	local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then
		return spawn.CFrame
	end
	return CFrame.new(0, 5, 0)
end

-- Training-dummy look (blocky, built from parts): burlap sack body, straw
-- sticking out of the head and cuffs, a stitched face with button eyes, a
-- red-and-white target on the chest, rope belt, wooden peg feet.
local BURLAP = Color3.fromRGB(196, 160, 108)
local BURLAP_DARK = Color3.fromRGB(150, 116, 74)
local STRAW = Color3.fromRGB(236, 205, 110)
local ROPE = Color3.fromRGB(120, 85, 50)
local RED = Color3.fromRGB(200, 50, 45)
local WHITE = Color3.fromRGB(245, 240, 230)
local INK = Color3.fromRGB(35, 28, 24)
local WOOD = Color3.fromRGB(110, 75, 45)

local function deco(parent, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent.Parent
	return p
end

local function dress(dummy)
	local head = dummy:FindFirstChild("Head")
	local torso = dummy:FindFirstChild("UpperTorso") or dummy:FindFirstChild("Torso")
	local lower = dummy:FindFirstChild("LowerTorso")
	for _, part in ipairs(dummy:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Color = BURLAP
			part.Material = Enum.Material.Fabric
		end
	end
	if head then
		local face = head:FindFirstChildOfClass("Decal")
		if face then
			face:Destroy()
		end
		local s = head.Size.Y / 1.2
		local front = -head.Size.Z / 2 - 0.02
		-- Button eyes, a stitched mouth, a seam down the middle.
		for _, side in ipairs({ -1, 1 }) do
			deco(head, "Button", Vector3.new(0.26, 0.26, 0.06) * s, INK, CFrame.new(side * 0.24 * s, 0.1 * s, front))
			deco(head, "ButtonHole", Vector3.new(0.06, 0.06, 0.04) * s, BURLAP, CFrame.new(side * 0.24 * s, 0.1 * s, front - 0.04 * s))
		end
		deco(head, "Mouth", Vector3.new(0.6, 0.05, 0.04) * s, INK, CFrame.new(0, -0.26 * s, front))
		for i = -2, 2 do
			deco(head, "Stitch", Vector3.new(0.04, 0.16, 0.04) * s, INK, CFrame.new(i * 0.12 * s, -0.26 * s, front - 0.01 * s))
		end
		deco(head, "Seam", Vector3.new(0.05, head.Size.Y + 0.02, 0.05), BURLAP_DARK, CFrame.new(0, 0, front + 0.01))
		-- Straw sticking out of the top.
		for i = 0, 6 do
			local a = i / 7 * math.pi * 2
			deco(head, "Straw", Vector3.new(0.08, 0.6, 0.08) * s, STRAW, CFrame.new(math.cos(a) * 0.25 * s, head.Size.Y / 2 + 0.15 * s, math.sin(a) * 0.25 * s) * CFrame.Angles(math.sin(a) * 0.6, 0, -math.cos(a) * 0.6))
		end
		deco(head, "Tie", Vector3.new(0.5, 0.1, 0.5) * s, ROPE, CFrame.new(0, head.Size.Y / 2 - 0.02, 0))
	end
	if torso then
		local z = -torso.Size.Z / 2 - 0.03
		-- Target on the chest.
		deco(torso, "Target", Vector3.new(1.3, 1.3, 0.05), RED, CFrame.new(0, 0.1, z))
		deco(torso, "Target", Vector3.new(0.95, 0.95, 0.05), WHITE, CFrame.new(0, 0.1, z - 0.01))
		deco(torso, "Target", Vector3.new(0.6, 0.6, 0.05), RED, CFrame.new(0, 0.1, z - 0.02))
		deco(torso, "Target", Vector3.new(0.25, 0.25, 0.05), WHITE, CFrame.new(0, 0.1, z - 0.03))
		deco(torso, "Patch", Vector3.new(0.5, 0.4, 0.05), BURLAP_DARK, CFrame.new(-0.55, -0.55, z) * CFrame.Angles(0, 0, 0.2))
	end
	local waist = lower or torso
	if waist then
		local y = lower and 0 or -torso.Size.Y / 2 + 0.1
		deco(waist, "Rope", Vector3.new(waist.Size.X + 0.12, 0.2, waist.Size.Z + 0.12), ROPE, CFrame.new(0, y, 0))
		deco(waist, "RopeKnot", Vector3.new(0.3, 0.45, 0.15), ROPE, CFrame.new(0.4, y - 0.15, -waist.Size.Z / 2 - 0.08))
	end
	-- Straw cuffs at the wrists, wooden pegs for feet.
	for _, name in ipairs({ "LeftHand", "RightHand", "Left Arm", "Right Arm" }) do
		local hand = dummy:FindFirstChild(name)
		if hand then
			deco(hand, "Straw", Vector3.new(hand.Size.X + 0.15, 0.2, hand.Size.Z + 0.15), STRAW, CFrame.new(0, hand.Size.Y / 2 - 0.05, 0))
		end
	end
	for _, name in ipairs({ "LeftFoot", "RightFoot", "Left Leg", "Right Leg" }) do
		local foot = dummy:FindFirstChild(name)
		if foot then
			deco(foot, "Peg", Vector3.new(foot.Size.X + 0.05, 0.35, foot.Size.Z + 0.05), WOOD, CFrame.new(0, -foot.Size.Y / 2 + 0.15, 0))
		end
	end
	for _, d in ipairs(dummy:GetChildren()) do
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end
end

local function spawnDummy(folder, cframe, index)
	local ok, dummy = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok or not dummy then
		warn("[TestDummies] could not create dummy:", dummy)
		return
	end
	dummy.Name = "SpinDummy" .. index
	dummy:PivotTo(cframe)
	pcall(dress, dummy)
	local humanoid = dummy:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.DisplayName = "Training Dummy"
	humanoid.MaxHealth = 150
	humanoid.Health = 150
	dummy.Parent = folder
	humanoid.Died:Connect(function()
		task.wait(SpinConfig.Debug.DummyRespawnTime)
		dummy:Destroy()
		spawnDummy(folder, cframe, index)
	end)
end

function TestDummies.init()
	if not RunService:IsStudio() or not SpinConfig.Debug.SpawnTestDummies then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "SpinTestDummies"
	folder.Parent = workspace
	local base = findSpawn()
	for i = 1, SpinConfig.Debug.DummyCount do
		local offset = CFrame.new((i - (SpinConfig.Debug.DummyCount + 1) / 2) * 8, 3, -30 - i * 6)
		spawnDummy(folder, base * offset * CFrame.Angles(0, math.pi, 0), i)
	end
end

return TestDummies
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX45"><Properties><string name="Name">TuskActs</string></Properties><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">Axl</string><ProtectedString name="Source"><![CDATA[--[[
	Axl  (ServerScriptService.SpinServer.TuskActs.Axl)

	Axl RO: CIVIL WAR. His Stand makes a target's guilt real: the people
	they left behind rise as specters, the things they abandoned fly at them
	and stick, and their guilt wraps them in a membrane that shrinks until it
	crushes them. Water washes guilt away: in the rain the membrane dissolves
	twice as fast. Registered as "Act" 12 so it reuses the Tusk ability system.
	  Passive   GUILT: every hit he lands marks the target (up to 5 stacks,
	            fading 8 s after the last); his moves feed on it
	  M1        GUILT COMBO: strikes with Civil War's long arms (+1 guilt a hit)
	  Ability 1 GUILT SPECTERS: specters rise from his shadow and HUNT the
	            nearest enemy, grabbing on contact (more guilt = more specters)
	  Ability 2 ABANDONED JUNK: a volley of junk that sticks to whoever it
	            hits: each stuck piece slows them and adds guilt
	  Ability 3 GUILT MEMBRANE: wraps the nearest enemy; it squeezes harder
	            with every tick and USES UP their guilt to squeeze harder
	            still; at max guilt they're flattened
	  Ultimate  CIVIL WAR: the junkyard rises round him: everyone nearby is
	            loaded with guilt, grabbed and engulfed; while it lasts Civil
	            War breaks apart when he's hit (the hit misses, he reforms out
	            of reach); then every membrane crushes shut
Numbers: TuskConfig.Axl. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Axl = {}
local cfg = TuskConfig.Axl
local ACT = 12

local stick -- (defined with the junk)

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

local function now()
	return workspace:GetServerTimeNow()
end

-- Water washes guilt away: shorter in the rain.
local function rainy()
	return game:GetService("ReplicatedStorage"):GetAttribute("SpinRaining") == true
end

---------------------------------------------------------------------------
-- GUILT (passive): stacks on the target, fading after a while
---------------------------------------------------------------------------
local function guiltOf(target)
	local g = target:GetAttribute("Guilt") or 0
	if g > 0 and os.clock() - (target:GetAttribute("GuiltAt") or 0) > cfg.Guilt.FadeAfter then
		return 0
	end
	return g
end

local function setGuilt(S, target, g)
	g = math.clamp(g, 0, cfg.Guilt.Max)
	local stamp = os.clock()
	target:SetAttribute("Guilt", g > 0 and g or nil)
	target:SetAttribute("GuiltAt", g > 0 and stamp or nil)
	S.fx("Ability", { Act = ACT, Move = "Guilt", Phase = "Mark", Target = target, Stacks = g })
	if g > 0 then
		task.delay(cfg.Guilt.FadeAfter + 0.05, function()
			if target.Parent and target:GetAttribute("GuiltAt") == stamp then
				target:SetAttribute("Guilt", nil)
				target:SetAttribute("GuiltAt", nil)
				S.fx("Ability", { Act = ACT, Move = "Guilt", Phase = "Mark", Target = target, Stacks = 0 })
			end
		end)
	end
end

local function addGuilt(S, target, n)
	setGuilt(S, target, guiltOf(target) + (n or 1))
end

-- Uses up all their guilt; returns how much there was.
local function consumeGuilt(S, target)
	local g = guiltOf(target)
	if g > 0 then
		setGuilt(S, target, 0)
	end
	return g
end

-- Every hit he lands adds guilt: S with a hit() that marks the target.
local function guiltyHits(S)
	return setmetatable({
		hit = function(player, target, info)
			local ok = S.hit(player, target, info)
			if ok then
				addGuilt(S, target, 1)
			end
			return ok
		end,
	}, { __index = S })
end

function Axl.M1(S, player, state, aim)
	Moves.m1(guiltyHits(S), player, state, aim, cfg.M1, ACT)
end

local function slow(S, target, key, multiplier, seconds)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	S.Adapter.setMoveModifier(humanoid, key, multiplier)
	local token = tostring({})
	target:SetAttribute(key .. "Token", token)
	task.delay(seconds, function()
		if humanoid.Parent and target:GetAttribute(key .. "Token") == token then
			S.Adapter.setMoveModifier(humanoid, key, nil)
			target:SetAttribute(key .. "Token", nil)
		end
	end)
end

-- Nearest enemy in a cone in front.
local function targetInCone(S, character, root, direction, range, cone)
	local look = Moves.flat(direction)
	local cosLimit = math.cos(math.rad(cone / 2))
	local best, bestD
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, range, 8)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr and S.Adapter.canBeHit(nil, target) then
			local offset = tr.Position - root.Position
			local f = Vector3.new(offset.X, 0, offset.Z)
			if (f.Magnitude < 1 or f.Unit:Dot(look) >= cosLimit) and S.Hitbox.lineOfSight(root.Position, tr.Position, { character, target }) then
				if not bestD or offset.Magnitude < bestD then
					best, bestD = target, offset.Magnitude
				end
			end
		end
	end
	return best
end

---------------------------------------------------------------------------
-- The membrane (Guilt Membrane and the ultimate): slowed, squeezed harder
-- each tick, then crushed. Rain halves how long it lasts.
---------------------------------------------------------------------------
local function engulf(S, player, target, opts)
	local t = opts.Time * (rainy() and (opts.RainMultiplier or 0.5) or 1)
	local untilT = now() + t
	local token = tostring({}) -- only this membrane's squeezes may act (a newer one replaces it)
	target:SetAttribute("GuiltMembraneUntil", untilT)
	target:SetAttribute("GuiltMembraneCast", token)
	slow(S, target, "GuiltMembrane", opts.Slow, t)
	local ticks = math.max(1, math.floor(t / opts.Tick))
	for i = 1, ticks do
		task.delay(i * opts.Tick, function()
			local tr = target:FindFirstChild("HumanoidRootPart")
			-- (Ends early if the membrane was cleared, e.g. a new life.)
			if not tr or target:GetAttribute("GuiltMembraneCast") ~= token or not target:GetAttribute("GuiltMembraneUntil") then
				return
			end
			local last = i == ticks
			local damage = (opts.TickDamage + (opts.TickGrowth or 0) * (i - 1)) + (last and (opts.FinalDamage or 0) or 0)
			S.hit(player, target, {
				Damage = damage,
				Stun = last and (opts.FinalStun or 0.5) or 0.3,
				Knockback = last and (opts.FinalKnockback or 0) or 0,
				Launch = last and opts.FinalLaunch or nil,
				Direction = Vector3.new(0, -1, 0),
				Position = tr.Position,
				Source = opts.Source,
			})
			if last then
				target:SetAttribute("GuiltMembraneUntil", nil)
			end
		end)
	end
	return t
end

---------------------------------------------------------------------------
-- GUILT SPECTERS: they rise from his shadow and hunt the nearest enemy
---------------------------------------------------------------------------
local nextSpecter = 0

local function nearestEnemy(S, character, root, range)
	local best, bestD
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, range, 8)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr and S.Adapter.canBeHit(nil, target) then
			local d = (tr.Position - root.Position).Magnitude
			if not bestD or d < bestD then
				best, bestD = target, d
			end
		end
	end
	return best
end

local function guiltSpecters(S, player, state)
	local c = cfg.GuiltSpecter
	if not ready(S, player, state, "GuiltSpecter", 1) then
		return
	end
	S.startCooldown(player, state, "GuiltSpecter", c.Cooldown, 1)
	S.lock(state, c.Windup + 0.25)
	local character = alive(S, player)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "GuiltSpecter", Phase = "Cast", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local target = nearestEnemy(S, char, r, c.Range)
		if not target then
			S.startCooldown(player, state, "GuiltSpecter", c.MissCooldown, 1)
			S.fx("Ability", { Character = char, Act = ACT, Move = "GuiltSpecter", Phase = "Miss" })
			return
		end
		-- More guilt on them, more of their past comes back for them.
		local count = math.min(c.MaxCount, c.Count + math.floor(guiltOf(target) / c.GuiltPerExtra))
		local guilty = guiltyHits(S)
		for i = 1, count do
			nextSpecter = nextSpecter + 1
			local id = nextSpecter
			local side = (i - (count + 1) / 2) * c.Spread
			local pos = (r.CFrame * CFrame.new(side, 0, 1.5)).Position
			S.fx("Ability", { Character = char, Act = ACT, Move = "GuiltSpecter", Phase = "Spawn", Id = id, From = pos, Target = target, Speed = c.Speed, Life = c.Life, Delay = (i - 1) * 0.15 })
			task.delay((i - 1) * 0.15, function()
				local born = os.clock()
				local step = 0.1
				local function tick()
					local tr = target.Parent and target:FindFirstChild("HumanoidRootPart")
					local hum = target:FindFirstChildOfClass("Humanoid")
					if not tr or not hum or hum.Health <= 0 or os.clock() - born > c.Life or state.Life ~= life then
						S.fx("Ability", { Act = ACT, Move = "GuiltSpecter", Phase = "Fade", Id = id, Position = pos })
						return
					end
					local to = tr.Position - pos
					if to.Magnitude <= c.GrabRadius then
						guilty.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Launch = c.Launch, Direction = to, Position = tr.Position, Source = "AxlSpecter" })
						S.fx("Ability", { Act = ACT, Move = "GuiltSpecter", Phase = "Grab", Id = id, Position = tr.Position, Target = target })
						return
					end
					pos = pos + to.Unit * math.min(c.Speed * step, to.Magnitude)
					task.delay(step, tick)
				end
				tick()
			end)
		end
	end)
end

---------------------------------------------------------------------------
-- ABANDONED JUNK
---------------------------------------------------------------------------
local JUNK = { "Crate", "Wheel", "Chair", "Bottle", "Boot", "Lamp" }

-- Junk stuck to a target: each piece slows them a bit more until it falls off.
stick = function(S, target, style, c)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local n = (target:GetAttribute("JunkStuck") or 0) + 1
	target:SetAttribute("JunkStuck", n)
	S.Adapter.setMoveModifier(humanoid, "GuiltJunk", math.max(0.5, 1 - c.SlowPerPiece * n))
	S.fx("Ability", { Act = ACT, Move = "AbandonedJunk", Phase = "Stick", Target = target, Style = style, Duration = c.StickTime })
	task.delay(c.StickTime, function()
		local left = math.max(0, (target:GetAttribute("JunkStuck") or 1) - 1)
		target:SetAttribute("JunkStuck", left > 0 and left or nil)
		if humanoid.Parent then
			S.Adapter.setMoveModifier(humanoid, "GuiltJunk", left > 0 and math.max(0.5, 1 - c.SlowPerPiece * left) or nil)
		end
	end)
end

local function abandonedJunk(S, player, state, aim)
	local c = cfg.AbandonedJunk
	if not ready(S, player, state, "AbandonedJunk", 2) then
		return
	end
	S.startCooldown(player, state, "AbandonedJunk", c.Cooldown, 2)
	S.lock(state, c.Startup + 0.25)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local flat = Moves.flat(direction)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "AbandonedJunk", Phase = "Gather", Startup = c.Startup, Direction = flat, Count = c.Count })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local _, _, r = alive(S, player)
		local hits = {}
		for i = 1, c.Count do
			local t = c.Count == 1 and 0 or (i - 1) / (c.Count - 1) - 0.5
			local dir = (CFrame.lookAt(Vector3.new(), direction) * CFrame.Angles(math.rad((i % 2) * 4), math.rad(-t * c.Spread), 0)).LookVector
			local side = CFrame.lookAt(Vector3.new(), flat).RightVector
			local origin = r.Position + Vector3.new(0, 1.5 + (i % 3) * 0.6, 0) + flat * 2 + side * t * 5
			S.fireJunk(player, state, {
				Origin = origin,
				Direction = dir,
				Speed = c.Speed,
				Radius = c.Radius,
				Range = c.Range,
				Style = JUNK[(i - 1) % #JUNK + 1],
				OnHit = function(target, position)
					hits[target] = (hits[target] or 0) + 1
					if hits[target] <= c.MaxHitsPerTarget and S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Direction = dir, Position = position, Source = "AxlJunk" }) then
						-- It sticks to them: slower with every piece, and more guilt.
						addGuilt(S, target, 1)
						stick(S, target, JUNK[(i - 1) % #JUNK + 1], c)
					end
				end,
			})
		end
	end)
end

---------------------------------------------------------------------------
-- GUILT MEMBRANE
---------------------------------------------------------------------------
local function guiltMembrane(S, player, state, aim)
	local c = cfg.GuiltMembrane
	if not ready(S, player, state, "GuiltMembrane", 3) then
		return
	end
	S.startCooldown(player, state, "GuiltMembrane", c.Cooldown, 3)
	S.lock(state, c.Windup + 0.25)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "GuiltMembrane", Phase = "Cast", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local target = targetInCone(S, char, r, direction, c.Range, c.Cone)
		local tr = target and target:FindFirstChild("HumanoidRootPart")
		if not tr or not S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Direction = direction, Position = tr.Position, Source = "AxlMembrane" }) then
			S.startCooldown(player, state, "GuiltMembrane", c.MissCooldown, 3)
			S.fx("Ability", { Character = char, Act = ACT, Move = "GuiltMembrane", Phase = "Miss", Direction = direction })
			return
		end
		-- It feeds on their guilt (and uses it up): harder squeezes; at max guilt, flattened.
		local g = consumeGuilt(S, target)
		local mult = 1 + c.PerGuilt * g
		local flatten = g >= cfg.Guilt.Max
		local t = engulf(S, player, target, {
			Time = c.Time, Tick = c.Tick, TickDamage = c.TickDamage * mult, TickGrowth = c.TickGrowth * mult,
			Slow = c.Slow, FinalDamage = c.FinalDamage * mult, FinalStun = flatten and c.FlattenStun or 0.6,
			FinalLaunch = flatten and c.FlattenLaunch or nil, RainMultiplier = c.RainMultiplier, Source = "AxlMembrane",
		})
		S.fx("Ability", { Character = char, Act = ACT, Move = "GuiltMembrane", Phase = "Engulf", Targets = { target }, Duration = t, Rain = rainy(), Guilt = g, Flatten = flatten })
	end)
end

function Axl.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		guiltSpecters(S, player, state)
	elseif slot == 2 then
		abandonedJunk(S, player, state, aim)
	elseif slot == 3 then
		guiltMembrane(S, player, state, aim)
	end
end

---------------------------------------------------------------------------
-- CIVIL WAR (ultimate)
---------------------------------------------------------------------------
local scatters = setmetatable({}, { __mode = "k" }) -- [character] = break-apart function while it lasts

local function registerScatter(S)
	if S.Adapter.DodgeHandlers and not S.Adapter.DodgeHandlers.GuiltScatter then
		S.Adapter.DodgeHandlers.GuiltScatter = function(attackerPlayer, target, info)
			local f = scatters[target]
			if f then
				f(attackerPlayer, info)
			end
		end
	end
end

function Axl.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	registerScatter(S)
	local character, _, root = alive(S, player)
	local life = state.Life
	local center = Moves.groundBelow(root.Position, { character })
	S.lock(state, u.Windup + 0.3)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Rise", Windup = u.Windup, Position = center, Radius = u.Radius, Specters = u.Specters })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		S.finishUltimate(player, state)
		local up = center + Vector3.new(0, 2.5, 0)
		local caught = {}
		for _, target in ipairs(S.Hitbox.inRadius(character, up, u.Radius, 8)) do
			local tr = target:FindFirstChild("HumanoidRootPart")
			if tr and S.hit(player, target, { Damage = u.SpecterDamage, Stun = u.SpecterStun, Knockback = 0, Direction = tr.Position - center, Position = tr.Position, Source = "AxlCivilWar" }) then
				table.insert(caught, target)
			end
		end
		local t = u.Time * (rainy() and u.RainMultiplier or 1)
		local perGuilt = cfg.GuiltMembrane.PerGuilt
		for _, target in ipairs(caught) do
			-- Loaded with guilt, then the crush feeds on all of it.
			addGuilt(S, target, u.GuiltAdded)
			local mult = 1 + perGuilt * consumeGuilt(S, target)
			engulf(S, player, target, {
				Time = u.Time, Tick = u.Tick, TickDamage = u.TickDamage, Slow = u.Slow,
				FinalDamage = (u.FinalDamage - u.TickDamage) * mult, FinalStun = u.FinalStun, FinalKnockback = u.FinalKnockback, FinalLaunch = u.FinalLaunch,
				RainMultiplier = u.RainMultiplier, Source = "AxlCivilWar",
			})
		end
		S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Engulf", Targets = caught, Duration = t, Position = center, Radius = u.Radius, Rain = rainy() })
		-- While it lasts, a hit on him makes Civil War break apart: the hit misses.
		character:SetAttribute("GuiltScatter", true)
		scatters[character] = function(attackerPlayer)
			scatters[character] = nil
			character:SetAttribute("GuiltScatter", nil)
			local attacker = attackerPlayer and attackerPlayer.Character
			local ar = attacker and attacker:FindFirstChild("HumanoidRootPart")
			local _, _, r = alive(S, player)
			if not r then
				return
			end
			local away = ar and Moves.flat(r.Position - ar.Position) or r.CFrame.LookVector * -1
			local spot = Moves.safeStep(character, r, away, u.ScatterDistance) or r.Position
			local iframes = S.Adapter.Settings.IFrameAttribute
			character:SetAttribute(iframes, true)
			S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Scatter", From = r.Position, To = spot })
			character:PivotTo(CFrame.lookAt(spot, spot - away))
			task.delay(0.4, function()
				character:SetAttribute(iframes, nil)
			end)
		end
		task.delay(t + 0.05, function()
			scatters[character] = nil
			if character.Parent then
				character:SetAttribute("GuiltScatter", nil)
			end
			if state.Life == life then
				S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Crush", Position = center, Radius = u.Radius, Targets = caught })
			end
		end)
	end)
end

function Axl.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute("GuiltScatter", nil)
		scatters[state.Character] = nil
	end
end

return Axl
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Blackmore</string><ProtectedString name="Source"><![CDATA[--[[
	Blackmore  (ServerScriptService.SpinServer.TuskActs.Blackmore)

	Blackmore: CATCH THE RAINBOW. His Stand freezes raindrops in mid-air: he
	cuts with them, walks on them, and when he's hit in the rain he bursts
	into raindrops. Registered as "Act" 11 so it reuses the Tusk ability system.
	  M1        RAINDROP COMBO: shard strikes; the finisher fans out hardened drops
	  Ability 1 RAINDROP BLADES: drops freeze in a fan in front of him, then
	            fire as a volley (each enemy takes at most a few)
	  Ability 2 RAINDROP STEP: he dashes along a stair of frozen drops (can't
	            be hit), leaving a line of hanging drops that cut anyone who
	            walks through it for a few seconds
	  Ability 3 RAINDROP CAGE: a dome of frozen drops round the nearest enemy:
	            they're slowed, and every time they move the drops cut them
	  Ultimate  CATCH THE RAINBOW: a downpour round him (a rainbow overhead):
	            the rain slices every enemy inside, the first hit on him makes
	            him scatter into raindrops (cancelled, he reappears out of
	            reach), then every frozen drop fires inward at once
	Numbers: TuskConfig.Blackmore. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Blackmore = {}
local cfg = TuskConfig.Blackmore
local ACT = 11

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

local function now()
	return workspace:GetServerTimeNow()
end

function Blackmore.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, ACT)
end

local function slow(S, target, key, multiplier, seconds)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	S.Adapter.setMoveModifier(humanoid, key, multiplier)
	local token = tostring({})
	target:SetAttribute(key .. "Token", token)
	task.delay(seconds, function()
		if humanoid.Parent and target:GetAttribute(key .. "Token") == token then
			S.Adapter.setMoveModifier(humanoid, key, nil)
			target:SetAttribute(key .. "Token", nil)
		end
	end)
end

---------------------------------------------------------------------------
-- RAINDROP BLADES
---------------------------------------------------------------------------
local function raindropBlades(S, player, state, aim)
	local c = cfg.RaindropBlades
	if not ready(S, player, state, "RaindropBlades", 1) then
		return
	end
	S.startCooldown(player, state, "RaindropBlades", c.Cooldown, 1)
	S.lock(state, c.Startup + 0.25)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local flat = Moves.flat(direction)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "RaindropBlades", Phase = "Freeze", Startup = c.Startup, Direction = flat, Drops = c.Drops, Spread = c.Spread })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local hits = {}
		for i = 1, c.Drops do
			local t = c.Drops == 1 and 0 or (i - 1) / (c.Drops - 1) - 0.5
			local dir = (CFrame.lookAt(Vector3.new(), direction) * CFrame.Angles(0, math.rad(-t * c.Spread), 0)).LookVector
			local origin = r.Position + Vector3.new(0, 1, 0) + flat * 2.5 + (CFrame.lookAt(Vector3.new(), flat).RightVector * t * 4)
			S.fireRain(player, state, {
				Origin = origin,
				Direction = dir,
				Speed = c.Speed,
				Radius = c.Radius,
				Range = c.Range,
				OnHit = function(target, position)
					hits[target] = (hits[target] or 0) + 1
					if hits[target] <= c.MaxHitsPerTarget then
						S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Direction = dir, Position = position, Source = "BlackmoreBlades" })
					end
				end,
			})
		end
	end)
end

---------------------------------------------------------------------------
-- RAINDROP STEP
---------------------------------------------------------------------------
local function raindropStep(S, player, state, aim)
	local c = cfg.RaindropStep
	if not ready(S, player, state, "RaindropStep", 2) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local destination = Moves.safeStep(character, root, direction, c.Distance)
	if not destination then
		S.tell(player, "Denied", { Reason = "Blocked" })
		return
	end
	S.startCooldown(player, state, "RaindropStep", c.Cooldown, 2)
	S.lock(state, c.Windup + c.Travel + 0.1)
	local life = state.Life
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local from = r.Position
		local to = Moves.safeStep(char, r, direction, c.Distance) or destination
		local iframes = S.Adapter.Settings.IFrameAttribute
		char:SetAttribute(iframes, true)
		S.fx("Ability", { Character = char, Act = ACT, Move = "RaindropStep", Phase = "Step", From = from, To = to, Direction = direction, Travel = c.Travel, TrailTime = c.TrailTime })
		task.delay(c.Travel, function()
			char:SetAttribute(iframes, nil)
			if char.Parent and state.Life == life then
				char:PivotTo(CFrame.lookAt(to, to + direction))
			end
		end)
		-- The hanging drops cut anyone who walks through the line.
		local mid = (from + to) / 2
		local box = CFrame.lookAt(mid, mid + direction)
		local size = Vector3.new(c.TrailWidth, 6, (to - from).Magnitude + 2)
		local lastHit = {}
		for i = 1, math.floor(c.TrailTime / c.TrailTick) do
			task.delay(i * c.TrailTick, function()
				if not player.Character then
					return
				end
				for _, target in ipairs(S.Hitbox.inBox(player.Character, box, size, 6)) do
					local tr = target:FindFirstChild("HumanoidRootPart")
					local t = os.clock()
					if tr and t - (lastHit[target] or -math.huge) >= c.TrailHitEvery then
						lastHit[target] = t
						S.hit(player, target, { Damage = c.TrailDamage, Stun = c.TrailStun, Knockback = 0, Direction = direction, Position = tr.Position, Source = "BlackmoreStep" })
					end
				end
			end)
		end
	end)
end

---------------------------------------------------------------------------
-- RAINDROP CAGE
---------------------------------------------------------------------------
local function targetInCone(S, character, root, direction, range, cone)
	local look = Moves.flat(direction)
	local cosLimit = math.cos(math.rad(cone / 2))
	local best, bestD
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, range, 8)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr and S.Adapter.canBeHit(nil, target) then
			local offset = tr.Position - root.Position
			local f = Vector3.new(offset.X, 0, offset.Z)
			if (f.Magnitude < 1 or f.Unit:Dot(look) >= cosLimit) and S.Hitbox.lineOfSight(root.Position, tr.Position, { character, target }) then
				if not bestD or offset.Magnitude < bestD then
					best, bestD = target, offset.Magnitude
				end
			end
		end
	end
	return best
end

local function raindropCage(S, player, state, aim)
	local c = cfg.RaindropCage
	if not ready(S, player, state, "RaindropCage", 3) then
		return
	end
	S.startCooldown(player, state, "RaindropCage", c.Cooldown, 3)
	S.lock(state, c.Windup + 0.25)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "RaindropCage", Phase = "Startup", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local target = targetInCone(S, char, r, direction, c.Range, c.Cone)
		local tr = target and target:FindFirstChild("HumanoidRootPart")
		if not tr or not S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Direction = direction, Position = tr.Position, Source = "BlackmoreCage" }) then
			S.startCooldown(player, state, "RaindropCage", c.MissCooldown, 3)
			S.fx("Ability", { Character = char, Act = ACT, Move = "RaindropCage", Phase = "Miss", Direction = direction })
			return
		end
		local untilT = now() + c.CageTime
		target:SetAttribute("RainCagedUntil", untilT)
		slow(S, target, "RainCage", c.Slow, c.CageTime)
		S.fx("Ability", { Character = char, Act = ACT, Move = "RaindropCage", Phase = "Cage", Target = target, Duration = c.CageTime })
		-- Every tick they've moved, the drops cut them.
		local last = tr.Position
		for i = 1, math.floor(c.CageTime / c.Tick) do
			task.delay(i * c.Tick, function()
				local t = target:FindFirstChild("HumanoidRootPart")
				if not t or (target:GetAttribute("RainCagedUntil") or 0) < untilT - 0.01 then
					return
				end
				local moved = (t.Position - last).Magnitude
				last = t.Position
				if moved > c.MoveThreshold then
					S.hit(player, target, { Damage = c.MoveDamage, Stun = 0.2, Knockback = 0, Direction = t.Position - r.Position, Position = t.Position, Source = "BlackmoreCage" })
					S.fx("Ability", { Act = ACT, Move = "RaindropCage", Phase = "Cut", Position = t.Position })
				end
			end)
		end
	end)
end

function Blackmore.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		raindropBlades(S, player, state, aim)
	elseif slot == 2 then
		raindropStep(S, player, state, aim)
	elseif slot == 3 then
		raindropCage(S, player, state, aim)
	end
end

---------------------------------------------------------------------------
-- CATCH THE RAINBOW (ultimate)
---------------------------------------------------------------------------
local scatters = setmetatable({}, { __mode = "k" }) -- [character] = scatter function while the storm is up

local function registerScatter(S)
	if S.Adapter.DodgeHandlers and not S.Adapter.DodgeHandlers.RainScatter then
		S.Adapter.DodgeHandlers.RainScatter = function(attackerPlayer, target, info)
			local f = scatters[target]
			if f then
				f(attackerPlayer, info)
			end
		end
	end
end

function Blackmore.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	registerScatter(S)
	local character, _, root = alive(S, player)
	local life = state.Life
	local center = root.Position
	S.lock(state, u.Windup + 0.3)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Start", Windup = u.Windup, Position = center, Radius = u.Radius, Duration = u.Duration })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		S.finishUltimate(player, state)
		character:SetAttribute("RainStormUntil", now() + u.Duration)
		-- In the rain, the first hit on him scatters him into raindrops.
		character:SetAttribute("RainScatter", true)
		scatters[character] = function(attackerPlayer)
			scatters[character] = nil
			character:SetAttribute("RainScatter", nil)
			local attacker = attackerPlayer and attackerPlayer.Character
			local ar = attacker and attacker:FindFirstChild("HumanoidRootPart")
			local _, _, r = alive(S, player)
			if not r then
				return
			end
			local away = ar and Moves.flat(r.Position - ar.Position) or r.CFrame.LookVector * -1
			local spot = Moves.safeStep(character, r, away, u.ScatterDistance) or r.Position
			local iframes = S.Adapter.Settings.IFrameAttribute
			character:SetAttribute(iframes, true)
			S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Scatter", From = r.Position, To = spot })
			character:PivotTo(CFrame.lookAt(spot, spot - away))
			task.delay(0.4, function()
				character:SetAttribute(iframes, nil)
			end)
		end
		for i = 1, math.floor(u.Duration / u.Tick) - 1 do
			task.delay(i * u.Tick, function()
				if state.Life ~= life then
					return
				end
				Moves.aoe(S, player, center + Vector3.new(0, 2, 0), u.Radius, { Damage = u.TickDamage, Stun = u.TickStun, Knockback = 0, Source = "BlackmoreRain" }, 8)
			end)
		end
		task.delay(u.Duration, function()
			scatters[character] = nil
			if character.Parent then
				character:SetAttribute("RainScatter", nil)
				character:SetAttribute("RainStormUntil", nil)
			end
			if state.Life ~= life then
				return
			end
			-- Every frozen drop fires inward at once.
			Moves.aoe(S, player, center + Vector3.new(0, 2, 0), u.Radius, { Damage = u.BurstDamage, Stun = u.BurstStun, Knockback = u.BurstKnockback, Launch = u.BurstLaunch, Source = "BlackmoreRain" }, 8)
			S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Burst", Position = center, Radius = u.Radius })
		end)
	end)
end

function Blackmore.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute("RainScatter", nil)
		state.Character:SetAttribute("RainStormUntil", nil)
		scatters[state.Character] = nil
	end
end

return Blackmore
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">DiegoBrando</string><ProtectedString name="Source"><![CDATA[--[[
	DiegoBrando  (ServerScriptService.SpinServer.TuskActs.DiegoBrando)

	Diego Brando: SCARY MONSTERS (dinosaur Stand). Registered as "Act" 6 so it
	reuses the Tusk ability system (cooldowns, HUD, ultimate meter, input).
	  M1        CLAW COMBO: claw, claw, tail whip, bite (area). Stronger and
	            faster while transformed.
	  Ability 1 RAPTOR POUNCE: crouch, then leap at the nearest enemy in front
	            and land on them (bite + area hit). Hits harder transformed.
	  Ability 2 DINO INFECTION: an infecting bite. Scales spread over the
	            victim, then they TURN INTO A DINOSAUR (in their own avatar's
	            colours) that Diego commands for ThrallTime seconds: it heels
	            beside him and bites nearby enemies; press the move again to
	            send it after whoever Diego aims at. 25 s cooldown on a hit.
	  Ability 3 SCARY MONSTERS: turn into a full raptor for a while: faster,
	            stronger claws, and KINETIC VISION (moving enemies glow for
	            Diego). Press again to change back early.
	  Ultimate  RAPTOR PACK: a roar that stuns everyone close, then a pack of
	            raptors charges out in a fan, mauling everything in their path
	Numbers: TuskConfig.Diego. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Diego = {}
local cfg = TuskConfig.Diego
local ACT = 6

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function Diego.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, state.DinoMode and cfg.DinoM1 or cfg.M1, ACT)
end

---------------------------------------------------------------------------
-- SCARY MONSTERS (transformation)
---------------------------------------------------------------------------
local function revert(S, player, state, startCooldown)
	if not state.DinoMode then
		return
	end
	state.DinoMode = nil
	local character = state.Character
	if character then
		character:SetAttribute("DinoMode", nil)
		character:SetAttribute("DinoModeUntil", nil)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			S.Adapter.setMoveModifier(humanoid, "ScaryMonsters", nil)
		end
		S.fx("Ability", { Character = character, Act = ACT, Move = "ScaryMonsters", Phase = "Revert" })
	end
	if startCooldown then
		S.startCooldown(player, state, "ScaryMonsters", cfg.ScaryMonsters.Cooldown, 3)
	end
end

local function scaryMonsters(S, player, state)
	local c = cfg.ScaryMonsters
	if state.DinoMode then
		revert(S, player, state, true) -- press again: change back early
		return
	end
	if not ready(S, player, state, "ScaryMonsters", 3) then
		return
	end
	local character, humanoid = alive(S, player)
	local token = {}
	state.DinoMode = token
	S.lock(state, c.Transform)
	character:SetAttribute("Armored", true)
	S.fx("Ability", { Character = character, Act = ACT, Move = "ScaryMonsters", Phase = "Transform", Duration = c.Transform })
	task.delay(c.Transform * 0.6, function()
		if state.DinoMode ~= token or not character.Parent then
			return
		end
		character:SetAttribute("DinoMode", true)
		character:SetAttribute("DinoModeUntil", workspace:GetServerTimeNow() + c.Duration)
		S.Adapter.setMoveModifier(humanoid, "ScaryMonsters", c.SpeedMultiplier)
	end)
	task.delay(c.Transform, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
	end)
	task.delay(c.Duration + c.Transform * 0.6, function()
		if state.DinoMode == token then
			revert(S, player, state, true)
		end
	end)
end

---------------------------------------------------------------------------
-- RAPTOR POUNCE
---------------------------------------------------------------------------
local function raptorPounce(S, player, state, aim)
	local c = cfg.RaptorPounce
	if not ready(S, player, state, "RaptorPounce", 1) then
		return
	end
	S.startCooldown(player, state, "RaptorPounce", c.Cooldown, 1)
	S.lock(state, c.Windup + c.LeapTime + 0.2)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "RaptorPounce", Phase = "Startup", Windup = c.Windup, Direction = direction })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		-- Leap at the nearest enemy in front, or straight ahead.
		local distance = c.Distance
		local target = Moves.findTarget(S, char, r, c.Distance, c.TargetCone, direction)
		local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
		if targetRoot then
			local offset = targetRoot.Position - r.Position
			local flatOffset = Vector3.new(offset.X, 0, offset.Z)
			if flatOffset.Magnitude > 0.5 then
				direction = flatOffset.Unit
				distance = math.max(4, flatOffset.Magnitude - 2.5)
			end
		end
		local destination = Moves.safeStep(char, r, direction, distance)
		local from = r.Position
		local to = destination or from -- blocked: a short hop in place
		-- The leap itself is flown by Diego's own client (it owns his physics, so the
		-- arc is smooth for everyone). The server decides where it lands and hits there.
		S.fx("Ability", { Character = char, Act = ACT, Move = "RaptorPounce", Phase = "Leap", From = from, To = to, Time = c.LeapTime, Height = c.LeapHeight, Direction = direction })
		-- (a little extra time so a client that started the leap late isn't corrected mid-air)
		task.delay(c.LeapTime + (c.LandGrace or 0.12), function()
			if not S.stillValid(player, state, life) then
				return -- stunned or died mid-leap: no landing hit
			end
			local _, _, rr = alive(S, player)
			if not rr then
				return
			end
			-- If the client didn't arrive (lag, blocked), put Diego where the leap ends.
			if (rr.Position - to).Magnitude > 10 then
				char:PivotTo(CFrame.lookAt(to, to + direction))
			end
			local damage = c.Damage * (state.DinoMode and cfg.ScaryMonsters.PounceMultiplier or 1)
			local landAt = to + direction * 1.5
			local count = Moves.aoe(S, player, landAt, c.HitRadius, { Damage = damage, Stun = c.Stun, Knockback = c.Knockback, Direction = direction, Source = "DiegoPounce" }, 4)
			S.fx("Ability", { Character = char, Act = ACT, Move = "RaptorPounce", Phase = "Land", Position = to, Direction = direction, Radius = c.HitRadius, Hit = count > 0 })
		end)
	end)
end

---------------------------------------------------------------------------
-- DINO INFECTION: the bite turns the victim into a dinosaur (in their own
-- avatar's colours, drawn by the clients) that Diego commands for a while.
---------------------------------------------------------------------------
local Players = game:GetService("Players")

local function releaseThrall(S, player, state)
	local thrall = state.Thrall
	if not thrall then
		return
	end
	state.Thrall = nil
	local target = thrall.Target
	if target and target.Parent then
		target:SetAttribute("DinoThrall", nil)
		target:SetAttribute("DinoThrallUntil", nil)
		target:SetAttribute("DinoInfected", nil)
		local humanoid = target:FindFirstChildOfClass("Humanoid")
		local root = target:FindFirstChild("HumanoidRootPart")
		if humanoid then
			S.Adapter.setMoveModifier(humanoid, "DinoThrall", nil)
			if root then
				humanoid:MoveTo(root.Position)
			end
		end
		-- Hand movement back to the player who owns this character.
		if root and thrall.Player then
			pcall(function()
				root:SetNetworkOwner(thrall.Player)
			end)
		end
		S.fx("Ability", { Act = ACT, Move = "DinoInfection", Phase = "Release", Target = target })
	end
	if state.Character then
		state.Character:SetAttribute("ThrallUntil", nil)
	end
end

-- Pick the thrall's prey: Diego's command target, else the nearest enemy close by.
local function preyFor(S, player, thrall, c)
	local forced = thrall.Command
	if forced and forced.Until > os.clock() and forced.Target.Parent and S.Adapter.canBeHit(player, forced.Target) then
		return forced.Target, true
	end
	thrall.Command = nil
	local tr = thrall.Target:FindFirstChild("HumanoidRootPart")
	if not tr then
		return nil
	end
	local best, bestDistance
	for _, enemy in ipairs(S.Hitbox.inRadius(player.Character, tr.Position, c.ThrallAggroRange, 6)) do
		if enemy ~= thrall.Target and S.Adapter.canBeHit(player, enemy) then
			local er = enemy:FindFirstChild("HumanoidRootPart")
			local d = er and (er.Position - tr.Position).Magnitude
			if d and (not bestDistance or d < bestDistance) then
				best, bestDistance = enemy, d
			end
		end
	end
	return best, false
end

local function enthrall(S, player, state, target, c)
	releaseThrall(S, player, state)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	local root = target:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end
	local token = {}
	local thrall = { Target = target, Player = Players:GetPlayerFromCharacter(target), Token = token, NextBite = 0 }
	state.Thrall = thrall
	local untilT = workspace:GetServerTimeNow() + c.ThrallTime
	-- 1) the infection spreads (scales grow), 2) they become a dinosaur.
	target:SetAttribute("DinoInfected", tostring(token))
	task.delay(c.SpreadTime, function()
		if state.Thrall ~= thrall or not target.Parent or humanoid.Health <= 0 then
			return
		end
		target:SetAttribute("DinoThrall", player.UserId)
		target:SetAttribute("DinoThrallUntil", untilT + c.SpreadTime)
		if state.Character then
			state.Character:SetAttribute("ThrallUntil", untilT + c.SpreadTime)
		end
		S.Adapter.setMoveModifier(humanoid, "DinoThrall", c.ThrallSpeed)
		-- The server takes over the body so Diego's commands drive it.
		if thrall.Player then
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
		end
		S.fx("Ability", { Act = ACT, Move = "DinoInfection", Phase = "Turn", Target = target, Position = root.Position })
	end)
	-- Brain: every tick, chase prey (bite when close) or heel beside Diego.
	local ticks = math.floor((c.ThrallTime + c.SpreadTime) / c.ThrallTick)
	for i = 1, ticks do
		task.delay(i * c.ThrallTick, function()
			if state.Thrall ~= thrall or i * c.ThrallTick < c.SpreadTime then
				return
			end
			if not target.Parent or humanoid.Health <= 0 then
				releaseThrall(S, player, state)
				return
			end
			local _, _, diegoRoot = alive(S, player)
			local tr = target:FindFirstChild("HumanoidRootPart")
			if not diegoRoot or not tr then
				releaseThrall(S, player, state)
				return
			end
			local prey, commanded = preyFor(S, player, thrall, c)
			local pr = prey and prey:FindFirstChild("HumanoidRootPart")
			if pr then
				humanoid:MoveTo(pr.Position)
				if (pr.Position - tr.Position).Magnitude <= c.ThrallBiteRange and os.clock() >= thrall.NextBite then
					thrall.NextBite = os.clock() + c.ThrallBiteInterval
					local dir = pr.Position - tr.Position
					S.hit(player, prey, { Damage = commanded and c.CommandDamage or c.ThrallDamage, Stun = 0.45, Knockback = 10, Direction = dir, Position = pr.Position, Source = "DiegoThrall" })
					S.fx("Ability", { Act = ACT, Move = "DinoInfection", Phase = "ThrallBite", Target = target, Position = pr.Position, Direction = dir })
				end
			else
				-- Heel: stay just behind Diego's shoulder.
				local spot = diegoRoot.Position - diegoRoot.CFrame.LookVector * 5 + diegoRoot.CFrame.RightVector * 4
				if (spot - tr.Position).Magnitude > 3 then
					humanoid:MoveTo(spot)
				end
			end
		end)
	end
	task.delay(c.ThrallTime + c.SpreadTime, function()
		if state.Thrall == thrall then
			releaseThrall(S, player, state)
		end
	end)
end

-- While a dinosaur is under control, pressing the move again sends it after
-- whoever Diego is aiming at ("sic 'em").
local function commandThrall(S, player, state, aim, c)
	local character, _, root = alive(S, player)
	local thrall = state.Thrall
	local direction = Moves.flat(S.aim(aim, root))
	local prey = Moves.findTarget(S, character, root, c.CommandRange, c.CommandCone, direction)
	if prey == thrall.Target then
		prey = nil
	end
	if not prey then
		S.tell(player, "Denied", { Reason = "NoTarget" })
		return
	end
	thrall.Command = { Target = prey, Until = os.clock() + c.CommandTime }
	thrall.NextBite = 0
	local pr = prey:FindFirstChild("HumanoidRootPart")
	S.fx("Ability", { Character = character, Act = ACT, Move = "DinoInfection", Phase = "Command", Target = thrall.Target, Prey = prey, Position = pr and pr.Position or root.Position })
end

local function dinoInfection(S, player, state, aim)
	local c = cfg.DinoInfection
	if state.Thrall and state.Thrall.Target:GetAttribute("DinoThrall") then
		commandThrall(S, player, state, aim, c)
		return
	end
	if not ready(S, player, state, "DinoInfection", 2) then
		return
	end
	S.lock(state, c.Windup + 0.35)
	local character = alive(S, player)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "DinoInfection", Phase = "Startup", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local _, _, r = alive(S, player)
		local cf = r.CFrame * CFrame.new(0, 0, -c.HitboxForward)
		local count, hitSet = Moves.boxHit(S, player, cf, c.HitboxSize, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Source = "DiegoInfection" }, 1)
		local victim = next(hitSet)
		if victim then
			S.startCooldown(player, state, "DinoInfection", c.Cooldown, 2)
			enthrall(S, player, state, victim, c)
		else
			S.startCooldown(player, state, "DinoInfection", c.MissCooldown, 2) -- missed: short cooldown
		end
		S.fx("Ability", { Character = character, Act = ACT, Move = "DinoInfection", Phase = "Hit", Position = cf.Position, Hit = count > 0 })
	end)
end

function Diego.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		raptorPounce(S, player, state, aim)
	elseif slot == 2 then
		dinoInfection(S, player, state, aim)
	elseif slot == 3 then
		scaryMonsters(S, player, state)
	end
end

---------------------------------------------------------------------------
-- RAPTOR PACK (ultimate)
---------------------------------------------------------------------------
function Diego.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.lock(state, u.Windup + 0.3)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Roar", Position = root.Position, Radius = u.RoarRadius, Windup = u.Windup, Direction = direction })
	-- The roar: stuns everyone close.
	task.delay(u.Windup * 0.35, function()
		if state.Life ~= life then
			return
		end
		local _, _, r = alive(S, player)
		if r then
			Moves.aoe(S, player, r.Position, u.RoarRadius, { Damage = u.RoarDamage, Stun = u.RoarStun, Knockback = 6, Source = "DiegoRoar" }, 8)
		end
	end)
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		local char, _, r = alive(S, player)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		local raptors = {}
		local bitten = {} -- target -> how many raptors have bitten it
		local maxBites = u.MaxHitsPerTarget or 2
		local baseId = tostring(os.clock()) .. player.UserId
		for i = 1, u.Count do
			local angle = math.rad((i - (u.Count + 1) / 2) * u.Spread)
			local dir = (CFrame.Angles(0, angle, 0) * CFrame.lookAt(Vector3.new(), direction)).LookVector
			dir = Moves.flat(dir)
			local origin = Moves.groundBelow(r.Position + dir * 2, { char })
			raptors[i] = { Id = baseId .. "_" .. i, Origin = origin, Direction = dir, Pos = origin, Traveled = 0, Hit = {}, Done = false }
		end
		local payload = {}
		for i, rp in ipairs(raptors) do
			payload[i] = { Id = rp.Id, Origin = rp.Origin, Direction = rp.Direction }
		end
		S.fx("Ultimate", { Character = char, Act = ACT, Phase = "Release", Raptors = payload, Speed = u.Speed, Range = u.Range })
		local ticks = math.ceil(u.Range / (u.Speed * u.Tick))
		for t = 1, ticks do
			task.delay(t * u.Tick, function()
				for _, rp in ipairs(raptors) do
					if not rp.Done then
						local step = rp.Direction * u.Speed * u.Tick
						local wall = workspace:Raycast(rp.Pos + Vector3.new(0, 2.5, 0), step * 1.2, params)
						rp.Traveled = rp.Traveled + step.Magnitude
						if wall or rp.Traveled >= u.Range then
							rp.Done = true
							S.fx("Ultimate", { Act = ACT, Phase = "RaptorEnd", Id = rp.Id, Position = rp.Pos })
						else
							rp.Pos = Moves.groundBelow(rp.Pos + step, { char })
							for _, target in ipairs(S.Hitbox.inRadius(player.Character, rp.Pos + Vector3.new(0, 2.5, 0), u.HitRadius, 4)) do
								if not rp.Hit[target] and (bitten[target] or 0) < maxBites and S.Adapter.canBeHit(player, target) then
									rp.Hit[target] = true
									bitten[target] = (bitten[target] or 0) + 1
									local tr = target:FindFirstChild("HumanoidRootPart")
									S.hit(player, target, { Damage = u.Damage, Stun = u.Stun, Knockback = u.Knockback, Launch = u.Launch, Direction = rp.Direction, Position = tr and tr.Position or rp.Pos, Source = "DiegoRaptorPack" })
									S.fx("Ultimate", { Act = ACT, Phase = "RaptorBite", Id = rp.Id, Position = tr and tr.Position or rp.Pos })
								end
							end
						end
					end
				end
			end)
		end
		S.finishUltimate(player, state)
	end)
end

function Diego.Cleanup(S, player, state)
	revert(S, player, state, false)
	releaseThrall(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
	end
end

return Diego
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">GyroZeppeli</string><ProtectedString name="Source"><![CDATA[--[[
	GyroZeppeli  (ServerScriptService.SpinServer.TuskActs.GyroZeppeli)

	Gyro Zeppeli: Steel Ball moveset (registered as "Act" 5 so it reuses the
	Tusk ability system: cooldowns, HUD, ultimate meter, input).
	  M1        STEEL BALL COMBO: jab, hook, kick, spinning-ball smash (area)
	  Ability 1 STEEL BALL THROW: the ball flies out and BOUNCES off walls (up
	            to MaxBounces times, each bank shot hits harder), then returns
	            to Gyro's hand (it can hit on the way back)
	  Ability 2 SPIN TORNADO: bowl the spinning ball along the ground; it
	            becomes a travelling tornado that pulls enemies in, juggles
	            them and bursts (stops at walls)
	  Ability 3 SPIN VIBRATION: press the spinning ball into the enemy in front:
	            paralysis (long stun) and a small launch
	  Ultimate  BALL BREAKER: spiral build-up, a huge ball opens a spinning
	            vortex that pulls enemies in, then bursts
	Numbers: TuskConfig.Gyro. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Gyro = {}
local cfg = TuskConfig.Gyro
local HAND = CFrame.new(0.9, 0.6, -1.6)

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function Gyro.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, 5)
end

-- Short body "shake" slow from the Spin (stackable, always removed).
local function spinSlow(S, target, multiplier, seconds)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local key = "GyroSpin"
	S.Adapter.setMoveModifier(humanoid, key, multiplier)
	target:SetAttribute("GyroSpinShake", true)
	local token = {}
	target:SetAttribute("GyroSpinToken", tostring(token))
	task.delay(seconds, function()
		if humanoid.Parent and target:GetAttribute("GyroSpinToken") == tostring(token) then
			S.Adapter.setMoveModifier(humanoid, key, nil)
			target:SetAttribute("GyroSpinShake", nil)
		end
	end)
end

local function steelBallThrow(S, player, state, aim)
	local c = cfg.SteelBallThrow
	if not ready(S, player, state, "SteelBallThrow", 1) then
		return
	end
	S.startCooldown(player, state, "SteelBallThrow", c.Cooldown, 1)
	S.lock(state, c.Startup + 0.25)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 5, Move = "SteelBallThrow", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local hitOut = {}
		local maxBounces = c.MaxBounces or 3

		-- The ball spins its way back to Gyro's hand from wherever it stopped.
		local function returnToHand(position)
			local _, _, rr = alive(S, player)
			if not rr or state.Life ~= life then
				S.fx("Ability", { Character = char, Act = 5, Move = "SteelBallThrow", Phase = "Caught" })
				return
			end
			local back = rr.Position + Vector3.new(0, 1, 0) - position
			if back.Magnitude < 2 then
				S.fx("Ability", { Character = char, Act = 5, Move = "SteelBallThrow", Phase = "Caught" })
				return
			end
			S.fireBall(player, state, {
				Origin = position,
				Direction = back.Unit,
				Speed = c.ReturnSpeed,
				Radius = c.Radius,
				Range = back.Magnitude,
				Style = "Return",
				OnHit = function(target, pos)
					if not hitOut[target] then
						hitOut[target] = true
						S.hit(player, target, { Damage = c.ReturnDamage, Stun = 0.3, Knockback = 8, Direction = back.Unit, Position = pos, Source = "GyroSteelBall" })
					end
				end,
				OnEnd = function()
					S.fx("Ability", { Character = char, Act = 5, Move = "SteelBallThrow", Phase = "Caught" })
				end,
			})
		end

		-- One straight flight. When it hits a wall it bounces off (reflects
		-- around the surface normal) and keeps flying with the range it has left.
		local function launch(origin, dir, rangeLeft, bounce)
			S.fireBall(player, state, {
				Origin = origin,
				Direction = dir,
				Speed = c.Speed * (1 + bounce * 0.08), -- each bounce comes off a little faster
				Radius = c.Radius,
				Range = rangeLeft,
				Style = "Throw",
				Bounce = bounce,
				OnHit = function(target, position)
					if hitOut[target] then
						return
					end
					hitOut[target] = true
					-- Bank shots hit harder.
					local damage = c.Damage + bounce * (c.BounceBonusDamage or 2)
					S.hit(player, target, { Damage = damage, Stun = c.Stun, Knockback = c.Knockback, Direction = dir, Position = position, Source = "GyroSteelBall" })
				end,
				OnEnd = function(position, normal, hitCharacter, projectile)
					if state.Life ~= life then
						S.fx("Ability", { Character = char, Act = 5, Move = "SteelBallThrow", Phase = "Caught" })
						return
					end
					local traveled = projectile and projectile.Traveled or rangeLeft
					local remaining = rangeLeft - traveled
					if not hitCharacter and projectile and projectile.HitWall and bounce < maxBounces and remaining > 6 then
						local n = normal.Unit
						local reflected = dir - 2 * dir:Dot(n) * n
						if reflected.Magnitude < 0.1 then
							reflected = -dir
						end
						reflected = reflected.Unit
						-- Start just off the surface so it doesn't hit the same wall again.
						local from = position + n * (c.Radius + 0.3)
						S.fx("Ability", { Character = char, Act = 5, Move = "SteelBallThrow", Phase = "Bounce", Position = position, Normal = n, Direction = reflected, Bounce = bounce + 1 })
						launch(from, reflected, remaining, bounce + 1)
						return
					end
					returnToHand(position)
				end,
			})
		end

		launch(S.origin(char, r, HAND), direction, c.Range, 0)
	end)
end

-- SPIN TORNADO: the spinning ball is bowled along the ground and becomes a
-- travelling tornado that pulls enemies in, juggles them, then bursts.
local function spinTornado(S, player, state, aim)
	local c = cfg.SpinTornado
	if not ready(S, player, state, "SpinTornado", 2) then
		return
	end
	S.startCooldown(player, state, "SpinTornado", c.Cooldown, 2)
	S.lock(state, c.Startup + 0.3)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	local id = tostring(os.clock()) .. player.UserId
	S.fx("Ability", { Character = character, Act = 5, Move = "SpinTornado", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		local pos = Moves.groundBelow(r.Position + direction * 4, { char }) + Vector3.new(0, 3, 0)
		S.fx("Tornado", { Act = 5, Id = id, Phase = "Start", Position = pos, Radius = c.Radius, Duration = c.Duration })
		local ticks = math.floor(c.Duration / c.Tick)
		local stopped = false
		for i = 1, ticks do
			task.delay(i * c.Tick, function()
				if stopped then
					return
				end
				-- Move forward; stop at walls; follow the ground.
				local step = direction * c.Speed * c.Tick
				if workspace:Raycast(pos, step * 1.5, params) then
					stopped = true
				else
					pos = Moves.groundBelow(pos + step, { char }) + Vector3.new(0, 3, 0)
				end
				S.fx("Tornado", { Act = 5, Id = id, Phase = "Move", Position = pos })
				for _, target in ipairs(S.Hitbox.inRadius(player.Character, pos, c.Radius, 6)) do
					local tr = target:FindFirstChild("HumanoidRootPart")
					if tr and S.Adapter.canBeHit(player, target) then
						local inward = pos - tr.Position
						S.Adapter.applyKnockback(target, inward, c.Pull, c.Lift)
						S.hit(player, target, { Damage = c.TickDamage, Stun = 0.3, Knockback = 0, Direction = inward, Position = tr.Position, Source = "GyroSpinTornado" })
					end
				end
			end)
		end
		task.delay(c.Duration + 0.05, function()
			Moves.aoe(S, player, pos, c.Radius + 1.5, { Damage = c.BurstDamage, Stun = 0.4, Knockback = c.BurstKnockback, Launch = c.BurstLaunch, Source = "GyroSpinTornado" }, 6)
			S.fx("Tornado", { Act = 5, Id = id, Phase = "Burst", Position = pos, Radius = c.Radius + 1.5 })
		end)
	end)
end

local function spinVibration(S, player, state, aim)
	local c = cfg.SpinVibration
	if not ready(S, player, state, "SpinVibration", 3) then
		return
	end
	S.startCooldown(player, state, "SpinVibration", c.Cooldown, 3)
	S.lock(state, c.Windup + 0.4)
	local character = alive(S, player)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 5, Move = "SpinVibration", Phase = "Startup", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local _, _, r = alive(S, player)
		local cf = r.CFrame * CFrame.new(0, 0, -c.HitboxForward)
		local count, hitSet = Moves.boxHit(S, player, cf, c.HitboxSize, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Launch = c.Launch, Source = "GyroSpinVibration" }, 2)
		for target in pairs(hitSet) do
			spinSlow(S, target, 0.4, 1.5)
		end
		S.fx("Ability", { Character = character, Act = 5, Move = "SpinVibration", Phase = "Hit", Position = cf.Position, Hit = count > 0 })
	end)
end

function Gyro.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		steelBallThrow(S, player, state, aim)
	elseif slot == 2 then
		spinTornado(S, player, state, aim)
	elseif slot == 3 then
		spinVibration(S, player, state, aim)
	end
end

-- BALL BREAKER
function Gyro.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.lock(state, u.Windup + 0.5)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = 5, Phase = "Start", Windup = u.Windup, Direction = direction })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		local _, _, r = alive(S, player)
		S.fx("Ultimate", { Character = character, Act = 5, Phase = "Release", Position = r.Position, Direction = direction })
		S.fireBall(player, state, {
			Origin = S.origin(character, r, CFrame.new(0, 1.5, -3)),
			Direction = direction,
			Speed = u.Speed,
			Radius = u.Radius,
			Range = u.Range,
			Style = "Breaker",
			Scale = u.Radius * 2,
			OnHit = function(target, position)
				S.hit(player, target, { Damage = u.Damage, Stun = 0.5, Knockback = 10, Direction = direction, Position = position, Source = "GyroBallBreaker" })
			end,
			OnEnd = function(position)
				-- The spinning vortex: pulls enemies in, then bursts.
				S.fx("Ultimate", { Character = character, Act = 5, Phase = "Vortex", Position = position, Radius = u.VortexRadius, Duration = u.VortexTime })
				local ticks = math.floor(u.VortexTime / u.TickInterval)
				for i = 1, ticks do
					task.delay(i * u.TickInterval, function()
						for _, target in ipairs(S.Hitbox.inRadius(player.Character, position, u.VortexRadius, 8)) do
							local tr = target:FindFirstChild("HumanoidRootPart")
							if tr and S.Adapter.canBeHit(player, target) then
								local inward = position - tr.Position
								S.Adapter.applyKnockback(target, inward, u.PullStrength, 2)
								S.hit(player, target, { Damage = u.TickDamage, Stun = 0.25, Knockback = 0, Direction = inward, Position = tr.Position, Source = "GyroBallBreaker" })
							end
						end
					end)
				end
				task.delay(u.VortexTime + 0.05, function()
					Moves.aoe(S, player, position, u.VortexRadius + 2, { Damage = u.BurstDamage, Stun = u.Stun, Knockback = u.BurstKnockback, Launch = u.Launch, Source = "GyroBallBreaker" }, 8)
					S.fx("Ultimate", { Character = character, Act = 5, Phase = "Burst", Position = position, Radius = u.VortexRadius + 2 })
				end)
			end,
		})
		S.finishUltimate(player, state)
	end)
end

function Gyro.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
	end
end

return Gyro
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">HotPants</string><ProtectedString name="Source"><![CDATA[--[[
	HotPants  (ServerScriptService.SpinServer.TuskActs.HotPants)

	Hot Pants: CREAM STARTER, a spray can that sprays flesh. It can seal
	wounds, coat things in flesh and smother people by sealing their mouth
	and nose. Registered as "Act" 10 so it reuses the Tusk ability system.
	  M1        SPRAY COMBO: jab, kick, a short spray burst, roundhouse
	  Ability 1 FLESH SPRAY: a cone of flesh for a moment; everyone in it is
	            coated (slowed) and takes ticks of damage
	  Ability 2 FLESH SEAL: flesh over the nearest enemy's mouth and nose:
	            they suffocate (damage over time) and are slowed
	  Ability 3 FLESH MEND: she sprays her own wounds shut (heals, clears
	            seals / coatings on herself)
	  Ultimate  FLESH STORM: a cloud of flesh in front hardens into cocoons
	            round everyone caught, crushes them, then bursts apart
	Numbers: TuskConfig.HotPants. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local HotPants = {}
local cfg = TuskConfig.HotPants
local ACT = 10

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function HotPants.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, ACT)
end

local function now()
	return workspace:GetServerTimeNow()
end

-- A slow that's always removed (stackable by key, refreshed by a token).
local function slow(S, target, key, multiplier, seconds)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	S.Adapter.setMoveModifier(humanoid, key, multiplier)
	local token = tostring({})
	target:SetAttribute(key .. "Token", token)
	task.delay(seconds, function()
		if humanoid.Parent and target:GetAttribute(key .. "Token") == token then
			S.Adapter.setMoveModifier(humanoid, key, nil)
			target:SetAttribute(key .. "Token", nil)
		end
	end)
end

-- Up to `max` enemies in a cone in front, nearest first.
local function targetsInCone(S, character, root, direction, range, cone, max)
	local look = Moves.flat(direction)
	local cosLimit = math.cos(math.rad(cone / 2))
	local list = {}
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, range, 8)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr and S.Adapter.canBeHit(nil, target) then
			local offset = tr.Position - root.Position
			local f = Vector3.new(offset.X, 0, offset.Z)
			if (f.Magnitude < 1 or f.Unit:Dot(look) >= cosLimit) and S.Hitbox.lineOfSight(root.Position, tr.Position, { character, target }) then
				table.insert(list, { Target = target, Distance = offset.Magnitude })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Distance < b.Distance
	end)
	local out = {}
	for i = 1, math.min(max, #list) do
		out[i] = list[i].Target
	end
	return out
end

---------------------------------------------------------------------------
-- FLESH SPRAY
---------------------------------------------------------------------------
local function fleshSpray(S, player, state, aim)
	local c = cfg.FleshSpray
	if not ready(S, player, state, "FleshSpray", 1) then
		return
	end
	S.startCooldown(player, state, "FleshSpray", c.Cooldown, 1)
	S.lock(state, c.Startup + c.Duration + 0.15)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "FleshSpray", Phase = "Spray", Startup = c.Startup, Duration = c.Duration, Direction = direction, Range = c.Range, Cone = c.Cone })
	local ticks = math.floor(c.Duration / c.Tick)
	for i = 1, ticks do
		task.delay(c.Startup + (i - 1) * c.Tick, function()
			if not S.stillValid(player, state, life) then
				return
			end
			local char, _, r = alive(S, player)
			for _, target in ipairs(targetsInCone(S, char, r, direction, c.Range, c.Cone, c.MaxTargets)) do
				local tr = target:FindFirstChild("HumanoidRootPart")
				if tr and S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Direction = direction, Position = tr.Position, Source = "HotPantsSpray" }) then
					target:SetAttribute("FleshCoatedUntil", now() + c.CoatTime)
					slow(S, target, "FleshCoat", c.CoatSlow, c.CoatTime)
				end
			end
		end)
	end
end

---------------------------------------------------------------------------
-- FLESH SEAL
---------------------------------------------------------------------------
local function fleshSeal(S, player, state, aim)
	local c = cfg.FleshSeal
	if not ready(S, player, state, "FleshSeal", 2) then
		return
	end
	S.startCooldown(player, state, "FleshSeal", c.Cooldown, 2)
	S.lock(state, c.Windup + 0.3)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "FleshSeal", Phase = "Startup", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local target = targetsInCone(S, char, r, direction, c.Range, c.Cone, 1)[1]
		local tr = target and target:FindFirstChild("HumanoidRootPart")
		if not tr or not S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Direction = direction, Position = tr.Position, Source = "HotPantsSeal" }) then
			S.startCooldown(player, state, "FleshSeal", c.MissCooldown, 2)
			S.fx("Ability", { Character = char, Act = ACT, Move = "FleshSeal", Phase = "Miss", Direction = direction, Range = c.Range })
			return
		end
		-- Mouth and nose sealed: they suffocate.
		local untilT = now() + c.SealTime
		target:SetAttribute("FleshSealedUntil", untilT)
		slow(S, target, "FleshSeal", c.SealSlow, c.SealTime)
		S.fx("Ability", { Character = char, Act = ACT, Move = "FleshSeal", Phase = "Seal", Target = target, Duration = c.SealTime })
		for i = 1, math.floor(c.SealTime / c.SealTick) do
			task.delay(i * c.SealTick, function()
				local t = target:FindFirstChild("HumanoidRootPart")
				-- (Flesh Mend or a new life clears it early.)
				if t and (target:GetAttribute("FleshSealedUntil") or 0) >= untilT - 0.01 then
					S.hit(player, target, { Damage = c.SealDamage, Stun = 0, Knockback = 0, Direction = direction, Position = t.Position, Source = "HotPantsSeal" })
				end
			end)
		end
	end)
end

---------------------------------------------------------------------------
-- FLESH MEND
---------------------------------------------------------------------------
local function fleshMend(S, player, state)
	local c = cfg.FleshMend
	if not ready(S, player, state, "FleshMend", 3) then
		return
	end
	S.startCooldown(player, state, "FleshMend", c.Cooldown, 3)
	S.lock(state, 0.35)
	local character, humanoid = alive(S, player)
	local life = state.Life
	-- Clears flesh tricks used on her.
	character:SetAttribute("FleshSealedUntil", nil)
	character:SetAttribute("FleshCoatedUntil", nil)
	character:SetAttribute("FleshMendUntil", now() + c.Duration)
	S.fx("Ability", { Character = character, Act = ACT, Move = "FleshMend", Phase = "Mend", Duration = c.Duration, Heal = c.Heal })
	for i = 1, c.Ticks do
		task.delay(i * c.Duration / c.Ticks, function()
			if state.Life ~= life or not humanoid.Parent or humanoid.Health <= 0 then
				return
			end
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + c.Heal / c.Ticks)
		end)
	end
	task.delay(c.Duration, function()
		if character.Parent then
			character:SetAttribute("FleshMendUntil", nil)
		end
	end)
end

function HotPants.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		fleshSpray(S, player, state, aim)
	elseif slot == 2 then
		fleshSeal(S, player, state, aim)
	elseif slot == 3 then
		fleshMend(S, player, state)
	end
end

---------------------------------------------------------------------------
-- FLESH STORM (ultimate)
---------------------------------------------------------------------------
function HotPants.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	local center = Moves.groundBelow(root.Position + direction * u.Distance, { character })
	S.lock(state, u.Windup + u.EncaseTime + 0.4)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Cloud", Windup = u.Windup, Position = center, Radius = u.Radius, Direction = direction })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		S.finishUltimate(player, state)
		local up = center + Vector3.new(0, 2.5, 0)
		local caught = {}
		for _, target in ipairs(S.Hitbox.inRadius(character, up, u.Radius, 8)) do
			local tr = target:FindFirstChild("HumanoidRootPart")
			if tr and S.hit(player, target, { Damage = u.EncaseDamage, Stun = u.EncaseStun, Knockback = 0, Direction = tr.Position - center, Position = tr.Position, Source = "HotPantsStorm" }) then
				target:SetAttribute("FleshEncasedUntil", now() + u.EncaseTime)
				slow(S, target, "FleshEncase", 0.05, u.EncaseTime)
				table.insert(caught, target)
			end
		end
		S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Encase", Targets = caught, Duration = u.EncaseTime, Position = center, Radius = u.Radius })
		-- The cocoons crush...
		for i = 1, math.floor(u.EncaseTime / u.CrushEvery) do
			task.delay(i * u.CrushEvery, function()
				if state.Life ~= life then
					return
				end
				for _, target in ipairs(caught) do
					local tr = target:FindFirstChild("HumanoidRootPart")
					if tr then
						S.hit(player, target, { Damage = u.CrushDamage, Stun = 0.6, Knockback = 0, Direction = Vector3.new(0, -1, 0), Position = tr.Position, Source = "HotPantsStorm" })
					end
				end
			end)
		end
		-- ...then burst.
		task.delay(u.EncaseTime, function()
			for _, target in ipairs(caught) do
				target:SetAttribute("FleshEncasedUntil", nil)
			end
			if state.Life ~= life then
				return
			end
			Moves.aoe(S, player, up, u.Radius + 1, { Damage = u.BurstDamage, Stun = u.BurstStun, Knockback = u.BurstKnockback, Launch = u.BurstLaunch, Source = "HotPantsStorm" }, 8)
			S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Burst", Position = center, Radius = u.Radius + 1, Targets = caught })
		end)
	end)
end

function HotPants.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute("FleshMendUntil", nil)
	end
end

return HotPants
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">MountainTim</string><ProtectedString name="Source"><![CDATA[--[[
	MountainTim  (ServerScriptService.SpinServer.TuskActs.MountainTim)

	Mountain Tim: OH! LONESOME ME. The cowboy's Stand splits his body into
	pieces that slide along his lasso rope. Registered as "Act" 9 so it
	reuses the Tusk ability system.
	  M1        LASSO COMBO: jab, jab, rope whip, overhead rope slam
	  Ability 1 LASSO SNARE: throw the lasso; a catch SPLITS THEIR BODY apart
	            along the rope for a moment (slowed) and drags them in
	  Ability 2 SPLIT DODGE: he bursts into pieces hanging on rope loops. If
	            anyone attacks him in that moment, the pieces zip along a rope
	            to behind the attacker and he reforms with a rope-slam counter.
	            If nobody does, he slides forward along the rope instead.
	  Ability 3 SPLIT BARRAGE: his arm splits along the rope (shoulder,
	            forearm, fist) and flies out punching down a line; the last
	            punch hooks them and reels them back to him
	  Ultimate  LONESOME ROUNDUP: ropes shoot to everyone nearby and split
	            them apart, his pieces ride the ropes in hitting over and over,
	            then he yanks everyone together and slams the rope down
	Numbers: TuskConfig.MountainTim. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Tim = {}
local cfg = TuskConfig.MountainTim
local ACT = 9
local HAND = CFrame.new(0.9, 0.6, -1.4)

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function Tim.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, ACT)
end

-- Rope pull toward `point` (one tick; the knockback lasts ~0.18 s).
local function pull(S, target, point, stopDistance)
	local tr = target:FindFirstChild("HumanoidRootPart")
	if not tr then
		return true
	end
	local offset = point - tr.Position
	local distance = offset.Magnitude
	if distance <= (stopDistance or 4) then
		return true
	end
	-- Mostly sideways; only lift when they're below the rope end (no bouncing).
	S.Adapter.applyKnockback(target, offset, math.min(distance / 0.18 * 0.6, 90), math.clamp(offset.Y * 3, 1, 20))
	return false
end

-- Oh! Lonesome Me on someone else: their body comes apart along the rope
-- for a moment (clients draw it) and they're slowed.
local function splitVictim(S, target, seconds, slow, slowTime)
	target:SetAttribute("TimSplitUntil", workspace:GetServerTimeNow() + seconds)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if humanoid and slow then
		S.Adapter.setMoveModifier(humanoid, "TimSplit", slow)
		local token = {}
		target:SetAttribute("TimSlowToken", tostring(token))
		task.delay(slowTime or seconds, function()
			if humanoid.Parent and target:GetAttribute("TimSlowToken") == tostring(token) then
				S.Adapter.setMoveModifier(humanoid, "TimSplit", nil)
				target:SetAttribute("TimSlowToken", nil)
			end
		end)
	end
end

---------------------------------------------------------------------------
-- LASSO SNARE
---------------------------------------------------------------------------
local function lassoSnare(S, player, state, aim)
	local c = cfg.LassoSnare
	if not ready(S, player, state, "LassoSnare", 1) then
		return
	end
	S.startCooldown(player, state, "LassoSnare", c.Cooldown, 1)
	S.lock(state, c.Startup + 0.3)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "LassoSnare", Phase = "Startup", Startup = c.Startup })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local caught = false
		S.fireLasso(player, state, {
			Character = char,
			Origin = S.origin(char, r, HAND),
			Direction = direction,
			Speed = c.Speed,
			Radius = c.Radius,
			Range = c.Range,
			OnHit = function(target, position)
				if caught then
					return
				end
				caught = true
				if not S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Direction = direction, Position = position, Source = "MountainTimLasso" }) then
					return
				end
				splitVictim(S, target, c.SplitTime, c.SplitSlow, c.SlowTime)
				S.fx("Ability", { Character = char, Act = ACT, Move = "LassoSnare", Phase = "Snag", Target = target, Duration = c.ReelTime, SplitTime = c.SplitTime })
				local done = false
				for i = 0, math.max(1, math.floor(c.ReelTime / c.ReelTick)) - 1 do
					task.delay(i * c.ReelTick, function()
						local _, _, rr = alive(S, player)
						if done or not rr or state.Life ~= life then
							return
						end
						done = pull(S, target, rr.Position + rr.CFrame.LookVector * 2, c.ReelStopDistance)
					end)
				end
			end,
		})
	end)
end

---------------------------------------------------------------------------
-- SPLIT DODGE
---------------------------------------------------------------------------
local counters = setmetatable({}, { __mode = "k" }) -- [character] = counter function while the dodge is up

local function registerCounter(S)
	if S.Adapter.DodgeHandlers and not S.Adapter.DodgeHandlers.SplitCounter then
		S.Adapter.DodgeHandlers.SplitCounter = function(attackerPlayer, target, info)
			local counter = counters[target]
			if counter then
				counter(attackerPlayer, info)
			end
		end
	end
end

local function slide(S, player, state, life, direction)
	local c = cfg.SplitDodge
	local char, _, r = alive(S, player)
	if not char or state.Life ~= life then
		return
	end
	local from = r.Position
	local to = Moves.safeStep(char, r, direction, c.Distance)
	if not to then
		S.fx("Ability", { Character = char, Act = ACT, Move = "SplitDodge", Phase = "Rejoin", Position = from })
		return
	end
	local iframes = S.Adapter.Settings.IFrameAttribute
	char:SetAttribute(iframes, true)
	S.fx("Ability", { Character = char, Act = ACT, Move = "SplitDodge", Phase = "Slide", From = from, To = to, Direction = direction, Travel = c.Travel })
	local length = (to - from).Magnitude
	local mid = (from + to) / 2
	Moves.boxHit(S, player, CFrame.lookAt(mid, mid + direction), Vector3.new(c.Width, 6, length + 2), { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Direction = direction, Source = "MountainTimSplit" }, 5)
	task.delay(c.Travel, function()
		char:SetAttribute(iframes, nil)
		if char.Parent and state.Life == life then
			char:PivotTo(CFrame.lookAt(to, to + direction))
			S.fx("Ability", { Character = char, Act = ACT, Move = "SplitDodge", Phase = "Rejoin", Position = to })
		end
	end)
end

local function splitDodge(S, player, state, aim)
	local c = cfg.SplitDodge
	if not ready(S, player, state, "SplitDodge", 2) then
		return
	end
	registerCounter(S)
	S.startCooldown(player, state, "SplitDodge", c.Cooldown, 2)
	S.lock(state, c.Window + c.Travel + 0.25)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	local used = false
	-- He's in pieces: no walking off during the window.
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		S.Adapter.setMoveModifier(humanoid, "SplitDodge", 0.01) -- (never exactly 0: the multipliers divide back out)
		task.delay(c.Window + 0.05, function()
			if humanoid.Parent then
				S.Adapter.setMoveModifier(humanoid, "SplitDodge", nil)
			end
		end)
	end
	character:SetAttribute("SplitCounter", true)
	S.fx("Ability", { Character = character, Act = ACT, Move = "SplitDodge", Phase = "Scatter", Window = c.Window, Position = root.Position })
	counters[character] = function(attackerPlayer)
		if used or state.Life ~= life then
			return
		end
		used = true
		counters[character] = nil
		character:SetAttribute("SplitCounter", nil)
		local attacker = attackerPlayer and attackerPlayer.Character
		local ar = attacker and attacker:FindFirstChild("HumanoidRootPart")
		local _, _, r = alive(S, player)
		if not ar or not r then
			S.fx("Ability", { Character = character, Act = ACT, Move = "SplitDodge", Phase = "Rejoin", Position = r and r.Position or ar.Position })
			return
		end
		-- Reform right behind whoever swung at him.
		local from = r.Position
		-- Behind them if there's room, otherwise beside them; never inside a wall.
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character, attacker }
		local behind
		for _, offset in ipairs({ CFrame.new(0, 0, 3.5), CFrame.new(3, 0, 1), CFrame.new(-3, 0, 1), CFrame.new(0, 0, -3) }) do
			local spot = (ar.CFrame * offset).Position
			if not workspace:Raycast(ar.Position, spot - ar.Position, params) then
				behind = spot
				break
			end
		end
		behind = behind or from
		local iframes = S.Adapter.Settings.IFrameAttribute
		character:SetAttribute(iframes, true)
		character:PivotTo(CFrame.lookAt(behind, Vector3.new(ar.Position.X, behind.Y, ar.Position.Z)))
		S.fx("Ability", { Character = character, Act = ACT, Move = "SplitDodge", Phase = "Counter", From = from, To = behind, Attacker = attacker })
		task.delay(0.14, function()
			if attacker.Parent and ar.Parent then
				S.hit(player, attacker, { Damage = c.CounterDamage, Stun = c.CounterStun, Knockback = c.CounterKnockback, Launch = c.CounterLaunch, Direction = ar.Position - behind, Position = ar.Position, Source = "MountainTimCounter" })
			end
		end)
		task.delay(0.4, function()
			character:SetAttribute(iframes, nil)
		end)
	end
	task.delay(c.Window, function()
		if used then
			return
		end
		counters[character] = nil
		character:SetAttribute("SplitCounter", nil)
		if state.Life == life then
			slide(S, player, state, life, direction) -- nobody bit: slide forward along the rope
		end
	end)
end

---------------------------------------------------------------------------
-- SPLIT BARRAGE
---------------------------------------------------------------------------
local function splitBarrage(S, player, state, aim)
	local c = cfg.SplitBarrage
	if not ready(S, player, state, "SplitBarrage", 3) then
		return
	end
	S.startCooldown(player, state, "SplitBarrage", c.Cooldown, 3)
	S.lock(state, c.Windup + c.Hits * c.HitEvery + c.ReelTime + 0.2)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "SplitBarrage", Phase = "Startup", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		S.fx("Ability", { Character = character, Act = ACT, Move = "SplitBarrage", Phase = "Fly", Direction = direction, Range = c.Range, Hits = c.Hits, HitEvery = c.HitEvery, ReelTime = c.ReelTime })
		for i = 1, c.Hits do
			task.delay((i - 1) * c.HitEvery, function()
				local char, _, r = alive(S, player)
				if not char or state.Life ~= life then
					return
				end
				local mid = r.Position + direction * (c.Range / 2)
				local last = i == c.Hits
				local _, hitSet = Moves.boxHit(S, player, CFrame.lookAt(mid, mid + direction), Vector3.new(c.Width, 5, c.Range), { Damage = last and c.FinalDamage or c.Damage, Stun = c.Stun, Knockback = last and 0 or 2, Direction = direction, Source = "MountainTimBarrage" }, 4)
				if last then
					-- The last punch hooks them: the rope reels them back to him.
					for target in pairs(hitSet) do
						for k = 0, math.floor(c.ReelTime / c.ReelTick) - 1 do
							task.delay(k * c.ReelTick, function()
								local _, _, rr = alive(S, player)
								if rr and state.Life == life and target.Parent then
									pull(S, target, rr.Position + rr.CFrame.LookVector * 3, 4)
								end
							end)
						end
					end
				end
			end)
		end
	end)
end

function Tim.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		lassoSnare(S, player, state, aim)
	elseif slot == 2 then
		splitDodge(S, player, state, aim)
	elseif slot == 3 then
		splitBarrage(S, player, state, aim)
	end
end

---------------------------------------------------------------------------
-- LONESOME ROUNDUP (ultimate)
---------------------------------------------------------------------------
function Tim.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local life = state.Life
	S.lock(state, u.Windup + u.RideHits * u.RideEvery + u.ReelTime + 0.4)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Start", Windup = u.Windup, Radius = u.Radius })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		local char, _, r = alive(S, player)
		local roped = {}
		for _, target in ipairs(S.Hitbox.inRadius(char, r.Position, u.Radius, u.MaxTargets)) do
			local tr = target:FindFirstChild("HumanoidRootPart")
			if tr and S.Adapter.canBeHit(player, target) and S.Hitbox.lineOfSight(r.Position + Vector3.new(0, 2, 0), tr.Position, { char, target }) then
				table.insert(roped, target)
			end
		end
		S.finishUltimate(player, state)
		for _, target in ipairs(roped) do
			splitVictim(S, target, u.SplitTime, 0.5, u.SplitTime)
		end
		S.fx("Ultimate", { Character = char, Act = ACT, Phase = "Rope", Targets = roped, SplitTime = u.SplitTime, RideHits = u.RideHits, RideEvery = u.RideEvery, ReelTime = u.ReelTime })
		-- His pieces ride the ropes and hit, again and again.
		for i = 1, u.RideHits do
			task.delay((i - 1) * u.RideEvery, function()
				if state.Life ~= life then
					return
				end
				for _, target in ipairs(roped) do
					local tr = target:FindFirstChild("HumanoidRootPart")
					if tr then
						S.hit(player, target, { Damage = u.RideDamage, Stun = u.RideStun, Knockback = 0, Direction = tr.Position - r.Position, Position = tr.Position, Source = "MountainTimRoundup" })
					end
				end
			end)
		end
		-- Then the rope yanks everyone together in front of him...
		local reelStart = u.RideHits * u.RideEvery
		for i = 0, math.floor(u.ReelTime / u.ReelTick) - 1 do
			task.delay(reelStart + i * u.ReelTick, function()
				local _, _, rr = alive(S, player)
				if not rr or state.Life ~= life then
					return
				end
				local point = rr.Position + rr.CFrame.LookVector * 5
				for _, target in ipairs(roped) do
					if target.Parent then
						pull(S, target, point, 3)
					end
				end
			end)
		end
		-- ...and slams the rope down on them.
		task.delay(reelStart + u.ReelTime + 0.05, function()
			local _, _, rr = alive(S, player)
			if not rr or state.Life ~= life then
				return
			end
			local pos = rr.Position + rr.CFrame.LookVector * 5
			Moves.aoe(S, player, pos, u.SlamRadius, { Damage = u.SlamDamage, Stun = u.SlamStun, Knockback = u.SlamKnockback, Launch = u.SlamLaunch, Source = "MountainTimRoundup" }, 8)
			S.fx("Ultimate", { Character = char, Act = ACT, Phase = "Slam", Position = pos, Radius = u.SlamRadius })
		end)
	end)
end

function Tim.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute("RopeSplit", nil)
		state.Character:SetAttribute("SplitCounter", nil)
		counters[state.Character] = nil
		state.Character:SetAttribute(S.Adapter.Settings.IFrameAttribute, nil)
	end
end

return Tim
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">PorkPieHatKid</string><ProtectedString name="Source"><![CDATA[--[[
	PorkPieHatKid  (ServerScriptService.SpinServer.TuskActs.PorkPieHatKid)

	Pork Pie Hat Kid: WIRED. Two fish hooks on steel cables that roll out of a
	winch in the back of his mouth; the hooks come out of water to snag
	whoever goes for the bait, and together they can lift a horse.
	Registered as "Act" 7 so it reuses the Tusk ability system (cooldowns,
	HUD, ultimate meter, input).
	  M1        HOOK COMBO: slap, slap, a hook lash out of his mouth, flying kick
	  Ability 1 WIRED HOOK: a hook shoots out of his mouth; a hit snags the
	            enemy and the winch reels them in to him
	  Ability 2 BAIT PAN: puts down a pan of water with a feather bait. The
	            first enemies to come near get hooked out of the water,
	            hoisted up and yanked back down
	  Ability 3 DOUBLE HOOK LIFT: both hooks snag up to two enemies in front,
	            hoist them high in the air, then slam them down
	  Ultimate  WIRED WINCH: puddles of water all around him, hooks erupt from
	            every one, the winch reels everyone in through the air, slam
	Numbers: TuskConfig.PorkPie. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local PorkPie = {}
local cfg = TuskConfig.PorkPie
local ACT = 7
local MOUTH = CFrame.new(0, 1.3, -1.2) -- roughly where his mouth is (root space)

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function PorkPie.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, ACT)
end

-- The winch pulls `target` toward `point` (one tick; the knockback lasts ~0.18 s).
local function pull(S, target, point, stopDistance)
	local tr = target:FindFirstChild("HumanoidRootPart")
	if not tr then
		return true
	end
	local offset = point - tr.Position
	local distance = offset.Magnitude
	if distance <= (stopDistance or 4) then
		return true
	end
	local strength = math.min(distance / 0.18 * 0.6, 90)
	S.Adapter.applyKnockback(target, offset, strength, math.clamp(offset.Y * 3, 4, 40))
	return false
end

-- Yank a hoisted enemy straight back down into the ground.
local function slamDown(S, player, target, damage, source)
	if not target.Parent then
		return
	end
	S.Adapter.applyKnockback(target, Vector3.new(0, 0, 1), 1, -90)
	task.delay(0.25, function()
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr then
			S.hit(player, target, { Damage = damage, Stun = 0.5, Knockback = 0, Direction = Vector3.new(0, -1, 0), Position = tr.Position, Source = source })
		end
	end)
end

-- Up to `max` enemies in a cone in front, nearest first.
local function targetsInCone(S, character, root, direction, range, cone, max)
	local look = Moves.flat(direction)
	local cosLimit = math.cos(math.rad(cone / 2))
	local list = {}
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, range, 8)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr and S.Adapter.canBeHit(nil, target) then
			local offset = tr.Position - root.Position
			local f = Vector3.new(offset.X, 0, offset.Z)
			if (f.Magnitude < 1 or f.Unit:Dot(look) >= cosLimit) and S.Hitbox.lineOfSight(root.Position, tr.Position, { character, target }) then
				table.insert(list, { Target = target, Distance = offset.Magnitude })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Distance < b.Distance
	end)
	local out = {}
	for i = 1, math.min(max, #list) do
		out[i] = list[i].Target
	end
	return out
end

---------------------------------------------------------------------------
-- WIRED HOOK
---------------------------------------------------------------------------
local function wiredHook(S, player, state, aim)
	local c = cfg.WiredHook
	if not ready(S, player, state, "WiredHook", 1) then
		return
	end
	S.startCooldown(player, state, "WiredHook", c.Cooldown, 1)
	S.lock(state, c.Startup + 0.3)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "WiredHook", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local snagged = false
		S.fireHook(player, state, {
			Origin = S.origin(char, r, MOUTH),
			Direction = direction,
			Speed = c.Speed,
			Radius = c.Radius,
			Range = c.Range,
			OnHit = function(target, position)
				if snagged then
					return
				end
				snagged = true
				if not S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Direction = direction, Position = position, Source = "PorkPieHook" }) then
					return
				end
				S.fx("Ability", { Character = char, Act = ACT, Move = "WiredHook", Phase = "Snag", Target = target, Duration = c.ReelTime })
				-- The winch reels them in.
				local ticks = math.max(1, math.floor(c.ReelTime / c.ReelTick))
				local done = false
				for i = 0, ticks - 1 do
					task.delay(i * c.ReelTick, function()
						local _, _, rr = alive(S, player)
						if done or not rr or state.Life ~= life then
							return
						end
						done = pull(S, target, rr.Position + rr.CFrame.LookVector * 2, c.ReelStopDistance)
					end)
				end
			end,
		})
	end)
end

---------------------------------------------------------------------------
-- BAIT PAN
---------------------------------------------------------------------------
local function clearPan(S, state, reason)
	local pan = state.BaitPan
	if not pan then
		return
	end
	state.BaitPan = nil
	if state.Character then
		state.Character:SetAttribute("BaitPanUntil", nil)
	end
	S.fx("Ability", { Act = ACT, Move = "BaitPan", Phase = reason or "Expire", Id = pan.Id, Position = pan.Position })
end

local function baitPan(S, player, state, aim)
	local c = cfg.BaitPan
	if not ready(S, player, state, "BaitPan", 2) then
		return
	end
	S.startCooldown(player, state, "BaitPan", c.Cooldown, 2)
	S.lock(state, c.Startup + 0.2)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "BaitPan", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		clearPan(S, state, "Expire") -- one pan at a time
		local spot = Moves.safeStep(char, r, direction, c.Distance) or (r.Position + direction * 3)
		local ground = Moves.groundBelow(spot, { char })
		local pan = { Id = tostring(os.clock()) .. player.UserId, Position = ground, Until = os.clock() + c.Duration }
		state.BaitPan = pan
		char:SetAttribute("BaitPanUntil", workspace:GetServerTimeNow() + c.Duration)
		S.fx("Ability", { Character = char, Act = ACT, Move = "BaitPan", Phase = "Place", Id = pan.Id, Position = ground, From = r.Position, Duration = c.Duration, Radius = c.TriggerRadius })

		local function check()
			if state.BaitPan ~= pan or state.Life ~= life then
				return
			end
			if os.clock() >= pan.Until then
				clearPan(S, state, "Expire")
				return
			end
			local center = pan.Position + Vector3.new(0, 2.5, 0)
			local caught = {}
			for _, target in ipairs(S.Hitbox.inRadius(player.Character, center, c.TriggerRadius, c.MaxTargets)) do
				if S.Adapter.canBeHit(player, target) then
					table.insert(caught, target)
				end
			end
			if #caught == 0 then
				task.delay(c.CheckEvery, check)
				return
			end
			-- Hooks burst out of the water and hoist them.
			S.fx("Ability", { Act = ACT, Move = "BaitPan", Phase = "Trigger", Id = pan.Id, Position = pan.Position, Targets = caught, SlamAfter = c.SlamAfter })
			state.BaitPan = nil
			if state.Character then
				state.Character:SetAttribute("BaitPanUntil", nil)
			end
			for _, target in ipairs(caught) do
				local tr = target:FindFirstChild("HumanoidRootPart")
				if tr and S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Launch = c.Lift, Direction = tr.Position - pan.Position, Position = tr.Position, Source = "PorkPieBait" }) then
					task.delay(c.SlamAfter, function()
						slamDown(S, player, target, c.SlamDamage, "PorkPieBait")
					end)
				end
			end
		end
		task.delay(c.CheckEvery, check)
	end)
end

---------------------------------------------------------------------------
-- DOUBLE HOOK LIFT
---------------------------------------------------------------------------
local function doubleHookLift(S, player, state, aim)
	local c = cfg.DoubleHookLift
	if not ready(S, player, state, "DoubleHookLift", 3) then
		return
	end
	S.startCooldown(player, state, "DoubleHookLift", c.Cooldown, 3)
	S.lock(state, c.Windup + 0.5)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "DoubleHookLift", Phase = "Startup", Windup = c.Windup, Direction = direction })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local targets = targetsInCone(S, char, r, direction, c.Range, c.Cone, c.MaxTargets)
		local hooked = {}
		for _, target in ipairs(targets) do
			local tr = target:FindFirstChild("HumanoidRootPart")
			if tr and S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Launch = c.Lift, Direction = direction, Position = tr.Position, Source = "PorkPieLift" }) then
				table.insert(hooked, target)
			end
		end
		S.fx("Ability", { Character = char, Act = ACT, Move = "DoubleHookLift", Phase = "Hoist", Targets = hooked, Direction = direction, Range = c.Range, SlamAfter = c.SlamAfter })
		if #hooked == 0 then
			-- Missed: shorter cooldown.
			S.startCooldown(player, state, "DoubleHookLift", c.MissCooldown, 3)
			return
		end
		task.delay(c.SlamAfter, function()
			for _, target in ipairs(hooked) do
				slamDown(S, player, target, c.SlamDamage, "PorkPieLift")
			end
			task.delay(0.3, function()
				for _, target in ipairs(hooked) do
					local tr = target:FindFirstChild("HumanoidRootPart")
					if tr then
						S.fx("Ability", { Act = ACT, Move = "DoubleHookLift", Phase = "Slam", Position = tr.Position, Radius = c.SlamRadius })
					end
				end
			end)
		end)
	end)
end

function PorkPie.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		wiredHook(S, player, state, aim)
	elseif slot == 2 then
		baitPan(S, player, state, aim)
	elseif slot == 3 then
		doubleHookLift(S, player, state, aim)
	end
end

---------------------------------------------------------------------------
-- WIRED WINCH (ultimate)
---------------------------------------------------------------------------
function PorkPie.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local life = state.Life
	S.lock(state, u.Windup + u.ReelTime + 0.5)
	character:SetAttribute("Armored", true)
	-- Puddles of water in a ring around him.
	local puddles = {}
	for i = 1, u.Puddles do
		local a = (i - 1) / u.Puddles * math.pi * 2
		local spot = root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * u.PuddleRadius
		puddles[i] = Moves.groundBelow(spot, { character })
	end
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Start", Windup = u.Windup, Puddles = puddles, Radius = u.Radius })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		local char, _, r = alive(S, player)
		-- Hooks erupt from the puddles and snag everyone around.
		local snagged, from = {}, {}
		for _, target in ipairs(S.Hitbox.inRadius(char, r.Position, u.Radius, 8)) do
			local tr = target:FindFirstChild("HumanoidRootPart")
			if tr and S.Hitbox.lineOfSight(r.Position + Vector3.new(0, 2, 0), tr.Position, { char, target }) then
				if S.hit(player, target, { Damage = u.SnagDamage, Stun = u.SnagStun, Knockback = 0, Launch = u.SnagLift, Direction = r.Position - tr.Position, Position = tr.Position, Source = "PorkPieWinch" }) then
					table.insert(snagged, target)
					local best, bestD = 1, math.huge
					for i, p in ipairs(puddles) do
						local d = (p - tr.Position).Magnitude
						if d < bestD then
							best, bestD = i, d
						end
					end
					table.insert(from, best)
				end
			end
		end
		S.fx("Ultimate", { Character = char, Act = ACT, Phase = "Snag", Targets = snagged, From = from, Puddles = puddles, ReelTime = u.ReelTime })
		S.finishUltimate(player, state)
		-- The winch reels them all in through the air.
		local ticks = math.floor(u.ReelTime / u.ReelTick)
		local nextDamage = u.TickEvery
		for i = 1, ticks do
			task.delay(i * u.ReelTick, function()
				local _, _, rr = alive(S, player)
				if not rr or state.Life ~= life then
					return
				end
				local point = rr.Position + rr.CFrame.LookVector * 4 + Vector3.new(0, 4, 0)
				local damageTick = i * u.ReelTick >= nextDamage
				if damageTick then
					nextDamage = nextDamage + u.TickEvery
				end
				for _, target in ipairs(snagged) do
					if target.Parent then
						pull(S, target, point, 3)
						local tr = target:FindFirstChild("HumanoidRootPart")
						if damageTick and tr then
							S.hit(player, target, { Damage = u.TickDamage, Stun = 0.6, Knockback = 0, Direction = point - tr.Position, Position = tr.Position, Source = "PorkPieWinch" })
						end
					end
				end
			end)
		end
		task.delay(u.ReelTime + 0.05, function()
			local _, _, rr = alive(S, player)
			if not rr or state.Life ~= life then
				return
			end
			local pos = rr.Position + rr.CFrame.LookVector * 4
			Moves.aoe(S, player, pos, u.SlamRadius, { Damage = u.SlamDamage, Stun = u.SlamStun, Knockback = u.SlamKnockback, Launch = u.SlamLaunch, Source = "PorkPieWinch" }, 8)
			S.fx("Ultimate", { Character = char, Act = ACT, Phase = "Slam", Position = pos, Radius = u.SlamRadius })
		end)
	end)
end

function PorkPie.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
	end
	clearPan(S, state, "Expire")
end

return PorkPie
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">Sandman</string><ProtectedString name="Source"><![CDATA[--[[
	Sandman  (ServerScriptService.SpinServer.TuskActs.Sandman)

	Sandman (Soundman): IN A SILENT WAY. His Stand turns sounds into solid,
	written sound effects that do what they say when touched (cut, burn,
	explode). Registered as "Act" 8 so it reuses the Tusk ability system.
	  M1        SOUND CUT COMBO: chop, chop, spinning kick, a written sound that bursts
	  Ability 1 SOUND SLASH: a written "ZBAAK!" flies along the ground and cuts
	  Ability 2 SOUND TRAP: plants a written "DOGOOON" on the ground (up to 3);
	            the first enemy to step near it sets it off
	  Ability 3 SAND RUN: sprints straight through enemies (he's a runner),
	            hitting everyone in his path
	  Ultimate  SILENT SYMPHONY: gathers sound, rains written sounds down on the
	            area in front, the last one explodes
	Numbers: TuskConfig.Sandman. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Sandman = {}
local cfg = TuskConfig.Sandman
local ACT = 8
local HAND = CFrame.new(0.9, 0.2, -1.8)

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function Sandman.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, ACT)
end

---------------------------------------------------------------------------
-- SOUND SLASH
---------------------------------------------------------------------------
local function soundSlash(S, player, state, aim)
	local c = cfg.SoundSlash
	if not ready(S, player, state, "SoundSlash", 1) then
		return
	end
	S.startCooldown(player, state, "SoundSlash", c.Cooldown, 1)
	S.lock(state, c.Startup + 0.25)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "SoundSlash", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		S.fireWord(player, state, {
			Origin = S.origin(char, r, HAND) - Vector3.new(0, 1, 0),
			Direction = direction,
			Speed = c.Speed,
			Radius = c.Radius,
			Range = c.Range,
			Text = "ZBAAK!",
			Style = "Slash",
			OnHit = function(target, position)
				S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Direction = direction, Position = position, Source = "SandmanSlash" })
			end,
		})
	end)
end

---------------------------------------------------------------------------
-- SOUND TRAP
---------------------------------------------------------------------------
local function clearTraps(S, state)
	for _, trap in ipairs(state.SoundTraps or {}) do
		S.fx("Ability", { Act = ACT, Move = "SoundTrap", Phase = "Expire", Id = trap.Id, Position = trap.Position })
	end
	state.SoundTraps = {}
end

local function soundTrap(S, player, state, aim)
	local c = cfg.SoundTrap
	if not ready(S, player, state, "SoundTrap", 2) then
		return
	end
	S.startCooldown(player, state, "SoundTrap", c.Cooldown, 2)
	S.lock(state, c.Startup + 0.2)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "SoundTrap", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		state.SoundTraps = state.SoundTraps or {}
		-- Oldest trap goes when the limit is reached.
		if #state.SoundTraps >= c.MaxTraps then
			local old = table.remove(state.SoundTraps, 1)
			S.fx("Ability", { Act = ACT, Move = "SoundTrap", Phase = "Expire", Id = old.Id, Position = old.Position })
		end
		local spot = Moves.safeStep(char, r, direction, c.Distance) or (r.Position + direction * 3)
		local ground = Moves.groundBelow(spot, { char })
		local trap = { Id = tostring(os.clock()) .. player.UserId, Position = ground, Until = os.clock() + c.Lifetime }
		table.insert(state.SoundTraps, trap)
		S.fx("Ability", { Character = char, Act = ACT, Move = "SoundTrap", Phase = "Place", Id = trap.Id, Position = ground, Lifetime = c.Lifetime })

		local function remove()
			for i, t in ipairs(state.SoundTraps or {}) do
				if t == trap then
					table.remove(state.SoundTraps, i)
					return true
				end
			end
			return false
		end
		local function check()
			if state.Life ~= life or not table.find(state.SoundTraps or {}, trap) then
				return
			end
			if os.clock() >= trap.Until then
				remove()
				S.fx("Ability", { Act = ACT, Move = "SoundTrap", Phase = "Expire", Id = trap.Id, Position = trap.Position })
				return
			end
			local center = trap.Position + Vector3.new(0, 2.5, 0)
			for _, target in ipairs(S.Hitbox.inRadius(player.Character, center, c.TriggerRadius, 1)) do
				if S.Adapter.canBeHit(player, target) then
					remove()
					S.fx("Ability", { Act = ACT, Move = "SoundTrap", Phase = "Boom", Id = trap.Id, Position = trap.Position, Radius = c.Radius })
					-- His other traps in the blast go off with it (one hit, a bit harder).
					local chained = 0
					for k = #state.SoundTraps, 1, -1 do
						local other = state.SoundTraps[k]
						if (other.Position - trap.Position).Magnitude <= c.Radius then
							table.remove(state.SoundTraps, k)
							chained = chained + 1
							S.fx("Ability", { Act = ACT, Move = "SoundTrap", Phase = "Boom", Id = other.Id, Position = other.Position, Radius = c.Radius })
						end
					end
					Moves.aoe(S, player, center, c.Radius, { Damage = c.Damage + chained * (c.ChainBonus or 2), Stun = c.Stun, Knockback = c.Knockback, Launch = c.Launch, Source = "SandmanTrap" }, 6)
					return
				end
			end
			task.delay(c.CheckEvery, check)
		end
		task.delay(c.CheckEvery, check)
	end)
end

---------------------------------------------------------------------------
-- SAND RUN
---------------------------------------------------------------------------
local function sandRun(S, player, state, aim)
	local c = cfg.SandRun
	if not ready(S, player, state, "SandRun", 3) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local destination = Moves.safeStep(character, root, direction, c.Distance)
	if not destination then
		S.tell(player, "Denied", { Reason = "Blocked" })
		return
	end
	S.startCooldown(player, state, "SandRun", c.Cooldown, 3)
	S.lock(state, c.Windup + 0.3)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "SandRun", Phase = "Startup", Windup = c.Windup, Direction = direction })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local from = r.Position
		local to = Moves.safeStep(char, r, direction, c.Distance) or destination
		local length = (to - from).Magnitude
		char:SetAttribute(S.Adapter.Settings.IFrameAttribute, true)
		char:PivotTo(CFrame.lookAt(to, to + direction))
		-- Everyone along the path gets hit.
		local mid = (from + to) / 2
		local box = CFrame.lookAt(mid, mid + direction)
		local _, hitSet = Moves.boxHit(S, player, box, Vector3.new(c.Width, 6, length + 2), { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Direction = direction, Source = "SandmanRun" }, 5)
		local hits = {}
		for target in pairs(hitSet) do
			table.insert(hits, target)
		end
		S.fx("Ability", { Character = char, Act = ACT, Move = "SandRun", Phase = "Run", From = from, To = to, Direction = direction, Targets = hits })
		task.delay(0.25, function()
			if char.Parent then
				char:SetAttribute(S.Adapter.Settings.IFrameAttribute, nil)
			end
		end)
	end)
end

function Sandman.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		soundSlash(S, player, state, aim)
	elseif slot == 2 then
		soundTrap(S, player, state, aim)
	elseif slot == 3 then
		sandRun(S, player, state, aim)
	end
end

---------------------------------------------------------------------------
-- SILENT SYMPHONY (ultimate)
---------------------------------------------------------------------------
function Sandman.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	local center = Moves.groundBelow(root.Position + direction * u.Distance, { character })
	S.lock(state, u.Windup + u.Waves * u.WaveEvery + 0.4)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Start", Windup = u.Windup, Position = center, Radius = u.Radius, Direction = direction })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		S.finishUltimate(player, state)
		local up = center + Vector3.new(0, 2.5, 0)
		for wave = 1, u.Waves do
			task.delay((wave - 1) * u.WaveEvery, function()
				if state.Life ~= life then
					return
				end
				S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Wave", Wave = wave, Position = center, Radius = u.Radius })
				Moves.aoe(S, player, up, u.Radius, { Damage = u.WaveDamage, Stun = u.WaveStun, Knockback = 0, Source = "SandmanSymphony" }, 8)
			end)
		end
		task.delay(u.Waves * u.WaveEvery, function()
			if state.Life ~= life then
				return
			end
			Moves.aoe(S, player, up, u.Radius + 1, { Damage = u.FinalDamage, Stun = u.FinalStun, Knockback = u.FinalKnockback, Launch = u.FinalLaunch, Source = "SandmanSymphony" }, 8)
			S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Final", Position = center, Radius = u.Radius + 1 })
		end)
	end)
end

function Sandman.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute(S.Adapter.Settings.IFrameAttribute, nil)
	end
	clearTraps(S, state)
end

return Sandman
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">TuskAct1</string><ProtectedString name="Source"><![CDATA[--[[
	TuskAct1  (ServerScriptService.SpinServer.TuskActs.TuskAct1)

	Server logic for Tusk Act 1, "the beginning of Spin".
	  M1        NAIL COMBO: jab, nail strike, spinning nail assist, shock finisher
	  Ability 1 NAIL SHOT: one spinning nail
	  Ability 2 NAIL BARRAGE: five nails fanned out
	  Ability 3 SPINNING NAIL: hold to charge, release (golden-blue at full charge)
	  Ultimate  TUSK AWAKENING: armored cinematic burst, then evolves to Act 2
	            (in Menu mode: 20 s Awakened buff instead)

	Every number is in TuskConfig.Act1. All hits go through S.hit()
	(CombatAdapter), all timing and cooldowns live here on the server.
	Visual events are sent with S.fx(); clients choreograph them in
	SpinClient.TuskActVFX.Act1.
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)

local Act1 = {}
local cfg = TuskConfig.Act1

local HAND_OFFSET = CFrame.new(0.9, 0.55, -1.5) -- right-hand fingertip area

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function nailDamage(state, base)
	return state.Awakened and base * cfg.Ultimate.DamageMultiplier or base
end

local function cooldown(state, base)
	return state.Awakened and base * cfg.Ultimate.CooldownMultiplier or base
end

---------------------------------------------------------------------------
-- M1: NAIL COMBO
---------------------------------------------------------------------------
function Act1.M1(S, player, state, aim)
	local m = cfg.M1
	if S.isBusy(state) or state.Charging then
		return
	end
	local now = os.clock()
	if now - state.LastM1 > m.ResetAfter then
		state.Combo = 0
	end
	local index = state.Combo + 1
	state.Combo = index >= 4 and 0 or index
	state.LastM1 = now
	S.lock(state, index == 4 and m.EndLag or m.Interval)

	local character, _, root = alive(S, player)
	local hit = m.Hits[index]
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("M1", { Character = character, Act = 1, Index = index })

	task.delay(m.Windup, function()
		-- Getting stunned during the wind-up cancels the hit (trades are fair).
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		if hit.Projectile then
			local p = hit.Projectile
			S.fireNail(player, state, {
				Origin = S.origin(char, r, HAND_OFFSET),
				Direction = direction,
				Speed = p.Speed,
				Radius = p.Radius,
				Range = p.Range,
				Style = "M1",
				OnHit = function(target, position)
					S.hit(player, target, {
						Damage = hit.Damage,
						Stun = hit.Stun,
						Knockback = hit.Knockback,
						Direction = direction,
						Position = position,
						Source = "TuskM1",
					})
				end,
			})
			return
		end

		local boxCF = r.CFrame * CFrame.new(0, 0, -m.HitboxForward)
		local targets = S.Hitbox.inBox(char, boxCF, m.HitboxSize, m.MaxTargets)
		local landed = false
		for _, target in ipairs(targets) do
			local targetRoot = target:FindFirstChild("HumanoidRootPart")
			if targetRoot and S.Hitbox.lineOfSight(r.Position, targetRoot.Position, { char, target }) then
				local ok = S.hit(player, target, {
					Damage = hit.Damage,
					Stun = hit.Stun,
					Knockback = hit.Knockback,
					Launch = hit.Launch,
					Direction = targetRoot.Position - r.Position,
					Position = targetRoot.Position,
					Source = "TuskM1",
				})
				landed = landed or ok
			end
		end
		if index == 4 then
			S.fx("M1Finisher", { Character = char, Act = 1, Position = boxCF.Position, Radius = hit.ShockwaveRadius, Hit = landed })
		end
	end)
end

---------------------------------------------------------------------------
-- Abilities
---------------------------------------------------------------------------
local function nailShot(S, player, state, aim)
	local c = cfg.NailShot
	if S.isBusy(state) or state.Charging or not S.cooldownReady(player, state, "NailShot", 1) then
		return
	end
	S.startCooldown(player, state, "NailShot", cooldown(state, c.Cooldown), 1)
	S.lock(state, c.Startup + 0.2)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 1, Move = "NailShot", Phase = "Startup", Direction = direction, Startup = c.Startup })

	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		S.fireNail(player, state, {
			Origin = S.origin(char, r, HAND_OFFSET),
			Direction = direction,
			Speed = c.Speed,
			Radius = c.Radius,
			Range = c.Range,
			Style = "Shot",
			OnHit = function(target, position)
				S.hit(player, target, {
					Damage = nailDamage(state, c.Damage),
					Stun = c.Stun,
					Knockback = c.Knockback,
					Direction = direction,
					Position = position,
					Source = "TuskNailShot",
				})
			end,
		})
	end)
end

-- Fixed fan pattern (not random) so the barrage is readable and dodgeable.
local BARRAGE_PATTERN = { { 0, 0 }, { -1, 0.3 }, { 1, -0.2 }, { -0.5, -0.4 }, { 0.6, 0.5 }, { 0, 0.2 }, { -1, -0.3 } }

local function nailBarrage(S, player, state, aim)
	local c = cfg.NailBarrage
	if S.isBusy(state) or state.Charging or not S.cooldownReady(player, state, "NailBarrage", 2) then
		return
	end
	S.startCooldown(player, state, "NailBarrage", cooldown(state, c.Cooldown), 2)
	S.lock(state, c.Startup + c.Count * c.Interval + 0.15)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 1, Move = "NailBarrage", Phase = "Startup", Direction = direction, Startup = c.Startup, Count = c.Count, Interval = c.Interval })

	for i = 1, c.Count do
		task.delay(c.Startup + (i - 1) * c.Interval, function()
			if not S.stillValid(player, state, life) then
				return
			end
			local char, _, r = alive(S, player)
			local pattern = BARRAGE_PATTERN[(i - 1) % #BARRAGE_PATTERN + 1]
			local spread = math.rad(c.SpreadDegrees)
			local look = CFrame.lookAt(Vector3.new(), direction)
			local dir = (look * CFrame.Angles(pattern[2] * spread * 0.5, pattern[1] * spread, 0)).LookVector
			S.fireNail(player, state, {
				Origin = S.origin(char, r, HAND_OFFSET),
				Direction = dir,
				Speed = c.Speed,
				Radius = c.Radius,
				Range = c.Range,
				Style = "Barrage",
				OnHit = function(target, position)
					S.hit(player, target, {
						Damage = nailDamage(state, c.Damage),
						Stun = c.Stun,
						Knockback = c.Knockback,
						Direction = dir,
						Position = position,
						Source = "TuskNailBarrage",
					})
				end,
			})
		end)
	end
end

local function spinningNailRelease(S, player, state, aim)
	local c = cfg.SpinningNail
	local charge = S.endCharge(player, state)
	if not charge or charge.Move ~= "SpinningNail" then
		return
	end
	local character, _, root = alive(S, player)
	if not character then
		return
	end
	local t = math.clamp((os.clock() - charge.Start) / c.FullChargeAt, 0, 1)
	local full = t >= 1
	local direction = S.aim(aim, root)
	local function lerp(a, b)
		return a + (b - a) * t
	end
	S.startCooldown(player, state, "SpinningNail", cooldown(state, c.Cooldown), 3)
	S.lock(state, 0.3)
	S.fx("Ability", { Character = character, Act = 1, Move = "SpinningNail", Phase = "Release", Charge = t, Full = full, Direction = direction })
	S.fireNail(player, state, {
		Origin = S.origin(character, root, HAND_OFFSET),
		Direction = direction,
		Speed = lerp(c.MinSpeed, c.MaxSpeed),
		Radius = lerp(c.MinRadius, c.MaxRadius),
		Range = c.Range,
		Style = "Spinning",
		Charge = t,
		OnHit = function(target, position)
			S.hit(player, target, {
				Damage = nailDamage(state, lerp(c.MinDamage, c.MaxDamage)),
				Stun = c.Stun * (0.5 + t * 0.5),
				Knockback = c.Knockback * (0.4 + t * 0.6),
				Direction = direction,
				Position = position,
				Source = "TuskSpinningNail",
			})
		end,
	})
end

local function spinningNailPress(S, player, state)
	local c = cfg.SpinningNail
	if S.isBusy(state) or state.Charging or not S.cooldownReady(player, state, "SpinningNail", 3) then
		return
	end
	local charge = S.beginCharge(player, state, "SpinningNail", 3, c.WalkSpeedMultiplier)
	local token = charge.Token
	task.delay(c.MaxHold, function()
		if state.Charging and state.Charging.Token == token then
			spinningNailRelease(S, player, state, nil) -- auto-release forward
		end
	end)
end

function Act1.Ability(S, player, state, slot, phase, aim)
	if slot == 1 and phase == "Press" then
		nailShot(S, player, state, aim)
	elseif slot == 2 and phase == "Press" then
		nailBarrage(S, player, state, aim)
	elseif slot == 3 then
		if phase == "Press" then
			spinningNailPress(S, player, state)
		else
			spinningNailRelease(S, player, state, aim)
		end
	end
end

function Act1.CancelCharge(S, player, state)
	local charge = S.endCharge(player, state)
	if charge then
		S.startCooldown(player, state, charge.Move, 1.5, charge.Slot)
		S.fx("Ability", { Character = state.Character, Act = 1, Move = charge.Move, Phase = "Cancel" })
	end
end

---------------------------------------------------------------------------
-- Ultimate: TUSK AWAKENING
---------------------------------------------------------------------------
local function endAwakening(S, player, state)
	state.Awakened = false
	state.AwakenToken = nil
	if state.Character then
		state.Character:SetAttribute("TuskAwakened", nil)
	end
	S.tell(player, "AwakenEnded", {})
end

function Act1.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging or state.Awakened then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character = alive(S, player)
	local life = state.Life
	S.lock(state, u.Windup + 0.4)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = 1, Phase = "Start", Windup = u.Windup })

	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if not S.stillValid(player, state, life, true) then
			return
		end
		local char, _, root = alive(S, player)
		for _, target in ipairs(S.Hitbox.inRadius(char, root.Position, u.Radius, 8)) do
			local targetRoot = target:FindFirstChild("HumanoidRootPart")
			if targetRoot and S.Hitbox.lineOfSight(root.Position, targetRoot.Position, { char, target }) then
				S.hit(player, target, {
					Damage = u.Damage,
					Stun = u.Stun,
					Knockback = u.Knockback,
					Launch = u.Launch,
					Direction = targetRoot.Position - root.Position,
					Position = targetRoot.Position,
					Source = "TuskAwakening",
				})
			end
		end
		S.fx("Ultimate", { Character = char, Act = 1, Phase = "Burst", Position = root.Position, Radius = u.Radius })

		if TuskConfig.Progression.Mode == "Awaken" then
			S.finishUltimate(player, state) -- awakens Tusk to Act 2
			return
		end
		state.Awakened = true
		local token = {}
		state.AwakenToken = token
		char:SetAttribute("TuskAwakened", true)
		S.tell(player, "Awakened", { Duration = u.Duration })
		task.delay(u.Duration, function()
			if state.AwakenToken == token then
				endAwakening(S, player, state)
			end
		end)
	end)
end

function Act1.Cleanup(S, player, state)
	if state.Charging then
		S.endCharge(player, state)
	end
	if state.Awakened then
		endAwakening(S, player, state)
	end
end

return Act1
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">TuskAct2</string><ProtectedString name="Source"><![CDATA[--[[
	TuskAct2  (ServerScriptService.SpinServer.TuskActs.TuskAct2)

	Tusk Act 2: wormhole combat.
	  M1        DIMENSIONAL COMBO: Tusk-assisted hits, portal flashes, dimensional finisher
	  Ability 1 WORMHOLE NAIL: nail opens a wormhole where it lands; a second nail
	            bursts out of an exit portal behind the nearest enemy
	  Ability 2 UNDERGROUND PURSUIT: burrow, travel under the ground, emerge behind the target
	  Ability 3 NAIL DIMENSION: three portals around the target fire converging nails,
	            then a dimensional shockwave
	  Ultimate  DIMENSIONAL STORM: six portals rain nail waves, giant blue burst,
	            then Tusk evolves to Act 3
	Numbers: TuskConfig.Act2.
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)
local Sneak = require(script.Parent.Parent.TuskSneakService)

local Act2 = {}
local cfg = TuskConfig.Act2

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function Act2.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, 2)
end

local function wormholeNail(S, player, state, aim)
	local c = cfg.WormholeNail
	if not ready(S, player, state, "WormholeNail", 1) then
		return
	end
	S.startCooldown(player, state, "WormholeNail", c.Cooldown, 1)
	S.lock(state, c.Startup + 0.2)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 2, Move = "WormholeNail", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		Moves.nail(S, player, state, {
			Origin = S.origin(char, r, Moves.HAND),
			Direction = direction,
			Speed = c.Speed,
			Radius = c.Radius,
			Range = c.Range,
			Style = "Wormhole",
			Damage = c.Damage,
			Stun = c.Stun,
			Knockback = c.Knockback,
			Source = "TuskWormholeNail",
			OnEnd = function(position, normal)
				-- Entrance wormhole where the nail landed.
				S.fx("Portal", { Act = 2, Position = position + normal * 0.5, LookAt = position + normal * 5, Radius = 2.4, Duration = c.ExitDelay + 0.35 })
				-- Exit portal behind the nearest enemy near the impact.
				local victims = S.Hitbox.inRadius(char, position, c.ExitSearch, 1)
				local victim = victims[1]
				local vr = victim and victim:FindFirstChild("HumanoidRootPart")
				if not vr then
					return
				end
				local exitPos = (vr.CFrame * CFrame.new(0, 1.5, 6)).Position
				if not S.Hitbox.lineOfSight(vr.Position, exitPos, { char, victim }) then
					exitPos = vr.Position + Vector3.new(0, 7, 0)
				end
				S.fx("Portal", { Act = 2, Position = exitPos, LookAt = vr.Position, Radius = 2.2, Duration = c.ExitDelay + 0.45 })
				task.delay(c.ExitDelay, function()
					if state.Life ~= life or not vr.Parent then
						return
					end
					local dir = (vr.Position - exitPos)
					if dir.Magnitude < 0.5 then
						return
					end
					Moves.nail(S, player, state, {
						Origin = exitPos,
						Direction = dir.Unit,
						Speed = c.Speed,
						Radius = c.Radius,
						Range = dir.Magnitude + 6,
						Style = "Wormhole",
						Damage = c.ExitDamage,
						Stun = c.Stun,
						Knockback = c.Knockback,
						Source = "TuskWormholeNail",
					})
				end)
			end,
		})
	end)
end

local function undergroundPursuit(S, player, state, aim)
	local c = cfg.UndergroundPursuit
	if not ready(S, player, state, "UndergroundPursuit", 2) then
		return
	end
	local character, _, root = alive(S, player)
	local target = Moves.findTarget(S, character, root, c.Range, c.ConeDegrees, S.aim(aim, root))
	if not target then
		S.startCooldown(player, state, "UndergroundPursuit", 1.5, 2)
		S.tell(player, "Denied", { Reason = "NoTarget" })
		return
	end
	S.startCooldown(player, state, "UndergroundPursuit", c.Cooldown, 2)
	Sneak.burrowStrike(player, state, target, {
		Range = c.Range,
		BurrowTime = c.BurrowTime,
		WarningTime = c.WarningTime,
		EmergeDistance = 3.5,
		MaxTargetDrift = 16,
		HitRadius = c.HitRadius,
		Damage = c.Damage,
		Stun = c.Stun,
		Knockback = c.Knockback,
		Launch = c.Launch,
	}, "TuskUndergroundPursuit")
end

-- Portals around a point fire converging nails, then a shockwave.
local function nailDimension(S, player, state, aim)
	local c = cfg.NailDimension
	if not ready(S, player, state, "NailDimension", 3) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local target = Moves.findTarget(S, character, root, c.Range, c.ConeDegrees, direction)
	local center
	if target then
		center = target.HumanoidRootPart.Position
	else
		center = Moves.groundBelow(root.Position + Moves.flat(direction) * 35, { character }) + Vector3.new(0, 3, 0)
	end
	S.startCooldown(player, state, "NailDimension", c.Cooldown, 3)
	S.lock(state, 0.6)
	local yaw = math.atan2(direction.Z, direction.X)
	local portals = Moves.ring(center, c.Portals, c.PortalRadius, yaw, 4, 8)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 2, Move = "NailDimension", Phase = "Open", Portals = portals, Center = center, OpenTime = c.OpenTime })
	task.delay(c.OpenTime, function()
		if state.Life ~= life then
			return
		end
		local aimAt = (target and target.Parent and target:FindFirstChild("HumanoidRootPart")) and target.HumanoidRootPart.Position or center
		for _, pos in ipairs(portals) do
			local dir = aimAt - pos
			Moves.nail(S, player, state, {
				Origin = pos,
				Direction = dir.Unit,
				Speed = c.Speed,
				Radius = 0.8,
				Range = dir.Magnitude + 8,
				Style = "Portal",
				Damage = c.Damage,
				Stun = c.Stun,
				Knockback = c.Knockback,
				Source = "TuskNailDimension",
			})
		end
		local travel = (portals[1] - aimAt).Magnitude / c.Speed
		task.delay(travel + 0.05, function()
			if state.Life ~= life then
				return
			end
			Moves.aoe(S, player, aimAt, c.FinalRadius, { Damage = c.FinalDamage, Stun = 0.3, Knockback = 20, Launch = 12, Source = "TuskNailDimension" }, 5)
			S.fx("AbilityImpact", { Act = 2, Move = "NailDimension", Position = aimAt, Radius = c.FinalRadius })
		end)
	end)
end

function Act2.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		wormholeNail(S, player, state, aim)
	elseif slot == 2 then
		undergroundPursuit(S, player, state, aim)
	elseif slot == 3 then
		nailDimension(S, player, state, aim)
	end
end

-- DIMENSIONAL STORM
function Act2.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local life = state.Life
	local total = u.Windup + u.Waves * u.WaveInterval + 0.5
	S.lock(state, total)
	character:SetAttribute("Armored", true)
	local center = root.Position
	local portals = Moves.ring(center, u.Portals, u.Radius * 0.55, math.random() * math.pi * 2, 7, 11)
	S.fx("Ultimate", { Character = character, Act = 2, Phase = "Start", Windup = u.Windup, Portals = portals, Center = center })

	local function finish()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
	end
	for wave = 1, u.Waves do
		task.delay(u.Windup + (wave - 1) * u.WaveInterval, function()
			if state.Life ~= life then
				return
			end
			local targets = S.Hitbox.inRadius(character, center, u.Radius, 8)
			for i, pos in ipairs(portals) do
				local t = targets[(i + wave) % math.max(#targets, 1) + 1]
				local tr = t and t:FindFirstChild("HumanoidRootPart")
				local aimAt = tr and tr.Position or (center + Vector3.new(math.random(-12, 12), -2, math.random(-12, 12)))
				local dir = aimAt - pos
				Moves.nail(S, player, state, {
					Origin = pos,
					Direction = dir.Unit,
					Speed = u.NailSpeed,
					Radius = 0.8,
					Range = dir.Magnitude + 10,
					Style = "Portal",
					Damage = u.NailDamage,
					Stun = 0.3,
					Knockback = 4,
					Source = "TuskDimensionalStorm",
				})
			end
		end)
	end
	task.delay(total - 0.4, function()
		finish()
		if state.Life ~= life or not alive(S, player) then
			return
		end
		Moves.aoe(S, player, center, u.BurstRadius, { Damage = u.BurstDamage, Stun = u.Stun, Knockback = u.Knockback, Launch = u.Launch, Source = "TuskDimensionalStorm" }, 8)
		S.fx("Ultimate", { Character = character, Act = 2, Phase = "Burst", Position = center, Radius = u.BurstRadius })
		task.delay(0.35, function()
			if state.Life == life then
				S.finishUltimate(player, state) -- evolves to Act 3
			end
		end)
	end)
	task.delay(total + 1, finish)
end

function Act2.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
	end
end

return Act2
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">TuskAct3</string><ProtectedString name="Source"><![CDATA[--[[
	TuskAct3  (ServerScriptService.SpinServer.TuskActs.TuskAct3)

	Tusk Act 3: master of spatial movement.
	  M1        WORMHOLE STRIKES: fast combo with portal flashes, portal uppercut finisher
	  Ability 1 DIMENSIONAL STEP: short validated portal teleport (entrance + exit portals)
	  Ability 2 SPATIAL PURSUIT: four portals around the target fire nails one after
	            another, each re-aimed at where the target is now
	  Ability 3 DIMENSIONAL BREAK: energy gathers, a large portal opens, a long
	            dimensional shockwave tears forward
	  Ultimate  INFINITE DIMENSION: layered portals around the battlefield, a giant
	            dimensional collapse, then Tusk evolves to Act 4
	Numbers: TuskConfig.Act3.
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Act3 = {}
local cfg = TuskConfig.Act3

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function Act3.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, 3)
end

local function dimensionalStep(S, player, state, aim)
	local c = cfg.DimensionalStep
	if not ready(S, player, state, "DimensionalStep", 1) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local destination = Moves.safeStep(character, root, direction, c.Distance)
	if not destination then
		S.tell(player, "Denied", { Reason = "Blocked" })
		return
	end
	S.startCooldown(player, state, "DimensionalStep", c.Cooldown, 1)
	S.lock(state, 0.25)
	local from = root.Position
	character:SetAttribute(S.Adapter.Settings.IFrameAttribute, true)
	character:PivotTo(CFrame.lookAt(destination, destination + direction))
	S.fx("Ability", { Character = character, Act = 3, Move = "DimensionalStep", From = from, To = destination, Direction = direction })
	task.delay(c.IFrames, function()
		if character.Parent then
			character:SetAttribute(S.Adapter.Settings.IFrameAttribute, nil)
		end
	end)
end

local function spatialPursuit(S, player, state, aim)
	local c = cfg.SpatialPursuit
	if not ready(S, player, state, "SpatialPursuit", 2) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local target = Moves.findTarget(S, character, root, c.Range, c.ConeDegrees, direction)
	if not target then
		S.startCooldown(player, state, "SpatialPursuit", 1.5, 2)
		S.tell(player, "Denied", { Reason = "NoTarget" })
		return
	end
	S.startCooldown(player, state, "SpatialPursuit", c.Cooldown, 2)
	S.lock(state, 0.5)
	local tr = target.HumanoidRootPart
	local portals = Moves.ring(tr.Position, c.Portals, c.PortalRadius, math.random() * math.pi * 2, 3, 7)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 3, Move = "SpatialPursuit", Phase = "Open", Portals = portals, Target = target, OpenTime = c.OpenTime, Stagger = c.Stagger })
	for i, pos in ipairs(portals) do
		task.delay(c.OpenTime + (i - 1) * c.Stagger, function()
			if state.Life ~= life or not tr.Parent then
				return
			end
			local dir = tr.Position - pos -- re-aimed at the target's current position
			Moves.nail(S, player, state, {
				Origin = pos,
				Direction = dir.Unit,
				Speed = c.Speed,
				Radius = 0.8,
				Range = dir.Magnitude + 10,
				Style = "Portal",
				Damage = c.Damage,
				Stun = c.Stun,
				Knockback = c.Knockback,
				Source = "TuskSpatialPursuit",
			})
		end)
	end
end

local function dimensionalBreak(S, player, state, aim)
	local c = cfg.DimensionalBreak
	if not ready(S, player, state, "DimensionalBreak", 3) then
		return
	end
	S.startCooldown(player, state, "DimensionalBreak", c.Cooldown, 3)
	S.lock(state, c.Charge + 0.5)
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 3, Move = "DimensionalBreak", Phase = "Charge", Charge = c.Charge, Direction = direction })
	task.delay(c.Charge, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local _, _, r = alive(S, player)
		local origin = r.Position
		local cf = CFrame.lookAt(origin, origin + direction) * CFrame.new(0, 0, -(c.Length / 2 + 1))
		Moves.boxHit(S, player, cf, Vector3.new(c.Width, 9, c.Length), { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Launch = c.Launch, Direction = direction, Source = "TuskDimensionalBreak" }, 6)
		S.fx("Ability", { Character = character, Act = 3, Move = "DimensionalBreak", Phase = "Release", Origin = origin, Direction = direction, Length = c.Length, Width = c.Width })
	end)
end

function Act3.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		dimensionalStep(S, player, state, aim)
	elseif slot == 2 then
		spatialPursuit(S, player, state, aim)
	elseif slot == 3 then
		dimensionalBreak(S, player, state, aim)
	end
end

-- INFINITE DIMENSION
function Act3.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local life = state.Life
	S.lock(state, u.Windup + 0.6)
	character:SetAttribute("Armored", true)
	local center = root.Position
	local inner = Moves.ring(center, u.Portals / 2, u.Radius * 0.45, 0, 5, 9)
	local outer = Moves.ring(center, u.Portals / 2, u.Radius * 0.85, math.pi / (u.Portals / 2), 10, 14)
	local portals = {}
	for _, p in ipairs(inner) do
		table.insert(portals, p)
	end
	for _, p in ipairs(outer) do
		table.insert(portals, p)
	end
	S.fx("Ultimate", { Character = character, Act = 3, Phase = "Start", Windup = u.Windup, Portals = portals, Center = center, Radius = u.Radius })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		Moves.aoe(S, player, center, u.Radius, { Damage = u.Damage, Stun = u.Stun, Knockback = u.Knockback, Launch = u.Launch, Source = "TuskInfiniteDimension" }, 10)
		S.fx("Ultimate", { Character = character, Act = 3, Phase = "Burst", Position = center, Radius = u.Radius })
		task.delay(0.4, function()
			if state.Life == life then
				S.finishUltimate(player, state) -- evolves to Act 4
			end
		end)
	end)
end

function Act3.Cleanup(S, player, state)
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute(S.Adapter.Settings.IFrameAttribute, nil)
	end
end

return Act3
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">TuskAct4</string><ProtectedString name="Source"><![CDATA[--[[
	TuskAct4  (ServerScriptService.SpinServer.TuskActs.TuskAct4)

	Tusk Act 4: Infinite Rotation. Gold and deep blue, heavy and majestic.
	  M1        INFINITE BARRAGE: heavy punch, golden spin strike, rapid Stand
	            triple-hit, massive golden rotational finisher (area)
	  Ability 1 GOLDEN SPIN NAIL: big rotating projectile, golden impact blast
	  Ability 2 INFINITE ROTATION (hold): 3 charge stages, bigger projectile and
	            blast per stage
	  Ability 3 GOLDEN PURSUIT: golden rush to the first enemy ahead, rotational
	            strikes, huge golden shockwave
	  Ultimate  INFINITE ROTATION: 10-step cinematic, giant golden rotational
	            projectile, battlefield-wide golden shockwave (final form)
	Numbers: TuskConfig.Act4.
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Act4 = {}
local cfg = TuskConfig.Act4

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

function Act4.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, 4)
end

-- Projectile with an area blast where it lands (direct target excluded from the blast).
local function blastNail(S, player, state, spec, blastRadius, blastDamage, source)
	local directHit = {}
	local base = spec.OnHit
	spec.OnEnd = function(position, _, hitCharacter)
		if hitCharacter then
			directHit[hitCharacter] = true
		end
		Moves.aoe(S, player, position, blastRadius, { Damage = blastDamage, Stun = 0.35, Knockback = 25, Launch = 10, Source = source }, 6, directHit)
	end
	return Moves.nail(S, player, state, spec), base
end

local function goldenSpinNail(S, player, state, aim)
	local c = cfg.GoldenSpinNail
	if not ready(S, player, state, "GoldenSpinNail", 1) then
		return
	end
	S.startCooldown(player, state, "GoldenSpinNail", c.Cooldown, 1)
	S.lock(state, c.Startup + 0.25)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = 4, Move = "GoldenSpinNail", Phase = "Startup", Startup = c.Startup, Direction = direction })
	task.delay(c.Startup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		blastNail(S, player, state, {
			Origin = S.origin(char, r, Moves.HAND),
			Direction = direction,
			Speed = c.Speed,
			Radius = c.Radius,
			Range = c.Range,
			Style = "Golden",
			Damage = c.Damage,
			Stun = c.Stun,
			Knockback = c.Knockback,
			Source = "TuskGoldenSpinNail",
		}, c.ImpactRadius, c.ImpactDamage, "TuskGoldenSpinNail")
	end)
end

local function infiniteRotationRelease(S, player, state, aim)
	local c = cfg.InfiniteRotation
	local charge = S.endCharge(player, state)
	if not charge or charge.Move ~= "InfiniteRotation" then
		return
	end
	local character, _, root = alive(S, player)
	if not character then
		return
	end
	local held = os.clock() - charge.Start
	local stage = 1
	for i, t in ipairs(c.Stages) do
		if held >= t then
			stage = i
		end
	end
	local direction = S.aim(aim, root)
	S.startCooldown(player, state, "InfiniteRotation", c.Cooldown, 2)
	S.lock(state, 0.4)
	S.fx("Ability", { Character = character, Act = 4, Move = "InfiniteRotation", Phase = "Release", Stage = stage, Direction = direction })
	blastNail(S, player, state, {
		Origin = S.origin(character, root, CFrame.new(0, 1.2, -2.5)),
		Direction = direction,
		Speed = c.Speed[stage],
		Radius = c.Radius[stage],
		Range = c.Range,
		Style = "Rotation",
		Charge = stage / 3,
		Damage = c.Damage[stage],
		Stun = c.Stun,
		Knockback = c.Knockback * (0.5 + stage / 6),
		Source = "TuskInfiniteRotation",
	}, c.ImpactRadius[stage], c.ImpactDamage[stage], "TuskInfiniteRotation")
end

local function infiniteRotationPress(S, player, state)
	local c = cfg.InfiniteRotation
	if not ready(S, player, state, "InfiniteRotation", 2) then
		return
	end
	local charge = S.beginCharge(player, state, "InfiniteRotation", 2, c.WalkSpeedMultiplier)
	local token = charge.Token
	task.delay(c.MaxHold, function()
		if state.Charging and state.Charging.Token == token then
			infiniteRotationRelease(S, player, state, nil)
		end
	end)
end

local function goldenPursuit(S, player, state, aim)
	local c = cfg.GoldenPursuit
	if not ready(S, player, state, "GoldenPursuit", 3) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	-- Stop just short of the first enemy along the rush line.
	local distance = c.Distance
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, c.Distance + 4, 8)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr then
			local offset = tr.Position - root.Position
			local along = offset:Dot(direction)
			local side = (offset - direction * along).Magnitude
			if along > 0 and side < 5 and along - 3 < distance then
				distance = math.max(along - 3, 3)
			end
		end
	end
	local destination = Moves.safeStep(character, root, direction, distance)
	if not destination then
		S.tell(player, "Denied", { Reason = "Blocked" })
		return
	end
	S.startCooldown(player, state, "GoldenPursuit", c.Cooldown, 3)
	local gather = 0.2
	S.lock(state, gather + c.Hits * c.HitInterval + 0.45)
	local life = state.Life
	local from = root.Position
	S.fx("Ability", { Character = character, Act = 4, Move = "GoldenPursuit", Phase = "Gather", Direction = direction })
	task.delay(gather, function()
		if not S.stillValid(player, state, life) then
			return
		end
		character:SetAttribute(S.Adapter.Settings.IFrameAttribute, true)
		character:PivotTo(CFrame.lookAt(destination, destination + direction))
		S.fx("Ability", { Character = character, Act = 4, Move = "GoldenPursuit", Phase = "Dash", From = from, To = destination })
		task.delay(0.15, function()
			if character.Parent then
				character:SetAttribute(S.Adapter.Settings.IFrameAttribute, nil)
			end
		end)
		local front = destination + direction * 3
		for i = 1, c.Hits do
			task.delay(i * c.HitInterval, function()
				if state.Life ~= life then
					return
				end
				Moves.aoe(S, player, front, 6, { Damage = c.HitDamage, Stun = 0.4, Knockback = 3, Direction = direction, Source = "TuskGoldenPursuit" }, 3)
				S.fx("Ability", { Character = character, Act = 4, Move = "GoldenPursuit", Phase = "Hit", Position = front, Index = i })
			end)
		end
		task.delay((c.Hits + 1) * c.HitInterval, function()
			if state.Life ~= life then
				return
			end
			Moves.aoe(S, player, front, c.FinalRadius, { Damage = c.FinalDamage, Stun = c.Stun, Knockback = c.Knockback, Launch = c.Launch, Direction = direction, Source = "TuskGoldenPursuit" }, 6)
			S.fx("Ability", { Character = character, Act = 4, Move = "GoldenPursuit", Phase = "Final", Position = front, Radius = c.FinalRadius })
		end)
	end)
end

function Act4.Ability(S, player, state, slot, phase, aim)
	if slot == 1 and phase == "Press" then
		goldenSpinNail(S, player, state, aim)
	elseif slot == 2 then
		if phase == "Press" then
			infiniteRotationPress(S, player, state)
		else
			infiniteRotationRelease(S, player, state, aim)
		end
	elseif slot == 3 and phase == "Press" then
		goldenPursuit(S, player, state, aim)
	end
end

function Act4.CancelCharge(S, player, state)
	local charge = S.endCharge(player, state)
	if charge then
		S.startCooldown(player, state, charge.Move, 2, charge.Slot)
		S.fx("Ability", { Character = state.Character, Act = 4, Move = charge.Move, Phase = "Cancel" })
	end
end

-- INFINITE ROTATION (ultimate)
function Act4.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.lock(state, u.Windup + 0.6)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = 4, Phase = "Start", Windup = u.Windup, Direction = direction })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		local _, _, r = alive(S, player)
		S.fx("Ultimate", { Character = character, Act = 4, Phase = "Release", Position = r.Position, Direction = direction })
		blastNail(S, player, state, {
			Origin = S.origin(character, r, CFrame.new(0, 2, -4)),
			Direction = direction,
			Speed = u.Speed,
			Radius = u.ProjectileRadius,
			Range = u.Range,
			Style = "InfiniteUlt",
			Charge = 1,
			Damage = u.Damage,
			Stun = u.Stun,
			Knockback = u.Knockback,
			Launch = u.Launch,
			Source = "TuskInfiniteRotationUlt",
		}, u.BlastRadius, u.BlastDamage, "TuskInfiniteRotationUlt")
		S.finishUltimate(player, state) -- final form: no evolution (Studio refills the meter)
	end)
end

function Act4.Cleanup(S, player, state)
	if state.Charging then
		S.endCharge(player, state)
	end
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute(S.Adapter.Settings.IFrameAttribute, nil)
	end
end

return Act4
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">Valentine</string><ProtectedString name="Source"><![CDATA[--[[
	Valentine  (ServerScriptService.SpinServer.TuskActs.Valentine)

	Funny Valentine: D4C (Dirty Deeds Done Dirt Cheap). Sandwiched between
	two things (a flag wrapped round him) he slips into a parallel world and
	out again somewhere else; he brings people across from other worlds;
	and with Love Train, misfortune can't reach him: it lands on someone
	else. Registered as "Act" 13 so it reuses the Tusk ability system.
	  M1        DIRTY DEEDS COMBO: D4C chops with him
	  Ability 1 DIMENSION HOP: a flag sweeps over him (he can't be hit while
	            he's between worlds) and he steps out behind the nearest enemy
	            in front, striking them; with nobody there, he hops ahead. He
	            leaves a flag where he was: press again within 4 s to hop back
	  Ability 2 PARALLEL VALENTINE: a Valentine from another world joins the
	            fight for a few seconds, chasing and punching the nearest enemy.
	            If he's nearly beaten while it's out, they SWAP: he takes its
	            place (healed) and it's gone
	  Ability 3 MENGER SPONGE: the nearest enemy's other-world self appears
	            beside them: two of the same person can't exist together, so
	            they crumble into cubes (slowed, ticks of damage), then burst,
	            hitting whoever's next to them. They only crumble near their
	            double: running away from it ends it
	  Ultimate  D4C LOVE TRAIN: a wall of light: every hit on him is
	            cancelled and the misfortune lands on the nearest enemy
	            instead; he moves faster; it ends with a pulse of light
Numbers: TuskConfig.Valentine. All damage goes through S.hit (CombatAdapter).
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Moves = require(script.Parent.Parent.TuskMoves)

local Valentine = {}
local cfg = TuskConfig.Valentine
local ACT = 13

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function ready(S, player, state, name, slot)
	return not S.isBusy(state) and not state.Charging and S.cooldownReady(player, state, name, slot)
end

local function now()
	return workspace:GetServerTimeNow()
end

function Valentine.M1(S, player, state, aim)
	Moves.m1(S, player, state, aim, cfg.M1, ACT)
end

local function slow(S, target, key, multiplier, seconds)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	S.Adapter.setMoveModifier(humanoid, key, multiplier)
	local token = tostring({})
	target:SetAttribute(key .. "Token", token)
	task.delay(seconds, function()
		if humanoid.Parent and target:GetAttribute(key .. "Token") == token then
			S.Adapter.setMoveModifier(humanoid, key, nil)
			target:SetAttribute(key .. "Token", nil)
		end
	end)
end

-- Nearest enemy (optionally only in a cone in front).
local function nearest(S, character, root, range, direction, cone)
	local look = direction and Moves.flat(direction)
	local cosLimit = cone and math.cos(math.rad(cone / 2))
	local best, bestD
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, range, 8)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		local hum = target:FindFirstChildOfClass("Humanoid")
		if tr and hum and hum.Health > 0 and S.Adapter.canBeHit(nil, target) then
			local offset = tr.Position - root.Position
			local f = Vector3.new(offset.X, 0, offset.Z)
			if not look or f.Magnitude < 1 or f.Unit:Dot(look) >= cosLimit then
				if not bestD or offset.Magnitude < bestD then
					best, bestD = target, offset.Magnitude
				end
			end
		end
	end
	return best
end

---------------------------------------------------------------------------
-- DIMENSION HOP
---------------------------------------------------------------------------
-- Step out of another world at `to` (shared by the hop and the hop back).
local function hopThrough(S, player, state, c, to, facing, onArrive)
	local character, _, root = alive(S, player)
	local life = state.Life
	S.lock(state, c.Windup + 0.3)
	local iframes = S.Adapter.Settings.IFrameAttribute
	character:SetAttribute(iframes, true)
	S.fx("Ability", { Character = character, Act = ACT, Move = "DimensionHop", Phase = "Wrap", Position = root.Position, Windup = c.Windup })
	task.delay(c.Windup, function()
		character:SetAttribute(iframes, nil)
		if not S.stillValid(player, state, life) then
			return
		end
		local char = alive(S, player)
		local dest, face = to(), facing()
		local flatFace = Vector3.new(face.X, dest.Y, face.Z)
		char:PivotTo((flatFace - dest).Magnitude > 0.1 and CFrame.lookAt(dest, flatFace) or CFrame.new(dest))
		S.fx("Ability", { Character = char, Act = ACT, Move = "DimensionHop", Phase = "Unwrap", Position = dest })
		if onArrive then
			onArrive(char, dest)
		end
	end)
end

local function dimensionHop(S, player, state, aim)
	local c = cfg.DimensionHop
	-- Hop back through the flag he left (doesn't need the cooldown).
	local back = state.HopReturn
	if back and now() < back.Until and not S.isBusy(state) and not state.Charging then
		state.HopReturn = nil
		local character = alive(S, player)
		S.fx("Ability", { Character = character, Act = ACT, Move = "DimensionHop", Phase = "AnchorGone" })
		hopThrough(S, player, state, c, function()
			return back.Pos
		end, function()
			return back.Pos + back.Facing
		end)
		return
	end
	if not ready(S, player, state, "DimensionHop", 1) then
		return
	end
	local character, _, root = alive(S, player)
	local direction = Moves.flat(S.aim(aim, root))
	-- Where he'll step out: behind the nearest enemy in front, or straight ahead.
	local target = nearest(S, character, root, c.Range, direction, c.Cone)
	local tr = target and target:FindFirstChild("HumanoidRootPart")
	local destination, facing
	if tr then
		local behind = -Moves.flat(tr.CFrame.LookVector)
		destination = Moves.safeStep(character, tr, behind, 5) or Moves.safeStep(character, tr, -behind, 5)
		facing = tr.Position
	end
	if not destination then
		target, tr = nil, nil
		destination = Moves.safeStep(character, root, direction, c.Distance)
		facing = destination and destination + direction
	end
	if not destination then
		S.tell(player, "Denied", { Reason = "Blocked" })
		return
	end
	S.startCooldown(player, state, "DimensionHop", c.Cooldown, 1)
	-- He leaves a flag where he was: press again soon to hop back to it.
	local from, fromFacing = root.Position, Moves.flat(root.CFrame.LookVector)
	hopThrough(S, player, state, c, function()
		-- The target may have moved: step out behind where they are now.
		if tr and tr.Parent then
			local behind = -Moves.flat(tr.CFrame.LookVector)
			destination = Moves.safeStep(alive(S, player), tr, behind, 5) or destination
			facing = tr.Position
		end
		return destination
	end, function()
		return facing
	end, function(char, dest)
		state.HopReturn = { Pos = from, Facing = fromFacing, Until = now() + c.ReturnWindow }
		S.fx("Ability", { Character = char, Act = ACT, Move = "DimensionHop", Phase = "Anchor", Position = from, Duration = c.ReturnWindow })
		-- Out of the other world: a strike at whoever he came for.
		if target and tr and (tr.Position - dest).Magnitude <= c.StrikeRange then
			S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Direction = tr.Position - dest, Position = tr.Position, Source = "ValentineHop" })
		end
	end)
end

---------------------------------------------------------------------------
-- PARALLEL VALENTINE: a Valentine from another world fights with him
---------------------------------------------------------------------------
local nextClone = 0

local function parallelClone(S, player, state)
	local c = cfg.ParallelClone
	if not ready(S, player, state, "ParallelClone", 2) then
		return
	end
	S.startCooldown(player, state, "ParallelClone", c.Cooldown, 2)
	S.lock(state, c.Windup + 0.2)
	local character, _, root = alive(S, player)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "ParallelClone", Phase = "Call", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		nextClone = nextClone + 1
		local id = nextClone
		local pos = (r.CFrame * CFrame.new(-3, 0, 0)).Position
		local untilT = now() + c.Duration
		char:SetAttribute("ParallelCloneUntil", untilT)
		S.fx("Ability", { Character = char, Act = ACT, Move = "ParallelClone", Phase = "Arrive", Id = id, From = pos, Duration = c.Duration, Speed = c.Speed })
		local born = now()
		local punches, nextPunch, target = 0, 0, nil
		local step = 0.1
		local swapped = false
		local function tick()
			local _, myHum, myRoot = alive(S, player)
			-- Nearly beaten while his other self is out: they swap places.
			if myHum and myRoot and not swapped and myHum.Health > 0 and myHum.Health <= myHum.MaxHealth * c.SwapAt and state.Life == life then
				swapped = true
				local old = myRoot.Position
				myHum.Health = math.min(myHum.MaxHealth, myHum.Health + myHum.MaxHealth * c.SwapHeal)
				local at = Vector3.new(pos.X, old.Y, pos.Z)
				char:PivotTo(CFrame.lookAt(at, at + Moves.flat(myRoot.CFrame.LookVector)))
				char:SetAttribute("ParallelCloneUntil", nil)
				S.fx("Ability", { Character = char, Act = ACT, Move = "ParallelClone", Phase = "Swap", Id = id, From = old, To = at })
				return
			end
			if not myRoot or state.Life ~= life or now() - born > c.Duration or punches >= c.MaxPunches then
				char:SetAttribute("ParallelCloneUntil", nil)
				S.fx("Ability", { Act = ACT, Move = "ParallelClone", Phase = "Leave", Id = id, Position = pos })
				return
			end
			-- Pick the enemy nearest to Valentine (re-picked as they move).
			local pick = nearest(S, char, myRoot, c.Range)
			if pick ~= target then
				target = pick
				S.fx("Ability", { Act = ACT, Move = "ParallelClone", Phase = "Chase", Id = id, Target = target, From = pos })
			end
			local tr = target and target:FindFirstChild("HumanoidRootPart")
			local goal = tr and tr.Position or (myRoot.CFrame * CFrame.new(-3, 0, 2)).Position
			local to = goal - pos
			local reach = tr and c.PunchRange or 2
			if to.Magnitude > reach then
				pos = pos + to.Unit * math.min(c.Speed * step, to.Magnitude - reach * 0.8)
			elseif tr and now() >= nextPunch then
				nextPunch = now() + c.PunchEvery
				punches = punches + 1
				S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = c.Knockback, Direction = to, Position = tr.Position, Source = "ValentineClone" })
				S.fx("Ability", { Act = ACT, Move = "ParallelClone", Phase = "Punch", Id = id, Position = tr.Position, From = pos })
			end
			task.delay(step, tick)
		end
		tick()
	end)
end

---------------------------------------------------------------------------
-- MENGER SPONGE: their other-world self appears and they crumble into cubes
---------------------------------------------------------------------------
local function mengerSponge(S, player, state, aim)
	local c = cfg.MengerSponge
	if not ready(S, player, state, "MengerSponge", 3) then
		return
	end
	S.startCooldown(player, state, "MengerSponge", c.Cooldown, 3)
	S.lock(state, c.Windup + 0.25)
	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("Ability", { Character = character, Act = ACT, Move = "MengerSponge", Phase = "Cast", Windup = c.Windup })
	task.delay(c.Windup, function()
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		local target = nearest(S, char, r, c.Range, direction, c.Cone)
		local tr = target and target:FindFirstChild("HumanoidRootPart")
		if not tr or not S.hit(player, target, { Damage = c.Damage, Stun = c.Stun, Knockback = 0, Direction = direction, Position = tr.Position, Source = "ValentineMenger" }) then
			S.startCooldown(player, state, "MengerSponge", c.MissCooldown, 3)
			S.fx("Ability", { Character = char, Act = ACT, Move = "MengerSponge", Phase = "Miss", Direction = direction })
			return
		end
		local untilT = now() + c.Time
		local token = tostring({}) -- only this cast's ticks may act (a newer one replaces it)
		target:SetAttribute("MengerUntil", untilT)
		target:SetAttribute("MengerCast", token)
		slow(S, target, "Menger", c.Slow, c.Time)
		-- Their double appears right beside them, and stays put.
		local doublePos = (tr.CFrame * CFrame.new(c.DoubleOffset, 0, 0)).Position
		S.fx("Ability", { Character = char, Act = ACT, Move = "MengerSponge", Phase = "Crumble", Target = target, Duration = c.Time, DoublePos = doublePos, Leash = c.Leash })
		local ticks = math.floor(c.Time / c.Tick)
		for i = 1, ticks do
			task.delay(i * c.Tick, function()
				local t = target:FindFirstChild("HumanoidRootPart")
				if not t or target:GetAttribute("MengerCast") ~= token or not target:GetAttribute("MengerUntil") then
					return
				end
				-- Got away from their double: it's over.
				if (t.Position - doublePos).Magnitude > c.Leash then
					target:SetAttribute("MengerUntil", nil)
					local hum = target:FindFirstChildOfClass("Humanoid")
					if hum then
						S.Adapter.setMoveModifier(hum, "Menger", nil)
					end
					S.fx("Ability", { Act = ACT, Move = "MengerSponge", Phase = "Escape", Position = t.Position, Target = target, DoublePos = doublePos })
					return
				end
				local last = i == ticks
				S.hit(player, target, {
					Damage = c.TickDamage + c.TickGrowth * (i - 1) + (last and c.FinalDamage or 0),
					Stun = last and c.FinalStun or 0.25,
					Knockback = last and c.FinalKnockback or 0,
					Direction = t.Position - r.Position,
					Position = t.Position,
					Source = "ValentineMenger",
				})
				if last then
					target:SetAttribute("MengerUntil", nil)
					-- The burst catches whoever's right next to them.
					Moves.aoe(S, player, t.Position, c.BurstRadius, { Damage = c.BurstDamage, Stun = 0.5, Knockback = 20, Source = "ValentineMenger" }, 6, { [target] = true })
					S.fx("Ability", { Act = ACT, Move = "MengerSponge", Phase = "Burst", Position = t.Position, Target = target, Radius = c.BurstRadius })
				end
			end)
		end
	end)
end

function Valentine.Ability(S, player, state, slot, phase, aim)
	if phase ~= "Press" then
		return
	end
	if slot == 1 then
		dimensionHop(S, player, state, aim)
	elseif slot == 2 then
		parallelClone(S, player, state)
	elseif slot == 3 then
		mengerSponge(S, player, state, aim)
	end
end

---------------------------------------------------------------------------
-- D4C LOVE TRAIN (ultimate)
---------------------------------------------------------------------------
local trains = setmetatable({}, { __mode = "k" }) -- [character] = redirect function while it's up

local function registerTrain(S)
	if S.Adapter.DodgeHandlers and not S.Adapter.DodgeHandlers.LoveTrain then
		S.Adapter.DodgeHandlers.LoveTrain = function(attackerPlayer, target, info)
			local f = trains[target]
			if f then
				f(attackerPlayer, info)
			end
		end
	end
end

function Valentine.Ultimate(S, player, state, aim)
	local u = cfg.Ultimate
	if S.isBusy(state) or state.Charging then
		return
	end
	if not S.spendUlt(player) then
		return
	end
	registerTrain(S)
	local character, humanoid = alive(S, player)
	local life = state.Life
	S.lock(state, u.Windup + 0.2)
	character:SetAttribute("Armored", true)
	S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Board", Windup = u.Windup, Duration = u.Duration })
	task.delay(u.Windup, function()
		if character.Parent then
			character:SetAttribute("Armored", nil)
		end
		if state.Life ~= life or not alive(S, player) then
			return
		end
		S.finishUltimate(player, state)
		character:SetAttribute("LoveTrain", true)
		S.Adapter.setMoveModifier(humanoid, "LoveTrain", u.SpeedMultiplier)
		local lastRedirect = -math.huge
		-- Misfortune can't reach him: it lands on the nearest enemy instead.
		trains[character] = function(attackerPlayer, info)
			-- (Misfortune already bounced once is just cancelled: no ping-pong
			-- between two Love Trains.)
			if now() - lastRedirect < u.RedirectEvery or (info and info.Source == "ValentineLoveTrain") then
				return
			end
			lastRedirect = now()
			local _, _, r = alive(S, player)
			if not r then
				return
			end
			local victim = nearest(S, character, r, u.RedirectRange)
			local vr = victim and victim:FindFirstChild("HumanoidRootPart")
			S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Redirect", From = r.Position, To = vr and vr.Position, Victim = victim })
			if vr then
				local damage = math.max(u.RedirectMin, (tonumber(info and info.Damage) or 0) * u.RedirectShare)
				S.hit(player, victim, { Damage = damage, Stun = 0.5, Knockback = 10, Direction = vr.Position - r.Position, Position = vr.Position, Source = "ValentineLoveTrain" })
			end
		end
		task.delay(u.Duration, function()
			trains[character] = nil
			if character.Parent then
				character:SetAttribute("LoveTrain", nil)
			end
			if humanoid.Parent then
				S.Adapter.setMoveModifier(humanoid, "LoveTrain", nil)
			end
			if state.Life ~= life then
				return
			end
			local _, _, r = alive(S, player)
			if r then
				Moves.aoe(S, player, r.Position, u.PulseRadius, { Damage = u.PulseDamage, Stun = u.PulseStun, Knockback = u.PulseKnockback, Source = "ValentineLoveTrain" }, 8)
				S.fx("Ultimate", { Character = character, Act = ACT, Phase = "Pulse", Position = r.Position, Radius = u.PulseRadius })
			end
		end)
	end)
end

function Valentine.Cleanup(S, player, state)
	state.HopReturn = nil
	local character = state.Character
	if character then
		character:SetAttribute("Armored", nil)
		character:SetAttribute("LoveTrain", nil)
		character:SetAttribute("ParallelCloneUntil", nil)
		trains[character] = nil
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			S.Adapter.setMoveModifier(humanoid, "LoveTrain", nil)
		end
	end
end

return Valentine
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">TuskHitbox</string><ProtectedString name="Source"><![CDATA[--[[
	TuskHitbox  (ServerScriptService.SpinServer.TuskHitbox)
	Server-side spatial queries for melee and area attacks.
	Returns unique characters (models with a Humanoid), nearest first.
]]

local TuskHitbox = {}

local function characterFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end
TuskHitbox.characterFromPart = characterFromPart

local function collect(parts, attacker, origin, max)
	local seen, list = {}, {}
	for _, part in ipairs(parts) do
		local character = characterFromPart(part)
		if character and character ~= attacker and not seen[character] then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local root = character:FindFirstChild("HumanoidRootPart")
			if humanoid and root and humanoid.Health > 0 then
				seen[character] = true
				table.insert(list, { Character = character, Distance = (root.Position - origin).Magnitude })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Distance < b.Distance
	end)
	local out = {}
	for i = 1, math.min(#list, max or #list) do
		out[i] = list[i].Character
	end
	return out
end

local function overlapParams(attacker)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = attacker and { attacker } or {}
	return params
end

function TuskHitbox.inBox(attacker, cframe, size, max)
	local parts = workspace:GetPartBoundsInBox(cframe, size, overlapParams(attacker))
	return collect(parts, attacker, cframe.Position, max)
end

function TuskHitbox.inRadius(attacker, position, radius, max)
	local parts = workspace:GetPartBoundsInRadius(position, radius, overlapParams(attacker))
	return collect(parts, attacker, position, max)
end

-- True if nothing but characters blocks the line between the two points.
function TuskHitbox.lineOfSight(fromPos, toPos, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	params.IgnoreWater = true
	local offset = toPos - fromPos
	local result = workspace:Raycast(fromPos, offset, params)
	if not result then
		return true
	end
	return characterFromPart(result.Instance) ~= nil
end

return TuskHitbox
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">TuskMoves</string><ProtectedString name="Source"><![CDATA[--[[
	TuskMoves  (ServerScriptService.SpinServer.TuskMoves)

	Shared server building blocks for every Tusk Act, so each Act module
	only describes what makes it different:
	  m1(...)          generic 4-hit combo (portals, multi-hits, AoE finisher, nail hits)
	  findTarget(...)  nearest valid enemy in a cone with line of sight
	  aoe(...)         radius hit with line-of-sight checks
	  boxHit(...)      oriented box hit
	  safeStep(...)    validated short teleport / dash destination
	  nail(...)        fire a nail with standard damage handling
	All damage still goes through TuskService.hit -> CombatAdapter.
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)

local TuskMoves = {}
TuskMoves.HAND = CFrame.new(0.9, 0.55, -1.5)

local function alive(S, player)
	return S.Adapter.getAlive(player)
end

local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
TuskMoves.flat = flat

---------------------------------------------------------------------------
-- Targeting and area damage
---------------------------------------------------------------------------
function TuskMoves.findTarget(S, character, root, range, coneDegrees, direction)
	local look = flat(direction or root.CFrame.LookVector)
	local cosLimit = math.cos(math.rad((coneDegrees or 360) / 2))
	local best, bestDistance
	for _, target in ipairs(S.Hitbox.inRadius(character, root.Position, range)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr and S.Adapter.canBeHit(nil, target) then
			local offset = tr.Position - root.Position
			local f = Vector3.new(offset.X, 0, offset.Z)
			if f.Magnitude < 0.5 or f.Unit:Dot(look) >= cosLimit then
				if S.Hitbox.lineOfSight(root.Position, tr.Position, { character, target }) then
					if not bestDistance or offset.Magnitude < bestDistance then
						best, bestDistance = target, offset.Magnitude
					end
				end
			end
		end
	end
	return best
end

-- Damage everyone in a radius (line of sight from `center`). Returns hit count.
function TuskMoves.aoe(S, player, center, radius, info, maxTargets, exclude)
	local character = player.Character
	local count = 0
	for _, target in ipairs(S.Hitbox.inRadius(character, center, radius, maxTargets or 8)) do
		if not (exclude and exclude[target]) then
			local tr = target:FindFirstChild("HumanoidRootPart")
			if tr and S.Hitbox.lineOfSight(center, tr.Position, { character, target }) then
				local hitInfo = table.clone(info)
				hitInfo.Direction = info.Direction or (tr.Position - center)
				hitInfo.Position = tr.Position
				if S.hit(player, target, hitInfo) then
					count = count + 1
				end
			end
		end
	end
	return count
end

function TuskMoves.boxHit(S, player, cframe, size, info, maxTargets)
	local character, _, root = alive(S, player)
	local count, hitSet = 0, {}
	if not character then
		return 0, hitSet
	end
	for _, target in ipairs(S.Hitbox.inBox(character, cframe, size, maxTargets or 3)) do
		local tr = target:FindFirstChild("HumanoidRootPart")
		if tr and S.Hitbox.lineOfSight(root.Position, tr.Position, { character, target }) then
			local hitInfo = table.clone(info)
			hitInfo.Direction = info.Direction or (tr.Position - root.Position)
			hitInfo.Position = tr.Position
			if S.hit(player, target, hitInfo) then
				count = count + 1
				hitSet[target] = true
			end
		end
	end
	return count, hitSet
end

---------------------------------------------------------------------------
-- Movement
---------------------------------------------------------------------------
-- Validated destination for a short teleport/dash along a flat direction.
-- Stops before walls, needs ground below, and free space to stand in.
function TuskMoves.safeStep(character, root, direction, distance)
	local dir = flat(direction)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, workspace:FindFirstChild("SpinClientFX") }
	local wall = workspace:Raycast(root.Position, dir * distance, params)
	local travel = wall and (wall.Distance - 2.5) or distance
	if travel < 3 then
		return nil
	end
	local groundHere = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params)
	local height = groundHere and (root.Position.Y - groundHere.Position.Y) or 3
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { character }
	-- Walk back from the furthest point until a valid spot is found.
	local d = travel
	while d >= 3 do
		local probe = root.Position + dir * d
		local ground = workspace:Raycast(probe + Vector3.new(0, 4, 0), Vector3.new(0, -20, 0), params)
		if ground then
			local stand = Vector3.new(probe.X, ground.Position.Y + height, probe.Z)
			local blocked = false
			for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(stand), Vector3.new(2, 4.5, 2), overlap)) do
				if part.CanCollide then
					blocked = true
					break
				end
			end
			if not blocked then
				return stand
			end
		end
		d = d - 2
	end
	return nil
end

function TuskMoves.groundBelow(position, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	local hit = workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), params)
	return hit and hit.Position or position
end

---------------------------------------------------------------------------
-- Nails
---------------------------------------------------------------------------
--[[ spec: Origin, Direction, Speed, Radius, Range, Style, Charge,
          Damage, Stun, Knockback, Launch, Source, OnEnd ]]
function TuskMoves.nail(S, player, state, spec)
	return S.fireNail(player, state, {
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius or 0.7,
		Range = spec.Range,
		Style = spec.Style,
		Charge = spec.Charge,
		OnHit = function(target, position)
			S.hit(player, target, {
				Damage = spec.Damage,
				Stun = spec.Stun,
				Knockback = spec.Knockback,
				Launch = spec.Launch,
				Direction = spec.Direction,
				Position = position,
				Source = spec.Source or "TuskNail",
			})
		end,
		OnEnd = spec.OnEnd,
	})
end

---------------------------------------------------------------------------
-- Generic M1 combo
---------------------------------------------------------------------------
--[[ m1cfg.Hits[i] fields: Damage, Stun, Knockback, Launch,
     Portal (cosmetic), Repeat + RepeatInterval (multi-hit), AoeRadius
     (finisher hits a radius instead of the box), ShockwaveRadius (visual),
     Projectile = { Speed, Radius, Range } (nail instead of melee) ]]
function TuskMoves.m1(S, player, state, aim, m1cfg, act)
	if S.isBusy(state) or state.Charging then
		return
	end
	local now = os.clock()
	if now - state.LastM1 > m1cfg.ResetAfter then
		state.Combo = 0
	end
	local index = state.Combo + 1
	state.Combo = index >= 4 and 0 or index
	state.LastM1 = now
	local hit = m1cfg.Hits[index]
	local repeatTime = (hit.Repeat or 1) > 1 and (hit.Repeat - 1) * (hit.RepeatInterval or 0.08) or 0
	S.lock(state, (index == 4 and m1cfg.EndLag or m1cfg.Interval) + repeatTime)

	local character, _, root = alive(S, player)
	local direction = S.aim(aim, root)
	local life = state.Life
	S.fx("M1", { Character = character, Act = act, Index = index, Portal = hit.Portal == true, Repeat = hit.Repeat })

	local function strike(isLast)
		if not S.stillValid(player, state, life) then
			return
		end
		local char, _, r = alive(S, player)
		if hit.Projectile then
			TuskMoves.nail(S, player, state, {
				Origin = S.origin(char, r, TuskMoves.HAND),
				Direction = direction,
				Speed = hit.Projectile.Speed,
				Radius = hit.Projectile.Radius,
				Range = hit.Projectile.Range,
				Style = "M1",
				Damage = hit.Damage,
				Stun = hit.Stun,
				Knockback = hit.Knockback,
				Source = "TuskM1",
			})
			return
		end
		local boxCF = r.CFrame * CFrame.new(0, 0, -m1cfg.HitboxForward)
		local info = { Damage = hit.Damage, Stun = hit.Stun, Knockback = hit.Knockback, Launch = hit.Launch, Source = "TuskM1" }
		local landed
		if hit.AoeRadius and isLast then
			landed = TuskMoves.aoe(S, player, boxCF.Position, hit.AoeRadius, info, 5) > 0
		else
			landed = TuskMoves.boxHit(S, player, boxCF, m1cfg.HitboxSize, info, m1cfg.MaxTargets) > 0
		end
		if index == 4 and isLast then
			S.fx("M1Finisher", { Character = char, Act = act, Position = boxCF.Position, Radius = hit.ShockwaveRadius or 7, Hit = landed })
		end
	end

	local count = hit.Repeat or 1
	for i = 1, count do
		task.delay(m1cfg.Windup + (i - 1) * (hit.RepeatInterval or 0.08), function()
			strike(i == count)
		end)
	end
end

-- Ring of points around a center (portal placement shared by server and client payloads).
function TuskMoves.ring(center, count, radius, yaw, heightA, heightB)
	local points = {}
	for i = 1, count do
		local angle = (yaw or 0) + (i - 1) / count * math.pi * 2
		local h = (i % 2 == 0) and (heightB or 6) or (heightA or 4)
		table.insert(points, center + Vector3.new(math.cos(angle) * radius, h, math.sin(angle) * radius))
	end
	return points
end

TuskMoves.Config = TuskConfig
return TuskMoves
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">TuskService</string><ProtectedString name="Source"><![CDATA[--[[
	TuskService  (ServerScriptService.SpinServer.TuskService)

	Server brain for Tusk (the "TuskController" of the design doc):
	  * equips / switches Acts (validated against TuskActRegistry and
	    TuskConfig.Progression)
	  * routes every TuskRequest to the active Act module or TuskSneakService
	  * owns per-player state, action locks, cooldowns, the ultimate meter
	  * gives Act modules safe helpers: hit(), fireNail(), aim(), origin()...

	Request protocol (client -> server, TuskRequest:FireServer):
	  "Select", act          equip Act n (0 = unequip)
	  "M1", aim              basic attack (sneak attack while sneaking)
	  "Ability", slot, phase, aim   slot 1..3, phase "Press" | "Release"
	  "Ultimate", aim
	  "Sneak", on

	Attributes it sets (replicated; clients render from them):
	  Player.TuskUlt (0..Max)  Character.TuskAct  Character.TuskCharge
	  Character.TuskAwakened   Character.Armored  (Sneak ones: see TuskSneakService)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Registry = require(Shared.TuskActRegistry)
local Net = require(Shared.Net)
local Adapter = require(script.Parent.CombatAdapter)
local Cooldowns = require(script.Parent.CooldownService)
local Projectiles = require(script.Parent.ProjectileService)
local Hitbox = require(script.Parent.TuskHitbox)

local Request = Net.get("TuskRequest")
local FX = Net.get("TuskFX")

local TuskService = {}
TuskService.Hitbox = Hitbox
TuskService.Adapter = Adapter

local states = {} -- [player] = state
local rate = {}
local actModules = {}
local Defense -- DefenseService (block / dash), loaded in init
local Sneak -- set in init (circular dependency)

local RATE_LIMIT = 24 -- requests per second

---------------------------------------------------------------------------
-- Helpers for Act modules
---------------------------------------------------------------------------
function TuskService.getState(player)
	return states[player]
end

function TuskService.fx(name, data)
	FX:FireAllClients(name, data)
end

function TuskService.tell(player, kind, data)
	if typeof(player) ~= "Instance" then
		return -- a Stand-user NPC (StandBots): nobody to tell
	end
	data = data or {}
	data.Kind = kind
	FX:FireClient(player, "TuskState", data)
end

function TuskService.isBusy(state)
	return os.clock() < state.LockUntil
end

function TuskService.lock(state, seconds)
	state.LockUntil = math.max(state.LockUntil, os.clock() + seconds)
end

local function cooldownKey(state, name)
	return "Tusk" .. state.Act .. "_" .. name
end

-- Returns true if ready; otherwise tells the client how long is left.
function TuskService.cooldownReady(player, state, name, slot)
	local remaining = Cooldowns.remaining(player, cooldownKey(state, name))
	if remaining > 0 then
		TuskService.tell(player, "Denied", { Reason = "Cooldown", Slot = slot, Remaining = remaining })
		return false
	end
	return true
end

function TuskService.startCooldown(player, state, name, seconds, slot)
	Cooldowns.start(player, cooldownKey(state, name), seconds)
	TuskService.tell(player, "Cooldown", { Slot = slot, Duration = seconds })
end

-- A token that changes on death / Act switch, so delayed actions can
-- check they still belong to the same "life".
function TuskService.stillValid(player, state, life, allowStunned)
	if states[player] ~= state or state.Life ~= life then
		return false
	end
	if allowStunned then
		return Adapter.getAlive(player) ~= nil
	end
	return Adapter.canAct(player)
end

function TuskService.aim(aim, root)
	local fallback = root.CFrame.LookVector
	if typeof(aim) ~= "Vector3" or aim ~= aim or aim.Magnitude < 1e-3 or aim.Magnitude > 1e4 then
		return fallback
	end
	if aim.X ~= aim.X or aim.Y ~= aim.Y or aim.Z ~= aim.Z then
		return fallback
	end
	local unit = aim.Unit
	local y = math.clamp(unit.Y, -0.8, 0.8)
	local flat = Vector3.new(unit.X, 0, unit.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(fallback.X, 0, fallback.Z)
	end
	flat = flat.Unit * math.sqrt(1 - y * y)
	return Vector3.new(flat.X, y, flat.Z).Unit
end

-- Spawn point for attacks, pulled back to the root if a wall is in the way.
function TuskService.origin(character, root, offset)
	local desired = (root.CFrame * offset).Position
	if Hitbox.lineOfSight(root.Position, desired, { character }) then
		return desired
	end
	return root.Position
end

function TuskService.addUlt(player, amount)
	local max = TuskConfig.Ultimate.MaxMeter
	local state = states[player]
	local byAct = TuskConfig.Ultimate.GainByAct
	if state and state.Act and byAct and byAct[state.Act] then
		amount = amount * byAct[state.Act]
	end
	local current = player:GetAttribute("TuskUlt") or 0
	player:SetAttribute("TuskUlt", math.clamp(current + amount, 0, max))
end

function TuskService.spendUlt(player)
	local max = TuskConfig.Ultimate.MaxMeter
	if (player:GetAttribute("TuskUlt") or 0) < max then
		TuskService.tell(player, "Denied", { Reason = "UltNotReady" })
		return false
	end
	-- Each Act must be played for a while before the next awakening.
	local state = states[player]
	local wait = TuskConfig.Ultimate.MinSecondsPerAct or 0
	if state and state.ActSince and os.clock() - state.ActSince < wait then
		TuskService.tell(player, "Denied", { Reason = "TooSoon", Remaining = wait - (os.clock() - state.ActSince) })
		return false
	end
	player:SetAttribute("TuskUlt", 0)
	return true
end

-- All Tusk damage goes through here: CombatAdapter + ultimate meter.
function TuskService.hit(player, targetCharacter, info)
	local ok, damage = Adapter.dealHit(player, targetCharacter, info)
	if ok then
		TuskService.addUlt(player, (damage or 0) * TuskConfig.Ultimate.GainPerDamage)
	end
	return ok
end

-- Server projectile with a Tusk nail visual.
function TuskService.fireNail(player, state, spec)
	return Projectiles.fire(player, {
		Kind = "TuskNail",
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Visual = {
			Act = state.Act,
			Style = spec.Style or "Shot",
			Charge = spec.Charge or 0,
			Awakened = state.Awakened == true,
			Stage = spec.Stage,
		},
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd,
	})
end

-- Server projectile with a Steel Ball visual (Gyro).
function TuskService.fireBall(player, state, spec)
	return Projectiles.fire(player, {
		Kind = "GyroBall",
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Visual = { Style = spec.Style or "Throw", Scale = spec.Scale, Bounce = spec.Bounce },
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd,
	})
end

-- Server projectile with a Wired fish-hook visual (Pork Pie Hat Kid).
function TuskService.fireHook(player, state, spec)
	return Projectiles.fire(player, {
		Kind = "WiredHook",
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Visual = { Style = spec.Style or "Hook" },
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd,
	})
end

-- Server projectile with a written-sound visual (Sandman: In a Silent Way).
function TuskService.fireWord(player, state, spec)
	return Projectiles.fire(player, {
		Kind = "SoundWord",
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Visual = { Text = spec.Text or "ZBAAK!", Style = spec.Style or "Slash" },
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd,
	})
end

-- Server projectile with a lasso visual (Mountain Tim).
function TuskService.fireLasso(player, state, spec)
	return Projectiles.fire(player, {
		Kind = "TimLasso",
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Visual = { Style = spec.Style or "Lasso", Character = spec.Character },
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd,
	})
end

-- Server projectile with a frozen-raindrop visual (Blackmore).
function TuskService.fireRain(player, state, spec)
	return Projectiles.fire(player, {
		Kind = "RainDrop",
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Visual = { Style = spec.Style or "Drop" },
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd,
	})
end

-- Server projectile with a piece of abandoned junk as the visual (Axl RO).
function TuskService.fireJunk(player, state, spec)
	return Projectiles.fire(player, {
		Kind = "GuiltJunk",
		Origin = spec.Origin,
		Direction = spec.Direction,
		Speed = spec.Speed,
		Radius = spec.Radius,
		Range = spec.Range,
		Visual = { Style = spec.Style or "Crate" },
		OnHit = spec.OnHit,
		OnEnd = spec.OnEnd,
	})
end

-- Some characters walk faster or slower (Registry WalkSpeed, e.g. Sandman).
function TuskService.applyCharacterSpeed(state)
	local character = state and state.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local info = state.Act and Registry.get(state.Act)
	local mult = info and info.WalkSpeed or 1
	Adapter.setMoveModifier(humanoid, "CharacterSpeed", mult ~= 1 and mult or nil)
end

-- Charge helpers (hold abilities): sets the replicated TuskCharge attribute.
function TuskService.beginCharge(player, state, move, slot, multiplier)
	local character, humanoid = Adapter.getAlive(player)
	state.Charging = { Move = move, Slot = slot, Start = os.clock(), Token = {} }
	Adapter.setMoveModifier(humanoid, "TuskCharge", multiplier or 1)
	character:SetAttribute("TuskCharge", workspace:GetServerTimeNow())
	character:SetAttribute("TuskChargeMove", move)
	return state.Charging
end

function TuskService.endCharge(player, state)
	local charge = state.Charging
	state.Charging = nil
	local character = state.Character
	if character then
		character:SetAttribute("TuskCharge", nil)
		character:SetAttribute("TuskChargeMove", nil)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			Adapter.setMoveModifier(humanoid, "TuskCharge", nil)
		end
	end
	return charge
end

---------------------------------------------------------------------------
-- Equip / switch
---------------------------------------------------------------------------
local function cleanupAct(player, state)
	state.Life = state.Life + 1
	if Defense then
		Defense.release(player, state)
	end
	local module = state.Act and actModules[state.Act]
	if module and module.Cleanup then
		pcall(module.Cleanup, TuskService, player, state)
	end
	TuskService.endCharge(player, state)
	if Sneak then
		Sneak.exit(player, state, false)
	end
	if state.Character then
		state.Character:SetAttribute("Armored", nil)
		state.Character:SetAttribute("TuskAwakened", nil)
	end
	state.Awakened = false
	state.Combo = 0
	state.LockUntil = 0
end

local function isUnlocked(player, act)
	local p = TuskConfig.Progression
	if p.Mode == "Awaken" then
		-- Acts are reached through ultimates; the menu is a Studio testing aid only.
		return RunService:IsStudio() and p.StudioMenu == true
	end
	if p.Mode == "Unlock" then
		return p.IsUnlocked ~= nil and p.IsUnlocked(player, act) == true
	end
	return true
end

function TuskService.select(player, act, internal)
	if typeof(act) ~= "number" or act ~= math.floor(act) then
		return
	end
	local state = states[player]
	if not state then
		return
	end
	if act == 0 then
		cleanupAct(player, state)
		state.Act = nil
		if state.Character then
			state.Character:SetAttribute("TuskAct", nil)
		end
		TuskService.tell(player, "Equipped", { Act = 0 })
		return
	end
	if not Registry.isImplemented(act) or not actModules[act] then
		TuskService.tell(player, "Denied", { Reason = "NotAvailable" })
		return
	end
	if not internal and not isUnlocked(player, act) then
		TuskService.tell(player, "Denied", { Reason = "Locked" })
		return
	end
	if state.Act == act then
		return
	end
	if not internal and (os.clock() - state.LastSwitch < TuskConfig.Progression.SwitchCooldown or TuskService.isBusy(state)) then
		TuskService.tell(player, "Denied", { Reason = "SwitchCooldown" })
		return
	end
	cleanupAct(player, state)
	state.Act = act
	state.LastSwitch = os.clock()
	TuskService.markActStart(player, state)
	player:SetAttribute("TuskSelectedAct", act)
	if state.Character then
		state.Character:SetAttribute("TuskAct", act)
	end
	TuskService.applyCharacterSpeed(state)
	TuskService.tell(player, "Equipped", { Act = act })
end

-- Remember when the current Act began (the HUD shows the lock timer).
function TuskService.markActStart(player, state)
	state.ActSince = os.clock()
	player:SetAttribute("TuskActSince", workspace:GetServerTimeNow())
end

-- Awakening: move straight to another Act (no menu rules, no switch cooldown).
function TuskService.evolve(player, state, toAct)
	if not Registry.isImplemented(toAct) or not actModules[toAct] then
		return
	end
	local from = state.Act
	cleanupAct(player, state)
	state.Act = toAct
	TuskService.markActStart(player, state)
	player:SetAttribute("TuskSelectedAct", toAct)
	if state.Character then
		state.Character:SetAttribute("TuskAct", toAct)
	end
	TuskService.applyCharacterSpeed(state)
	TuskService.fx("Evolve", { Character = state.Character, From = from, To = toAct })
	TuskService.tell(player, "Evolved", { Act = toAct })
end

-- Called by every Act's ultimate when its attack has finished.
function TuskService.finishUltimate(player, state)
	local info = Registry.get(state.Act)
	if TuskConfig.Progression.Mode == "Awaken" and info and info.Next then
		TuskService.evolve(player, state, info.Next)
	end
	if RunService:IsStudio() and TuskConfig.Ultimate.StudioRefill then
		player:SetAttribute("TuskUlt", TuskConfig.Ultimate.MaxMeter)
	end
end

---------------------------------------------------------------------------
-- Request routing
---------------------------------------------------------------------------
local function rateLimited(player)
	local r = rate[player]
	local now = os.clock()
	if not r or now - r.Start >= 1 then
		rate[player] = { Start = now, Count = 1 }
		return false
	end
	r.Count = r.Count + 1
	return r.Count > RATE_LIMIT
end

local function onRequest(player, action, a, b, c)
	if rateLimited(player) or typeof(action) ~= "string" then
		return
	end
	if action == "Select" then
		TuskService.select(player, a)
		return
	end
	if action == "Character" then
		-- Character dropdown: "Johnny" (Tusk, starts at Act 1) or "Gyro" (Ball Breaker).
		local st = states[player]
		local start = typeof(a) == "string" and Registry.StartAct[a]
		if not st or not start then
			return
		end
		if st.Act and Registry.characterOf(st.Act) == a then
			return -- already playing that character
		end
		if TuskService.isBusy(st) or st.Charging or st.Burrowed then
			return
		end
		TuskService.select(player, start, true)
		return
	end
	if action == "RainFloat" then
		-- Blackmore standing on frozen raindrops in mid-air (the movement is the
		-- client's; this only shows the drops to everyone).
		local st = states[player]
		local character = player.Character
		if not st or not character or st.Act ~= 11 then
			return
		end
		local raining = game:GetService("ReplicatedStorage"):GetAttribute("SpinRaining") == true
			or (character:GetAttribute("RainStormUntil") or 0) > workspace:GetServerTimeNow()
		if a == true and raining then
			local cfg = TuskConfig.Blackmore and TuskConfig.Blackmore.RainWalk
			local token = tostring({})
			character:SetAttribute("RainFloating", token)
			task.delay((cfg and cfg.FloatTime or 6) + 0.5, function()
				if character:GetAttribute("RainFloating") == token then
					character:SetAttribute("RainFloating", nil)
				end
			end)
		else
			character:SetAttribute("RainFloating", nil)
		end
		return
	end
	local state = states[player]
	if not state or not state.Act or not state.Character then
		return
	end
	local module = actModules[state.Act]

	local isJohnny = Registry.characterOf(state.Act) == "Johnny"
	if action == "Sneak" then
		if isJohnny then -- Tusk Sneak is Johnny's
			Sneak.toggle(player, state, a == true)
		end
		return
	end
	if state.Burrowed then
		return
	end
	-- Block and Dash work for every character.
	if action == "Block" then
		Defense.block(player, state, a == true)
		return
	elseif action == "Dash" then
		Defense.dash(player, state, a)
		return
	end
	-- Attacking drops the block.
	if action == "M1" or action == "Ultimate" or (action == "Ability" and b ~= "Release") then
		Defense.release(player, state)
	end

	-- Releasing a held ability is allowed even mid-lock; everything else needs a free player.
	if action == "Ability" and b == "Release" then
		if typeof(a) == "number" and module.Ability then
			module.Ability(TuskService, player, state, a, "Release", c)
		end
		return
	end
	if not Adapter.canAct(player) then
		return
	end

	if action == "M1" then
		if state.Sneaking then
			Sneak.attack(player, state)
		else
			module.M1(TuskService, player, state, a)
		end
	elseif action == "Ability" then
		if typeof(a) ~= "number" or (a ~= 1 and a ~= 2 and a ~= 3) then
			return
		end
		if state.Sneaking then
			Sneak.exit(player, state, true)
		end
		module.Ability(TuskService, player, state, a, "Press", c)
	elseif action == "Ultimate" then
		if state.Sneaking then
			Sneak.exit(player, state, true)
		end
		module.Ultimate(TuskService, player, state, a)
	end
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------
local function onCharacter(player, character)
	local state = states[player]
	if not state then
		return
	end
	cleanupAct(player, state)
	state.Character = character
	state.Burrowed = false
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or states[player] ~= state or state.Character ~= character then
		return
	end
	local progression = TuskConfig.Progression
	if state.Act and progression.Mode == "Awaken" and progression.ResetOnDeath then
		-- Back to the character's first Act after dying (Johnny -> Act 1; Gyro stays Gyro).
		state.Act = Registry.StartAct[Registry.characterOf(state.Act)] or progression.DefaultAct
		TuskService.markActStart(player, state)
	end
	if state.Act then
		character:SetAttribute("TuskAct", state.Act)
	end
	TuskService.applyCharacterSpeed(state)
	humanoid.Died:Connect(function()
		if state.Character == character then
			cleanupAct(player, state)
		end
	end)
	-- Getting stunned interrupts charges and breaks sneak (counterplay).
	character:GetAttributeChangedSignal(Adapter.Settings.StunAttribute):Connect(function()
		if not Adapter.isStunned(character) or state.Character ~= character then
			return
		end
		if Defense then
			Defense.release(player, state) -- a stun knocks you out of your block
		end
		if state.Charging then
			local module = state.Act and actModules[state.Act]
			if module and module.CancelCharge then
				module.CancelCharge(TuskService, player, state)
			else
				TuskService.endCharge(player, state)
			end
			TuskService.tell(player, "Interrupted", {})
		end
		if state.Sneaking then
			Sneak.exit(player, state, true)
		end
	end)
end

local function onPlayer(player)
	states[player] = {
		Act = nil,
		Character = nil,
		Life = 0,
		Combo = 0,
		LastM1 = 0,
		LockUntil = 0,
		LastSwitch = -math.huge,
		Charging = nil,
		Sneaking = false,
		Burrowed = false,
		Awakened = false,
	}
	player:SetAttribute("TuskUlt", (RunService:IsStudio() and TuskConfig.Ultimate.StudioStartFull) and TuskConfig.Ultimate.MaxMeter or 0)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	if TuskConfig.Progression.AutoEquip then
		task.defer(TuskService.select, player, TuskConfig.Progression.DefaultAct, true)
	end
end

-- Stand-user NPCs (StandBots): a bot is a table that looks enough like a
-- Player for the move code ({ Name, UserId < 0, Character, Neutral,
-- GetAttribute, SetAttribute }). It gets a normal state and plays an Act.
function TuskService.hasAct(act)
	return actModules[act] ~= nil
end

function TuskService.actModule(act)
	return actModules[act]
end

function TuskService.addBot(bot, act)
	local state = {
		Act = nil,
		Character = bot.Character,
		Life = 0,
		Combo = 0,
		LastM1 = 0,
		LockUntil = 0,
		LastSwitch = -math.huge,
		Charging = nil,
		Sneaking = false,
		Burrowed = false,
		Awakened = false,
		IsBot = true,
	}
	states[bot] = state
	bot:SetAttribute("TuskUlt", 0)
	TuskService.select(bot, act, true)
	local humanoid = bot.Character and bot.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			if states[bot] == state then
				cleanupAct(bot, state)
			end
		end)
	end
	return state
end

function TuskService.removeBot(bot)
	local state = states[bot]
	if state then
		cleanupAct(bot, state)
		states[bot] = nil
	end
end

function TuskService.init()
	local actsFolder = script.Parent:WaitForChild("TuskActs")
	for act, info in pairs(Registry.Acts) do
		local moduleScript = actsFolder:FindFirstChild(info.Module or ("TuskAct" .. act))
		if moduleScript and Registry.isImplemented(act) then
			actModules[act] = require(moduleScript)
		end
	end
	Sneak = require(script.Parent.TuskSneakService)
	Sneak.init(TuskService)
	Defense = require(script.Parent.DefenseService)
	Defense.init(TuskService)
	TuskService.Defense = Defense
	-- Tell every client which characters this server can actually play (each
	-- non-Johnny character is an optional script), so the menu can say so.
	local installed, seen = {}, {}
	for act in pairs(actModules) do
		local who = Registry.characterOf(act)
		if not seen[who] then
			seen[who] = true
			table.insert(installed, who)
		end
	end
	table.sort(installed)
	game:GetService("ReplicatedStorage"):SetAttribute("SpinInstalledCharacters", table.concat(installed, ","))
	print("[Spin] Characters installed: " .. table.concat(installed, ", "))

	Request.OnServerEvent:Connect(onRequest)
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local state = states[player]
		if state then
			cleanupAct(player, state)
		end
		states[player] = nil
		rate[player] = nil
	end)
end

return TuskService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">TuskSneakService</string><ProtectedString name="Source"><![CDATA[--[[
	TuskSneakService  (ServerScriptService.SpinServer.TuskSneakService)

	Tusk Sneak (every Act): a crouched, slowed stalking state, plus the
	Sneak Attack (M1 while sneaking):
	  1. Tusk sinks into the ground (Burrow): invisible and briefly untargetable
	  2. a distortion warning appears under the target (WarningTime before emergence)
	  3. Tusk emerges behind the target at a server-validated safe spot
	  4. surprise hit + launch, finished with a blue shockwave

	Counterplay: the warning is visible and audible, a target that moves
	MaxTargetDrift studs away is missed, getting hit breaks sneak, and both
	sneak and the attack have cooldowns.

	Character attributes: TuskSneaking, TuskBurrowed.
]]

local Shared = game:GetService("ReplicatedStorage").SpinShared
local TuskConfig = require(Shared.TuskConfig)
local Adapter = require(script.Parent.CombatAdapter)
local Cooldowns = require(script.Parent.CooldownService)
local Hitbox = require(script.Parent.TuskHitbox)

local TuskSneakService = {}
local S -- TuskService

local cfg = TuskConfig.Sneak

function TuskSneakService.init(service)
	S = service
end

function TuskSneakService.exit(player, state, applyCooldown)
	if not state.Sneaking then
		return
	end
	state.Sneaking = false
	state.SneakToken = nil
	local character = state.Character
	if character then
		character:SetAttribute("TuskSneaking", nil)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			Adapter.setMoveModifier(humanoid, "TuskSneak", nil)
		end
	end
	if applyCooldown then
		Cooldowns.start(player, "TuskSneak", cfg.Cooldown)
		S.tell(player, "SneakCooldown", { Duration = cfg.Cooldown })
	end
end

function TuskSneakService.toggle(player, state, on)
	if not on then
		TuskSneakService.exit(player, state, true)
		return
	end
	if state.Sneaking or state.Charging or S.isBusy(state) or not Adapter.canAct(player) then
		return
	end
	local remaining = Cooldowns.remaining(player, "TuskSneak")
	if remaining > 0 then
		S.tell(player, "Denied", { Reason = "SneakCooldown", Remaining = remaining })
		return
	end
	local character, humanoid = Adapter.getAlive(player)
	state.Sneaking = true
	local token = {}
	state.SneakToken = token
	character:SetAttribute("TuskSneaking", true)
	Adapter.setMoveModifier(humanoid, "TuskSneak", cfg.WalkSpeedMultiplier)
	task.delay(cfg.MaxDuration, function()
		if state.SneakToken == token then
			TuskSneakService.exit(player, state, true)
		end
	end)
end

-- Nearest enemy in front, in range, with line of sight.
local function findTarget(character, root, range, coneDegrees)
	range = range or cfg.Attack.Range
	coneDegrees = coneDegrees or cfg.Attack.ConeDegrees
	local best, bestDistance
	local cosLimit = math.cos(math.rad(coneDegrees / 2))
	for _, target in ipairs(Hitbox.inRadius(character, root.Position, range)) do
		local targetRoot = target:FindFirstChild("HumanoidRootPart")
		if targetRoot and Adapter.canBeHit(nil, target) then
			local offset = targetRoot.Position - root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			if flat.Magnitude > 0.1 and flat.Unit:Dot(look.Unit) >= cosLimit then
				if Hitbox.lineOfSight(root.Position, targetRoot.Position, { character, target }) then
					if not bestDistance or offset.Magnitude < bestDistance then
						best, bestDistance = target, offset.Magnitude
					end
				end
			end
		end
	end
	return best
end

-- Safe emergence point near the target: behind first, then the sides, then in front.
-- Must have clear line of sight from the target, solid ground below and free space.
TuskSneakService.findTarget = findTarget

local function emergePoint(attacker, target, distance)
	local targetRoot = target.HumanoidRootPart
	local d = distance or cfg.Attack.EmergeDistance
	local candidates = {
		targetRoot.CFrame * CFrame.new(0, 0, d),
		targetRoot.CFrame * CFrame.new(d, 0, 0),
		targetRoot.CFrame * CFrame.new(-d, 0, 0),
		targetRoot.CFrame * CFrame.new(0, 0, -d),
	}
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { attacker, target }
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { attacker, target }
	for _, cf in ipairs(candidates) do
		local pos = cf.Position
		if Hitbox.lineOfSight(targetRoot.Position, pos, { attacker, target }) then
			local ground = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), rayParams)
			if ground then
				local standPos = ground.Position + Vector3.new(0, 3, 0)
				local blocking = workspace:GetPartBoundsInBox(CFrame.new(standPos), Vector3.new(2, 4.5, 2), overlap)
				local solid = false
				for _, part in ipairs(blocking) do
					if part.CanCollide then
						solid = true
						break
					end
				end
				if not solid then
					return standPos
				end
			end
		end
	end
	return nil
end

function TuskSneakService.attack(player, state)
	local a = cfg.Attack
	if S.isBusy(state) or state.Charging then
		return
	end
	local remaining = Cooldowns.remaining(player, "TuskSneakAttack")
	if remaining > 0 then
		S.tell(player, "Denied", { Reason = "SneakAttackCooldown", Remaining = remaining })
		return
	end
	local character, _, root = Adapter.getAlive(player)
	local target = findTarget(character, root)
	if not target then
		Cooldowns.start(player, "TuskSneakAttack", a.FailCooldown)
		S.tell(player, "Denied", { Reason = "NoTarget" })
		return
	end

	TuskSneakService.exit(player, state, true)
	Cooldowns.start(player, "TuskSneakAttack", a.Cooldown)
	S.tell(player, "SneakAttackCooldown", { Duration = a.Cooldown })
	TuskSneakService.burrowStrike(player, state, target, a, "TuskSneakAttack")
end

--[[
	Burrow -> warning -> emerge behind the target -> hit + shockwave.
	Shared by the Sneak Attack and Act 2's Underground Pursuit.
	a = { BurrowTime, WarningTime, EmergeDistance, MaxTargetDrift, Range,
	      HitRadius, Damage, Stun, Knockback, Launch }
]]
function TuskSneakService.burrowStrike(player, state, target, a, source)
	local character, _, root = Adapter.getAlive(player)
	if not character then
		return
	end
	a = setmetatable(table.clone(a), { __index = cfg.Attack })
	S.lock(state, a.BurrowTime + 0.45)

	local life = state.Life
	local startPos = root.Position
	local targetStart = target.HumanoidRootPart.Position
	state.Burrowed = true
	character:SetAttribute("TuskBurrowed", true)
	character:SetAttribute(Adapter.Settings.IFrameAttribute, true)
	-- Anchor in place while underground so the hidden body can't wander.
	root.Anchored = true

	S.fx("SneakAttack", { Phase = "Burrow", Character = character, Position = startPos - Vector3.new(0, 2.8, 0), Target = target, BurrowTime = a.BurrowTime })

	local function surface()
		state.Burrowed = false
		if character.Parent then
			character:SetAttribute("TuskBurrowed", nil)
			character:SetAttribute(Adapter.Settings.IFrameAttribute, nil)
			if root.Parent then
				root.Anchored = false
			end
		end
	end

	task.delay(a.BurrowTime - a.WarningTime, function()
		if state.Life ~= life or not target.Parent then
			return
		end
		local targetRoot = target:FindFirstChild("HumanoidRootPart")
		if targetRoot then
			S.fx("SneakAttack", { Phase = "Warning", Character = character, Target = target, Position = targetRoot.Position - Vector3.new(0, 2.8, 0), Duration = a.WarningTime })
		end
	end)

	task.delay(a.BurrowTime, function()
		if state.Life ~= life or not Adapter.getAlive(player) then
			surface()
			return
		end
		local targetRoot = target.Parent and target:FindFirstChild("HumanoidRootPart")
		local valid = targetRoot
			and Adapter.canBeHit(player, target)
			and (targetRoot.Position - targetStart).Magnitude <= a.MaxTargetDrift
			and (targetRoot.Position - startPos).Magnitude <= a.Range * 1.4
		local pos = valid and emergePoint(character, target, a.EmergeDistance) or nil

		surface()
		if not pos then
			-- Whiff: surface where we went under.
			S.fx("SneakAttack", { Phase = "Emerge", Character = character, Position = startPos - Vector3.new(0, 2.8, 0), Hit = false })
			return
		end
		local facing = Vector3.new(targetRoot.Position.X, pos.Y, targetRoot.Position.Z)
		character:PivotTo(CFrame.lookAt(pos, facing))
		S.fx("SneakAttack", { Phase = "Emerge", Character = character, Position = pos - Vector3.new(0, 2.8, 0), Hit = true })

		local hitAny = false
		for _, victim in ipairs(Hitbox.inRadius(character, pos, a.HitRadius, 3)) do
			local victimRoot = victim:FindFirstChild("HumanoidRootPart")
			if victimRoot and Hitbox.lineOfSight(pos, victimRoot.Position, { character, victim }) then
				local hit = S.hit(player, victim, {
					Damage = a.Damage,
					Stun = a.Stun,
					Knockback = a.Knockback,
					Launch = a.Launch,
					Direction = victimRoot.Position - pos,
					Position = victimRoot.Position,
					Source = source or "TuskSneakAttack",
				})
				hitAny = hitAny or hit
			end
		end
		S.fx("SneakAttack", { Phase = "Shockwave", Character = character, Position = pos - Vector3.new(0, 2.8, 0), Hit = hitAny })
	end)
end

return TuskSneakService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">ValentineOutfit</string><ProtectedString name="Source"><![CDATA[--[[
	ValentineOutfit  (ServerScriptService.SpinServer.ValentineOutfit)

	Gives a character Funny Valentine's look while they play him (TuskAct
	13), built from blocky parts (no catalog asset ids), matched to his art:
	  * long wavy blond hair down to his shoulders with big spiral ringlets
	    at the sides
	  * a pink long coat: a high grey collar, ribbed sleeves with grey
	    ruffled cuffs, the skirt flaring down to his calves
	  * magenta padded trousers with a belt, tall magenta boots
	  * magenta gloves with a lattice pattern
	The player's own hats/hair are hidden while they play him and come back
	when they switch. Built on the server so every player sees it.
]]

local Players = game:GetService("Players")

local ValentineOutfit = {}
ValentineOutfit.Act = 13

local C = {
	Hair = Color3.fromRGB(238, 218, 130),
	HairDark = Color3.fromRGB(204, 180, 96),
	Coat = Color3.fromRGB(232, 150, 196),
	CoatShade = Color3.fromRGB(200, 116, 166),
	CoatDark = Color3.fromRGB(170, 86, 136),
	Collar = Color3.fromRGB(120, 116, 124),
	Pants = Color3.fromRGB(196, 96, 210),
	PantsShade = Color3.fromRGB(160, 70, 178),
	Belt = Color3.fromRGB(120, 54, 136),
	Glove = Color3.fromRGB(214, 110, 196),
	GloveLine = Color3.fromRGB(150, 60, 140),
}

local saved = setmetatable({}, { __mode = "k" })

local function piece(parent, outfit, name, size, color, offset)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = outfit
	return p
end

-- A spiral ringlet: a ring of blocks curling round, facing sideways.
local function ringlet(head, outfit, cf, r, s)
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2
		local rr = r * (1 - k * 0.07)
		piece(head, outfit, "Ringlet", Vector3.new(0.14 * s, 0.2 * s, 0.2 * s), k % 2 == 0 and C.Hair or C.HairDark, cf * CFrame.new(0, math.sin(a) * rr, math.cos(a) * rr) * CFrame.Angles(-a, 0, 0))
	end
	piece(head, outfit, "RingletCore", Vector3.new(0.14 * s, 0.14 * s, 0.14 * s), C.HairDark, cf)
end

local function headPieces(head, outfit)
	local s = head.Size.Y / 1.2
	local w, h, d = head.Size.X / 2, head.Size.Y / 2, head.Size.Z / 2
	-- Long wavy blond hair: over the top, a side part, down past the shoulders at the back.
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.18 * s, 0.32 * s, head.Size.Z + 0.18 * s), C.Hair, CFrame.new(0, h - 0.02 * s, 0.02 * s))
	piece(head, outfit, "Bangs", Vector3.new(head.Size.X * 0.7, 0.3 * s, 0.12 * s), C.Hair, CFrame.new(-0.14 * s, h - 0.24 * s, -d - 0.04 * s) * CFrame.Angles(0, 0, 0.25))
	piece(head, outfit, "Hair", Vector3.new(head.Size.X + 0.3 * s, 1.5 * s, 0.26 * s), C.Hair, CFrame.new(0, -0.4 * s, d + 0.1 * s))
	piece(head, outfit, "HairWave", Vector3.new(head.Size.X + 0.34 * s, 0.12 * s, 0.28 * s), C.HairDark, CFrame.new(0, -0.6 * s, d + 0.11 * s))
	for _, side in ipairs({ -1, 1 }) do
		piece(head, outfit, "Hair", Vector3.new(0.18 * s, 1.2 * s, head.Size.Z * 0.85), C.Hair, CFrame.new(side * (w + 0.08 * s), -0.2 * s, 0.06 * s))
		-- Big spiral ringlets at the sides, one high and one at the shoulder.
		ringlet(head, outfit, CFrame.new(side * (w + 0.26 * s), 0.05 * s, -0.05 * s), 0.3 * s, s)
		ringlet(head, outfit, CFrame.new(side * (w + 0.22 * s), -0.75 * s, 0.15 * s), 0.26 * s, s)
	end
end

local function body(character, outfit)
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso")
	if upper then
		local s = upper.Size
		local top, front = s.Y / 2, -s.Z / 2
		piece(upper, outfit, "Coat", s + Vector3.new(0.1, 0.02, 0.1), C.Coat, CFrame.new())
		-- High grey collar.
		piece(upper, outfit, "Collar", Vector3.new(s.X * 0.6, 0.44, s.Z + 0.22), C.Collar, CFrame.new(0, top + 0.16, 0.02))
		piece(upper, outfit, "CollarFold", Vector3.new(s.X * 0.75, 0.2, s.Z + 0.26), C.CoatShade, CFrame.new(0, top - 0.02, 0.02))
		-- The coat closes in a diagonal line across the chest.
		piece(upper, outfit, "Closure", Vector3.new(0.08, s.Y * 1.05, 0.05), C.CoatDark, CFrame.new(0.15, -0.05, front - 0.06) * CFrame.Angles(0, 0, -0.18))
		piece(upper, outfit, "Panel", Vector3.new(s.X * 0.45, s.Y * 0.9, 0.05), C.CoatShade, CFrame.new(-0.42, -0.05, front - 0.05))
	end
	-- Long flaring coat skirt (front split), magenta trousers with a belt.
	local waist = lower or upper
	if waist then
		local ws = waist.Size
		local waistTop = lower and ws.Y / 2 or -upper.Size.Y / 2 + 0.3
		if lower then
			piece(lower, outfit, "Pants", ws + Vector3.new(0.06, 0.02, 0.06), C.Pants, CFrame.new())
		end
		piece(waist, outfit, "Belt", Vector3.new(ws.X + 0.1, 0.16, ws.Z + 0.1), C.Belt, CFrame.new(0, waistTop - 0.12, 0))
		local skirtH = lower and 2.4 or 2.0
		for _, side in ipairs({ -1, 1 }) do
			-- Front panels pulled back to the sides (the trousers show in the middle).
			piece(waist, outfit, "Skirt", Vector3.new(ws.X * 0.3, skirtH, 0.12), C.Coat, CFrame.new(side * (ws.X / 2 - 0.1), waistTop - skirtH / 2, -ws.Z / 2 - 0.1) * CFrame.Angles(0, side * 0.35, side * -0.05))
			piece(waist, outfit, "Skirt", Vector3.new(0.12, skirtH, ws.Z + 0.3), C.CoatShade, CFrame.new(side * (ws.X / 2 + 0.16), waistTop - skirtH / 2, 0.06) * CFrame.Angles(0, 0, side * -0.06))
		end
		piece(waist, outfit, "SkirtBack", Vector3.new(ws.X + 0.5, skirtH + 0.1, 0.12), C.Coat, CFrame.new(0, waistTop - skirtH / 2 - 0.05, ws.Z / 2 + 0.14) * CFrame.Angles(0.06, 0, 0))
		piece(waist, outfit, "Hem", Vector3.new(ws.X + 0.56, 0.1, 0.14), C.CoatDark, CFrame.new(0, waistTop - skirtH - 0.02, ws.Z / 2 + 0.22))
	end
	-- Ribbed pink sleeves with grey ruffled cuffs.
	for _, name in ipairs({ "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "Left Arm", "Right Arm" }) do
		local arm = character:FindFirstChild(name)
		if arm then
			local as = arm.Size
			local tall = as.Y > 1.8
			local h = tall and as.Y - 0.3 or as.Y
			piece(arm, outfit, "Sleeve", Vector3.new(as.X + 0.1, h + 0.02, as.Z + 0.1), C.Coat, CFrame.new(0, as.Y / 2 - h / 2, 0))
			local y = as.Y / 2 - 0.25
			while y > as.Y / 2 - h + 0.15 do
				piece(arm, outfit, "Rib", Vector3.new(as.X + 0.16, 0.08, as.Z + 0.16), C.CoatShade, CFrame.new(0, y, 0))
				y = y - 0.3
			end
			if name:find("Lower") or tall then
				piece(arm, outfit, "Cuff", Vector3.new(as.X + 0.2, 0.26, as.Z + 0.2), C.Collar, CFrame.new(0, as.Y / 2 - h + 0.05, 0))
			end
		end
	end
	-- Magenta lattice gloves.
	for _, name in ipairs({ "LeftHand", "RightHand" }) do
		local hand = character:FindFirstChild(name)
		if hand then
			local hs = hand.Size
			piece(hand, outfit, "Glove", hs + Vector3.new(0.08, 0.06, 0.08), C.Glove, CFrame.new())
			for _, a in ipairs({ 0.7, -0.7 }) do
				piece(hand, outfit, "Lattice", Vector3.new(hs.X * 1.2, 0.04, 0.04), C.GloveLine, CFrame.new(0, 0, -hs.Z / 2 - 0.06) * CFrame.Angles(0, 0, a))
			end
		end
	end
	-- Padded magenta trousers and tall boots.
	for _, name in ipairs({ "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg" }) do
		local leg = character:FindFirstChild(name)
		if leg then
			local ls = leg.Size
			piece(leg, outfit, "Pants", ls + Vector3.new(0.06, 0.02, 0.06), C.Pants, CFrame.new())
			piece(leg, outfit, "Pad", Vector3.new(ls.X * 0.7, ls.Y * 0.4, 0.06), C.PantsShade, CFrame.new(0, ls.Y * 0.12, -ls.Z / 2 - 0.05))
			if name:find("Lower") or ls.Y > 1.8 then
				local bh = ls.Y > 1.8 and 1.0 or ls.Y + 0.05
				piece(leg, outfit, "Boot", Vector3.new(ls.X + 0.12, bh, ls.Z + 0.12), C.Pants, CFrame.new(0, -ls.Y / 2 + bh / 2, 0))
				piece(leg, outfit, "BootTop", Vector3.new(ls.X + 0.16, 0.12, ls.Z + 0.16), C.PantsShade, CFrame.new(0, -ls.Y / 2 + bh, 0))
			end
		end
	end
	for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(name)
		if foot then
			piece(foot, outfit, "Boot", foot.Size + Vector3.new(0.1, 0.06, 0.14), C.PantsShade, CFrame.new(0, 0, -0.03))
		end
	end
end

function ValentineOutfit.apply(character)
	if character:FindFirstChild("ValentineOutfit") then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local store = { Hidden = {} }
	saved[character] = store
	for _, d in ipairs(character:GetChildren()) do
		if d:IsA("Accessory") then
			local handle = d:FindFirstChild("Handle")
			local kind = d.AccessoryType
			if handle and (kind == Enum.AccessoryType.Hat or kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Unknown) then
				store.Hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	local outfit = Instance.new("Model")
	outfit.Name = "ValentineOutfit"
	outfit.Parent = character
	headPieces(head, outfit)
	body(character, outfit)
end

function ValentineOutfit.remove(character)
	local outfit = character:FindFirstChild("ValentineOutfit")
	if outfit then
		outfit:Destroy()
	end
	local store = saved[character]
	if not store then
		return
	end
	saved[character] = nil
	for thing, transparency in pairs(store.Hidden) do
		if thing.Parent then
			thing.Transparency = transparency
		end
	end
end

local function watch(character)
	local function update()
		if character:GetAttribute("TuskAct") == ValentineOutfit.Act then
			task.delay(0.3, function()
				if character.Parent and character:GetAttribute("TuskAct") == ValentineOutfit.Act then
					ValentineOutfit.apply(character)
				end
			end)
		else
			ValentineOutfit.remove(character)
		end
	end
	character:GetAttributeChangedSignal("TuskAct"):Connect(update)
	update()
end

function ValentineOutfit.init()
	local function onPlayer(player)
		player.CharacterAppearanceLoaded:Connect(watch)
		if player.Character then
			watch(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	-- Stand-user NPCs (StandBots) wear the outfit too.
	local CollectionService = game:GetService("CollectionService")
	for _, model in ipairs(CollectionService:GetTagged("SpinFighter")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinFighter"):Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
end

return ValentineOutfit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">WeatherService</string><ProtectedString name="Source"><![CDATA[--[[
	WeatherService  (ServerScriptService.SpinServer.WeatherService)

	Rain for the whole server: every TuskConfig.Weather.RainEvery seconds it
	rains for RainDuration seconds. Sets these ReplicatedStorage attributes:
	  SpinRaining   true while it rains
	  SpinRainEnds  server time the rain stops
	  SpinNextRain  server time the next rain starts
	Clients draw the rain (WeatherClient). Blackmore can walk on raindrops
	while it rains (TuskActs/Blackmore + BlackmoreVFX).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("SpinShared")
local TuskConfig = require(Shared.TuskConfig)

local WeatherService = {}

local function now()
	return workspace:GetServerTimeNow()
end

function WeatherService.isRaining()
	return ReplicatedStorage:GetAttribute("SpinRaining") == true
end

function WeatherService.setRain(on, seconds)
	ReplicatedStorage:SetAttribute("SpinRaining", on and true or nil)
	ReplicatedStorage:SetAttribute("SpinRainEnds", on and (now() + (seconds or 60)) or nil)
end

function WeatherService.init()
	local cfg = TuskConfig.Weather
	if not cfg or cfg.Enabled == false then
		return
	end
	local first = RunService:IsStudio() and (cfg.StudioFirstRainAfter or cfg.FirstRainAfter) or cfg.FirstRainAfter
	task.spawn(function()
		local nextRain = now() + (first or cfg.RainEvery)
		while true do
			ReplicatedStorage:SetAttribute("SpinNextRain", nextRain)
			task.wait(math.max(nextRain - now(), 0.1))
			WeatherService.setRain(true, cfg.RainDuration)
			task.wait(cfg.RainDuration)
			WeatherService.setRain(false)
			nextRain = nextRain + math.max(cfg.RainEvery, cfg.RainDuration + 1)
			if nextRain < now() then
				nextRain = now() + cfg.RainEvery
			end
		end
	end)
end

return WeatherService
]]></ProtectedString></Properties></Item></Item></roblox>